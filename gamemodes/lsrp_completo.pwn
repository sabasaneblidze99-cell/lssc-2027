bool:Admin_ParseSanctionTarget(playerid, const token[], &targetid)
{
	if (!Admin_ParseTarget(playerid, token, targetid))
	{
		return false;
	}
	if (targetid == playerid)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.");
		return false;
	}
	if (!Admin_CanTarget(playerid, targetid, false))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return false;
	}
	return true;
}

public Cmd_ah(playerid, const params[])
{
	if (Util_GetAdmin(playerid) < 1)
	{
		return 0;
	}
	Admin_SendHelp(playerid);
	return 1;
}

public Cmd_a(playerid, const params[])
{
	if (Util_GetAdmin(playerid) < 1)
	{
		return 0;
	}
	new text[129];
	if (!Util_SanitizeText(params, text, 128))
