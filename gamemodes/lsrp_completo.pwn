			}
			format(logDetail, 384, "%s: %s", tn, detail);
			Admin_LogRaw(g_FcSetStaffAcc[ctx], g_FcSetStaffName[ctx], g_FcSetTargetAcc[ctx], "setfazione", logDetail);
			Admin_AdmCmd(g_FcSetStaffName[ctx], "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;", tn, detail, "");
		}
		else if (req != INVALID_PLAYER_ID)
		{
			switch (cmd)
			{
				case 1:
				{
					SendClientMessage(req, 0x66DD66FF, "%s \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA3;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x93;\xE1;\x83;\x90; %s-\xE1;\x83;\xA1;.", tn, g_FacShort[faction]);
				}
				case 2:
				{
					SendClientMessage(req, 0x66DD66FF, "%s \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: %s.", tn, rn);
				}
				case 3:
				{
					SendClientMessage(req, 0x66DD66FF, "%s \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\x93;\xE1;\x83;\x90;: %s.", tn, rn);
				}
				case 4:
				{
					SendClientMessage(req, 0x66DD66FF, "%s \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;.", tn);
				}
			}
		}
		new msg[384];
		format(msg, 384, "cmd %d char %d fazione %d grado %d", cmd, targetChar, faction, rank);
		Log_Write("FACTION", msg);
	}
	else
	{
		new notify = ctx != 65535 && IsPlayerConnected(ctx) ? ctx : req;
		if (notify != 65535)
		{
			if (result < 0)
			{
				Util_Send(notify, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
			}
			else
