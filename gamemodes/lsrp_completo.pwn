		return 0;
	}
	if (!Freight_VehOk(playerid))
	{
		Freight_Stop(playerid, 4, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; Mule \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		return 0;
	}
	new veh = g_FrtVeh[playerid];
	new Float:hp;
	GetVehicleHealth(veh, hp);
	if ((hp < 300.0))
	{
		Freight_Stop(playerid, 4, "Mule \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x90;, \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		return 0;
	}
	new bool:driving = Freight_IsDriving(playerid);
	if (driving)
	{
		g_FrtBoarded[playerid] = true;
		g_FrtOff[playerid] = false;
		gPlayer[playerid][pFreightLeftVehTick] = 0;
	}
	else if (g_FrtBoarded[playerid])
	{
		if (!g_FrtOff[playerid])
		{
