UI_FactionMemberListClear(playerid)
{
	if (!UI_FcValid(playerid))
	{
		return 0;
	}
	g_UiFcCount[playerid] = 0;
	g_UiFcSel[playerid] = -1;
	return 0;
}

bool:UI_FactionMemberListAdd(playerid, memberId, const name[], rank, status)
{
	if (!UI_FcValid(playerid))
	{
		return false;
	}
	new n = g_UiFcCount[playerid];
	if (n >= 32)
	{
		return false;
	}
	if (rank < 1)
	{
		rank = 1;
	}
	if (rank > 6)
	{
		rank = 6;
	}
	if (status < 0 || status > 2)
	{
		status = 0;
	}
	g_UiFcMemId[playerid][n] = memberId;
	g_UiFcMemInfo[playerid][n] = rank | status << 8;
	strpack(g_UiFcMemName[playerid][n], name, 7);
	g_UiFcCount[playerid] = n + 1;
	return true;
}

UI_FcMemberName(playerid, idx, out[], size)
{
	strunpack(out, g_UiFcMemName[playerid][idx], size);
}

bool:UI_FcEligible(ownRank, action, rank, reason[], size)
{
	if (action == 2)
	{
		return true;
	}
	if (rank >= ownRank)
	{
		format(reason, size, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;.");
		return false;
	}
	if (action == 4 && rank + 1 >= ownRank)
	{
		format(reason, size, "\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA1;.");
		return false;
	}
	if (action == 5 && rank <= 1)
	{
		format(reason, size, "\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA0; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;.");
		return false;
	}
	return true;
}

UI_FcPagesCount(playerid)
{
	new pages = (g_UiFcCount[playerid] + 12 - 1) / 12;
	return pages < 1 ? 1 : pages;
}

UI_FcMembersPage(playerid, page)
{
	new faction = g_UiFcFaction[playerid], ownRank = g_UiFcRank[playerid], mode = g_UiFcMode[playerid];
	new pages = UI_FcPagesCount(playerid);
	if (page < 0)
	{
		page = 0;
	}
	if (page >= pages)
	{
		page = pages - 1;
	}
	g_UiFcPage[playerid] = page;
	g_UiFcSel[playerid] = -1;
	new title[576], verb[48];
	UI_FcActionVerb(mode, verb, 48);
	if (g_UiFcCount[playerid] == 0)
	{
		format(title, 576, "%s - %s", verb, g_UiFcShort[faction]);
		Lang_ShowPlayerDialog(playerid, 9323, DIALOG_STYLE_MSGBOX, title, "{FFFFFF}\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;.", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;", "");
		return 0;
	}
	new body[3072], line[576], name[75], rankName[72], status[72], reason[24];
	strcat(body, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\t\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\t\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;\n", 3072);
	new start = page * 12;
	new n = g_UiFcCount[playerid] - start;
	if (n > 12)
	{
		n = 12;
	}
	for (new i = 0; i < n; i++)
	{
		new idx = start + i;
		new rank = g_UiFcMemInfo[playerid][idx] & 255;
		new st = g_UiFcMemInfo[playerid][idx] >> 8 & 255;
		UI_FcMemberName(playerid, idx, name, 75);
		UI_FcRankText(faction, rank, rankName, 72);
		if (UI_FcEligible(ownRank, mode, rank, reason, 24))
		{
			UI_FcStatusText(st, status, 72);
			format(line, 576, "{FFFFFF}%s\t{FFD24D}%s (%d)\t%s\n", name, rankName, rank, status);
		}
		else
		{
			format(line, 576, "{888888}%s\t%s (%d)\t{888888}\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\n", name, rankName, rank);
		}
		strcat(body, line, 3072);
	}
	if (page > 0)
	{
		strcat(body, "{FFD24D}<< \xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x98;\t\t\n", 3072);
	}
	if (page < pages - 1)
	{
		strcat(body, "{FFD24D}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x98; >>\t\t\n", 3072);
	}
	if (mode == 2)
	{
		format(title, 576, "\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; %s (\xE1;\x83;\x92;\xE1;\x83;\x95;. %d/%d)", g_UiFcShort[faction], page + 1, pages);
	}
	else
	{
		format(title, 576, "%s \xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; - %s (\xE1;\x83;\x92;\xE1;\x83;\x95;. %d/%d)", verb, g_UiFcShort[faction], page + 1, pages);
	}
	Lang_ShowPlayerDialog(playerid, 9322, DIALOG_STYLE_TABLIST_HEADERS, title, body, mode == 2 ? "\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;" : "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
	return 0;
}

UI_FactionMembersShow(playerid, faction, ownRank, mode)
{
	if (!UI_FcValid(playerid))
	{
		return 0;
	}
	if (faction < 1 || faction > 2 || ownRank < 1 || ownRank > 6)
	{
		return 0;
