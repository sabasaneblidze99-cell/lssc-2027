	Lang_ShowPlayerDialog(playerid, 9503, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", body, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;");
