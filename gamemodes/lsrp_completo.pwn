Bank_OnInit()
{
	for (new i = 0; i < 9; i++)
	{
		new bool:counter = Bank_IsCounter(i);
		g_BankPickup[i] = CreatePickup(1274, 1, s_BankPoints[i][0], s_BankPoints[i][1], s_BankPoints[i][2], 0);
		g_BankLabel[i] = Lang_Create3DTextLabel(counter ? "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98; - \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\n\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /atm" : "ATM\n\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /atm", 0x66DD66FF, s_BankPoints[i][0], s_BankPoints[i][1], (1.0 + s_BankPoints[i][2]), 12.0, 0, false);
	}
}

Bank_OnExit()
{
	for (new i = 0; i < 9; i++)
	{
		if (g_BankPickup[i] >= 0)
		{
			DestroyPickup(g_BankPickup[i]);
		}
		Delete3DTextLabel(g_BankLabel[i]);
		g_BankPickup[i] = -1;
		g_BankLabel[i] = INVALID_3DTEXT_ID;
	}
}

Bank_OnPlayerConnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	gPlayer[playerid][pBankOpBusy] = 0;
	return 0;
}

Bank_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (gPlayer[playerid][pBankOpBusy] != 0 && gPlayer[playerid][pBankOp] >= 1 && gPlayer[playerid][pBankOp] <= 3)
	{
		new msg[528], name[75];
		GetPlayerName(playerid, name, 75);
		format(msg, 528, "%s esce con operazione bancaria %d in volo (importo %d, op %s)", name, gPlayer[playerid][pBankOp], gPlayer[playerid][pBankOpAmount], gPlayer[playerid][pBankOpId]);
		Log_Write("BANK", msg);
	}
	gPlayer[playerid][pBankPendTarget] = 0;
	return 0;
}

