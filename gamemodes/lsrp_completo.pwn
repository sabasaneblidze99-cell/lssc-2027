			Util_Send(playerid, 0x99CCFFFF, "Pershing Square-\xE1;\x83;\x98;\xE1;\x83;\xA1; Job Center \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;. \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAA; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x9D; /lavoro \xE1;\x83;\x90;\xE1;\x83;\x9C; /noleggio.");
		}
