Veh_CmdV(playerid, const params[])
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	new pos = 0, sub[48], a1[48], a2[48];
	Util_NextToken(params, pos, sub, 48);
	Util_NextToken(params, pos, a1, 48);
	Util_NextToken(params, pos, a2, 48);
	for (new i = 0; sub[i] != 0; i++)
	{
		sub[i] = tolower(sub[i]);
	}
	if (sub[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /v lock | engine | lights | park | find [slot] | list | sell [slot] | recover [slot]");
		return 0;
	}
	if (Veh_CooldownBlocked(playerid))
	{
		return 0;
	}
	if (!strcmp(sub, "lock", false, 0x7FFFFFFF))
	{
		Veh_DoLock(playerid);
		return 0;
	}
	if (!strcmp(sub, "engine", false, 0x7FFFFFFF))
	{
		Veh_DoEngine(playerid);
		return 0;
	}
	if (!strcmp(sub, "lights", false, 0x7FFFFFFF))
	{
		Veh_DoLights(playerid);
		return 0;
	}
	if (!strcmp(sub, "park", false, 0x7FFFFFFF))
	{
		Veh_DoPark(playerid);
		return 0;
	}
	if (!strcmp(sub, "list", false, 0x7FFFFFFF))
	{
		Veh_DoList(playerid);
		return 0;
	}
	if (!strcmp(sub, "tow", false, 0x7FFFFFFF))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
