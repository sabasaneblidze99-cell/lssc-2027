Intro_CmdSalta(playerid)
{
	new left = Intro_Skip(playerid);
	if (left < 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9F;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA3;\xE1;\x83;\xA7;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;.");
	}
	else if (left > 0)
	{
		new msg[1024];
		format(msg, 1024, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; %d \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", left);
		Util_Send(playerid, -10270721, msg);
	}
}

Intro_CmdStoria(playerid, const params[])
{
	new pos = 0, tok[48], name[75], target = INVALID_PLAYER_ID;
	Util_NextToken(params, pos, tok, 48);
	if (tok[0] == 0)
	{
		GetPlayerName(playerid, name, 75);
		UI_StoryShowOwn(playerid, name, gPlayer[playerid][pStoryOrigin], gPlayer[playerid][pStoryMotive]);
		return 0;
	}
	if (!strcmp(tok, "imposta", true, 0x7FFFFFFF))
	{
		if (gPlayer[playerid][pStoryOrigin] != 0 || gPlayer[playerid][pStoryMotive] != 0)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
			return 0;
		}
		gPlayer[playerid][pStorySetMode] = 1;
		UI_StoryBegin(playerid);
		return 0;
	}
	if (Util_GetAdmin(playerid) >= 2 && Util_ParsePlayerId(tok, target) && Util_IsPlaying(target))
	{
		DB_StoryRead(playerid, target, 2);
		return 0;
	}
	if (Util_GetAdmin(playerid) >= 2)
	{
