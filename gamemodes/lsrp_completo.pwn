		}
	}
	Lang_ShowPlayerDialog(playerid, 9324, DIALOG_STYLE_MSGBOX, verb, body, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;");
}

UI_FactionInviteShow(playerid, faction, const inviterName[], ttlSec)
{
	if (!UI_FcValid(playerid))
	{
		return 0;
	}
	if (faction < 1 || faction > 2)
	{
		return 0;
	}
	new body[1024], rank1[72];
	UI_FcRankText(faction, 1, rank1, 72);
	format(body, 1024, "{FFD24D}%s{FFFFFF} \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA1; {FFD24D}%s{FFFFFF}-\xE1;\x83;\xA8;\xE1;\x83;\x98;.\n\n\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; {FFD24D}%s{FFFFFF}.\n\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; {FF6666}%d{FFFFFF} \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", inviterName, g_UiFcFull[faction], rank1, ttlSec > 0 ? ttlSec : 60);
	Lang_ShowPlayerDialog(playerid, 9326, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;", body, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x90;");
	return 0;
}

UI_FactionInviteClose(playerid)
{
	if (!UI_FcValid(playerid))
	{
		return 0;
	}
	if (GetPlayerDialogID(playerid) == 9326)
	{
		HidePlayerDialog(playerid);
	}
	return 0;
}

bool:UI_FactionOnDialogResponse(playerid, dialogid, response, listitem, const inputtext[])
{
	if (!UI_FcValid(playerid))
	{
		return false;
	}
	switch (dialogid)
	{
		case 9320:
		{
			if (!response)
			{
				return true;
			}
			if (listitem < 0 || listitem >= 8 || g_UiFcMenuAct[playerid][listitem] == 0)
			{
				UI_FactionMenuShow(playerid, g_UiFcFaction[playerid], g_UiFcRank[playerid], g_UiFcDuty[playerid], g_UiFcOnline[playerid], g_UiFcTotal[playerid]);
				return true;
			}
			new act = g_UiFcMenuAct[playerid][listitem];
			if (act == 1)
			{
				UI_FcInfoShow(playerid);
			}
			else if (act == 3)
			{
				if (g_UiFcRank[playerid] < 5)
				{
					return true;
				}
				UI_FcInviteTargetShow(playerid, "");
			}
			else
			{
				if (act != 2 && g_UiFcRank[playerid] < 5)
				{
					return true;
				}
				UI_OnFactionMenuAction(playerid, act);
			}
			return true;
		}
		case 9321:
		{
			if (response)
			{
				UI_FactionMenuShow(playerid, g_UiFcFaction[playerid], g_UiFcRank[playerid], g_UiFcDuty[playerid], g_UiFcOnline[playerid], g_UiFcTotal[playerid]);
			}
			return true;
		}
		case 9322:
		{
			if (!response)
			{
				return true;
			}
			new page = g_UiFcPage[playerid];
			new pages = UI_FcPagesCount(playerid);
			new start = page * 12;
			new n = g_UiFcCount[playerid] - start;
			if (n > 12)
			{
				n = 12;
			}
			if (listitem < 0)
			{
				UI_FcMembersPage(playerid, page);
				return true;
			}
			if (listitem < n)
			{
				new idx = start + listitem;
				new mode = g_UiFcMode[playerid];
				if (mode == 2)
				{
					g_UiFcSel[playerid] = idx;
					UI_FcMemberInfoShow(playerid, idx);
					return true;
				}
				new reason[192];
				reason[0] = 0;
				if (g_UiFcRank[playerid] < 5 || !UI_FcEligible(g_UiFcRank[playerid], mode, g_UiFcMemInfo[playerid][idx] & 255, reason, 192))
				{
					if (reason[0] != 0)
					{
						SendClientMessage(playerid, -10066177, reason);
					}
					UI_FcMembersPage(playerid, page);
					return true;
				}
				UI_FcConfirmShow(playerid, idx);
				return true;
			}
			new pos = listitem - n;
			if (page > 0)
			{
				if (pos == 0)
				{
					UI_FcMembersPage(playerid, page - 1);
					return true;
				}
				pos--;
			}
			if (page < pages - 1 && pos == 0)
			{
				UI_FcMembersPage(playerid, page + 1);
				return true;
			}
			UI_FcMembersPage(playerid, page);
			return true;
		}
		case 9323:
		{
			if (response && g_UiFcCount[playerid] > 0)
			{
				UI_FcMembersPage(playerid, g_UiFcPage[playerid]);
			}
			return true;
		}
		case 9324:
		{
			new idx = g_UiFcSel[playerid];
			new mode = g_UiFcMode[playerid];
			if (idx < 0 || idx >= g_UiFcCount[playerid])
			{
				return true;
			}
			if (!response)
			{
				UI_FcMembersPage(playerid, g_UiFcPage[playerid]);
				return true;
			}
			new reason[192];
