public UI_OnTaxiCallAccept(playerid, callId)
{
	if (callId <= 0)
	{
		return 1;
	}
	if (callId <= 1000)
	{
		Taxi_AcceptPlayer(playerid, callId - 1);
	}
	else if (callId == g_TxOfferCall[playerid])
	{
		Taxi_AcceptNpc(playerid);
	}
	else
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;.");
	}
	return 1;
}

public UI_OnTaxiPayConfirm(playerid, rideId, accept)
{
	new d = Taxi_DriverOf(playerid);
	if (d == 65535 || rideId <= 0 || gPlayer[d][pTaxiRideId] != rideId || g_TxPhase[d] != 4 || gPlayer[d][pTaxiPendOp] != 0)
	{
		UI_LivingReject(playerid, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;.");
		return 1;
	}
	g_TxPhase[d] = 5;
	g_TxPayAccept[d] = accept != 0;
	g_TxRetry[d] = 0;
	gPlayer[d][pTaxiPendOp] = 7;
	DB_LivingMakeOpId(gPlayer[d][pTaxiOpId], 41, "tp", rideId, gPlayer[d][pCharId]);
	Util_Send(playerid, -1, accept != 0 ? "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;..." : "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
	DB_LivingTaxiPay(d, rideId, playerid, g_TxPayMeters[d], g_TxPayToD[d], g_TxPayAccept[d], 0, gPlayer[d][pTaxiOpId]);
	return 1;
}

public UI_OnTaxiPayExpired(playerid, rideId)
{
	new d = Taxi_DriverOf(playerid);
