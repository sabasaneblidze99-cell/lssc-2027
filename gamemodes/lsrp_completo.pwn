public UI_OnContractAbandon(playerid, contractId)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	if (contractId <= 0 || gPlayer[playerid][pContractId] != contractId)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;.");
		return 1;
	}
	Director_Release(playerid, 1);
	return 1;
}

public UI_OnContractBoardRefresh(playerid)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	if (!DB_IsReady())
	{
		CityOS_ShowBoard(playerid);
		return 1;
	}
	g_CosWaitBoard[playerid] = true;
	DB_LivingBoard(65535);
	return 1;
}

public UI_OnDistrictPick(playerid, districtId)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	CityOS_ShowDistrict(playerid, districtId);
	return 1;
}

