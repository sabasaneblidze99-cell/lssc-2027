public Bank_OnDBSynced(playerid, result, balance)
{
	if (!Bank_Valid(playerid))
	{
		return 1;
	}
	if (result == 1)
	{
		Char_RefreshHud(playerid);
	}
	if (!Bank_OpIs(playerid, 7))
	{
		return 1;
	}
	if (result == 1)
	{
		Bank_EndOp(playerid);
		SendClientMessage(playerid, -1, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D; \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: $%d.", gPlayer[playerid][pBank]);
		return 1;
	}
	Bank_ScheduleResync(playerid);
	return 1;
}

bool:Bank_XferCheck(playerid, target, amount, bool:ui)
{
	new now = Bank_Tick(), msg[528];
	if (gPlayer[playerid][pBankXferBlockUntil] != 0)
	{
		new left = gPlayer[playerid][pBankXferBlockUntil] - now;
		if (left > 0)
		{
			format(msg, 528, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x95; %d \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x97; (\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;).", (left + 1000 - 1) / 1000);
			Bank_Reply(playerid, ui, msg);
			return false;
		}
		gPlayer[playerid][pBankXferBlockUntil] = 0;
	}
