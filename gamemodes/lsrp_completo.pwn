public Cmd_stats(playerid, const params[])
{
	new name[75], level = gPlayer[playerid][pLevel], exp = gPlayer[playerid][pExp];
	GetPlayerName(playerid, name, 75);
	SendClientMessage(playerid, -2994689, "--- %s-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\x99;\xE1;\x83;\x90; ---", name);
	if (level >= 50)
	{
		SendClientMessage(playerid, -1, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;: %d (\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;)  \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9A; Exp: %d", level, exp);
	}
	else
	{
		SendClientMessage(playerid, -1, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;: %d  Exp: %d/%d", level, exp - Level_ExpForLevel(level), Level_StepExp(level));
	}
	SendClientMessage(playerid, -1, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98;: $%d  \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;: $%d", gPlayer[playerid][pMoney], gPlayer[playerid][pBank]);
	new played = gPlayer[playerid][pSessionMs];
	new total = gPlayer[playerid][pPlayedMs];
	SendClientMessage(playerid, -1, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;: \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x90; %d\xE1;\x83;\xA1; %02d\xE1;\x83;\xAC;, \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9A; %d\xE1;\x83;\xA1; %02d\xE1;\x83;\xAC;", played / 3600000, played % 3600000 / 60000, total / 3600000, total % 3600000 / 60000);
	new remainSec = (900000 - gPlayer[playerid][pPaycheckMs]) / 1000;
	if (remainSec < 0)
	{
		remainSec = 0;
	}
	SendClientMessage(playerid, -1, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;: %d \xE1;\x83;\xAC;\xE1;\x83;\x97; %02d \xE1;\x83;\xAC;\xE1;\x83;\x9B; (%d $ \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA8;\xE1;\x83;\x98;)", remainSec / 60, remainSec % 60, Economy_PaycheckAmount(level));
	return 1;
}

public Cmd_who(playerid, const params[])
{
	new total = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i))
		{
			total++;
		}
	}
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; (%d) ---", total);
	new shown = 0, name[75];
	for (new i = 0; i < MAX_PLAYERS && shown < 50; i++)
	{
		if (!Util_IsPlaying(i))
		{
			continue;
		}
		GetPlayerName(i, name, 75);
		SendClientMessage(playerid, -1, "[%d] %s", i, name);
		shown++;
	}
	if (total > shown)
	{
		SendClientMessage(playerid, -1, "... \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x95; %d \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.", total - shown);
	}
	return 1;
}

