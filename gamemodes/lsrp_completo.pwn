	if (!Rental_BeginOpen(playerid, modelIdx, blocks, 1))
	{
		UI_LivingReject(playerid, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return 1;
	}
	Util_Send(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;...");
	return 1;
}

bool:Rental_CanReturn(playerid, bool:verbose)
{
	if (!Util_IsPlaying(playerid))
	{
		return false;
	}
	if (gPlayer[playerid][pRentalId] == 0)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		}
		return false;
	}
	if (gPlayer[playerid][pRentalClass] == 2)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; /taxi off-\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		}
		return false;
	}
	if (gPlayer[playerid][pRentalPendOp] != 0)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		}
		return false;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || GetPlayerVehicleID(playerid) != veh || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		}
		return false;
	}
	if (gPlayer[playerid][pRentalKind] != SRENT_VKIND && !Rental_AtOffice(playerid, 12.0))
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; Pershing Square-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98;.");
		}
		return false;
	}
	return true;
}

Rental_CmdRiconsegna(playerid, const params[])
{
	#pragma unused params
	if (!Rental_CanReturn(playerid, true))
	{
		return 1;
	}
	new name[48], health = Rental_VehHealth(gPlayer[playerid][pRentalVehicle]);
	Rental_KindName(gPlayer[playerid][pRentalKind], name, 48);
	new deposit = g_RtDeposit[playerid];
	new refund = LD_RentalRefund(deposit, health);
	if (gPlayer[playerid][pRentalDueAt] > 0 && gettime() > gPlayer[playerid][pRentalDueAt] + 300)
	{
		refund = 0;
	}
	UI_LivingRentalReturnConfirm(playerid, gPlayer[playerid][pRentalId], name, health / 10, deposit, refund);
	return 1;
}

public UI_OnRentalReturnConfirm(playerid, rentalId)
{
	if (rentalId <= 0 || rentalId != gPlayer[playerid][pRentalId])
	{
		UI_LivingReject(playerid, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;.");
		return 1;
	}
	if (!Rental_CanReturn(playerid, true))
	{
		return 1;
	}
	Rental_SendClose(playerid, 1, Rental_VehHealth(gPlayer[playerid][pRentalVehicle]), 1);
	Util_Send(playerid, -1, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;...");
	return 1;
}

Rental_GetVehicle(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || !IsValidVehicle(veh))
	{
		return 0;
	}
	return veh;
}

bool:Rental_OpenPro(playerid, vkind)
{
	if (!Rental_ValidPlayer(playerid) || !Util_IsPlaying(playerid) || vkind != 4)
	{
		return false;
	}
	if (!LD_PoolHasRoom())
	{
		return false;
	}
	return Rental_BeginOpen(playerid, vkind, 1, 2);
}

bool:Rental_ClosePro(playerid, reason)
{
	if (!Rental_ValidPlayer(playerid) || gPlayer[playerid][pRentalClass] != 2)
	{
		return false;
	}
	if (gPlayer[playerid][pRentalPendOp] == 5)
	{
		g_RtAbortOpen[playerid] = true;
		return true;
	}
	if (gPlayer[playerid][pRentalId] == 0)
	{
		return false;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	switch (reason)
	{
		case 1, 4, 5:
		{
			return Rental_SendClose(playerid, 1, Rental_VehHealth(veh), reason);
		}
		case 2, 3:
		{
			return Rental_CloseInterrupted(playerid, reason);
		}
	}
	return Rental_SendClose(playerid, 3, 0, reason);
}

Rental_RetrySend(playerid)
{
	g_RtRetryAt[playerid] = 0;
	if (gPlayer[playerid][pRentalPendOp] != 6 || gPlayer[playerid][pRentalId] == 0)
	{
		return 0;
	}
	DB_LivingRentClose(playerid, gPlayer[playerid][pRentalId], g_RtCloseMode[playerid], g_RtCloseHealth[playerid], gPlayer[playerid][pRentalOpId]);
	return 0;
}

Rental_TickPlayer(playerid, now, nowTick)
{
	if (g_RtRetryAt[playerid] != 0 && nowTick - g_RtRetryAt[playerid] >= 0)
	{
		Rental_RetrySend(playerid);
		return 0;
	}
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || !IsValidVehicle(veh))
	{
		Log_Write("RENTAL", "veicolo a noleggio scomparso senza OnVehicleDeath: noleggio interrotto (cauzione 100%)");
		if (pro)
		{
			Rental_ClosePro(playerid, 7);
		}
		else
		{
			Rental_SendClose(playerid, 3, 0, 7);
		}
		return 0;
	}
	new due = gPlayer[playerid][pRentalDueAt];
	if (due <= 0)
	{
		return 0;
	}
	new left = due - now;
	if (left <= 300 && !(gPlayer[playerid][pRentalWarnFlags] & 1))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 1;
		SendClientMessage(playerid, -2994689, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; %d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", (left + 60 - 1) / 60);
	}
	if (left <= 60 && !(gPlayer[playerid][pRentalWarnFlags] & 2))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 2;
		Util_Send(playerid, -2994689, pro ? "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;." : "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98; (/riconsegna).");
	}
	if (left <= 0 && !(gPlayer[playerid][pRentalWarnFlags] & 4))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 4;
		if (!pro)
		{
			SendClientMessage(playerid, -10270721, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; %d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x98;, \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", 5);
		}
	}
	if (pro)
	{
		if (left <= 0 && (gPlayer[playerid][pTaxiRideId] == 0 || -left >= 150))
		{
			Util_Send(playerid, -1, "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;: \xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
			Rental_ClosePro(playerid, 5);
		}
		return 0;
	}
	if (-left >= 300)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		Rental_SendClose(playerid, 2, 0, 5);
	}
	return 0;
}

public Rental_OnTick()
{
	new now = gettime(), nowTick = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (gPlayer[i][pRentalId] == 0 && g_RtRetryAt[i] == 0)
		{
			continue;
		}
		Rental_TickPlayer(i, now, nowTick);
	}
	return 1;
}

Rental_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Rental_ResetPlayer(i);
	}
	if (g_RtTimer != 0)
	{
		KillTimer(g_RtTimer);
	}
	g_RtTimer = SetTimer("Rental_OnTick", 1000, true);
	CreatePickup(1239, 1, 1505.0, -1700.0, 13.5, 0);
	Lang_Create3DTextLabel("\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\n/noleggio  \xC2;\xB7;  /riconsegna", -2994689, 1505.0, -1700.0, (13.5 + 0.8), 20.0, 0, false);
}

Rental_OnExit()
{
	if (g_RtTimer != 0)
	{
		KillTimer(g_RtTimer);
	}
	g_RtTimer = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (gPlayer[i][pRentalVehicle] != 0)
		{
			Rental_VehDestroy(i);
		}
	}
}

Rental_OnPlayerConnect(playerid)
{
	Rental_ResetPlayer(playerid);
}

Rental_OnCharReady(playerid)
{
	#pragma unused playerid
}

Rental_OnPlayerDisconnect(playerid, reason)
{
	#pragma unused reason
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] == 0 && gPlayer[playerid][pRentalId] != 0)
	{
		if (gPlayer[playerid][pRentalClass] == 2)
		{
			Rental_ClosePro(playerid, 2);
		}
		else
		{
			Rental_CloseInterrupted(playerid, 2);
		}
	}
	Rental_VehDestroy(playerid);
	Rental_ResetPlayer(playerid);
	return 0;
}

Rental_OnPlayerDeath(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] == 5)
	{
		g_RtAbortOpen[playerid] = true;
		return 0;
	}
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalClass] == 2)
