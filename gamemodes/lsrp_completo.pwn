public Admin_OnAccountFound(requesterid, tag, accountId, const name[], adminLevel, const lastIp[])
{
	new e = Admin_PendTake(tag, 0, name);
	if (e < 0)
	{
		return 1;
	}
	new tname[75], sname[75], msg[768];
	strmid(sname, g_AdmPend[e][apStaffName], 0, strlen(g_AdmPend[e][apStaffName]), 75);
	new level = g_AdmPend[e][apValue], staffAcc = g_AdmPend[e][apStaffAcc];
	if (accountId > 0)
	{
		strmid(tname, name, 0, strlen(name), 75);
	}
	else
	{
		strmid(tname, g_AdmPend[e][apTargetName], 0, strlen(g_AdmPend[e][apTargetName]), 75);
	}
	if (tag == 5)
	{
		if (accountId == -1)
		{
			print("[ADMIN] setadmin: errore database");
			return 1;
		}
		if (accountId <= 0)
		{
			printf("[ADMIN] setadmin: account '%s' non trovato (deve essere registrato)", tname);
			return 1;
		}
		Admin_ApplyLevel(accountId, level);
		format(msg, 768, "rcon: livello %d", level);
		Admin_LogRaw(0, "Console", accountId, "setadmin", msg);
		printf("[ADMIN] %s impostato a livello staff %d", tname, level);
		new online = Admin_FindByAccount(accountId);
		if (online != 65535)
		{
			SendClientMessage(online, -5963521, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;-\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90;: %d.", level);
		}
		return 1;
	}
	if (requesterid == 65535 || !IsPlayerConnected(requesterid) || gPlayer[requesterid][pAccountId] != staffAcc)
	{
		return 1;
	}
	if (accountId == -1)
	{
		Admin_Reply(requesterid, -10270721, "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;, \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
		return 1;
	}
	if (accountId <= 0)
	{
		Admin_Reply(requesterid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x90;.");
		return 1;
	}
	new myLevel = Util_GetAdmin(requesterid);
	if (adminLevel >= myLevel || accountId == staffAcc)
	{
		Admin_Reply(requesterid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return 1;
	}
	if (tag == 4)
	{
		if (myLevel < 3)
		{
			return 1;
		}
		Admin_ApplyLevel(accountId, level);
		new online = Admin_FindByAccount(accountId);
		if (online != 65535)
		{
			SendClientMessage(online, -5963521, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;-\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;: %d (%s).", level, sname);
		}
		format(msg, 768, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d", level);
		Admin_AdmCmd(sname, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;-\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;:", tname, msg, "");
		Admin_LogRaw(staffAcc, sname, accountId, "setadmin", msg);
	}
	else if (tag == 6)
	{
		if (myLevel < 3)
		{
			return 1;
		}
		Admin_PendSet(requesterid, 3, accountId, tname, 0, "");
		DB_Unban(requesterid, tname);
	}
	return 1;
}

Admin_StoreReport(playerid, const text[])
{
	g_RepSeq++;
	new slot = g_RepSeq % 10;
	g_RepId[slot] = g_RepSeq;
	GetPlayerName(playerid, g_RepAuthor[slot], 25);
	strmid(g_RepText[slot], text, 0, strlen(text), 97);
}

Admin_ListReports(playerid)
{
	new shown = 0, msg[256];
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\x91;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; ---");
	for (new k = 0; k < 10; k++)
	{
		new id = g_RepSeq - k;
		if (id < 1)
		{
			break;
		}
		new slot = id % 10;
		if (g_RepId[slot] != id)
		{
			continue;
		}
		format(msg, 256, "[#%d] %s: %s", id, g_RepAuthor[slot], g_RepText[slot]);
		Admin_Notify_One(playerid, msg);
		shown++;
	}
	if (shown == 0)
	{
		Util_Send(playerid, -1, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;.");
	}
}

Admin_ReplyReport(playerid, reportId, const text[])
{
	if (reportId < 1 || reportId > g_RepSeq)
	{
		return 0;
	}
	new slot = reportId % 10;
	if (g_RepId[slot] != reportId)
	{
		return 0;
	}
	new target = Admin_FindByName(g_RepAuthor[slot]);
	if (target == INVALID_PLAYER_ID)
	{
		return 2;
	}
	new name[75];
	GetPlayerName(playerid, name, 75);
	SendClientMessage(target, -5963521, "[STAFF] %s: %s", name, text);
	return 1;
}

Admin_OnRconCommand(const cmd[])
{
	new pos = 0, word[48], name[75], tlv[36], level = 0;
	Util_NextToken(cmd, pos, word, 48);
	if (strcmp(word, "setadmin", true, 0x7FFFFFFF) != 0)
	{
		return 0;
	}
	Util_NextToken(cmd, pos, name, 75);
	Util_NextToken(cmd, pos, tlv, 36);
	for (new i = 0; tlv[i] != 0; i++)
	{
		if (tlv[i] < 48 || tlv[i] > 57)
		{
			tlv[i] = 0;
			break;
		}
	}
	if (name[0] == 0 || tlv[0] == 0 || !Util_ParseInt(tlv, level) || level < 0 || level > 3)
	{
		printf("Uso: %s nome_account 0-%d", "setadmin", 3);
		return 1;
	}
	if (!DB_IsReady())
	{
		print("[ADMIN] database non disponibile");
		return 1;
	}
	if (Admin_Busy(65535))
	{
		print("[ADMIN] operazione precedente ancora in corso, riprova");
		return 1;
	}
	Admin_PendSet(65535, 5, 0, name, level, "");
	DB_FindAccountByName(65535, name, 5);
	return 1;
}

