	DB_PendingClear(playerid, 262144);
	if (funcidx("Job_OnDBPayout") != -1)
	{
		CallLocalFunction("Job_OnDBPayout", "dddd", playerid, jobId, amount, affected > 0 ? 1 : 0);
	}
	return 1;
}

