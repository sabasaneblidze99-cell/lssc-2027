		}
		case 2:
		{
			UI_LivingNotify(playerid, "\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x98;, \xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x9D;\xE1;\x83;\xA0; \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x97;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1; Idlewood. \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAA; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x97;, \xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA1;.", 1);
		}
		case 3:
		{
			if (paid > 0)
			{
				format(msg, 768, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1;. \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x96;\xE1;\x83;\x94; $%d \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;.", paid);
