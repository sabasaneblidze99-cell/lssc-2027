bool:UI_InvValid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

bool:UI_InvItemOk(itemId)
{
	return itemId >= 1 && itemId < 11;
}

bool:UI_InvParseNum(const s[], &value)
{
	new i = 0, len = strlen(s), digits = 0;
	value = 0;
	while (i < len && s[i] == 32)
	{
		i++;
	}
	while (i < len && s[i] >= 48 && s[i] <= 57)
	{
		if (digits >= 4)
		{
			return false;
		}
		value = value * 10 + (s[i] - 48);
		digits++;
		i++;
	}
	while (i < len && s[i] == 32)
	{
		i++;
	}
	return digits > 0 && i == len;
}

UI_InvSelReset(playerid)
{
	g_UiInvSel[playerid] = -1;
	g_UiInvSelItem[playerid] = 0;
	g_UiInvSelQty[playerid] = 0;
	g_UiInvPendAct[playerid] = 0;
}

bool:UI_InvSelOk(playerid)
{
	new slot = g_UiInvSel[playerid];
	if (slot < 0 || slot >= 20 || slot >= g_UiInvMax[playerid])
	{
		return false;
	}
	return g_UiInvItem[playerid][slot] == g_UiInvSelItem[playerid] && g_UiInvQty[playerid][slot] > 0;
}

UI_InvClear(playerid)
{
	if (!UI_InvValid(playerid))
	{
		return 0;
	}
	for (new i = 0; i < 20; i++)
	{
		g_UiInvItem[playerid][i] = 0;
		g_UiInvQty[playerid][i] = 0;
	}
	g_UiInvUsed[playerid] = 0;
	return 0;
}

UI_InvSet(playerid, slot, itemId, qty)
{
	if (!UI_InvValid(playerid) || slot < 0 || slot >= 20)
	{
		return 0;
	}
	if (!UI_InvItemOk(itemId) || qty <= 0)
	{
		g_UiInvItem[playerid][slot] = 0;
		g_UiInvQty[playerid][slot] = 0;
		return 0;
	}
	g_UiInvItem[playerid][slot] = itemId;
	g_UiInvQty[playerid][slot] = qty;
	return 0;
}

UI_InvMeta(playerid, slotsUsed, slotsMax, bool:bag)
{
	if (!UI_InvValid(playerid))
	{
		return 0;
	}
	if (slotsMax < 1)
	{
		slotsMax = 1;
	}
	if (slotsMax > 20)
	{
		slotsMax = 20;
	}
	if (slotsUsed < 0)
	{
		slotsUsed = 0;
	}
	if (slotsUsed > slotsMax)
	{
		slotsUsed = slotsMax;
	}
	g_UiInvUsed[playerid] = slotsUsed;
	g_UiInvMax[playerid] = slotsMax;
	g_UiInvBag[playerid] = bag;
	return 0;
}

UI_InvListPage(playerid, page)
{
	new slots[20], n = 0;
	new limit = g_UiInvMax[playerid];
	if (limit < 1)
	{
		limit = 12;
	}
	if (limit > 20)
	{
		limit = 20;
	}
	for (new i = 0; i < limit; i++)
	{
		if (g_UiInvItem[playerid][i] != 0)
		{
			slots[n++] = i;
		}
	}
	new title[576], used = g_UiInvUsed[playerid];
	format(title, 576, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; - %d/%d \xE1;\x83;\xA1;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x98; - \xE1;\x83;\x96;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x97;\xE1;\x83;\x90; %s", used, limit, g_UiInvBag[playerid] ? "\xE1;\x83;\x99;\xE1;\x83;\x98;" : "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;");
	if (n == 0)
	{
		new empty[480];
		format(empty, 480, "{FFFFFF}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.\n\n\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: {FFD24D}%d/%d{FFFFFF} \xE1;\x83;\xA1;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x98;. \xE1;\x83;\x96;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x97;\xE1;\x83;\x90;: {FFD24D}%s{FFFFFF}.", used, limit, g_UiInvBag[playerid] ? "\xE1;\x83;\x99;\xE1;\x83;\x98;" : "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;");
		g_UiInvRowCount[playerid] = 0;
		g_UiInvNavNext[playerid] = -1;
		g_UiInvNavPrev[playerid] = -1;
		Lang_ShowPlayerDialog(playerid, 9400, DIALOG_STYLE_MSGBOX, title, empty, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;", "");
		return 0;
	}
	new pages = (n + 10 - 1) / 10;
	if (page < 0)
	{
		page = 0;
	}
	if (page >= pages)
	{
		page = pages - 1;
	}
	g_UiInvPage[playerid] = page;
	new body[2048], line[288], name[72];
	format(body, 2048, "\xE1;\x83;\xA1;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x98;\t\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;\t\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\n");
	new first = page * 10, rows = 0;
	for (new k = first; k < n && rows < 10; k++)
	{
