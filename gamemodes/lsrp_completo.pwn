public House_InvFridgeAbort(houseId)
{
	new idx = House_Find(houseId);
	if (idx == -1)
	{
		return 1;
	}
	g_HsFridgeBusy[idx] = true;
	SetTimerEx("House_FridgeReloadLater", 1500, false, "d", houseId);
	return 1;
}

public House_FridgeReloadLater(houseId)
{
	DB_ReloadFridge(houseId);
	return 1;
}

public House_OnDBFridgeReloaded(houseId, units)
{
	new idx = House_Find(houseId);
	if (idx == -1)
	{
		return 1;
	}
	if (units != -1 && units >= 0)
	{
		g_HouseRows[idx][hrFridgeUnits] = units;
		House_RefreshInside(idx);
	}
	g_HsFridgeBusy[idx] = false;
	return 1;
}

public House_InvHunger(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || g_HPl[playerid][hpHungerState] != 2)
	{
		return -1;
	}
	return g_HPl[playerid][hpHunger];
}

public House_InvHungerAdd(playerid, amount)
{
	if (House_InvHunger(playerid) < 0)
	{
		return -1;
	}
	House_HungerSet(playerid, g_HPl[playerid][hpHunger] + amount, true);
	return g_HPl[playerid][hpHunger];
}

House_CmdFrigo(playerid, const params[])
{
	if (!House_CmdGuard(playerid, false))
	{
		return 0;
	}
	new idx = House_FoodContext(playerid);
	if (idx == -1)
	{
		return 0;
	}
	new pos = 0, sub[96], arg[96], n = 0;
	Util_NextToken(params, pos, sub, 96);
	if (sub[0] == 0)
	{
		SendClientMessage(playerid, -1, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;: %d/%d \xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90; (\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;: %d/%d).", g_HouseRows[idx][hrFridgeUnits], House_FridgeCap(idx), Inv_Count(playerid, 1), 12);
		if (!House_LightOn(idx))
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\xAD;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		}
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /frigo metti [n] (\xE1;\x83;\x9B;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93; \xE1;\x83;\x9B;\xE1;\x83;\xA4;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;) \xC2;\xB7; /frigo prendi [n] (\xE1;\x83;\x9B;\xE1;\x83;\xA4;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;)");
		return 0;
	}
	new bool:store = !strcmp(sub, "metti", true, 0x7FFFFFFF);
	if (!store && strcmp(sub, "prendi", true, 0x7FFFFFFF))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /frigo metti [n] \xC2;\xB7; /frigo prendi [n]");
		return 0;
	}
	Util_NextToken(params, pos, arg, 96);
	n = 1;
	if (arg[0] != 0 && (!Util_ParseInt(arg, n) || n < 1 || n > 40))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		return 0;
	}
	if (store)
	{
		House_Store(playerid, n);
	}
	else
	{
		House_Take(playerid, n);
	}
	return 0;
}

House_CmdMangia(playerid, const params[])
{
	if (!House_CmdGuard(playerid, false))
	{
		return 0;
	}
	new pos = 0, sub[96];
	Util_NextToken(params, pos, sub, 96);
	if (sub[0] == 0)
	{
		House_EatPlate(playerid);
		return 0;
	}
	if (!strcmp(sub, "freddo", true, 0x7FFFFFFF))
	{
		House_EatCold(playerid);
		return 0;
	}
	Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /mangia (\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x98; /cucina-\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;) \xC2;\xB7; /mangia freddo");
	return 0;
}

House_CmdCucina(playerid)
{
	if (!House_CmdGuard(playerid, false))
	{
		return 0;
	}
	House_StartCook(playerid);
	return 0;
}

House_CmdCompra(playerid, const params[])
{
	if (!House_CmdGuard(playerid, false))
	{
		return 0;
	}
	if (!House_NearShop(playerid))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;.");
		return 0;
	}
	if (GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
		return 0;
	}
	new pos = 0, sub[96], arg[96], n = 1;
	Util_NextToken(params, pos, sub, 96);
	if (sub[0] == 0)
	{
		Inv_ShopList(playerid);
		return 0;
	}
	new itemId = Inv_ParseItem(sub);
	if (itemId == 10)
	{
		itemId = 0;
	}
	if (itemId < 1)
	{
		Inv_ShopList(playerid);
		return 0;
	}
	Util_NextToken(params, pos, arg, 96);
	if (arg[0] != 0 && (!Util_ParseInt(arg, n) || n < 1 || n > 12))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		return 0;
	}
	Inv_Buy(playerid, itemId, n);
	return 0;
}

House_BillAmount(tariff, minutesOn)
{
	new minutes = clamp(minutesOn, 0, 180);
	new amount = tariff * minutes / 180;
	new floorAmount = tariff * 25 / 100;
	if (amount < floorAmount)
	{
		amount = floorAmount;
	}
	return amount < 1 ? 1 : amount;
}

House_CloseCycle(idx)
{
	if (!DB_IsReady())
	{
		return 0;
	}
	new id = g_HouseRows[idx][hrId], tier = House_Tier(idx);
	new luceAmt = House_BillAmount(s_HsBillLuce[tier], g_HouseRows[idx][hrLuceMin]);
	new gasAmt = House_BillAmount(s_HsBillGas[tier], g_HouseRows[idx][hrGasMin]);
	g_HouseRows[idx][hrLuceMin] = 0;
	g_HouseRows[idx][hrGasMin] = 0;
	g_HouseRows[idx][hrCycleMin] = 0;
	House_SaveTick(idx);
	DB_AgeBills(id, 2);
	DB_AddBill(id, 0, luceAmt, 4);
	DB_AddBill(id, 1, gasAmt, 4);
	return 0;
}

public House_OnDBBillAdded(houseId, kind, billId, amount)
{
	new idx = House_Find(houseId);
	if (billId == -1 || idx == -1)
	{
		Log_Write("HOUSE", "emissione bolletta fallita (errore database)");
		return 1;
	}
	if (billId <= 0)
	{
		return 1;
	}
	g_HouseRows[idx][hrBills]++;
	new owner = House_OwnerPlayer(idx);
	if (owner != 65535 && Util_IsPlaying(owner))
	{
		SendClientMessage(owner, -2994689, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98; %d: \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98; %s, $%d (/bollette).", houseId, kind == 1 ? "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\xA1;" : "\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA1;", amount);
	}
	return 1;
}

House_CutUtil(idx, kind)
{
	new id = g_HouseRows[idx][hrId];
	if (kind == 1)
	{
		if (g_HouseRows[idx][hrGasCut])
		{
			return 0;
		}
		g_HouseRows[idx][hrGasCut] = 1;
		g_HouseRows[idx][hrGasOn] = 0;
	}
	else
	{
		if (g_HouseRows[idx][hrLuceCut])
		{
			return 0;
		}
		g_HouseRows[idx][hrLuceCut] = 1;
		g_HouseRows[idx][hrLuceOn] = 0;
	}
	DB_CutUtility(id, kind);
	House_RefreshInside(idx);
	new owner = House_OwnerPlayer(idx);
	if (owner != 65535)
	{
		SendClientMessage(owner, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98; %d: %s \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x90;%s \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;. \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; /bollette (+$%d \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90;).", id, kind == 1 ? "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;" : "\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x98;", "", 40);
	}
	new msg[256];
	format(msg, 256, "DISTACCO casa %d: %s", id, kind == 1 ? "gas" : "luce");
	Log_Write("HOUSE", msg);
	return 0;
}

public House_OnDBBillsAged(houseId, overdueMask)
{
	if (overdueMask == -1 || houseId <= 0)
	{
		Log_Write("HOUSE", "invecchiamento bollette fallito (errore database)");
		return 1;
	}
	new idx = House_Find(houseId);
	if (idx == -1 || g_HouseRows[idx][hrOwnerId] <= 0)
	{
		return 1;
	}
	for (new kind = 0; kind < 2; kind++)
	{
		if (overdueMask & 1 << kind)
		{
			House_CutUtil(idx, kind);
		}
	}
	return 1;
}

