		case 7:
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91; (\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;, \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;).");
		}
		case 10:
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		}
		default:
		{
			format(msg, 480, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\xA1; (\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98; %d).", result);
			Util_Send(playerid, -10270721, msg);
		}
	}
	DB_LivingBoard(65535);
	return 0;
}

Director_AfterFreight(playerid, contractId, bool:terminal, relReason)
{
	if (gPlayer[playerid][pContractId] != contractId || gPlayer[playerid][pContractPendOp] != 0)
	{
		return 0;
	}
	if (terminal)
	{
		Director_Release(playerid, relReason);
	}
	else
	{
		Director_RunDeferred(playerid);
	}
	return 0;
}

Director_OnPickup(playerid, result)
{
	new ct = gPlayer[playerid][pContractId];
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	gPlayer[playerid][pContractPendOp] = 0;
	if (result == 1 || result == 2)
	{
		gPlayer[playerid][pContractPhase] = 2;
		if (gPlayer[playerid][pFreightLegTick] == 0)
		{
			gPlayer[playerid][pFreightLegTick] = GetTickCount();
		}
		LD_Emit(102, gPlayer[playerid][pContractFromDistrict], gPlayer[playerid][pCharId], ct, gPlayer[playerid][pContractOpId]);
		Freight_OnPickupResult(playerid, 1);
		Director_AfterFreight(playerid, ct, false, 0);
		return 0;
	}
	new bool:terminal = result != -1 && result != 10;
	Freight_OnPickupResult(playerid, result);
	Director_AfterFreight(playerid, ct, terminal, 5);
	return 0;
}

Director_OnComplete(playerid, result, amount, balance, v1, v2)
{
	new ct = gPlayer[playerid][pContractId], toD = gPlayer[playerid][pContractToDistrict], charId = gPlayer[playerid][pCharId];
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	gPlayer[playerid][pContractPendOp] = 0;
	new bool:paid = result == 1 || result == 6;
	if (result == -1 || result == 10 || result == 4)
	{
		if (result == 4)
		{
			g_DirCompOp[playerid][0] = 0;
			g_DirCompCt[playerid] = 0;
		}
		Freight_OnCompleteResult(playerid, result, 0, 0);
		Director_AfterFreight(playerid, ct, false, 0);
		return 0;
	}
	new op[123];
	strcat(op, gPlayer[playerid][pContractOpId], 123);
	if (paid || result == 8)
	{
		LD_SetProPoints(playerid, 1, v1);
	}
	if (paid && v2 > 0)
	{
		District_SetCache(toD, v2, -1, -1);
	}
	if (paid || result == 8 || result == 2)
	{
		Freight_OnCompleteResult(playerid, result, paid ? amount : 0, balance);
		Director_EndLocal(playerid, 0, false, 0);
		gPlayer[playerid][pContractCooldownUntil] = GetTickCount() + 90000;
		if (paid)
		{
			District_Emit(1, toD, charId, amount, op);
		}
		else if (result == 8)
		{
			District_Emit(2, toD, charId, ct, op);
		}
		District_ReloadPlayer(playerid);
		return 0;
	}
	g_DirCompOp[playerid][0] = 0;
	g_DirCompCt[playerid] = 0;
	Freight_OnCompleteResult(playerid, result, 0, balance);
	Director_AfterFreight(playerid, ct, true, 5);
	return 0;
}

Director_OnReleased(playerid, result, v2)
{
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	if (result == 1 && v2 >= 0)
	{
		LD_SetProPoints(playerid, 1, v2);
	}
	new reason = g_DirRelReason[playerid], bool:silent = g_DirRelSilent[playerid];
	if (result == -1)
	{
		Log_Write("DIRECTOR", "rilascio contratto senza esito dal DB: lo completa la pulizia al prossimo login/boot");
	}
	if (!silent && result == 1)
	{
		if (reason == 1 || reason == 4)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;: \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x95;, \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		}
		else if (reason != 5)
		{
			Util_Send(playerid, -1, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xAF;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		}
	}
	Director_EndLocal(playerid, reason, true, reason);
	return 0;
}

public Living_OnDBContract(playerid, action, result, contractId, amount, balance, v1, v2, v3)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (gPlayer[playerid][pContractId] == 0 || (contractId != 0 && contractId != gPlayer[playerid][pContractId]))
	{
		if (result != 10)
		{
			new msg[480];
			format(msg, 480, "esito contratto fuori sequenza: azione %d contratto %d esito %d", action, contractId, result);
			Log_Write("DIRECTOR", msg);
		}
		return 1;
	}
	switch (action)
	{
		case 1:
		{
			if (gPlayer[playerid][pContractPendOp] == 1)
			{
				Director_OnAccept(playerid, result, gPlayer[playerid][pContractId], v2);
			}
		}
		case 2:
		{
			if (gPlayer[playerid][pContractPendOp] == 2)
			{
				Director_OnPickup(playerid, result);
			}
		}
		case 4:
		{
			if (gPlayer[playerid][pContractPendOp] == 3)
			{
				Director_OnComplete(playerid, result, amount, balance, v1, v2);
			}
		}
		case 3:
		{
			if (gPlayer[playerid][pContractPendOp] == 4)
			{
				Director_OnReleased(playerid, result, v2);
			}
		}
	}
	return 1;
}

// ===== modules/rental/street_rental.inc =====
// =============================================================================
// rental/street_rental.inc - auto a noleggio parcheggiate per la citta' ("noleggio di strada").
//
// Berline di classe base (Landstalker, Premier, Admiral, ...) parcheggiate in punti casuali di Los Santos.
// Il giocatore sale al volante -> offerta $179 per 60 minuti (nessuna cauzione). Il pagamento passa dallo
// stesso sistema dei noleggi (sp_rental_open, vkind 5, migrazione sql/migrations/013_street_rental.sql):
// stesse regole (un solo noleggio alla volta, op_id idempotente, banca + contanti), stessa scadenza e riconsegna.
// La riconsegna si fa ovunque con /riconsegna (o scade da sola); poi l'auto sparisce e un'altra compare altrove.
// =============================================================================

#define SRENT_VKIND        (5)
#define SRENT_PRICE        (179)          // deve coincidere con ld_config RENT_FEE_STREET (il DB decide l'addebito)
#define SRENT_MINUTES      (60)           // = RENT_STREET_MIN
#define SRENT_ACTIVE       (10)           // auto disponibili in contemporanea
#define SRENT_RESPAWN_S    (180)          // dopo un noleggio, un'auto nuova compare entro ~3 minuti
#define SRENT_DIALOG       (9800)

static const s_SrModels[] = { 400, 426, 445, 421, 405, 507, 546, 547, 404, 439, 492, 551, 529, 540, 585, 550 };

// punti di parcheggio all'aperto (interior 0, mondo 0): x, y, z, angolo
static const Float:s_SrSpots[][4] = {
	{1524.0, -1716.0, 13.4, 90.0},      // Pershing Square, vicino all'agenzia
	{1546.0, -1676.0, 13.4, 90.0},      // parcheggio LSPD, Pershing Square
	{1773.0, -1916.0, 13.4, 270.0},     // Unity Station
	{1745.0, -1862.0, 13.4, 0.0},       // Unity Station, uscita
	{1936.0, -1789.0, 13.4, 270.0},     // distributore di Idlewood
	{2079.0, -1808.0, 13.4, 90.0},      // Idlewood, strada principale
	{2228.0, -1735.0, 13.4, 270.0},     // Ganton, palestra
	{2486.0, -1667.0, 13.2, 90.0},      // Grove Street
	{2408.0, -1720.0, 13.5, 0.0},       // Ganton
	{2215.0, -1150.0, 25.7, 270.0},     // Jefferson, motel
	{2128.0, -1196.0, 23.8, 180.0},     // Jefferson
	{1971.0, -1197.0, 25.6, 0.0},       // Glen Park
	{1180.0, -1340.0, 13.6, 270.0},     // All Saints General Hospital
	{1185.0, -1338.0, 13.6, 270.0},     // All Saints, secondo posto
	{1004.0, -946.0, 42.0, 0.0},        // distributore di Mulholland
	{2116.0, -1903.0, 13.4, 0.0},       // distributore di Willowfield
	{1685.0, -2245.0, 13.4, 180.0},     // aeroporto, parcheggio
	{1835.0, -1855.0, 13.4, 90.0}       // El Corona, negozio
};

new g_SrVeh[sizeof s_SrSpots];            // veicolo libero su quel punto (0 = vuoto)
new g_SrPend[MAX_PLAYERS];                // auto per cui il giocatore ha accettato l'offerta (attesa DB)
new g_SrOffer[MAX_PLAYERS];               // auto offerta (dialog aperto)
new g_SrNextSpawn;                        // gettime() del prossimo riempimento
new g_SrTimer;

StreetRental_OnInit()
{
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		g_SrVeh[i] = 0;
	}
	for (new n = 0; n < SRENT_ACTIVE; n++)
	{
		StreetRental_SpawnOne();
	}
	g_SrTimer = SetTimer("StreetRental_OnTick", 10000, true);
}

StreetRental_OnExit()
{
	if (g_SrTimer)
	{
		KillTimer(g_SrTimer);
		g_SrTimer = 0;
	}
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] != 0 && IsValidVehicle(g_SrVeh[i]))
		{
			DestroyVehicle(g_SrVeh[i]);
		}
		g_SrVeh[i] = 0;
	}
}

StreetRental_Count()
{
	new n = 0;
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] != 0)
		{
			n++;
		}
	}
	return n;
}

StreetRental_SpotOf(vehicleid)
{
	if (vehicleid <= 0)
	{
		return -1;
	}
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] == vehicleid)
		{
			return i;
		}
	}
	return -1;
}

bool:StreetRental_Watched(spot)
{
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (IsPlayerConnected(p) && GetPlayerInterior(p) == 0 &&
			GetPlayerDistanceFromPoint(p, s_SrSpots[spot][0], s_SrSpots[spot][1], s_SrSpots[spot][2]) < 25.0)
		{
			return true;
		}
	}
	return false;
}

// un'auto nuova su un punto libero scelto a caso (niente se un giocatore e' a meno di 25 m: non compare sotto gli occhi)
StreetRental_SpawnOne()
{
	new free[sizeof s_SrSpots], n = 0;
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] == 0 && !StreetRental_Watched(i))
		{
			free[n++] = i;
		}
	}
	if (n == 0 || !LD_PoolHasRoom())
	{
		return 0;
	}
	new s = free[random(n)], model = s_SrModels[random(sizeof s_SrModels)];
	new col = random(126);
	new veh = CreateVehicle(model, s_SrSpots[s][0], s_SrSpots[s][1], s_SrSpots[s][2], s_SrSpots[s][3], col, col, -1, false);
	if (veh == INVALID_VEHICLE_ID || veh <= 0)
	{
		return 0;
	}
	SetVehicleParamsEx(veh, 0, 0, 0, 0, 0, 0, 0);
	SetVehicleNumberPlate(veh, "RENT");
	g_SrVeh[s] = veh;
	return 1;
}

public StreetRental_OnTick()
{
	if (StreetRental_Count() < SRENT_ACTIVE && gettime() >= g_SrNextSpawn)
	{
		if (StreetRental_SpawnOne())
		{
			g_SrNextSpawn = gettime() + 20;
		}
	}
}

StreetRental_OnPlayerConnect(playerid)
{
	g_SrPend[playerid] = 0;
	g_SrOffer[playerid] = 0;
}

StreetRental_OnPlayerDisconnect(playerid)
{
	g_SrPend[playerid] = 0;
	g_SrOffer[playerid] = 0;
}

// al volante di un'auto libera: motore spento finche' non si noleggia
StreetRental_OnStateChange(playerid, PLAYER_STATE:newstate)
{
	if (newstate != PLAYER_STATE_DRIVER)
	{
		if (g_SrOffer[playerid] != 0)
		{
			g_SrOffer[playerid] = 0;
			HidePlayerDialog(playerid);
		}
		return 0;
	}
	new veh = GetPlayerVehicleID(playerid);
	if (StreetRental_SpotOf(veh) < 0)
	{
		return 0;
	}
	SetVehicleParamsEx(veh, 0, 0, 0, 0, 0, 0, 0);
	if (!Util_IsPlaying(playerid))
	{
		RemovePlayerFromVehicle(playerid);
		return 1;
	}
	if (gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		Util_Send(playerid, 0xFF6347FF, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;. \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94; /riconsegna-\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		RemovePlayerFromVehicle(playerid);
		return 1;
	}
	new name[24], body[2048];
	Veh_StdModelName(GetVehicleModel(veh), name);
	format(body, sizeof body,
		"{FFFFFF}%s\n\n{AAAAAA}\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;: {66DD66}$%d{AAAAAA} - %d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x98;\n\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;. \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x97;.\n\n{AAAAAA}\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA1;: /riconsegna",
		name, SRENT_PRICE, SRENT_MINUTES);
	g_SrOffer[playerid] = veh;
	Lang_ShowPlayerDialog(playerid, SRENT_DIALOG, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;", body, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90;");
	return 1;
}

bool:StreetRental_OnDialogResponse(playerid, dialogid, response)
{
	if (dialogid != SRENT_DIALOG)
	{
		return false;
	}
	new veh = g_SrOffer[playerid];
	g_SrOffer[playerid] = 0;
	if (veh == 0 || GetPlayerVehicleID(playerid) != veh || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		return true;
	}
	if (!response)
	{
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	if (StreetRental_SpotOf(veh) < 0 || gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	new have = (gPlayer[playerid][pBank] > 0 ? gPlayer[playerid][pBank] : 0) + (gPlayer[playerid][pMoney] > 0 ? gPlayer[playerid][pMoney] : 0);
	if (have < SRENT_PRICE)
	{
		Util_Send(playerid, 0xFF6347FF, "\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; (\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98; + \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98;).");
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	g_SrPend[playerid] = veh;
	if (!Rental_BeginOpen(playerid, SRENT_VKIND, 1, 1, GetVehicleModel(veh)))
	{
		g_SrPend[playerid] = 0;
		Util_Send(playerid, 0xFF6347FF, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;, \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	Util_Send(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;...");
	return true;
}

// chiamata da Rental_SpawnVehicle per vkind 5: l'auto c'e' gia', si consegna quella parcheggiata
bool:StreetRental_Take(playerid)
{
	new veh = g_SrPend[playerid];
	g_SrPend[playerid] = 0;
	new s = StreetRental_SpotOf(veh);
	if (s < 0 || !IsValidVehicle(veh))
	{
		return false;
	}
	if (LD_VehRegister(veh, 1, playerid) == 0)
	{
		return false;
	}
	g_SrVeh[s] = 0;                       // non piu' libera: il punto si riempira' con un'altra auto
	g_SrNextSpawn = gettime() + SRENT_RESPAWN_S;
	SetVehicleParamsEx(veh, 1, 0, 0, 0, 0, 0, 0);
	gPlayer[playerid][pRentalVehicle] = veh;
	if (GetPlayerVehicleID(playerid) != veh)
	{
		PutPlayerInVehicle(playerid, veh, 0);
	}
	return true;
}

// l'auto libera e' stata distrutta (incidente, esplosione): si libera il punto
StreetRental_OnVehicleDeath(vehicleid)
{
	new s = StreetRental_SpotOf(vehicleid);
	if (s < 0)
	{
		return 0;
	}
	g_SrVeh[s] = 0;
	DestroyVehicle(vehicleid);
	return 1;
}

// ===== modules/rental/rental.inc =====
new g_RtTimer;
new g_RtFee[MAX_PLAYERS];
new g_RtDeposit[MAX_PLAYERS];
new g_RtOpenTs[MAX_PLAYERS];
new g_RtBlocks[MAX_PLAYERS];
new bool:g_RtAbortOpen[MAX_PLAYERS];
new g_RtCloseMode[MAX_PLAYERS];
new g_RtCloseHealth[MAX_PLAYERS];
new g_RtCloseReason[MAX_PLAYERS];
new g_RtRetry[MAX_PLAYERS];
new g_RtRetryAt[MAX_PLAYERS];

Rental_KindName(vkind, dest[], size)
{
	dest[0] = 0;
	switch (vkind)
	{
		case 1:
		{
			strcat(dest, "Faggio", size);
		}
		case 2:
		{
			strcat(dest, "Previon", size);
		}
		case 3:
		{
			strcat(dest, "Manana", size);
		}
		case 4:
		{
			strcat(dest, "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;", size);
		}
		default:
		{
			strcat(dest, "veicolo", size);
		}
	}
}

bool:Rental_ValidPlayer(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

Rental_MaxLocalRep(playerid)
{
	new best = 0;
	for (new d = 1; d <= 3; d++)
	{
		new r = LD_GetLocalRep(playerid, d);
		if (d == 1 || r > best)
		{
			best = r;
		}
	}
	return best;
}

Rental_VehHealth(vehicleid)
{
	if (vehicleid <= 0 || !IsValidVehicle(vehicleid))
	{
		return 0;
	}
	new Float:hp;
	GetVehicleHealth(vehicleid, hp);
	return LD_Clamp(floatround(hp, floatround_method:1), 0, 1000);
}

Rental_ResetPlayer(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	g_RtFee[playerid] = 0;
	g_RtDeposit[playerid] = 0;
	g_RtOpenTs[playerid] = 0;
	g_RtBlocks[playerid] = 0;
	g_RtAbortOpen[playerid] = false;
	g_RtCloseMode[playerid] = 0;
	g_RtCloseHealth[playerid] = 0;
	g_RtCloseReason[playerid] = 0;
	g_RtRetry[playerid] = 0;
	g_RtRetryAt[playerid] = 0;
	return 0;
}

Rental_VehDestroy(playerid)
{
	new veh = gPlayer[playerid][pRentalVehicle];
	gPlayer[playerid][pRentalVehicle] = 0;
	if (veh <= 0 || veh >= 2000)
	{
		return 0;
	}
	if (LD_VehOwner(veh) == playerid)
	{
		LD_VehRelease(veh);
	}
	if (IsValidVehicle(veh))
	{
		if (IsPlayerConnected(playerid) && GetPlayerVehicleID(playerid) == veh)
		{
			RemovePlayerFromVehicle(playerid, false);
		}
		DestroyVehicle(veh);
	}
	return 0;
}

Rental_ClearLocal(playerid)
{
	Rental_VehDestroy(playerid);
	gPlayer[playerid][pRentalId] = 0;
	gPlayer[playerid][pRentalClass] = 0;
	gPlayer[playerid][pRentalKind] = 0;
	gPlayer[playerid][pRentalDueAt] = 0;
	gPlayer[playerid][pRentalWarnFlags] = 0;
	gPlayer[playerid][pRentalPendOp] = 0;
	gPlayer[playerid][pRentalOpId][0] = 0;
	Rental_ResetPlayer(playerid);
}

Rental_ScheduleRetry(playerid)
{
	g_RtRetry[playerid]++;
	g_RtRetryAt[playerid] = GetTickCount() + 3000;
	if (g_RtRetryAt[playerid] == 0)
	{
		g_RtRetryAt[playerid] = 1;
	}
}

bool:Rental_BeginOpen(playerid, vkind, blocks, rentClass, streetModel = 0)
{
	new model = vkind == SRENT_VKIND ? streetModel : LD_RentalModel(vkind);
	if (model <= 0 || gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return false;
	}
	if (DB_LivingBusy(playerid, 1))
	{
		return false;
	}
	Rental_ResetPlayer(playerid);
	gPlayer[playerid][pRentalClass] = rentClass;
	gPlayer[playerid][pRentalKind] = vkind;
	gPlayer[playerid][pRentalPendOp] = 5;
	g_RtBlocks[playerid] = blocks;
	DB_LivingMakeOpId(gPlayer[playerid][pRentalOpId], 41, "ro", vkind, gPlayer[playerid][pCharId]);
	DB_LivingRentOpen(playerid, vkind, model, blocks, gPlayer[playerid][pRentalOpId]);
	return true;
}

bool:Rental_SpawnVehicle(playerid)
{
	if (gPlayer[playerid][pRentalKind] == SRENT_VKIND)
	{
		return StreetRental_Take(playerid);   // auto di strada: si consegna quella parcheggiata
	}
	new vkind = gPlayer[playerid][pRentalKind], model = LD_RentalModel(vkind);
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new Float:x = 1512.0, Float:y = -1708.0, Float:z = 13.5, Float:a = 180.0;
	if (pro)
	{
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, a);
	}
	if (model <= 0 || !LD_PoolHasRoom())
	{
		return false;
	}
	new veh = CreateVehicle(model, x, y, z, a, pro ? 6 : 1, pro ? 6 : 1, -1, false);
	if (veh == 65535 || veh <= 0 || veh >= 2000)
	{
		return false;
	}
	if (LD_VehRegister(veh, pro ? 2 : 1, playerid) == 0)
	{
		DestroyVehicle(veh);
		return false;
	}
	SetVehicleHealth(veh, float(1000));
	SetVehicleParamsEx(veh, 1, 0, 0, 0, 0, 0, 0);
	gPlayer[playerid][pRentalVehicle] = veh;
	PutPlayerInVehicle(playerid, veh, 0);
	return true;
}

bool:Rental_SendClose(playerid, mode, health, reason)
{
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return false;
	}
	Rental_VehDestroy(playerid);
	g_RtCloseMode[playerid] = mode;
	g_RtCloseHealth[playerid] = LD_Clamp(health, 0, 1000);
	g_RtCloseReason[playerid] = reason;
	g_RtRetry[playerid] = 0;
	g_RtRetryAt[playerid] = 0;
	gPlayer[playerid][pRentalPendOp] = 6;
	DB_LivingMakeOpId(gPlayer[playerid][pRentalOpId], 41, "rc", gPlayer[playerid][pRentalId], gPlayer[playerid][pCharId]);
	DB_LivingRentClose(playerid, gPlayer[playerid][pRentalId], mode, g_RtCloseHealth[playerid], gPlayer[playerid][pRentalOpId]);
	return true;
}

bool:Rental_CloseInterrupted(playerid, reason)
{
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh > 0 && IsValidVehicle(veh))
	{
		return Rental_SendClose(playerid, 1, Rental_VehHealth(veh), reason);
	}
	return Rental_SendClose(playerid, 3, 0, reason);
}

Rental_NotifyClosed(playerid, result, refund, newState)
{
	new name[48];
	Rental_KindName(gPlayer[playerid][pRentalKind], name, 48);
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new reason = g_RtCloseReason[playerid];
	if (pro)
	{
		if (reason != 100)
		{
			Taxi_OnProRentalClosed(playerid, result, refund);
		}
		return 0;
	}
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	switch (result)
	{
		case 1:
		{
			if (reason == 100)
			{
				Util_Send(playerid, -10270721, "\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;: \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;, \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
				return 0;
			}
			new minutes = (gettime() - g_RtOpenTs[playerid]) / 60;
			if (g_RtOpenTs[playerid] <= 0)
			{
				minutes = 0;
			}
			if (newState == 3)
			{
				SendClientMessage(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D; $%d \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;.", refund);
			}
			else
			{
				UI_LivingRentalReceipt(playerid, name, g_RtFee[playerid], g_RtDeposit[playerid], refund, minutes);
			}
		}
		case 5:
		{
			if (refund > 0)
			{
				SendClientMessage(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; $%d.", refund);
			}
			else
			{
				Util_Send(playerid, -10270721, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;, \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
			}
		}
		case 2:
		{
			Util_Send(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;.");
		}
		default:
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		}
	}
	return 0;
}

Rental_OnOpenResult(playerid, result, rentalId, amount, dueAt)
{
	if (gPlayer[playerid][pRentalPendOp] != 5)
	{
		if (result == 1)
		{
			Log_Write("RENTAL", "apertura confermata senza richiesta in attesa: lasciata al cleanup del DB");
		}
		return 0;
	}
	gPlayer[playerid][pRentalPendOp] = 0;
