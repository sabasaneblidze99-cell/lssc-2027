				}
				case 2:
				{
					Util_Send(playerid, -10270721, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; (/contratto).");
				}
