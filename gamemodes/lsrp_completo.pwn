	g_TxPhase[d] = 3;
	Util_Send(d, -2994689, "\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA3;\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xAE;\xE1;\x83;\x90;: /tassametro stop \xE2;\x80;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;, /tassametro annulla \xE2;\x80;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;.");
