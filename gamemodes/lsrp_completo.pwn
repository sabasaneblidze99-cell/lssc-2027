		return -1;
	}
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
		Bank_Deny(playerid, ui, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x92;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; ATM \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;.");
