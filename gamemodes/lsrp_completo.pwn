public Cmd_report(playerid, const params[])
{
	new text[97];
	if (!Util_SanitizeText(params, text, 96))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /report \xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98;");
		return 1;
	}
	new now = GetTickCount(), elapsed = now - gPlayer[playerid][pLastReportTick];
	if (elapsed < 30000)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9A; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x95; %d \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x98;.", (30000 - elapsed + 1000 - 1) / 1000);
		return 1;
	}
	new name[75], msg[256], staff = 0;
	GetPlayerName(playerid, name, 75);
	format(msg, 256, "[REPORT] %s [%d]: %s", name, playerid, text);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || Util_GetAdmin(i) < 1)
		{
			continue;
		}
		Util_Send(i, -5963521, msg);
		staff++;
	}
	if (staff == 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x90;: \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;.");
		return 1;
	}
	gPlayer[playerid][pLastReportTick] = now;
	Admin_StoreReport(playerid, text);
	Util_Send(playerid, 0x66DD66FF, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;.");
	return 1;
}

