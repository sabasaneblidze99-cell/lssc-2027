	}
	if (g_UiLvHudOn[playerid] && IsPlayerConnected(playerid))
	{
		UI_LvTdShow(playerid, 0, 4, false);
	}
	g_UiLvHudOn[playerid] = false;
	g_UiLvHudId[playerid] = 0;
	g_UiLvHudExpAt[playerid] = 0;
