			Inv_Say(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90; \xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\x98; (/frigo metti) \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\xAD;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x94;.");
			return 0;
		}
