Cmd_Dispatch(playerid, const cmdtext[])
{
	if (cmdtext[0] != 47)
	{
		return 0;
	}
	new name[16], pos = 1, n = 0;
	while (cmdtext[pos] != 0 && cmdtext[pos] != 32)
	{
		if (n >= 15)
		{
			return 0;
		}
		name[n++] = tolower(cmdtext[pos]);
		pos++;
	}
	name[n] = 0;
	while (cmdtext[pos] == 32)
	{
		pos++;
	}
	new index = -1;
	for (new i = 0; i < sizeof g_CmdNames; i++)
	{
		if (!strcmp(name, g_CmdNames[i], false, 0x7FFFFFFF))
		{
			index = i;
			break;
		}
	}
	if (index < 0)
	{
		return 0;
	}
	if (!Util_IsPlaying(playerid))
	{
		if (!strcmp(name, "salta", false, 0x7FFFFFFF) && gPlayer[playerid][pLoggedIn] && gPlayer[playerid][pAuthState] == 14)
		{
			Intro_CmdSalta(playerid);
			return 1;
		}
		if (index >= 74)
		{
			return 0;
		}
		Util_Send(playerid, -10270721, "\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;.");
		return 1;
	}
	if (index < 5 && Admin_CheckMuted(playerid))
	{
		return 1;
	}
	new fn[72];
	format(fn, 72, "Cmd_%s", name);
	return CallLocalFunction(fn, "ds", playerid, cmdtext[pos]);
}

public Cmd_me(playerid, const params[])
{
	new text[129];
