Bank_StartUndo(playerid, const reason[])
{
	new opId[111];
	strcopy(opId, gPlayer[playerid][pBankOpId], 111);
	gPlayer[playerid][pBankOp] = 6;
	gPlayer[playerid][pBankOpAux] = 0;
	gPlayer[playerid][pBankOpTick] = Bank_Tick();
	Util_Send(playerid, -10270721, reason);
	DB_BankUndo(opId);
}

public Bank_OnDBDeposit(playerid, amount, result, balance)
{
	if (!Bank_Valid(playerid))
	{
		return 1;
	}
	if (!Bank_OpIs(playerid, 1) || gPlayer[playerid][pBankOpAmount] != amount)
	{
		if (result == 1)
		{
			new opId[111];
			DB_BankLastOpId(playerid, opId, 111);
			Log_Write("BANK", "deposito OK senza lock corrispondente: annullamento");
			DB_BankUndo(opId);
		}
		return 1;
	}
	new bool:ui = gPlayer[playerid][pBankOpAux] != 0;
	if (result == 1)
	{
		if (!Money_Take(playerid, amount))
		{
			Bank_StartUndo(playerid, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98;: \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
			Char_RefreshHud(playerid);
			return 1;
		}
		Bank_EndOp(playerid);
		Char_Save(playerid);
		Char_RefreshHud(playerid);
		new msg[528];
		format(msg, 528, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; $%d. \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98;: $%d  \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;: $%d.", amount, gPlayer[playerid][pMoney], gPlayer[playerid][pBank]);
		Util_Send(playerid, 0x66DD66FF, msg);
		if (ui)
		{
			UI_BankToast(playerid, "\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;", true);
		}
		return 1;
	}
	if (result == -1)
	{
