public Cmd_pay(playerid, const params[])
{
	new pos = 0, tid[36], tam[36], targetid = 0, amount = 0;
	Util_NextToken(params, pos, tid, 36);
	Util_NextToken(params, pos, tam, 36);
	if (tid[0] == 0 || tam[0] == 0 || !Util_ParseInt(tam, amount) || !Util_ParsePlayerId(tid, targetid))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /pay id \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90;");
		return 1;
	}
	if (gPlayer[playerid][pLevel] < 2)
	{
		SendClientMessage(playerid, -10270721, "/pay-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\x9B; %d \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", 2);
		return 1;
	}
	if (amount < 1 || amount > 50000)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; (%d-%d).", 1, 50000);
		return 1;
	}
	if (targetid == playerid || !Util_IsPlaying(targetid))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.");
		return 1;
	}
	if (!Util_InRange(playerid, targetid, 3.0))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA1; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;.");
		return 1;
	}
	new payResult = Valid_PayAmount(amount, gPlayer[playerid][pMoney], gPlayer[targetid][pMoney]);
	if (payResult == 2)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return 1;
	}
	if (payResult != 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;.");
		return 1;
	}
	Money_Take(playerid, amount);
	Money_Give(targetid, amount);
	new sn[75], tn[75], msg[768];
	GetPlayerName(playerid, sn, 75);
	GetPlayerName(targetid, tn, 75);
	SendClientMessage(playerid, 0x66DD66FF, "$%d \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x98; %s-\xE1;\x83;\xA1;.", amount, tn);
	SendClientMessage(targetid, 0x66DD66FF, "$%d \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94; %s-\xE1;\x83;\xA1;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;.", amount, sn);
	format(msg, 768, "* %s \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1; %s-\xE1;\x83;\xA1;", sn, tn);
	Util_SendNear(playerid, 0xC2A2DAFF, 20.0, msg);
	Char_Save(playerid);
	Char_Save(targetid);
	format(msg, 768, "%s -> %s: $%d", sn, tn, amount);
	Log_Write("PAY", msg);
	return 1;
}

