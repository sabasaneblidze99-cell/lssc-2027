UI_ShowSkinSelect(playerid, gender)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	new g = gender == 1 ? 1 : 0;
	g_UiSkinGender[playerid] = g;
	if (CefUI_Active(playerid))
	{
		for (new i = 0; i < 7; i++)
		{
			CefUI_AuthSkin(playerid, i, Valid_SkinAt(g, i));
		}
		CefUI_AuthStep(playerid, "skin", "", g);
		return 0;
	}
	new body[1024], line[288];
	for (new i = 0; i < 7; i++)
	{
		format(line, 288, "\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; %d (\xE1;\x83;\xA1;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98; %d)\n", i + 1, Valid_SkinAt(g, i));
		strcat(body, line, 1024);
	}
	Lang_ShowPlayerDialog(playerid, 9004, DIALOG_STYLE_LIST, "\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x9C;\xE1;\x83;\x90; - \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;", body, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "");
	return 0;
}

UI_CloseDialogs(playerid)
{
	HidePlayerDialog(playerid);
}

bool:UI_OnDialogResponse(playerid, dialogid, response, listitem, const inputtext[])
{
	switch (dialogid)
	{
		case 9001:
		{
			if (!response)
			{
				UI_OnDialogCancel(playerid, dialogid);
				return true;
			}
			new len = strlen(inputtext);
			if (len < 6 || len > 32)
			{
				new err[768];
				format(err, 768, "{FF4444}\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA1; %d-\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; %d-\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x91;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;.\n{FFFFFF}", 6, 32);
				UI_ShowRegisterEx(playerid, err);
				return true;
			}
			UI_OnRegisterSubmit(playerid, inputtext);
			return true;
		}
		case 9002:
		{
			if (!response)
			{
				UI_OnDialogCancel(playerid, dialogid);
				return true;
			}
			if (strlen(inputtext) < 1)
			{
				UI_ShowLogin(playerid, false);
				return true;
			}
			UI_OnLoginSubmit(playerid, inputtext);
			return true;
		}
		case 9003:
		{
			if (!response || listitem < 0 || listitem > 1)
			{
				UI_ShowGenderSelect(playerid);
				return true;
			}
			UI_OnGenderChosen(playerid, listitem);
			return true;
		}
		case 9004:
		{
			if (!response || listitem < 0 || listitem >= 7)
			{
				UI_ShowSkinSelect(playerid, g_UiSkinGender[playerid]);
				return true;
			}
			new skin = Valid_SkinAt(g_UiSkinGender[playerid], listitem);
			if (skin == -1)
			{
				UI_ShowSkinSelect(playerid, g_UiSkinGender[playerid]);
				return true;
			}
			UI_OnSkinChosen(playerid, skin);
			return true;
		}
	}
	return false;
}

UI_CefRegisterSubmit(playerid, const password[])
{
	new len = strlen(password);
	if (len < 6 || len > 32)
	{
		UI_ShowRegisterEx(playerid, "x");
		return 0;
	}
	UI_OnRegisterSubmit(playerid, password);
	return 0;
}

UI_CefLoginSubmit(playerid, const password[])
{
	if (password[0] == 0)
	{
		UI_ShowLogin(playerid, false);
		return 0;
	}
	UI_OnLoginSubmit(playerid, password);
	return 0;
}

UI_CefSkinPick(playerid, idx)
{
	if (idx < 0 || idx >= 7)
	{
		UI_ShowSkinSelect(playerid, g_UiSkinGender[playerid]);
		return 0;
	}
	new skin = Valid_SkinAt(g_UiSkinGender[playerid], idx);
	if (skin == -1)
	{
		UI_ShowSkinSelect(playerid, g_UiSkinGender[playerid]);
		return 0;
	}
	UI_OnSkinChosen(playerid, skin);
	return 0;
}

// ===== modules/ui/hud.inc =====
new PlayerText:g_UiHud[MAX_PLAYERS][6];
new bool:g_UiHudActive[MAX_PLAYERS];

UI_ExpForLevel(level)
{
	return (level - 1) * 2 * level / 2 + (level - 1) * 2;
}

PlayerText:UI_HudText(playerid, Float:x, Float:y, const text[], Float:lw, Float:lh, color, t_TEXT_DRAW_ALIGN:align)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, text);
	PlayerTextDrawLetterSize(playerid, td, lw, lh);
	PlayerTextDrawAlignment(playerid, td, align);
	PlayerTextDrawColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetProportional(playerid, td, true);
	PlayerTextDrawSetOutline(playerid, td, 1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawBackgroundColour(playerid, td, 255);
	return td;
}

PlayerText:UI_HudBox(playerid, Float:x, Float:y, Float:w, Float:h, color)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, "_");
	PlayerTextDrawLetterSize(playerid, td, 0.0, (h / 9.0));
	PlayerTextDrawTextSize(playerid, td, (x + w), 0.0);
	PlayerTextDrawUseBox(playerid, td, true);
	PlayerTextDrawBoxColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawSetOutline(playerid, td, 0);
	return td;
}

UI_HudSetBar(playerid, Float:fraction)
{
	if ((fraction < 0.0))
	{
		fraction = 0.0;
	}
	if ((fraction > 1.0))
	{
		fraction = 1.0;
	}
	new Float:x = (5.0 + (632.0 - 150.0));
	PlayerTextDrawTextSize(playerid, PlayerText:g_UiHud[playerid][5], (0.1 + (x + (140.0 * fraction))), 0.0);
	PlayerTextDrawShow(playerid, PlayerText:g_UiHud[playerid][5]);
}

UI_HudDestroy(playerid)
{
	CefUI_HudShow(playerid, false);
	if (playerid < 0 || playerid >= MAX_PLAYERS || !g_UiHudActive[playerid])
	{
		return 0;
	}
	for (new i = 0; i < 6; i++)
	{
		if (g_UiHud[playerid][i] != INVALID_PLAYER_TEXT_DRAW)
		{
			PlayerTextDrawDestroy(playerid, PlayerText:g_UiHud[playerid][i]);
		}
		g_UiHud[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
	}
	g_UiHudActive[playerid] = false;
	return 0;
}

UI_HudCreate(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (g_UiHudActive[playerid])
	{
		UI_HudDestroy(playerid);
	}
	if (CefUI_Active(playerid))
	{
		CefUI_HudShow(playerid, true);
		return 0;
	}
	for (new i = 0; i < 6; i++)
	{
		g_UiHud[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
	}
	new Float:left = (632.0 - 150.0);
	g_UiHud[playerid][0] = UI_HudBox(playerid, left, 330.0, 150.0, 62.0, 153);
	g_UiHud[playerid][1] = UI_HudText(playerid, (632.0 - 5.0), (330.0 + 3.0), "$0", 0.3, 1.2, 0x66DD66FF, t_TEXT_DRAW_ALIGN:3);
	g_UiHud[playerid][2] = UI_HudText(playerid, (632.0 - 5.0), (330.0 + 20.0), "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;: $0", 0.22, 1.0, -1, t_TEXT_DRAW_ALIGN:3);
	g_UiHud[playerid][3] = UI_HudText(playerid, (5.0 + left), (330.0 + 36.0), "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; 1  Exp 0", 0.22, 1.0, -2994689, t_TEXT_DRAW_ALIGN:1);
	g_UiHud[playerid][4] = UI_HudBox(playerid, (5.0 + left), (330.0 + 51.0), 140.0, 6.0, 0x444444FF);
	g_UiHud[playerid][5] = UI_HudBox(playerid, (5.0 + left), (330.0 + 51.0), 140.0, 6.0, -2994689);
	for (new i = 0; i < 6; i++)
	{
		if (i != 5)
		{
			PlayerTextDrawShow(playerid, PlayerText:g_UiHud[playerid][i]);
		}
	}
	g_UiHudActive[playerid] = true;
	UI_HudSetBar(playerid, 0.0);
	return 0;
}

UI_HudCefData(playerid, money, bank, level, exp)
{
	if (level >= 50)
	{
		CefUI_HudData(playerid, money, bank, 50, 0, 0);
		return 0;
	}
	if (level < 1)
	{
		level = 1;
	}
	new step = level * 2 + 2;
	new inLevel = exp - UI_ExpForLevel(level);
	if (inLevel < 0)
	{
		inLevel = 0;
	}
	if (inLevel > step)
	{
		inLevel = step;
	}
	CefUI_HudData(playerid, money, bank, level, inLevel, step);
	return 0;
}

bool:UI_HudIsActive(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return false;
	}
	return g_UiHudActive[playerid];
}

UI_HudUpdate(playerid, money, bank, level, exp)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	UI_HudCefData(playerid, money, bank, level, exp);
	if (!g_UiHudActive[playerid])
	{
		return 0;
	}
	new str[432];
	format(str, 432, "$%d", money);
	Lang_PlayerTextDrawSetString(playerid, g_UiHud[playerid][1], str);
	format(str, 432, "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;: $%d", bank);
	Lang_PlayerTextDrawSetString(playerid, g_UiHud[playerid][2], str);
	if (level >= 50)
	{
		format(str, 432, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d  (MAX)", 50);
		Lang_PlayerTextDrawSetString(playerid, g_UiHud[playerid][3], str);
		UI_HudSetBar(playerid, 1.0);
		return 0;
	}
	if (level < 1)
	{
		level = 1;
	}
	new base = UI_ExpForLevel(level);
	new step = level * 2 + 2;
	new inLevel = exp - base;
	if (inLevel < 0)
	{
		inLevel = 0;
	}
	if (inLevel > step)
	{
		inLevel = step;
	}
	format(str, 432, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d  Exp %d/%d", level, inLevel, step);
	Lang_PlayerTextDrawSetString(playerid, g_UiHud[playerid][3], str);
	UI_HudSetBar(playerid, (float(inLevel) / float(step)));
	return 0;
}

// ===== modules/ui/vehicle_ui.inc =====
new g_UiVehModel[13] = {462, 436, 410, 491, 466, 547, 529, 543, 461, 422, 549, 500, 405};
new g_UiVehPrice[13] = {12000, 12500, 13500, 16000, 17500, 19000, 21000, 22000, 24000, 26000, 28000, 34000, 38000};
new g_UiVehMinLevel[13] = {1, 1, 1, 2, 2, 3, 3, 3, 3, 4, 4, 5, 5};
new g_UiVehName[13][12] = {
	"Faggio",
	"Previon",
	"Manana",
	"Virgo",
	"Glendale",
	"Primo",
	"Willard",
	"Sadler",
	"PCJ-600",
	"Bobcat",
	"Tampa",
	"Mesa",
	"Sentinel"
};
new g_UiVehLevel[MAX_PLAYERS];
new g_UiVehMoney[MAX_PLAYERS];
new g_UiVehBank[MAX_PLAYERS];
new g_UiVehSel[MAX_PLAYERS];
new g_UiVehCount[MAX_PLAYERS];
new g_UiVehSlot[MAX_PLAYERS][4];
new g_UiVehLModel[MAX_PLAYERS][4];
new g_UiVehLPlate[MAX_PLAYERS][4][8];
new g_UiVehFuel[MAX_PLAYERS][4];
new g_UiVehState[MAX_PLAYERS][4];

UI_VehMoney(value, out[], size)
{
	new raw[48], len = 0, pos = 0;
	if (value < 0)
	{
		value = 0;
	}
	format(raw, 48, "%d", value);
	len = strlen(raw);
	out[0] = 0;
	for (new i = 0; i < len && pos < size - 2; i++)
	{
		if (i > 0 && (len - i) % 3 == 0)
		{
			out[pos++] = 46;
		}
		out[pos++] = raw[i];
	}
	out[pos] = 0;
}

UI_VehCatalogIndexOf(model)
{
	for (new i = 0; i < 13; i++)
	{
		if (g_UiVehModel[i] == model)
		{
			return i;
		}
	}
	return -1;
}

UI_VehModelName(model, out[], size)
{
	new idx = UI_VehCatalogIndexOf(model);
	if (idx >= 0)
	{
		format(out, size, "%s", g_UiVehName[idx]);
	}
	else
	{
		format(out, size, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; %d", model);
	}
}

UI_VehicleShopShow(playerid, level, money, bank)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_UiVehLevel[playerid] = level;
	g_UiVehMoney[playerid] = money;
	g_UiVehBank[playerid] = bank;
	new body[1536], line[288], price[48];
	for (new i = 0; i < 13; i++)
	{
		UI_VehMoney(g_UiVehPrice[i], price, 48);
		if (level >= g_UiVehMinLevel[i])
		{
			format(line, 288, "{FFFFFF}%s\t{66DD66}$%s\t{AAAAAA}\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d\n", g_UiVehName[i], price, g_UiVehMinLevel[i]);
		}
		else
		{
			format(line, 288, "{777777}%s\t$%s\t{FF6666}\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d\n", g_UiVehName[i], price, g_UiVehMinLevel[i]);
		}
		strcat(body, line, 1536);
	}
	Lang_ShowPlayerDialog(playerid, 9100, DIALOG_STYLE_TABLIST, "\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;", body, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
	return 0;
}

UI_VehPayShow(playerid)
{
	new idx = g_UiVehSel[playerid];
	new body[640], price[48], cash[48], bank[48], t[144];
	UI_VehMoney(g_UiVehPrice[idx], price, 48);
	UI_VehMoney(g_UiVehMoney[playerid], cash, 48);
	UI_VehMoney(g_UiVehBank[playerid], bank, 48);
	format(body, 640, "{FFFFFF}\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\t%s$%s\n", g_UiVehMoney[playerid] >= g_UiVehPrice[idx] ? "{66DD66}" : "{FF6666}", cash);
	format(t, 144, "{FFFFFF}\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;\t%s$%s\n", g_UiVehBank[playerid] >= g_UiVehPrice[idx] ? "{66DD66}" : "{FF6666}", bank);
	strcat(body, t, 640);
	new title[576];
	format(title, 576, "%s - $%s: \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;", g_UiVehName[idx], price);
	Lang_ShowPlayerDialog(playerid, 9101, DIALOG_STYLE_TABLIST, title, body, "\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;");
}

UI_VehicleListClear(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_UiVehCount[playerid] = 0;
	return 0;
}

UI_VehicleListAdd(playerid, slot, model, const plate[], fuelPct, vstate)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	new n = g_UiVehCount[playerid];
	if (n >= 4)
	{
		return 0;
	}
	if (fuelPct < 0)
	{
		fuelPct = 0;
	}
	if (fuelPct > 100)
	{
		fuelPct = 100;
	}
	g_UiVehSlot[playerid][n] = slot;
	g_UiVehLModel[playerid][n] = model;
	strcopy(g_UiVehLPlate[playerid][n], plate, 8);
	g_UiVehFuel[playerid][n] = fuelPct;
	g_UiVehState[playerid][n] = vstate;
	g_UiVehCount[playerid] = n + 1;
	return 0;
}

UI_VehicleListShow(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (g_UiVehCount[playerid] <= 0)
	{
		Lang_ShowPlayerDialog(playerid, 9105, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;", "{FFFFFF}\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.\n\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", "\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x98;", "");
		return 0;
	}
	new body[3072], line[384], name[48], stxt[216];
	strcat(body, "\xE1;\x83;\xA1;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x98;\t\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\t\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\t\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\t\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;\n", 3072);
	for (new i = 0; i < g_UiVehCount[playerid]; i++)
	{
		UI_VehModelName(g_UiVehLModel[playerid][i], name, 48);
		switch (g_UiVehState[playerid][i])
		{
			case 1:
			{
				format(stxt, 216, "{66AAFF}\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;");
			}
			case 2:
			{
				format(stxt, 216, "{FF6666}\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;");
			}
			default:
			{
				format(stxt, 216, "{66DD66}\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\x90;");
			}
		}
		format(line, 384, "%d\t%s\t%s\t%d%%\t%s\n", g_UiVehSlot[playerid][i], name, g_UiVehLPlate[playerid][i], g_UiVehFuel[playerid][i], stxt);
		strcat(body, line, 3072);
	}
	Lang_ShowPlayerDialog(playerid, 9102, DIALOG_STYLE_TABLIST_HEADERS, "\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;", body, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
	return 0;
}

UI_VehActionShow(playerid)
{
	new i = g_UiVehSel[playerid], name[48], title[192];
	UI_VehModelName(g_UiVehLModel[playerid][i], name, 48);
	format(title, 192, "%s [%s]", name, g_UiVehLPlate[playerid][i]);
	Lang_ShowPlayerDialog(playerid, 9103, DIALOG_STYLE_LIST, title, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;\n\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;");
}

UI_VehSellConfirmShow(playerid)
{
	new i = g_UiVehSel[playerid], name[48], body[768], amount[48];
	new idx = UI_VehCatalogIndexOf(g_UiVehLModel[playerid][i]);
	UI_VehModelName(g_UiVehLModel[playerid][i], name, 48);
	if (idx >= 0)
	{
		UI_VehMoney(g_UiVehPrice[idx] * 60 / 100, amount, 48);
		format(body, 768, "{FFFFFF}\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x98; {FFD24D}%s{FFFFFF}-\xE1;\x83;\xA1; (\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s)?\n\n\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;. {66DD66}$%s{FFFFFF}-\xE1;\x83;\xA1; (\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x9D; \xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; %d%%).\n\xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x90;.", name, g_UiVehLPlate[playerid][i], amount, 60);
	}
	else
	{
		format(body, 768, "{FFFFFF}\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x98; {FFD24D}%s{FFFFFF}-\xE1;\x83;\xA1; (\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s)?\n\n\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x9D; \xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; %d%%-\xE1;\x83;\xA1;.\n\xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x90;.", name, g_UiVehLPlate[playerid][i], 60);
	}
	Lang_ShowPlayerDialog(playerid, 9104, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", body, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;");
}

bool:UI_VehicleOnDialogResponse(playerid, dialogid, response, listitem)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return false;
	}
	switch (dialogid)
	{
		case 9100:
		{
			if (!response)
			{
				return true;
			}
			if (listitem < 0 || listitem >= 13)
			{
				UI_VehicleShopShow(playerid, g_UiVehLevel[playerid], g_UiVehMoney[playerid], g_UiVehBank[playerid]);
				return true;
			}
			if (g_UiVehLevel[playerid] < g_UiVehMinLevel[listitem])
			{
				SendClientMessage(playerid, -10066177, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x9A; \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
				UI_VehicleShopShow(playerid, g_UiVehLevel[playerid], g_UiVehMoney[playerid], g_UiVehBank[playerid]);
				return true;
			}
			g_UiVehSel[playerid] = listitem;
			UI_VehPayShow(playerid);
			return true;
		}
		case 9101:
		{
			if (!response || listitem < 0 || listitem > 1)
			{
				UI_VehicleShopShow(playerid, g_UiVehLevel[playerid], g_UiVehMoney[playerid], g_UiVehBank[playerid]);
				return true;
			}
			new idx = g_UiVehSel[playerid];
			new funds = listitem == 1 ? g_UiVehBank[playerid] : g_UiVehMoney[playerid];
			if (idx < 0 || idx >= 13)
			{
				return true;
			}
			if (funds < g_UiVehPrice[idx])
			{
				SendClientMessage(playerid, -10066177, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
				UI_VehPayShow(playerid);
				return true;
			}
			UI_OnVehicleBuyConfirm(playerid, idx, listitem);
			return true;
		}
		case 9102:
		{
			if (!response)
			{
				return true;
			}
			if (listitem < 0 || listitem >= g_UiVehCount[playerid])
			{
				UI_VehicleListShow(playerid);
				return true;
			}
			g_UiVehSel[playerid] = listitem;
			UI_VehActionShow(playerid);
			return true;
		}
		case 9103:
		{
			if (!response)
			{
				UI_VehicleListShow(playerid);
				return true;
			}
			new i = g_UiVehSel[playerid];
			if (i < 0 || i >= g_UiVehCount[playerid])
			{
				return true;
			}
			if (listitem == 0)
			{
				UI_OnVehicleListAction(playerid, g_UiVehSlot[playerid][i], 0);
			}
			else if (listitem == 1)
			{
				UI_VehSellConfirmShow(playerid);
			}
			else
			{
				UI_VehActionShow(playerid);
			}
			return true;
		}
		case 9104:
		{
			new i = g_UiVehSel[playerid];
			if (!response)
			{
				UI_VehActionShow(playerid);
				return true;
			}
			if (i < 0 || i >= g_UiVehCount[playerid])
			{
				return true;
			}
			UI_OnVehicleListAction(playerid, g_UiVehSlot[playerid][i], 1);
			return true;
		}
		case 9105:
		{
			return true;
		}
	}
	return false;
}
new PlayerText:g_UiVHud[MAX_PLAYERS][6];
new bool:g_UiVHudCreated[MAX_PLAYERS];
new bool:g_UiVHudShown[MAX_PLAYERS];

PlayerText:UI_VHudText(playerid, Float:x, Float:y, const text[], Float:lw, Float:lh, color, t_TEXT_DRAW_ALIGN:align)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, text);
	PlayerTextDrawLetterSize(playerid, td, lw, lh);
	PlayerTextDrawAlignment(playerid, td, align);
	PlayerTextDrawColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetProportional(playerid, td, true);
	PlayerTextDrawSetOutline(playerid, td, 1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawBackgroundColour(playerid, td, 255);
	return td;
}

PlayerText:UI_VHudBox(playerid, Float:x, Float:y, Float:w, Float:h, color)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, "_");
	PlayerTextDrawLetterSize(playerid, td, 0.0, (h / 9.0));
	PlayerTextDrawTextSize(playerid, td, (x + w), 0.0);
	PlayerTextDrawUseBox(playerid, td, true);
	PlayerTextDrawBoxColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawSetOutline(playerid, td, 0);
	return td;
}

UI_VHudCreate(playerid)
{
	if (g_UiVHudCreated[playerid])
	{
		return 0;
	}
	new Float:left = (632.0 - 150.0);
	g_UiVHud[playerid][0] = UI_VHudBox(playerid, left, 398.0, 150.0, 56.0, 153);
	g_UiVHud[playerid][1] = UI_VHudText(playerid, (632.0 - 5.0), (398.0 + 2.0), "0 \xE1;\x83;\x99;\xE1;\x83;\x9B;/\xE1;\x83;\xA1;\xE1;\x83;\x97;", 0.3, 1.2, -1, t_TEXT_DRAW_ALIGN:3);
	g_UiVHud[playerid][2] = UI_VHudText(playerid, (5.0 + left), (398.0 + 22.0), "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; 0.0/0 \xE1;\x83;\x9A;", 0.22, 1.0, -1, t_TEXT_DRAW_ALIGN:1);
	g_UiVHud[playerid][3] = UI_VHudBox(playerid, (5.0 + left), (398.0 + 35.0), 140.0, 6.0, 0x444444FF);
	g_UiVHud[playerid][4] = UI_VHudBox(playerid, (5.0 + left), (398.0 + 35.0), 140.0, 6.0, 0x66DD66FF);
	g_UiVHud[playerid][5] = UI_VHudText(playerid, (5.0 + left), (398.0 + 43.0), "\xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;", 0.2, 0.9, -10066177, t_TEXT_DRAW_ALIGN:1);
	g_UiVHudCreated[playerid] = true;
	return 0;
}

UI_VHudSetVisible(playerid, bool:visible)
{
	for (new i = 0; i < 6; i++)
	{
		if (visible)
		{
			PlayerTextDrawShow(playerid, PlayerText:g_UiVHud[playerid][i]);
		}
		else
		{
			PlayerTextDrawHide(playerid, PlayerText:g_UiVHud[playerid][i]);
		}
	}
}

UI_VehicleHudShow(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (CefUI_Active(playerid))
	{
		return 0;    // tachimetro CEF (ui/hud_cef.inc)
	}
	UI_VHudCreate(playerid);
	g_UiVHudShown[playerid] = true;
	UI_VHudSetVisible(playerid, true);
	return 0;
}

UI_VehicleHudHide(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !g_UiVHudCreated[playerid])
	{
		return 0;
	}
	g_UiVHudShown[playerid] = false;
	UI_VHudSetVisible(playerid, false);
	return 0;
}

UI_VehicleHudUpdate(playerid, Float:fuel, Float:fuelMax, speedKmh, bool:engineOn)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !g_UiVHudCreated[playerid] || !g_UiVHudShown[playerid])
	{
		return 0;
	}
	if ((fuelMax < 1.0))
	{
		fuelMax = 1.0;
	}
	if ((fuel < 0.0))
	{
		fuel = 0.0;
	}
	if ((fuel > fuelMax))
	{
		fuel = fuelMax;
	}
	if (speedKmh < 0)
	{
		speedKmh = 0;
	}
	new Float:fraction = (fuel / fuelMax);
	new bool:low = ((100.0 * fraction) < float(15));
	new str[432];
	format(str, 432, "%d \xE1;\x83;\x99;\xE1;\x83;\x9B;/\xE1;\x83;\xA1;\xE1;\x83;\x97;", speedKmh);
	Lang_PlayerTextDrawSetString(playerid, g_UiVHud[playerid][1], str);
	format(str, 432, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; %.1f/%.0f \xE1;\x83;\x9A;", fuel, fuelMax);
	Lang_PlayerTextDrawSetString(playerid, g_UiVHud[playerid][2], str);
	new bool:blinkOff = low && GetTickCount() / 500 % 2 == 1;
	PlayerTextDrawColour(playerid, PlayerText:g_UiVHud[playerid][2], low ? (blinkOff ? -10066364 : -10066177) : -1);
	PlayerTextDrawShow(playerid, PlayerText:g_UiVHud[playerid][2]);
	PlayerTextDrawBoxColour(playerid, PlayerText:g_UiVHud[playerid][4], low ? -12303105 : 0x66DD66FF);
	PlayerTextDrawTextSize(playerid, PlayerText:g_UiVHud[playerid][4], (0.1 + ((5.0 + (632.0 - 150.0)) + (140.0 * fraction))), 0.0);
	PlayerTextDrawShow(playerid, PlayerText:g_UiVHud[playerid][4]);
	Lang_PlayerTextDrawSetString(playerid, g_UiVHud[playerid][5], engineOn ? "\xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;" : "\xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;");
	PlayerTextDrawColour(playerid, PlayerText:g_UiVHud[playerid][5], engineOn ? 0x66DD66FF : -10066177);
	PlayerTextDrawShow(playerid, PlayerText:g_UiVHud[playerid][5]);
	return 0;
}

UI_VehicleUiDestroy(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (g_UiVHudCreated[playerid])
	{
		for (new i = 0; i < 6; i++)
		{
			PlayerTextDrawDestroy(playerid, PlayerText:g_UiVHud[playerid][i]);
			g_UiVHud[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
	}
	g_UiVHudCreated[playerid] = false;
	g_UiVHudShown[playerid] = false;
	g_UiVehCount[playerid] = 0;
	g_UiVehSel[playerid] = 0;
	return 0;
}

