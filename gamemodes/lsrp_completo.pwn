		Util_Send(playerid, -1, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
	}
	return 0;
}

