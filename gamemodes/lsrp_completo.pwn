{
	new body[1024], title[192], cur = g_UiLvHpStep[playerid];
	g_UiLvHpView[playerid] = step;
	format(body, 1024, "{FFFFFF}%s\n\n%s", g_UiLvStepText[step], step < cur ? "{66DD66}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;." : (step == cur ? "{FFD24D}\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x98;\xE1;\x83;\x90;." : "{AAAAAA}\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A; \xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;."));
	format(title, 192, "%d. %s", step, g_UiLvStepTitle[step]);
	if (step == cur && !g_UiLvHpOff[playerid])
	{
		Lang_ShowPlayerDialog(playerid, 9723, DIALOG_STYLE_MSGBOX, title, body, "\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;");
	}
	else
	{
		Lang_ShowPlayerDialog(playerid, 9723, DIALOG_STYLE_MSGBOX, title, body, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
	}
}

UI_LivingHint(playerid, step)
{
	if (!UI_LvReady(playerid) || step < 1 || step > 5 || g_UiLvHpOff[playerid])
	{
		return 0;
	}
	UI_LvTdEnsure(playerid);
	new text[480];
	format(text, 480, "~y~\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94; %d/%d~n~~w~%s", step, 5, g_UiLvStepHint[step]);
	Lang_PlayerTextDrawSetString(playerid, g_UiLvTd[playerid][9], text);
	UI_LvTdShow(playerid, 8, 9, true);
	g_UiLvHintTtl[playerid] = 10;
	UI_LvTimerSync(playerid);
	return 0;
}

UI_LivingHintHide(playerid)
{
	if (!UI_LvValid(playerid))
	{
		return 0;
	}
	if (g_UiLvHintTtl[playerid] > 0 && IsPlayerConnected(playerid))
	{
		UI_LvTdShow(playerid, 8, 9, false);
	}
	g_UiLvHintTtl[playerid] = 0;
	if (IsPlayerConnected(playerid))
	{
		UI_LvTimerSync(playerid);
	}
	return 0;
}

