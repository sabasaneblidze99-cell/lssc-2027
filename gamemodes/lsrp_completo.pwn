	{
		CefUI_AuthStep(playerid, "register", error[0] != 0 ? "\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x92;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x94;." : "", 0);
