		SendClientMessage(playerid, -10066177, msg);
		UI_BankToast(playerid, "\xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;", false);
