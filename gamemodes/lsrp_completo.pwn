stock Veh_StdModelName(model, out[], size = sizeof out)
{
	if (model < 400 || model > 611)
	{
		out[0] = 0;
		return 0;
	}
	format(out, size, "%s", g_VehModelNames[model - 400]);
	return 1;
}

// ===== modules/core/lang.inc =====
new g_LangKa[33][3] = {
	"a",
	"b",
	"g",
	"d",
	"e",
	"v",
	"z",
	"t",
	"i",
	"k",
	"l",
	"m",
	"n",
	"o",
	"p",
	"zh",
	"r",
	"s",
	"t",
	"u",
	"f",
	"q",
	"gh",
	"y",
	"sh",
	"ch",
	"c",
	"dz",
	"w",
	"ch",
	"x",
	"j",
	"h"
};

Lang_Utf8Next(const src[], &i)
{
	new c = src[i] & 255;
	if (c < 128)
	{
		i++;
		return c;
	}
	new need = 0, cp = 0;
	if ((c & 224) == 192)
	{
		need = 1;
		cp = c & 31;
	}
	else if ((c & 240) == 224)
	{
		need = 2;
		cp = c & 15;
	}
	else if ((c & 248) == 240)
	{
		need = 3;
		cp = c & 7;
	}
	else
	{
		i++;
		return -c;
	}
	for (new k = 1; k <= need; k++)
	{
		new b = src[i + k] & 255;
		if ((b & 192) != 128)
		{
			i++;
			return -c;
		}
		cp = cp << 6 | b & 63;
	}
	i += need + 1;
	return cp;
}

Lang_Translit(const src[], dest[], size)
{
	new i = 0, o = 0;
	while (src[i] != 0 && o < size - 1)
	{
		new cp = Lang_Utf8Next(src, i);
		if (cp < 0)
		{
			dest[o++] = -cp;
			continue;
		}
		if (cp < 128)
		{
			dest[o++] = cp;
			continue;
		}
		new idx = -1;
		if (cp >= 4304 && cp <= 4336)
		{
			idx = cp - 4304;
		}
		else if (cp >= 7312 && cp <= 7344)
		{
			idx = cp - 7312;
		}
		if (idx >= 0)
		{
			for (new k = 0; g_LangKa[idx][k] != 0 && o < size - 1; k++)
			{
				dest[o++] = g_LangKa[idx][k];
			}
			continue;
		}
		switch (cp)
		{
			case 8211, 8212, 8722:
			{
				dest[o++] = 45;
			}
			case 171, 187, 8220 .. 8222:
			{
				dest[o++] = 34;
			}
			case 8216, 8217:
			{
				dest[o++] = 39;
			}
			case 8230:
			{
				for (new k = 0; k < 3 && o < size - 1; k++)
				{
					dest[o++] = 46;
				}
			}
			case 160:
			{
				dest[o++] = 32;
			}
			default:
			{
				dest[o++] = 63;
			}
		}
	}
	dest[o] = 0;
}

bool:Lang_ShowPlayerDialog(playerid, dialogid, t_DIALOG_STYLE:style, const title[], const body[], const button1[], const button2[])
{
	static cap[128], b1[64], b2[64], out[4096];
	Lang_Translit(title, cap, 128);
	Lang_Translit(body, out, 4096);
	Lang_Translit(button1, b1, 64);
	Lang_Translit(button2, b2, 64);
	return ShowPlayerDialog(playerid, dialogid, style, cap, out, b1, b2);
}

PlayerText:Lang_CreatePlayerTextDraw(playerid, Float:x, Float:y, text[])
{
	static out[1024];
	Lang_Translit(text, out, 1024);
	return CreatePlayerTextDraw(playerid, x, y, "%s", out);
}

bool:Lang_PlayerTextDrawSetString(playerid, PlayerText:textid, text[])
{
	static out[1024];
	Lang_Translit(text, out, 1024);
	return PlayerTextDrawSetString(playerid, textid, "%s", out);
}

Text3D:Lang_Create3DTextLabel(text[], colour, Float:x, Float:y, Float:z, Float:drawDistance, virtualWorld, bool:testLOS)
{
	static out[512];
	Lang_Translit(text, out, 512);
	return Create3DTextLabel(out, colour, x, y, z, drawDistance, virtualWorld, testLOS);
}

bool:Lang_Update3DTextLabelText(Text3D:textid, colour, text[])
{
	static out[512];
	Lang_Translit(text, out, 512);
	return Update3DTextLabelText(textid, colour, out);
}

// ===== modules/core/player_data.inc =====
new gPlayer[MAX_PLAYERS][E_PLAYER_DATA];

Player_Reset(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	for (new i = 0; i < _:E_PLAYER_DATA; i++)
	{
		gPlayer[playerid][i] = 0;
	}
}

// ===== modules/core/utils.inc =====
new g_UtilSaltChars[63];

Util_Send(playerid, color, const text[])
{
	// traslitterazione (giocatori senza chat CEF) e invio: core/chat.inc
	return Chat_Line(playerid, color, text);
}

bool:Util_IsPlaying(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid) || IsPlayerNPC(playerid))
	{
		return 0;
	}
	return gPlayer[playerid][pLoggedIn] && gPlayer[playerid][pSpawned];
}

Util_GetAdmin(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pLoggedIn])
	{
		return 0;
	}
	return gPlayer[playerid][pAdminLevel];
}

Util_Trim(str[])
{
	new len = strlen(str);
	while (len > 0 && str[len - 1] <= 32)
	{
		str[--len] = 0;
	}
	new start = 0;
	while (str[start] != 0 && str[start] <= 32)
	{
		start++;
	}
	if (start > 0)
	{
		strdel(str, 0, start);
	}
}

bool:Util_IsHexChar(c)
{
	return (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
}

bool:Util_IsColorCodeAt(str[], pos)
{
	if (str[pos] != 123)
	{
		return 0;
	}
	for (new i = 1; i <= 6; i++)
	{
		if (!Util_IsHexChar(str[pos + i]))
		{
			return 0;
		}
	}
	return str[pos + 7] == 125;
}

Util_StripColorCodes(str[])
{
	new i = 0;
	while (str[i] != 0)
	{
		if (Util_IsColorCodeAt(str, i))
		{
			strdel(str, i, i + 8);
			i -= i > 8 ? 8 : i;
		}
		else
		{
			i++;
		}
	}
}

bool:Util_SanitizeText(src[], dest[], maxLen)
{
	new tmp[256];
	strmid(tmp, src, 0, 255, 256);
	Util_StripColorCodes(tmp);
	Util_Trim(tmp);
	if (strlen(tmp) > maxLen)
	{
		// non spezzare un carattere UTF-8 (georgiano = 3 byte): si torna all'inizio del carattere
		new cut = maxLen;
		while (cut > 0 && (tmp[cut] & 0xC0) == 0x80)
		{
			cut--;
		}
		tmp[cut] = 0;
		Util_Trim(tmp);
	}
	strmid(dest, tmp, 0, maxLen, maxLen + 1);
	return dest[0] != 0;
}

bool:Util_ParseInt(str[], &value)
{
	new i = 0, digits = 0, bool:neg = 0;
	value = 0;
	if (str[0] == 45)
	{
		neg = 1;
		i++;
	}
	for (;str[i] != 0; i++)
	{
		if (str[i] < 48 || str[i] > 57)
		{
			return 0;
		}
		new d = str[i] - 48;
		if (value > (0x7FFFFFFF - d) / 10)
		{
			return 0;
		}
		value = value * 10 + d;
		if (++digits > 10)
		{
			return 0;
		}
	}
	if (digits == 0)
	{
		return 0;
	}
	if (neg)
	{
		value = -value;
	}
	return 1;
}

Util_NextToken(src[], &pos, dest[], size)
{
	while (src[pos] == 32)
	{
		pos++;
	}
	new n = 0;
	while (src[pos] != 0 && src[pos] != 32)
	{
		if (n < size - 1)
		{
			dest[n++] = src[pos];
		}
		pos++;
	}
	dest[n] = 0;
	return n;
}

bool:Util_ParsePlayerId(token[], &id)
{
	if (!Util_ParseInt(token, id))
	{
		return 0;
	}
	return id >= 0 && id < 1000;
}

bool:Util_IsValidRPNameC(const name[])
{
	new tmp[25];
	if (strlen(name) >= sizeof tmp)
	{
		return false;
	}
	strcat(tmp, name);
	return Util_IsValidRPName(tmp);
}

bool:Util_IsValidRPName(name[])
{
	new us = -1, len = strlen(name);
	for (new i = 0; i < len; i++)
	{
		new c = name[i];
		if (c == 95)
		{
			if (us != -1)
			{
				return 0;
			}
			us = i;
			continue;
		}
		if (c < 65 || (c > 90 && c < 97) || c > 122)
		{
			return 0;
		}
	}
	if (us < 2 || len - us - 1 < 2)
	{
		return 0;
	}
	return name[0] >= 65 && name[0] <= 90 && name[us + 1] >= 65 && name[us + 1] <= 90;
}

Util_SplitText(text[], out[][], maxLines)
{
	new len = strlen(text), start = 0, count = 0;
	while (start < len && count < maxLines)
	{
		new take = len - start;
		if (take > 110)
		{
			take = 110;
			for (new i = 110; i > 55; i--)
			{
				if (text[start + i] == 32)
				{
					take = i;
					break;
				}
			}
		}
		strmid(out[count], text, start, start + take, 128);
		start += take;
		if (text[start] == 32)
		{
			start++;
		}
		count++;
	}
	return count;
}

Util_SendNear(sourceid, color, Float:radius, text[])
{
	new lines[3][128];
	new count = Util_SplitText(text, lines, 3);
	if (count < 1)
	{
		return 0;
	}
	new Float:x, Float:y, Float:z;
	GetPlayerPos(sourceid, x, y, z);
	new interior = GetPlayerInterior(sourceid), world = GetPlayerVirtualWorld(sourceid);
	Chat_SetCategory(color == 0xAAAAAAFF ? CHAT_CAT_OOC : CHAT_CAT_IC);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!gPlayer[i][pSpawned] || !Util_IsPlaying(i))
		{
			continue;
		}
		if (GetPlayerInterior(i) != interior || GetPlayerVirtualWorld(i) != world)
		{
			continue;
		}
		if ((GetPlayerDistanceFromPoint(i, x, y, z) > radius))
		{
			continue;
		}
		for (new l = 0; l < count; l++)
		{
			SendClientMessage(i, color, "%s%s%s", l > 0 ? "... " : "", lines[l], l < count - 1 ? " ..." : "");
		}
	}
	Chat_SetCategory(CHAT_CAT_AUTO);
}

bool:Util_InRange(playerid, targetid, Float:radius)
{
	if (GetPlayerInterior(playerid) != GetPlayerInterior(targetid))
	{
		return 0;
	}
	if (GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(targetid))
	{
		return 0;
	}
	new Float:x, Float:y, Float:z;
	GetPlayerPos(targetid, x, y, z);
	return (GetPlayerDistanceFromPoint(playerid, x, y, z) <= radius);
}

// ===== modules/core/logger.inc =====

Log_Write(category[], text[])
{
	new h = 0, mi = 0, s = 0, y = 0, mo = 0, d = 0;
	new clean[320], line[320];
	gettime(h, mi, s);
	getdate(y, mo, d);
	strmid(clean, text, 0, 319, 320);
	for (new i = 0; clean[i] != 0; i++)
	{
		if (clean[i] == 13 || clean[i] == 10)
		{
			clean[i] = 32;
		}
	}
	format(line, 320, "[%04d-%02d-%02d %02d:%02d:%02d] [%s] %s", y, mo, d, h, mi, s, category, clean);
	printf("%s", line);
	new File:f = fopen("lsrp.log", 3);
	if (f)
	{
		fwrite(f, line);
		fwrite(f, "\r\n");
		fclose(f);
	}
}

