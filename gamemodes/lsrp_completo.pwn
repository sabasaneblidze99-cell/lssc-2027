	g_UiFHudCreated[playerid] = false;
	g_UiFHudShown[playerid] = false;
	g_UiFHudKit[playerid] = false;
	g_UiIHudCreated[playerid] = false;
	g_UiIHudShown[playerid] = false;
	g_UiFcFaction[playerid] = 0;
	g_UiFcRank[playerid] = 0;
