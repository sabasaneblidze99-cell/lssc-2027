UI_InvTimerStop(playerid)
{
	if (g_UiInvTimer[playerid] != 0)
	{
		KillTimer(g_UiInvTimer[playerid]);
		g_UiInvTimer[playerid] = 0;
	}
}

UI_InvTimerEnsure(playerid)
{
	if (g_UiInvTimer[playerid] == 0)
	{
		g_UiInvTimer[playerid] = SetTimerEx("UI_InvOnTimer", 1000, true, "d", playerid);
	}
}

PlayerText:UI_InvText(playerid, Float:x, Float:y, const text[], Float:lw, Float:lh, color, t_TEXT_DRAW_ALIGN:align)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, text);
	PlayerTextDrawLetterSize(playerid, td, lw, lh);
	PlayerTextDrawAlignment(playerid, td, align);
	PlayerTextDrawColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetProportional(playerid, td, true);
	PlayerTextDrawSetOutline(playerid, td, 1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawBackgroundColour(playerid, td, 255);
	return td;
}

PlayerText:UI_InvBox(playerid, Float:x, Float:y, Float:w, Float:h, color)
{
	new PlayerText:td = Lang_CreatePlayerTextDraw(playerid, x, y, "_");
	PlayerTextDrawLetterSize(playerid, td, 0.0, (h / 9.0));
	PlayerTextDrawTextSize(playerid, td, (x + w), 0.0);
	PlayerTextDrawUseBox(playerid, td, true);
	PlayerTextDrawBoxColour(playerid, td, color);
	PlayerTextDrawFont(playerid, td, TEXT_DRAW_FONT_1);
	PlayerTextDrawSetShadow(playerid, td, 0);
	PlayerTextDrawSetOutline(playerid, td, 0);
	return td;
}

UI_InvRecvDestroyTds(playerid)
{
	for (new i = 0; i < 4; i++)
	{
		if (g_UiInvRecvTd[playerid][i] != INVALID_PLAYER_TEXT_DRAW)
		{
			PlayerTextDrawDestroy(playerid, PlayerText:g_UiInvRecvTd[playerid][i]);
		}
		g_UiInvRecvTd[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
	}
}

UI_InvRecvRefresh(playerid)
{
	new str[432], left = g_UiInvRecvLeft[playerid], total = g_UiInvRecvTotal[playerid];
	format(str, 432, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;: %d \xE1;\x83;\xAC;\xE1;\x83;\x9B;", left);
	Lang_PlayerTextDrawSetString(playerid, g_UiInvRecvTd[playerid][1], str);
	new Float:fraction = (total > 0 ? (float(left) / float(total)) : 0.0);
	if ((fraction < 0.0))
	{
		fraction = 0.0;
	}
	if ((fraction > 1.0))
	{
		fraction = 1.0;
	}
	PlayerTextDrawTextSize(playerid, PlayerText:g_UiInvRecvTd[playerid][3], (0.1 + ((210.0 + 6.0) + (208.0 * fraction))), 0.0);
	PlayerTextDrawShow(playerid, PlayerText:g_UiInvRecvTd[playerid][1]);
	PlayerTextDrawShow(playerid, PlayerText:g_UiInvRecvTd[playerid][3]);
}

UI_InvRecvEnd(playerid)
{
	g_UiInvRecvActive[playerid] = false;
	g_UiInvRecvLeft[playerid] = 0;
	UI_InvRecvDestroyTds(playerid);
}

bool:UI_InvNeedTimer(playerid)
{
	if (g_UiInvRecvActive[playerid])
	{
		return true;
	}
	for (new i = 0; i < 3; i++)
	{
		if (g_UiInvToastTtl[playerid][i] > 0)
		{
			return true;
		}
	}
	return false;
}

UI_InvGiveConfirmShow(playerid, const giverName[], itemId, qty, ttlSec)
{
	if (!UI_InvValid(playerid) || !UI_InvItemOk(itemId) || qty <= 0)
	{
		return 0;
	}
	if (ttlSec <= 0)
	{
		ttlSec = 15;
	}
	if (g_UiInvRecvActive[playerid])
	{
		UI_InvRecvEnd(playerid);
	}
	for (new i = 0; i < 4; i++)
	{
		g_UiInvRecvTd[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
	}
	g_UiInvRecvTd[playerid][0] = UI_InvBox(playerid, 210.0, 124.0, 220.0, 26.0, 170);
	g_UiInvRecvTd[playerid][1] = UI_InvText(playerid, (210.0 + 6.0), (124.0 + 2.0), "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;", 0.24, 1.1, -2994689, t_TEXT_DRAW_ALIGN:1);
	g_UiInvRecvTd[playerid][2] = UI_InvBox(playerid, (210.0 + 6.0), (124.0 + 17.0), 208.0, 5.0, 0x444444FF);
	g_UiInvRecvTd[playerid][3] = UI_InvBox(playerid, (210.0 + 6.0), (124.0 + 17.0), 208.0, 5.0, -2994689);
	g_UiInvRecvActive[playerid] = true;
	g_UiInvRecvTotal[playerid] = ttlSec;
	g_UiInvRecvLeft[playerid] = ttlSec;
	PlayerTextDrawShow(playerid, PlayerText:g_UiInvRecvTd[playerid][0]);
	PlayerTextDrawShow(playerid, PlayerText:g_UiInvRecvTd[playerid][2]);
	UI_InvRecvRefresh(playerid);
	UI_InvTimerEnsure(playerid);
	new body[640], name[72], giver[75];
	strcopy(name, g_UiInvName[itemId], 72);
	strcopy(giver, giverName, 75);
	format(body, 640, "{FFD24D}%s{FFFFFF}-\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\xA1; {FFD24D}%s x%d{FFFFFF}.\n\n\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\x95;\xE1;\x83;\x90; {FF6666}%d{FFFFFF} \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98;.\n\xE1;\x83;\x97;\xE1;\x83;\xA3; \xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;, \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", giver, name, qty, ttlSec);
	Lang_ShowPlayerDialog(playerid, 9406, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;", body, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x90;");
	return 0;
}

UI_InvGiveConfirmClose(playerid)
{
	if (!UI_InvValid(playerid))
	{
		return 0;
	}
	if (g_UiInvRecvActive[playerid])
	{
		UI_InvRecvEnd(playerid);
	}
	if (GetPlayerDialogID(playerid) == 9406)
	{
		HidePlayerDialog(playerid);
	}
	if (!UI_InvNeedTimer(playerid))
	{
		UI_InvTimerStop(playerid);
	}
	return 0;
}

UI_InvToastCreate(playerid)
{
	if (g_UiInvToastCreated[playerid])
	{
		return 0;
	}
	for (new i = 0; i < 3; i++)
	{
		g_UiInvToastTd[playerid][i] = UI_InvText(playerid, 130.0, (404.0 + (12.0 * _:(i))), "_", 0.22, 1.0, 0x66DD66FF, t_TEXT_DRAW_ALIGN:1);
		g_UiInvToastTtl[playerid][i] = 0;
		g_UiInvToastItem[playerid][i] = 0;
		g_UiInvToastDelta[playerid][i] = 0;
	}
	g_UiInvToastCreated[playerid] = true;
	return 0;
}

UI_InvToastRedraw(playerid)
{
	if (!g_UiInvToastCreated[playerid])
	{
		return 0;
	}
	new str[144];
	for (new i = 0; i < 3; i++)
	{
		if (g_UiInvToastTtl[playerid][i] <= 0 || !UI_InvItemOk(g_UiInvToastItem[playerid][i]))
		{
			PlayerTextDrawHide(playerid, PlayerText:g_UiInvToastTd[playerid][i]);
			continue;
		}
		new delta = g_UiInvToastDelta[playerid][i];
		format(str, 144, "%s%d %s", delta > 0 ? "+" : "", delta, g_UiInvName[g_UiInvToastItem[playerid][i]]);
		Lang_PlayerTextDrawSetString(playerid, g_UiInvToastTd[playerid][i], str);
		PlayerTextDrawColour(playerid, PlayerText:g_UiInvToastTd[playerid][i], delta > 0 ? 0x66DD66FF : -10066177);
		PlayerTextDrawShow(playerid, PlayerText:g_UiInvToastTd[playerid][i]);
	}
	return 0;
}

UI_InvToast(playerid, itemId, delta)
{
	if (!UI_InvValid(playerid) || !UI_InvItemOk(itemId) || delta == 0)
	{
		return 0;
	}
	UI_InvToastCreate(playerid);
	if (g_UiInvToastTtl[playerid][0] > 0 && g_UiInvToastItem[playerid][0] == itemId && g_UiInvToastDelta[playerid][0] > 0 == delta > 0)
	{
		g_UiInvToastDelta[playerid][0] += delta;
		g_UiInvToastTtl[playerid][0] = 4;
	}
	else
	{
		for (new i = 2; i > 0; i--)
		{
			g_UiInvToastItem[playerid][i] = g_UiInvToastItem[playerid][i - 1];
			g_UiInvToastDelta[playerid][i] = g_UiInvToastDelta[playerid][i - 1];
			g_UiInvToastTtl[playerid][i] = g_UiInvToastTtl[playerid][i - 1];
		}
		g_UiInvToastItem[playerid][0] = itemId;
		g_UiInvToastDelta[playerid][0] = delta;
		g_UiInvToastTtl[playerid][0] = 4;
	}
	UI_InvToastRedraw(playerid);
	UI_InvTimerEnsure(playerid);
	return 0;
}

public UI_InvOnTimer(playerid)
{
	if (!UI_InvValid(playerid) || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new redraw = 0;
	for (new i = 0; i < 3; i++)
	{
		if (g_UiInvToastTtl[playerid][i] > 0)
		{
			g_UiInvToastTtl[playerid][i]--;
			redraw = 1;
		}
	}
	if (redraw)
	{
		UI_InvToastRedraw(playerid);
	}
	if (g_UiInvRecvActive[playerid])
	{
		g_UiInvRecvLeft[playerid]--;
		if (g_UiInvRecvLeft[playerid] <= 0)
		{
			UI_InvRecvEnd(playerid);
			if (GetPlayerDialogID(playerid) == 9406)
			{
				HidePlayerDialog(playerid);
			}
			SendClientMessage(playerid, -2994689, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
			UI_OnInvGiveExpired(playerid);
		}
		else
		{
			UI_InvRecvRefresh(playerid);
		}
	}
	if (!UI_InvNeedTimer(playerid))
	{
		UI_InvTimerStop(playerid);
	}
	return 1;
}

bool:UI_InvOnDialogResponse(playerid, dialogid, response, listitem, const inputtext[])
{
	if (!UI_InvValid(playerid) || dialogid < 9400 || dialogid > 9406)
	{
		return false;
	}
	switch (dialogid)
	{
		case 9400:
		{
			if (!response)
			{
				return true;
			}
			if (listitem < 0)
			{
				return true;
			}
			if (listitem < g_UiInvRowCount[playerid])
			{
				new slot = g_UiInvRows[playerid][listitem];
				UI_InvItemShow(playerid, slot);
				return true;
			}
			if (listitem == g_UiInvNavNext[playerid])
			{
				UI_InvListPage(playerid, g_UiInvPage[playerid] + 1);
			}
			else if (listitem == g_UiInvNavPrev[playerid])
			{
				UI_InvListPage(playerid, g_UiInvPage[playerid] - 1);
			}
			else
			{
				UI_InvListPage(playerid, g_UiInvPage[playerid]);
			}
			return true;
		}
		case 9401:
		{
			if (!response)
			{
				UI_InvSelReset(playerid);
				UI_InvListPage(playerid, g_UiInvPage[playerid]);
				return true;
			}
			if (!UI_InvSelOk(playerid))
			{
				UI_InvActionShow(playerid);
				return true;
			}
			new slot = g_UiInvSel[playerid], itemId = g_UiInvSelItem[playerid], flags = g_UiInvFlags[itemId];
			switch (listitem)
			{
				case 0:
				{
					if (!(flags & 1))
					{
						SendClientMessage(playerid, -10066177, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
						UI_InvActionShow(playerid);
						return true;
					}
					UI_InvSelReset(playerid);
					UI_OnInvUse(playerid, slot);
				}
				case 1, 2:
				{
					if (!(flags & 2))
					{
						SendClientMessage(playerid, -10066177, listitem == 1 ? "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;." : "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA3;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
						UI_InvActionShow(playerid);
						return true;
					}
					g_UiInvPendAct[playerid] = listitem;
					g_UiInvSelQty[playerid] = 1;
					if (g_UiInvQty[playerid][slot] > 1)
					{
						UI_InvQtyShow(playerid, "");
					}
					else if (listitem == 1)
					{
						UI_InvTargetShow(playerid, "");
					}
					else
					{
						UI_InvDropConfirmShow(playerid);
					}
				}
				case 3:
				{
					UI_InvInfoShow(playerid);
				}
				default:
				{
					UI_InvActionShow(playerid);
				}
			}
			return true;
		}
		case 9402:
		{
			if (response)
			{
				UI_InvActionShow(playerid);
			}
			else
			{
				UI_InvSelReset(playerid);
			}
			return true;
		}
		case 9403:
		{
			if (!response)
			{
				UI_InvActionShow(playerid);
				return true;
			}
			if (!UI_InvSelOk(playerid))
			{
				UI_InvActionShow(playerid);
				return true;
			}
			new q = 0, maxQ = g_UiInvQty[playerid][g_UiInvSel[playerid]];
			if (!UI_InvParseNum(inputtext, q) || q < 1 || q > maxQ)
			{
				new err[432];
				format(err, 432, "{FF6666}\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x90; \xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x98; 1-\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; %d-\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;.\n\n", maxQ);
				UI_InvQtyShow(playerid, err);
				return true;
			}
			g_UiInvSelQty[playerid] = q;
			if (g_UiInvPendAct[playerid] == 1)
			{
				UI_InvTargetShow(playerid, "");
			}
			else
			{
				UI_InvDropConfirmShow(playerid);
			}
			return true;
		}
		case 9404:
		{
			if (!response)
			{
				if (g_UiInvQty[playerid][g_UiInvSel[playerid]] > 1 && UI_InvSelOk(playerid))
				{
					UI_InvQtyShow(playerid, "");
				}
				else
				{
					UI_InvActionShow(playerid);
				}
				return true;
			}
			if (!UI_InvSelOk(playerid) || g_UiInvSelQty[playerid] < 1 || g_UiInvSelQty[playerid] > g_UiInvQty[playerid][g_UiInvSel[playerid]])
			{
				UI_InvActionShow(playerid);
				return true;
			}
			new target = 0;
			if (!UI_InvParseNum(inputtext, target))
			{
				UI_InvTargetShow(playerid, "{FF6666}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\x98; ID.\n\n");
				return true;
			}
			if (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target))
			{
				UI_InvTargetShow(playerid, "{FF6666}ID \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x96;\xE1;\x83;\x94;.\n\n");
				return true;
			}
			if (target == playerid)
			{
				UI_InvTargetShow(playerid, "{FF6666}\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x9B;.\n\n");
				return true;
			}
			new slot = g_UiInvSel[playerid], qty = g_UiInvSelQty[playerid];
			UI_InvSelReset(playerid);
			UI_OnInvGive(playerid, slot, target, qty);
			return true;
		}
		case 9405:
		{
			if (!response)
			{
				UI_InvActionShow(playerid);
				return true;
			}
			if (!UI_InvSelOk(playerid) || g_UiInvSelQty[playerid] < 1 || g_UiInvSelQty[playerid] > g_UiInvQty[playerid][g_UiInvSel[playerid]])
			{
				UI_InvActionShow(playerid);
				return true;
			}
			new slot = g_UiInvSel[playerid], qty = g_UiInvSelQty[playerid];
			UI_InvSelReset(playerid);
			UI_OnInvDrop(playerid, slot, qty);
			return true;
		}
		case 9406:
		{
			if (!g_UiInvRecvActive[playerid])
			{
				return true;
			}
			UI_InvRecvEnd(playerid);
			if (!UI_InvNeedTimer(playerid))
			{
				UI_InvTimerStop(playerid);
			}
			UI_OnInvGiveReply(playerid, response ? 1 : 0);
			return true;
		}
	}
	return false;
}

UI_InvUiDestroy(playerid)
{
	if (!UI_InvValid(playerid))
	{
		return 0;
	}
	UI_InvTimerStop(playerid);
	if (g_UiInvToastCreated[playerid])
	{
		for (new i = 0; i < 3; i++)
		{
			PlayerTextDrawDestroy(playerid, PlayerText:g_UiInvToastTd[playerid][i]);
			g_UiInvToastTd[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
			g_UiInvToastTtl[playerid][i] = 0;
			g_UiInvToastItem[playerid][i] = 0;
			g_UiInvToastDelta[playerid][i] = 0;
		}
	}
	g_UiInvToastCreated[playerid] = false;
	if (g_UiInvRecvActive[playerid])
	{
		UI_InvRecvEnd(playerid);
	}
	g_UiInvRecvActive[playerid] = false;
	UI_InvClear(playerid);
	g_UiInvMax[playerid] = 0;
	g_UiInvBag[playerid] = false;
	g_UiInvPage[playerid] = 0;
	g_UiInvRowCount[playerid] = 0;
	g_UiInvNavNext[playerid] = -1;
	g_UiInvNavPrev[playerid] = -1;
	UI_InvSelReset(playerid);
	return 0;
}

