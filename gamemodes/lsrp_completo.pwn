	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Job_ResetPlayer(p);
	}
	g_JPool = 0;
	g_JTimer = SetTimer("Job_OnTick", 500, true);
	CreatePickup(1239, 1, 1480.5, -1736.0, 13.5, 0);
	Lang_Create3DTextLabel("Job Center\n\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /lavoro", -2994689, 1480.5, -1736.0, (13.5 + 1.0), 15.0, 0, false);
