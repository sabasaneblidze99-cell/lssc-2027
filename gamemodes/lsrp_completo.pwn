	}
	else if (result == 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;.");
	}
	else
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;: /email");
	}
	return 1;
}

Account_CmdEmail(playerid, const params[])
{
	new pos = 0, email[255];
	Util_NextToken(params, pos, email, 255);
	if (email[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /email \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98;@\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\x98;.ge (\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x9D;, \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x93;)");
		return 0;
	}
	if (!Valid_Email(email))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return 0;
	}
	DB_AccountSetEmail(playerid, gPlayer[playerid][pAccountId], email);
	return 0;
}

// ===== modules/character/spawn.inc =====

Char_GetSpawnPoint(index, &Float:x, &Float:y, &Float:z, &Float:a)
{
	switch (index)
	{
		case 1:
		{
			x = 1481.0;
			y = -1749.5;
			z = 15.45;
			a = 0.0;
		}
		case 2:
		{
			x = 1967.0;
			y = -1200.0;
			z = 25.6;
			a = 180.0;
		}
		case 3:
		{
			x = 369.0;
			y = -2030.0;
			z = 7.67;
			a = 90.0;
		}
		default:
		{
			x = 1742.6;
			y = -1860.0;
			z = 13.5;
			a = 0.0;
		}
	}
}

Char_PickSpawn(playerid)
{
	new Float:x, Float:y, Float:z, Float:a;
	Char_GetSpawnPoint(random(4), x, y, z, a);
	gPlayer[playerid][pPosX] = x;
	gPlayer[playerid][pPosY] = y;
	gPlayer[playerid][pPosZ] = z;
	gPlayer[playerid][pAngle] = a;
	gPlayer[playerid][pInterior] = 0;
	gPlayer[playerid][pWorld] = 0;
}

Char_ApplySpawnInfo(playerid)
{
	SetSpawnInfo(playerid, 255, gPlayer[playerid][pSkin], gPlayer[playerid][pPosX], gPlayer[playerid][pPosY], gPlayer[playerid][pPosZ], gPlayer[playerid][pAngle], WEAPON_FIST, 0, WEAPON_FIST, 0, WEAPON_FIST, 0);
	SetPlayerInterior(playerid, gPlayer[playerid][pInterior]);
	SetPlayerVirtualWorld(playerid, gPlayer[playerid][pWorld]);
}

Char_Spawn(playerid)
{
	gPlayer[playerid][pAuthState] = 8;
	Char_ApplySpawnInfo(playerid);
	SpawnPlayer(playerid);
}

Char_SetLoginCamera(playerid)
{
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerCameraPos(playerid, (1481.0 + 60.0), (-1749.5 + 50.0), (15.45 + 25.0));
	SetPlayerCameraLookAt(playerid, 1481.0, -1749.5, 15.45, CAMERA_CUT);
}

// ===== modules/character/character.inc =====
new g_CharAutosaveTimer;

bool:Char_IsSkinAllowed(gender, skin)
{
	return Valid_SkinAllowed(gender, skin);
}

Char_SyncMoney(playerid)
{
	ResetPlayerMoney(playerid);
	GivePlayerMoney(playerid, gPlayer[playerid][pMoney]);
}

Char_RefreshHud(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pHudCreated])
	{
		return 0;
	}
	UI_HudUpdate(playerid, gPlayer[playerid][pMoney], gPlayer[playerid][pBank], gPlayer[playerid][pLevel], gPlayer[playerid][pExp]);
	return 0;
}

Char_RefreshState(playerid)
{
	if (!gPlayer[playerid][pSpawned] || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new Float:x, Float:y, Float:z, Float:a, Float:hp, Float:ar;
	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);
	GetPlayerHealth(playerid, hp);
	GetPlayerArmour(playerid, ar);
	gPlayer[playerid][pPosX] = x;
	gPlayer[playerid][pPosY] = y;
	gPlayer[playerid][pPosZ] = z;
	gPlayer[playerid][pAngle] = a;
	gPlayer[playerid][pHealth] = hp;
	gPlayer[playerid][pArmor] = ar;
	gPlayer[playerid][pInterior] = GetPlayerInterior(playerid);
	gPlayer[playerid][pWorld] = GetPlayerVirtualWorld(playerid);
	gPlayer[playerid][pSkin] = GetPlayerSkin(playerid);
	return 0;
}

Char_Save(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!gPlayer[playerid][pLoggedIn] || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	Char_RefreshState(playerid);
	DB_SaveCharacter(playerid);
	return 0;
}

Char_SaveAll()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i))
		{
			Char_Save(i);
		}
	}
}

public Char_OnAutosave()
{
	Char_SaveAll();
	return 1;
}

Char_SanitizeLoaded(playerid)
{
	gPlayer[playerid][pMoney] = clamp(gPlayer[playerid][pMoney], 0, 0x3B9ACA00);
	gPlayer[playerid][pBank] = clamp(gPlayer[playerid][pBank], 0, 0x3B9ACA00);
	gPlayer[playerid][pLevel] = clamp(gPlayer[playerid][pLevel], 1, 50);
	if (gPlayer[playerid][pExp] < 0)
	{
		gPlayer[playerid][pExp] = 0;
	}
	gPlayer[playerid][pLevel] = Level_FromExp(gPlayer[playerid][pExp]);
	if (gPlayer[playerid][pSkin] < 0 || gPlayer[playerid][pSkin] > 311)
	{
		gPlayer[playerid][pSkin] = 7;
	}
	gPlayer[playerid][pCivilSkin] = gPlayer[playerid][pSkin];
	gPlayer[playerid][pJob] = clamp(gPlayer[playerid][pJob], 0, 3);
	gPlayer[playerid][pFaction] = clamp(gPlayer[playerid][pFaction], 0, 2);
	gPlayer[playerid][pFactionRank] = clamp(gPlayer[playerid][pFactionRank], 0, 6);
	if (gPlayer[playerid][pFaction] == 0)
	{
		gPlayer[playerid][pFactionRank] = 0;
	}
	else if (gPlayer[playerid][pFactionRank] < 1)
	{
		gPlayer[playerid][pFactionRank] = 1;
	}
	gPlayer[playerid][pOnDuty] = 0;
	gPlayer[playerid][pCuffed] = 0;
	gPlayer[playerid][pWounded] = 0;
	if (gPlayer[playerid][pInterior] < 0)
	{
		gPlayer[playerid][pInterior] = 0;
	}
	if (gPlayer[playerid][pWorld] < 0)
	{
		gPlayer[playerid][pWorld] = 0;
	}
	if ((0.0 == gPlayer[playerid][pPosX]) && (0.0 == gPlayer[playerid][pPosY]) && (0.0 == gPlayer[playerid][pPosZ]))
	{
		Char_PickSpawn(playerid);
	}
}

public Char_OnDBError(playerid)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 4)
	{
		return 1;
	}
	Account_Kick(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
	return 1;
}

public Char_OnDBLoaded(playerid, bool:found)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 4)
	{
		return 1;
	}
	if (found)
	{
		Char_SanitizeLoaded(playerid);
		if (!CharSel_ApplyLoadedName(playerid))
		{
			Account_Kick(playerid, "\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90; (\xE1;\x83;\xA1;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;). \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
			return 1;
		}
		Intro_OnCharLoaded(playerid);
		SpawnSel_Begin(playerid);      // scelta dello spawn (character/spawn_select.inc)
		return 1;
	}
	if (!DB_IsReady())
	{
		Account_Kick(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	Intro_OnNoCharacter(playerid);
	gPlayer[playerid][pAuthState] = 5;
	Account_ShowPrompt(playerid);
	return 1;
}

public UI_OnGenderChosen(playerid, gender)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 5)
	{
		return 1;
	}
	if (gender != 0 && gender != 1)
	{
		UI_ShowGenderSelect(playerid);
		return 1;
	}
	gPlayer[playerid][pGender] = gender;
	gPlayer[playerid][pAuthState] = 6;
	UI_ShowSkinSelect(playerid, gender);
	return 1;
}

public UI_OnSkinChosen(playerid, skin)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 6)
	{
		return 1;
	}
	if (!Char_IsSkinAllowed(gPlayer[playerid][pGender], skin))
	{
		skin = gPlayer[playerid][pGender] == 1 ? 12 : 7;
	}
	gPlayer[playerid][pMoney] = 2500;
	gPlayer[playerid][pBank] = 5000;
	gPlayer[playerid][pLevel] = 1;
	gPlayer[playerid][pExp] = 0;
	gPlayer[playerid][pHealth] = 100.0;
	gPlayer[playerid][pArmor] = 0.0;
	gPlayer[playerid][pSkin] = skin;
	Char_PickSpawn(playerid);
	gPlayer[playerid][pStoryDraftOrigin] = 0;
	gPlayer[playerid][pStoryDraftMotive] = 0;
	if (Intro_TestSkip())
	{
		Char_BeginCreate(playerid);
		return 1;
	}
	gPlayer[playerid][pAuthState] = 15;
	Intro_StoryBegin(playerid);
	return 1;
}

Char_BeginCreate(playerid)
{
	gPlayer[playerid][pAuthState] = 7;
	DB_CreateCharacter(playerid, gPlayer[playerid][pAccountId]);
}

public Char_OnDBCreated(playerid, charId)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 7)
	{
		return 1;
	}
	if (charId <= 0)
	{
		Log_Write("CHAR", "creazione personaggio fallita");
		Account_Kick(playerid, "\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	new name[75], msg[384];
	GetPlayerName(playerid, name, 75);
	format(msg, 384, "nuovo personaggio %d (%s)", charId, name);
	Log_Write("CHAR", msg);
	Inv_IssueStartDoc(playerid);
	Intro_OnCharCreated(playerid, charId);
	return 1;
}

Char_OnInit()
{
	AddPlayerClass(7, 1481.0, -1749.5, 15.45, 0.0, WEAPON_FIST, 0, WEAPON_FIST, 0, WEAPON_FIST, 0);
	g_CharAutosaveTimer = SetTimer("Char_OnAutosave", 300000, true);
}

Char_OnExit()
{
	if (g_CharAutosaveTimer != 0)
	{
		KillTimer(g_CharAutosaveTimer);
	}
	g_CharAutosaveTimer = 0;
	Char_SaveAll();
}

Char_OnRequestClass(playerid)
{
	gPlayer[playerid][pClassRequested] = 1;
	if (SpawnSel_Active(playerid) || CharSel_Active(playerid))
	{
		Char_SetLoginCamera(playerid);
		return 1;
	}
	if (gPlayer[playerid][pAuthState] == 14)
	{
		return 1;
	}
	if (gPlayer[playerid][pAuthState] == 15)
	{
		Char_SetLoginCamera(playerid);
		Intro_StoryBegin(playerid);
		return 1;
	}
	if (gPlayer[playerid][pAuthState] == 9)
	{
		Char_Spawn(playerid);
		return 1;
	}
	Char_SetLoginCamera(playerid);
	Account_ShowPrompt(playerid);
	return 1;
}

Char_OnRequestSpawn(playerid)
{
	#pragma unused playerid
	return 0;
}

Char_OnSpawn(playerid)
{
	new authState = gPlayer[playerid][pAuthState];
	if (!gPlayer[playerid][pLoggedIn] || (authState != 8 && authState != 9))
	{
		return 1;
	}
	gPlayer[playerid][pAuthState] = 9;
	gPlayer[playerid][pSpawned] = 1;
	gPlayer[playerid][pLastActiveTick] = GetTickCount();
	gPlayer[playerid][pSkin] = gPlayer[playerid][pCivilSkin];
	SetPlayerSkin(playerid, gPlayer[playerid][pSkin]);
	SetPlayerInterior(playerid, gPlayer[playerid][pInterior]);
	SetPlayerVirtualWorld(playerid, gPlayer[playerid][pWorld]);
	SetPlayerHealth(playerid, 100.0);
	SetPlayerArmour(playerid, 0.0);
	SetCameraBehindPlayer(playerid);
	UI_CloseDialogs(playerid);
	Char_SyncMoney(playerid);
	if (gPlayer[playerid][pFrozen])
	{
		TogglePlayerControllable(playerid, false);
	}
	if (!gPlayer[playerid][pHudCreated])
	{
		UI_HudCreate(playerid);
		gPlayer[playerid][pHudCreated] = 1;
	}
	Char_RefreshHud(playerid);
	Intro_OnSpawn(playerid);
	if (gPlayer[playerid][pSpawnCount] == 0)
	{
		new name[75];
		GetPlayerName(playerid, name, 75);
		new msg[1024];
		format(msg, 1024, "\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\xA8;\xE1;\x83;\x98;, %s. \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x90;: /help", name);
		Util_Send(playerid, -1, msg);
	}
	gPlayer[playerid][pSpawnCount]++;
	return 1;
}

Char_OnDeath(playerid)
{
	if (!gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	Char_RefreshState(playerid);
	gPlayer[playerid][pSpawned] = 0;
	gPlayer[playerid][pHealth] = 100.0;
	gPlayer[playerid][pArmor] = 0.0;
	Char_ApplySpawnInfo(playerid);
	return 0;
}

Char_OnDisconnect(playerid)
{
	Char_Save(playerid);
	if (gPlayer[playerid][pHudCreated])
	{
		UI_HudDestroy(playerid);
	}
	gPlayer[playerid][pHudCreated] = 0;
}

Char_OnUpdate(playerid)
{
	gPlayer[playerid][pLastActiveTick] = GetTickCount();
	return 1;
}

Char_OnText(playerid)
{
	return gPlayer[playerid][pLoggedIn] && gPlayer[playerid][pSpawned] ? 1 : 0;
}

// ===== modules/economy/money.inc =====

Money_BankLog(playerid, const kind[], delta, const ref[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new charId = gPlayer[playerid][pCharId];
	if (charId <= 0 || delta == 0 || kind[0] == 0)
	{
		return 0;
	}
	new opId[111];
	DB_BankMakeOpId(opId, 111, charId);
	DB_BankLog(opId, charId, 0, kind, delta, gPlayer[playerid][pBank], 2, ref);
	return 0;
}

Money_Refresh(playerid)
{
	Char_SyncMoney(playerid);
	Char_RefreshHud(playerid);
}

bool:Money_ValidPlayer(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid);
}

bool:Money_Can(playerid, amount)
{
	if (!Money_ValidPlayer(playerid) || amount <= 0)
	{
		return false;
	}
	return gPlayer[playerid][pMoney] >= amount;
}

bool:Money_CanReceive(playerid, amount)
{
	if (!Money_ValidPlayer(playerid) || amount <= 0)
	{
		return false;
	}
	return amount <= 0x3B9ACA00 - gPlayer[playerid][pMoney];
}

bool:Money_Give(playerid, amount)
{
	if (!Money_CanReceive(playerid, amount))
	{
		return false;
	}
	gPlayer[playerid][pMoney] += amount;
	Money_Refresh(playerid);
	return true;
}

bool:Money_Take(playerid, amount)
{
	if (!Money_Can(playerid, amount))
	{
		return false;
	}
	gPlayer[playerid][pMoney] -= amount;
	Money_Refresh(playerid);
	return true;
}

bool:Money_Set(playerid, amount)
{
	if (!Money_ValidPlayer(playerid) || amount < 0 || amount > 0x3B9ACA00)
	{
		return false;
	}
	gPlayer[playerid][pMoney] = amount;
	Money_Refresh(playerid);
	return true;
}

Money_BankRoom(playerid)
{
	if (!Money_ValidPlayer(playerid))
	{
		return 0;
	}
	return 0x3B9ACA00 - gPlayer[playerid][pBank];
}

bool:Money_GiveBank(playerid, amount, const kind[], const ref[])
{
	if (!Money_ValidPlayer(playerid) || amount <= 0 || amount > Money_BankRoom(playerid))
	{
		return false;
	}
	gPlayer[playerid][pBank] += amount;
	Char_RefreshHud(playerid);
	if (kind[0] != 0)
	{
		Money_BankLog(playerid, kind, amount, ref);
	}
	return true;
}

bool:Money_CanBank(playerid, amount)
{
	if (!Money_ValidPlayer(playerid) || amount <= 0)
	{
		return false;
	}
	if (gPlayer[playerid][pBankOpBusy] != 0)
	{
		return false;
	}
	return gPlayer[playerid][pBank] >= amount;
}

bool:Money_TakeBank(playerid, amount, const kind[], const ref[])
{
	if (!Money_CanBank(playerid, amount))
	{
		return false;
	}
	gPlayer[playerid][pBank] -= amount;
	Char_RefreshHud(playerid);
	if (kind[0] != 0)
	{
		Money_BankLog(playerid, kind, -amount, ref);
	}
	return true;
}

// ===== modules/economy/level.inc =====

Level_StepExp(level)
{
	return level * 2 + 2;
}

Level_ExpForLevel(level)
{
	level = clamp(level, 1, 50);
	return (level - 1) * 2 * level / 2 + (level - 1) * 2;
}

Level_FromExp(exp)
{
	new n = 1;
	while (n < 50 && Level_ExpForLevel(n + 1) <= exp)
	{
		n++;
	}
	return n;
}

Level_Announce(playerid)
{
	SendClientMessage(playerid, -2994689, "\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x95;! \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x94; %d \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\xA1;.", gPlayer[playerid][pLevel]);
}

bool:Level_AddExp(playerid, amount)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid) || amount <= 0)
	{
		return false;
	}
	new maxExp = Level_ExpForLevel(50), exp = gPlayer[playerid][pExp];
	exp = amount > maxExp - exp ? maxExp : exp + amount;
	gPlayer[playerid][pExp] = exp;
	new newLevel = Level_FromExp(exp), bool:up = newLevel > gPlayer[playerid][pLevel];
	if (up)
	{
		gPlayer[playerid][pLevel] = newLevel;
		Level_Announce(playerid);
	}
	Char_RefreshHud(playerid);
	return up;
}

bool:Level_Set(playerid, level)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return false;
	}
	if (level < 1 || level > 50)
	{
		return false;
	}
	gPlayer[playerid][pLevel] = level;
	gPlayer[playerid][pExp] = Level_ExpForLevel(level);
	Char_RefreshHud(playerid);
	return true;
}

// ===== modules/economy/paycheck.inc =====
new g_EconomyTimer;

Economy_OnInit()
{
	g_EconomyTimer = SetTimer("Economy_OnTick", 1000, true);
}

Economy_OnExit()
{
	if (g_EconomyTimer != 0)
	{
		KillTimer(g_EconomyTimer);
	}
	g_EconomyTimer = 0;
}

Economy_PaycheckAmount(level)
{
	return level * 25 + 300;
}

Economy_PaycheckPaid(amount, room)
{
	if (room <= 0 || amount <= 0)
	{
		return 0;
	}
	return amount > room ? room : amount;
}

Economy_Paycheck(playerid)
{
	new amount = Economy_PaycheckAmount(gPlayer[playerid][pLevel]);
	new paid = Economy_PaycheckPaid(amount, Money_BankRoom(playerid));
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98; ---");
	if (paid > 0 && Money_GiveBank(playerid, paid, "paycheck", ""))
	{
		SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;: $%d \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA8;\xE1;\x83;\x98;. \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x98;: $%d.", paid, gPlayer[playerid][pBank]);
		if (paid < amount)
		{
			SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;: \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x90;.");
		}
	}
	else
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;: \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;.");
	}
	Level_AddExp(playerid, 1);
	Char_Save(playerid);
}

public Economy_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!gPlayer[i][pSpawned] || !Util_IsPlaying(i))
		{
			continue;
		}
		if (now - gPlayer[i][pLastActiveTick] > 10000)
		{
			continue;
		}
		gPlayer[i][pSessionMs] += 1000;
		gPlayer[i][pPlayedMs] += 1000;
		gPlayer[i][pPaycheckMs] += 1000;
		if (gPlayer[i][pPaycheckMs] >= 900000)
		{
			gPlayer[i][pPaycheckMs] -= 900000;
			Economy_Paycheck(i);
		}
	}
	return 1;
}

