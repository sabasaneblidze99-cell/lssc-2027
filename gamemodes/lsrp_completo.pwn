	if (!Inv_ValidPlayer(giver) || gPlayer[giver][pInvGiveTo] != playerid + 1 || gPlayer[giver][pInvGiveSeq] != seq || gPlayer[giver][pInvOp] == 2)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x98;.");
		return 1;
	}
	if (!accept)
	{
		Inv_GiveCancel(giver, expired ? "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;." : "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return 1;
	}
	new itemId = gPlayer[giver][pInvGiveItem], qty = gPlayer[giver][pInvGiveQty];
	if (GetTickCount() - start > 15000)
	{
