new g_UiBkStKind[MAX_PLAYERS][15][24];
new g_UiBkStOther[MAX_PLAYERS][15][25];
new g_UiBkStAmount[MAX_PLAYERS][15];
new g_UiBkStBalance[MAX_PLAYERS][15];
