public Inv_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < 40; i++)
	{
		if (g_InvGround[i][igState] != 2 || g_InvGround[i][igPicker] != 0)
		{
			continue;
		}
		if (now - g_InvGround[i][igExpireTick] >= 0)
		{
			Inv_GroundFree(i);
		}
	}
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (!IsPlayerConnected(p) || gPlayer[p][pInvGiveTo] == 0 || gPlayer[p][pInvOp] == 2)
		{
			continue;
		}
		if (now - gPlayer[p][pInvGiveStartTick] >= 15000)
		{
			Inv_GiveCancel(p, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;.");
		}
	}
	return 1;
}

Inv_OnInit()
{
	for (new i = 0; i < 40; i++)
	{
		g_InvGround[i][igObject] = 65535;
		g_InvGround[i][igState] = 0;
	}
	g_InvTickTimer = SetTimer("Inv_OnTick", 1000, true);
}

Inv_OnExit()
{
	if (g_InvTickTimer != 0)
	{
		KillTimer(g_InvTickTimer);
	}
	g_InvTickTimer = 0;
	for (new i = 0; i < 40; i++)
	{
		Inv_GroundFree(i);
	}
}

Inv_OnPlayerSpawn(playerid)
{
	if (!Inv_ValidPlayer(playerid) || !gPlayer[playerid][pLoggedIn] || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pInvState] == 0 || gPlayer[playerid][pInvState] == 3)
	{
		Inv_Load(playerid);
	}
	return 0;
}

Inv_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (gPlayer[playerid][pInvGiveTo] != 0 && gPlayer[playerid][pInvOp] != 2)
	{
		Inv_GiveCancel(playerid, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
	}
	else if (gPlayer[playerid][pInvGiveTo] != 0)
	{
		gPlayer[playerid][pInvGiveTo] = 0;
	}
	if (gPlayer[playerid][pInvGiveFrom] != 0)
	{
		new giver = gPlayer[playerid][pInvGiveFrom] - 1;
		gPlayer[playerid][pInvGiveFrom] = 0;
		if (Inv_ValidPlayer(giver) && gPlayer[giver][pInvGiveTo] == playerid + 1 && gPlayer[giver][pInvOp] != 2)
		{
			Inv_GiveCancel(giver, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
		}
	}
	if (gPlayer[playerid][pInvOpBusy] && gPlayer[playerid][pInvOp] == 7)
	{
		House_InvFridgeAbort(gPlayer[playerid][pInvOpAux]);
	}
	if (gPlayer[playerid][pFridgeHouse] > 0)
	{
		House_InvFridgeAbort(gPlayer[playerid][pFridgeHouse]);
	}
	Inv_GroundRelease(playerid);
	return 0;
}

// ===== modules/bank/bank.inc =====
new Float:s_BankPoints[9][3] = {
	{1462.0, -1010.5, 26.8},
	{1480.5, -1722.0, 13.5},
	{1495.0, -1745.0, 13.5},
	{1731.0, -1870.0, 13.6},
	{1829.0, -1845.0, 13.6},
	{1960.0, -1205.0, 25.1},
	{1190.0, -1335.0, 13.6},
	{365.0, -2040.0, 7.7},
	{2490.0, -1680.0, 13.5}
};
new g_BankPickup[9];
new Text3D:g_BankLabel[9];

bool:Bank_Valid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid);
}

Bank_Tick()
{
	new now = GetTickCount();
	return now != 0 ? now : 1;
}

bool:Bank_IsCounter(point)
{
	return point >= 0 && point < 2;
}

Bank_NearPoint(playerid, bool:counterOnly)
{
	if (!Bank_Valid(playerid))
	{
		return -1;
	}
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
		return -1;
	}
	new Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);
	new best = -1, Float:bestD;
	for (new i = 0; i < 9; i++)
	{
		if (counterOnly && !Bank_IsCounter(i))
		{
			continue;
		}
		new Float:radius = Float:((Bank_IsCounter(i) ? 2.5 : 2.0));
		new Float:dx = (px - s_BankPoints[i][0]), Float:dy = (py - s_BankPoints[i][1]), Float:dz = (pz - s_BankPoints[i][2]);
		new Float:d = floatsqroot(((dx * dx) + (dy * dy)));
		if ((d > radius) || (floatabs(dz) > 4.0))
		{
			continue;
		}
		if (best < 0 || (d < bestD))
		{
			best = i;
			bestD = d;
		}
	}
	return best;
}

bool:Bank_ParseAmount(const s[], &value)
{
	new i = 0, len = strlen(s), digits = 0;
	value = 0;
	while (i < len && s[i] == 32)
	{
		i++;
	}
	while (i < len && s[i] >= 48 && s[i] <= 57)
	{
		if (digits >= 9)
		{
			return false;
		}
		value = value * 10 + (s[i] - 48);
		digits++;
		i++;
	}
	while (i < len && s[i] == 32)
	{
		i++;
	}
	return digits > 0 && i == len && value >= 1;
}

Bank_FindPlayer(const input[])
{
	new text[75], len = strlen(input), start = 0, end = len;
	while (start < len && input[start] == 32)
	{
		start++;
	}
	while (end > start && input[end - 1] == 32)
	{
		end--;
	}
	if (end <= start || end - start > 24)
	{
		return -1;
	}
	strmid(text, input, start, end, 75);
	new bool:numeric = true;
	for (new i = 0; text[i] != 0; i++)
	{
		if (text[i] < 48 || text[i] > 57)
		{
			numeric = false;
			break;
		}
	}
	if (numeric)
	{
		new id = strval(text);
		return id >= 0 && id < 1000 && Util_IsPlaying(id) ? id : -1;
	}
	new found = -1, name[75];
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (!Util_IsPlaying(p))
		{
			continue;
		}
		GetPlayerName(p, name, 75);
		if (!strcmp(name, text, true, 0x7FFFFFFF))
		{
			return p;
		}
		if (strfind(name, text, true, 0) != -1)
		{
			if (found != -1)
			{
				return -2;
			}
			found = p;
		}
	}
	return found;
}

bool:Bank_SameIp(a, b)
{
	if (gPlayer[a][pAccountId] == gPlayer[b][pAccountId])
	{
		return false;
	}
	new ipA[48], ipB[48];
	GetPlayerIp(a, ipA, 48);
	GetPlayerIp(b, ipB, 48);
	return ipA[0] != 0 && !strcmp(ipA, ipB, false, 0x7FFFFFFF);
}

Bank_LocalOffset()
{
	new h = 0, m = 0, s = 0, now = gettime(h, m, s);
	new off = h * 3600 + m * 60 + s - now % 86400;
	if (off > 43200)
	{
		off -= 86400;
	}
	else if (off < -43200)
	{
		off += 86400;
	}
	return off;
}

Bank_FormatWhen(ts, dest[], size)
{
	if (ts <= 0)
	{
		format(dest, size, "--/-- --:--");
		return 0;
	}
	new local = ts + Bank_LocalOffset();
	if (local < 0)
	{
		local = 0;
	}
	new days = local / 86400, secs = local % 86400;
	new z = days + 719468, era = z / 146097, doe = z - era * 146097;
	new yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
	new doy = doe - (yoe * 365 + yoe / 4 - yoe / 100), mp = (doy * 5 + 2) / 153;
	new day = doy - (mp * 153 + 2) / 5 + 1, month = mp < 10 ? mp + 3 : mp - 9;
	format(dest, size, "%02d/%02d %02d:%02d", day, month, secs / 3600, secs % 3600 / 60);
	return 0;
}

Bank_KindLabel(const kind[], dest[], size)
{
	if (!strcmp(kind, "deposit", false, 0x7FFFFFFF))
	{
		strcopy(dest, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;", size);
	}
	else if (!strcmp(kind, "withdraw", false, 0x7FFFFFFF))
	{
