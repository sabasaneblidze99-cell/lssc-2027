UI_JbMoney(value, out[], size)
{
	new raw[48], len = 0, pos = 0;
	if (value < 0)
	{
		value = 0;
	}
	format(raw, 48, "%d", value);
	len = strlen(raw);
	out[0] = 0;
	for (new i = 0; i < len && pos < size - 2; i++)
	{
		if (i > 0 && (len - i) % 3 == 0)
		{
			out[pos++] = 46;
		}
		out[pos++] = raw[i];
	}
	out[pos] = 0;
}

UI_JbValid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

UI_JbRunPay(job)
{
	if (job < 1 || job > 3)
	{
		return 0;
	}
	return g_UiJbSteps[job] * g_UiJbPayStep[job] + g_UiJbPayBonus[job];
}

UI_JbHourly(job)
{
	if (job < 1 || job > 3)
	{
		return 0;
	}
	new hourly = UI_JbRunPay(job) * 60 / g_UiJbEstMinutes[job];
	if (hourly > 2200)
	{
		hourly = 2200;
	}
	return hourly;
}

UI_JobCenterShow(playerid, level, currentJob, cooldownSec)
{
	if (!UI_JbValid(playerid))
	{
		return 0;
	}
	if (currentJob < 0 || currentJob > 3)
	{
		currentJob = 0;
	}
	g_UiJbLevel[playerid] = level;
	g_UiJbCurrent[playerid] = currentJob;
	g_UiJbCooldown[playerid] = cooldownSec > 0 ? cooldownSec : 0;
	new body[2048], line[576], pay[48];
	strcat(body, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;\t\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;. \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;\t\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;. \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;/\xE1;\x83;\xA1;\xE1;\x83;\x97;\t\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\n", 2048);
	for (new job = 1; job <= 3; job++)
	{
		UI_JbMoney(UI_JbHourly(job), pay, 48);
		if (level < g_UiJbMinLevel[job])
		{
			format(line, 576, "{888888}%s\t{FF6666}\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d (\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;)\t{888888}~$%s\t{888888}%s\n", g_UiJbName[job], g_UiJbMinLevel[job], pay, g_UiJbVehicle[job]);
		}
		else if (job == currentJob)
		{
			format(line, 576, "{FFD24D}%s (\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;)\t{FFFFFF}\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d\t{66DD66}~$%s\t{FFFFFF}%s\n", g_UiJbName[job], g_UiJbMinLevel[job], pay, g_UiJbVehicle[job]);
		}
		else
		{
