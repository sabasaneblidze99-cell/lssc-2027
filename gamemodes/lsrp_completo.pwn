		case 9:
		{
			SendClientMessage(playerid, -1, "\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;: \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90; %d.", gPlayer[playerid][pCharId] + 555000);
