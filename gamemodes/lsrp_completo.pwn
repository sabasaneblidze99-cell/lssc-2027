House_CmdCasa(playerid, const params[])
{
	if (!House_CmdGuard(playerid, false))
	{
		return 0;
	}
	new pos = 0, sub[96], arg[96];
	Util_NextToken(params, pos, sub, 96);
	new idx = House_Context(playerid);
	if (idx == -1)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;.");
		return 0;
	}
	if (g_HPl[playerid][hpPendingOp] != 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return 0;
	}
	if (sub[0] == 0)
	{
		House_OpenMenu(playerid, idx);
		return 0;
	}
	if (!strcmp(sub, "info", true, 0x7FFFFFFF))
	{
		House_Info(playerid, idx);
		return 0;
	}
