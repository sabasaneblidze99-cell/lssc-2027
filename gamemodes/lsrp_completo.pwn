		return -1;
	}
	if (counterOnly && !Bank_IsCounter(point))
	{
		Bank_Deny(playerid, ui, "\xE1;\x83;\x94;\xE1;\x83;\xA1; ATM-\xE1;\x83;\x98;\xE1;\x83;\x90;: /banca-\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;.");
		return -1;
	}
	gPlayer[playerid][pBankAtCounter] = Bank_IsCounter(point) ? 1 : 0;
	return point;
}

Bank_Guard(playerid, bool:ui, bool:counterOnly)
{
	new point = Bank_StateGuard(playerid, ui, counterOnly);
	if (point < 0)
	{
		return -1;
	}
	new now = Bank_Tick();
	if (gPlayer[playerid][pBankOpBusy] != 0)
	{
		new op = gPlayer[playerid][pBankOp];
		if ((op == 4 || op == 5) && now - gPlayer[playerid][pBankOpTick] >= 15000)
		{
			Bank_EndOp(playerid);
		}
		else
		{
			Bank_Reply(playerid, ui, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
			return -1;
		}
	}
	if (gPlayer[playerid][pBankPendTarget] != 0)
	{
		if (now - gPlayer[playerid][pBankPendTick] >= 35000)
		{
			Bank_ClearPending(playerid, true);
		}
		else
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
			return -1;
		}
	}
	if (gPlayer[playerid][pBankLastOpTick] != 0 && now - gPlayer[playerid][pBankLastOpTick] < 2000)
	{
		Bank_Reply(playerid, ui, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;, \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9A; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x91;.");
		return -1;
	}
	gPlayer[playerid][pBankLastOpTick] = now;
	return point;
}

Bank_PushUi(playerid)
{
	new bool:counter = gPlayer[playerid][pBankAtCounter] != 0;
	new wdMax = counter ? 50000 : 5000;
	new wdDay = counter ? 100000 : 15000;
	new wdLeft = -1, sendLeft = -1;
	if (gPlayer[playerid][pBankLimitsLoaded])
	{
		wdLeft = gPlayer[playerid][pBankWithdrawnToday] >= wdDay ? 0 : wdDay - gPlayer[playerid][pBankWithdrawnToday];
		sendLeft = gPlayer[playerid][pBankXferOutToday] >= 50000 ? 0 : 50000 - gPlayer[playerid][pBankXferOutToday];
	}
	UI_BankSetBalance(playerid, gPlayer[playerid][pMoney], gPlayer[playerid][pBank]);
	UI_BankSetLimits(playerid, counter ? 0 : 20000, wdMax, wdLeft, 10, 25000, sendLeft);
}

Bank_RefreshLimits(playerid)
{
	if (!Bank_Valid(playerid) || gPlayer[playerid][pBankOpBusy] != 0 || gPlayer[playerid][pBankPendTarget] != 0 || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	Bank_BeginOp(playerid, 4, 0, gPlayer[playerid][pBankOpPoint]);
	gPlayer[playerid][pBankOpAux] = 0;
	DB_BankLimits(playerid, gPlayer[playerid][pCharId]);
	return 0;
}

Bank_CmdSaldo(playerid)
{
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x98; ---");
	SendClientMessage(playerid, -1, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98;: $%d  \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;: $%d  \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9A;: $%d", gPlayer[playerid][pMoney], gPlayer[playerid][pBank], gPlayer[playerid][pMoney] + gPlayer[playerid][pBank]);
}

Bank_CmdAtm(playerid, bool:counterOnly)
{
	new point = Bank_Guard(playerid, false, counterOnly);
	if (point < 0)
	{
		return 0;
	}
	Bank_PushUi(playerid);
	UI_BankMenu(playerid, Bank_IsCounter(point));
	Bank_RefreshLimits(playerid);
	return 0;
}

public UI_OnBankBalanceRefresh(playerid)
{
	if (!Bank_Valid(playerid))
	{
		return 1;
	}
	Bank_PushUi(playerid);
	Bank_RefreshLimits(playerid);
	return 1;
}

Bank_Deposit(playerid, amount, bool:ui)
{
	new point = Bank_Guard(playerid, ui, false);
	if (point < 0)
	{
		return 0;
	}
	if (amount < 1)
	{
		Bank_Reply(playerid, ui, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90;.");
		return 0;
	}
	if (amount > gPlayer[playerid][pMoney])
	{
		Bank_Reply(playerid, ui, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return 0;
	}
	if (!Bank_IsCounter(point) && amount > 20000)
	{
		new msg[528];
		format(msg, 528, "ATM-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94;: $%d \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94;. \xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;.", 20000);
		Bank_Reply(playerid, ui, msg);
		return 0;
	}
	if (amount > Money_BankRoom(playerid))
	{
		Bank_Reply(playerid, ui, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		return 0;
	}
	Bank_BeginWrite(playerid, 1, amount, point);
	gPlayer[playerid][pBankOpAux] = ui ? 1 : 0;
	DB_BankDeposit(playerid, gPlayer[playerid][pCharId], amount, Bank_IsCounter(point) ? 1 : 0, gPlayer[playerid][pBankOpId]);
	return 0;
}

public UI_OnBankDeposit(playerid, amount)
{
	if (Bank_Valid(playerid))
	{
		Bank_Deposit(playerid, amount, true);
	}
	return 1;
}

