		strcopy(prosp, "{FFFFFF}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;", 96);
