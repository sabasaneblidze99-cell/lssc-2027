	{
		StreetRental_OnStateChange(playerid, PLAYER_STATE_DRIVER);   // auto di strada non ancora noleggiata: offerta
		return 0;
	}
	new bool:mine = (gPlayer[playerid][pRentalVehicle] != 0 && gPlayer[playerid][pRentalVehicle] == veh)
		|| LD_VehOwner(veh) == playerid
		|| AzWorld_CanDrive(playerid, veh) == 1
		|| Job_VehicleOwner(veh) == playerid;
	if (!mine)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return 0;
	}
	new e, l, a, d, b, bt, o;
	GetVehicleParamsEx(veh, e, l, a, d, b, bt, o);
	SetVehicleParamsEx(veh, e == 1 ? 0 : 1, l, a, d, b, bt, o);
	Veh_Emote(playerid, e == 1 ? "\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1;." : "\xE1;\x83;\xA5;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
