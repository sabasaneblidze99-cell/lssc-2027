		return 0;
	}
	new Float:hp;
	GetPlayerHealth(playerid, hp);
	switch (itemId)
	{
		case 2 .. 4:
		{
			new hunger = House_InvHunger(playerid);
			if (hunger < 0)
			{
				Inv_Say(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x90;: \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98;.");
				return 0;
