public DB_LivingQueryError(const callback[])
{
	if (!strcmp(callback, "DB_OnLdDistricts", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnLdTicked", false, 0x7FFFFFFF))
	{
		if (funcidx("Living_OnDBDistricts") != -1)
		{
			CallLocalFunction("Living_OnDBDistricts", "dd", -1, 0);
		}
		return 1;
	}
	if (!strcmp(callback, "DB_OnLdBoot", false, 0x7FFFFFFF))
	{
		if (funcidx("Living_OnDBBoot") != -1)
		{
			CallLocalFunction("Living_OnDBBoot", "d", -1);
		}
		return 1;
	}
	if (!strcmp(callback, "DB_OnLdGlobal", false, 13) || !strcmp(callback, "DB_OnLdFire", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnLdCleanup", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnLdUndo", false, 11))
	{
		Log_Write("DBLIVING", "errore query di sistema/compensazione living: verificare a mano");
		return 1;
	}
	if (!strcmp(callback, "DB_OnLdBoard", false, 0x7FFFFFFF))
	{
		if (funcidx("Living_OnDBBoard") != -1)
		{
			CallLocalFunction("Living_OnDBBoard", "ddd", 65535, -1, 0);
		}
	}
	new bool:info = !strcmp(callback, "DB_OnLdPlayer", false, 13) || !strcmp(callback, "DB_OnLdBoard", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnLdHist", false, 0x7FFFFFFF);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		for (new cat = 0; cat < 6; cat++)
		{
			if (!(g_LdPending[i] & 1 << cat))
			{
				continue;
			}
			if (info != (cat == 5))
			{
				continue;
			}
			g_LdPending[i] &= ~(1 << cat);
			if (!IsPlayerConnected(i))
			{
				continue;
			}
			new idx = DB_LdIdx(i, cat), action = g_LdReq[idx][lqAction];
			if (action == 5)
			{
				DB_LivingRentUndo(i, g_LdReq[idx][lqCharId], g_LdReq[idx][lqAux], g_LdReq[idx][lqOpId]);
			}
			DB_LdDeliver(i, action, -1, action == 15 ? g_LdReq[idx][lqAux] : g_LdReq[idx][lqRef], 0, 0, 0, 0, 0);
		}
	}
	return 1;
}

// ===== modules/account/account.inc =====
new g_AuthSeq;

Account_NextSeq(playerid)
{
	g_AuthSeq++;
	if (g_AuthSeq <= 0)
	{
		g_AuthSeq = 1;
	}
	gPlayer[playerid][pAuthSeq] = g_AuthSeq;
	return g_AuthSeq;
}

bool:Account_SeqValid(playerid, seq, phase)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return false;
	}
	return seq != 0 && gPlayer[playerid][pAuthSeq] == seq && gPlayer[playerid][pAuthState] == phase;
}
new g_AccPendingEmail[MAX_PLAYERS][255];

Account_Kick(playerid, const reason[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pAuthState] == 10)
	{
		return 0;
	}
	Util_Send(playerid, -10270721, reason);
	gPlayer[playerid][pAuthState] = 10;
	UI_CloseDialogs(playerid);
	gPlayer[playerid][pKickTimer] = SetTimerEx("Account_OnKickTimer", 750, false, "d", playerid);
	return 0;
}

public Account_OnKickTimer(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 1;
	}
	gPlayer[playerid][pKickTimer] = 0;
	Kick(playerid);
	return 1;
}

Account_ShowPrompt(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pClassRequested])
	{
		return 0;
	}
	if (!CefUI_AuthGate(playerid))
	{
		return 0;
	}
	switch (gPlayer[playerid][pAuthState])
	{
		case 1:
		{
			UI_ShowRegister(playerid);
		}
		case 3:
		{
			UI_ShowLogin(playerid, gPlayer[playerid][pLoginAttempts] > 0);
		}
		case 5:
		{
			UI_ShowGenderSelect(playerid);
		}
		case 6:
		{
			UI_ShowSkinSelect(playerid, gPlayer[playerid][pGender]);
		}
	}
	return 0;
}

Account_OnConnect(playerid)
{
	g_DBPending[playerid] = 0;
	gPlayer[playerid][pAuthState] = 0;
	gPlayer[playerid][pLastReportTick] = GetTickCount() - 30000;
	gPlayer[playerid][pLastGiveMoneyTick] = GetTickCount() - 10000;
	new name[75];
	GetPlayerName(playerid, name, 75);
	if (1 && !Util_IsValidRPName(name))
	{
		Account_Kick(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;_\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; (\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x92;. Giorgi_Beridze).");
		return 0;
	}
	if (!DB_IsReady())
	{
		Log_Write("ACCOUNT", "connessione rifiutata: database non disponibile");
		Account_Kick(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 0;
	}
	new ip[48];
	GetPlayerIp(playerid, ip, 48);
	gPlayer[playerid][pAuthState] = 11;
	DB_CheckBan(playerid, name, ip);
	return 0;
}

Account_ContinueConnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pAuthState] != 11)
	{
		return 0;
	}
	gPlayer[playerid][pAuthState] = 0;
	DB_LoadAccount(playerid);
	return 0;
}

Account_OnDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_AccPendingEmail[playerid][0] = 0;
	if (gPlayer[playerid][pKickTimer] != 0)
	{
		KillTimer(gPlayer[playerid][pKickTimer]);
	}
	g_DBPending[playerid] = 0;
	return 0;
}

public Account_OnDBLoaded(playerid, accountId, const hash[], const salt[], adminLevel)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 0)
	{
		return 1;
	}
	if (accountId <= 0)
	{
		if (accountId == -1 || !DB_IsReady())
		{
			Account_Kick(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
			return 1;
		}
		gPlayer[playerid][pAuthState] = 1;
	}
	else
	{
		strmid(gPlayer[playerid][pPassHash], hash, 0, 64, 65);
		strmid(gPlayer[playerid][pPassSalt], salt, 0, 16, 17);
		gPlayer[playerid][pAccountId] = accountId;
		gPlayer[playerid][pAdminLevel] = clamp(adminLevel, 0, 3);
		gPlayer[playerid][pHashAlgo] = DB_GetHashAlgo(playerid);
		gPlayer[playerid][pMutedUntil] = DB_GetMutedUntil(playerid);
		gPlayer[playerid][pLoginAttempts] = 0;
		new locked = DB_GetLockedUntil(playerid) - gettime();
		if (locked > 0)
		{
			new msg[1024];
			format(msg, 1024, "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; %d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", (locked + 59) / 60);
			Account_Kick(playerid, msg);
			return 1;
		}
		gPlayer[playerid][pAuthState] = 3;
	}
	Account_ShowPrompt(playerid);
	return 1;
}

Account_CompleteLogin(playerid, accountId, adminLevel)
{
	new name[75], ip[48], msg[384];
	GetPlayerName(playerid, name, 75);
	GetPlayerIp(playerid, ip, 48);
	gPlayer[playerid][pAccountId] = accountId;
	gPlayer[playerid][pAdminLevel] = adminLevel;
	gPlayer[playerid][pLoggedIn] = 1;
	gPlayer[playerid][pLoginAttempts] = 0;
	gPlayer[playerid][pPassHash][0] = 0;
	gPlayer[playerid][pPassSalt][0] = 0;
	gPlayer[playerid][pAuthState] = 4;
	DB_UpdateLogin(accountId, ip);
	format(msg, 384, "login account %d (%s)", accountId, name);
	Log_Write("ACCOUNT", msg);
	Util_Send(playerid, 0x66DD66FF, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
	CharSel_Begin(playerid);       // M15: selezione dei 3 personaggi (character/char_select.inc)
}

Account_SetPendingEmail(playerid, const email[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_AccPendingEmail[playerid][0] = 0;
	if (email[0] != 0 && Valid_Email(email))
	{
		strcopy(g_AccPendingEmail[playerid], email, 255);
	}
	return 0;
}

public UI_OnRegisterSubmit(playerid, const password[])
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 1)
	{
		return 1;
	}
	if (!Valid_PasswordLength(password))
	{
		new err[1024];
		format(err, 1024, "\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA1; %d-\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; %d-\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x91;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;.", 6, 32);
		Util_Send(playerid, -10270721, err);
		UI_ShowRegister(playerid);
		return 1;
	}
	gPlayer[playerid][pAuthState] = 12;
	bcrypt_hash(playerid, "Account_OnRegisterHashed", password, 11, "d", Account_NextSeq(playerid));
	return 1;
}

public Account_OnRegisterHashed(playerid, seq)
{
	if (!Account_SeqValid(playerid, seq, 12))
	{
		return 1;
	}
	gPlayer[playerid][pAuthSeq] = 0;
	new hash[183];
	bcrypt_get_hash(hash, 183);
	if (strlen(hash) != 60)
	{
		Log_Write("ACCOUNT", "registrazione fallita: hash bcrypt non valido");
		Account_Kick(playerid, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	gPlayer[playerid][pAuthState] = 2;
	DB_CreateAccountEx(playerid, hash, "", 1);
	return 1;
}

public Account_OnDBCreated(playerid, accountId)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 2)
	{
		return 1;
	}
	if (accountId <= 0)
	{
		Log_Write("ACCOUNT", "registrazione fallita");
		Account_Kick(playerid, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	Util_Send(playerid, 0x66DD66FF, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
	Account_CompleteLogin(playerid, accountId, 0);
	if (g_AccPendingEmail[playerid][0] != 0)
	{
		DB_AccountSetEmail(playerid, accountId, g_AccPendingEmail[playerid]);
		g_AccPendingEmail[playerid][0] = 0;
	}
	return 1;
}

Account_LoginFailed(playerid)
{
	gPlayer[playerid][pAuthState] = 3;
	gPlayer[playerid][pAuthSeq] = 0;
	gPlayer[playerid][pLoginAttempts]++;
	new name[75], msg[384];
	GetPlayerName(playerid, name, 75);
	format(msg, 384, "login fallito %s (tentativo %d/%d)", name, gPlayer[playerid][pLoginAttempts], 3);
	Log_Write("ACCOUNT", msg);
	DB_AccountLoginFailed(gPlayer[playerid][pAccountId]);
	if (gPlayer[playerid][pLoginAttempts] >= 3)
	{
		Account_Kick(playerid, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		return 0;
	}
	new err[1024];
	format(err, 1024, "\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: %d.", 3 - gPlayer[playerid][pLoginAttempts]);
	Util_Send(playerid, -10270721, err);
	UI_ShowLogin(playerid, true);
	return 0;
}

public UI_OnLoginSubmit(playerid, const password[])
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != 3)
	{
		return 1;
	}
	if (!Valid_PasswordLength(password))
	{
		Account_LoginFailed(playerid);
		return 1;
	}
	if (gPlayer[playerid][pHashAlgo] == 1)
	{
		gPlayer[playerid][pAuthState] = 13;
		bcrypt_verify(playerid, "Account_OnLoginVerified", password, gPlayer[playerid][pPassHash], "dd", Account_NextSeq(playerid), gPlayer[playerid][pAccountId]);
		return 1;
	}
	new hash[195];
	SHA256_Hash(password, gPlayer[playerid][pPassSalt], hash, 195);
	if (strcmp(hash, gPlayer[playerid][pPassHash], true, 0x7FFFFFFF) != 0)
	{
		Account_LoginFailed(playerid);
		return 1;
	}
	gPlayer[playerid][pAuthState] = 12;
	bcrypt_hash(playerid, "Account_OnMigrateHashed", password, 11, "dd", Account_NextSeq(playerid), gPlayer[playerid][pAccountId]);
	return 1;
}

public Account_OnLoginVerified(playerid, bool:success, seq, accountId)
{
	if (!Account_SeqValid(playerid, seq, 13) || gPlayer[playerid][pAccountId] != accountId)
	{
		return 1;
	}
	if (!success)
	{
		Account_LoginFailed(playerid);
		return 1;
	}
	gPlayer[playerid][pAuthSeq] = 0;
	Account_CompleteLogin(playerid, accountId, gPlayer[playerid][pAdminLevel]);
	return 1;
}

public Account_OnMigrateHashed(playerid, seq, accountId)
{
	if (!Account_SeqValid(playerid, seq, 12) || gPlayer[playerid][pAccountId] != accountId)
	{
		return 1;
	}
	gPlayer[playerid][pAuthSeq] = 0;
	new hash[183];
	bcrypt_get_hash(hash, 183);
	if (strlen(hash) == 60)
	{
		DB_UpdatePasswordHash(accountId, hash, 1);
		Log_Write("ACCOUNT", "password migrata a bcrypt");
	}
	else
	{
		Log_Write("ACCOUNT", "migrazione bcrypt fallita: resta l'hash legacy");
	}
	Account_CompleteLogin(playerid, accountId, gPlayer[playerid][pAdminLevel]);
	return 1;
}

public UI_OnDialogCancel(playerid, dialogid)
{
	if (!IsPlayerConnected(playerid))
	{
		return 1;
	}
	switch (gPlayer[playerid][pAuthState])
	{
		case 1, 3:
		{
			Account_Kick(playerid, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		}
		case 5:
		{
			UI_ShowGenderSelect(playerid);
		}
		case 6:
		{
			gPlayer[playerid][pAuthState] = 5;
			UI_ShowGenderSelect(playerid);
		}
	}
	return 1;
}

