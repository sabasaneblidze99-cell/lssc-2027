	{
		new msg[528];
		format(msg, 528, "%s \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94;: $%d \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94;.%s", counter ? "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\xA1;" : "ATM-\xE1;\x83;\x98;\xE1;\x83;\xA1;", maxOp, counter ? "" : " \xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;.");
		Bank_Reply(playerid, ui, msg);
		return 0;
	}
	if (amount > 0x3B9ACA00 - gPlayer[playerid][pMoney])
	{
		Bank_Reply(playerid, ui, "\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;: \xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
