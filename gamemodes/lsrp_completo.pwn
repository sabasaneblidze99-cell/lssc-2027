	if (mode < 2 || mode > 6 || mode == 3)
	{
		mode = 2;
	}
	if (mode != 2 && ownRank < 5)
	{
		SendClientMessage(playerid, -10066177, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x9D; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return 0;
	}
	g_UiFcFaction[playerid] = faction;
	g_UiFcRank[playerid] = ownRank;
	g_UiFcMode[playerid] = mode;
	UI_FcMembersPage(playerid, 0);
	return 0;
}

