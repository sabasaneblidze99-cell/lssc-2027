public OnCefBrowserCreated(player_id, browser_id, status_code)
{
	if (status_code != 200)
	{
		new msg[96];
		format(msg, 96, "browser %d del giocatore %d non creato (codice %d)", browser_id, player_id, status_code);
		Log_Write("CEF", msg);
	}
	return 1;
}

