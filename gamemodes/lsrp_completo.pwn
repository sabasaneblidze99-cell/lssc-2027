		strcat(body, line, 2560);
	}
	strcat(body, "\n{AAAAAA}\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x98;\xE1;\x83;\x96;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;, \xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;-\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;.", 2560);
	Lang_ShowPlayerDialog(playerid, 9708, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;", body, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;", "");
	return 0;
}

UI_LivingRentalBegin(playerid, blockMinutes, maxBlocks, discountPct)
{
	if (!UI_LvValid(playerid))
	{
		return 0;
	}
	g_UiLvRnBlockMin[playerid] = blockMinutes < 1 ? 1 : blockMinutes;
	g_UiLvRnMaxBlocks[playerid] = UI_LvClamp(maxBlocks, 1, 6);
	g_UiLvRnDisc[playerid] = UI_LvClamp(discountPct, 0, 100);
	g_UiLvRnCount[playerid] = 0;
	g_UiLvRnSel[playerid] = -1;
	g_UiLvRnBlocks[playerid] = 0;
	return 0;
}

UI_LivingRentalAddModel(playerid, modelIdx, const name[], feePerBlock, deposit, minLevel, bool:available)
{
	if (!UI_LvValid(playerid))
	{
		return 0;
	}
	new n = g_UiLvRnCount[playerid];
	if (n < 0 || n >= 4)
	{
		return 0;
	}
	g_UiLvRnIdx[playerid][n] = modelIdx;
	strcopy(g_UiLvRnName[playerid][n], name, 32);
	g_UiLvRnFee[playerid][n] = feePerBlock < 0 ? 0 : feePerBlock;
	g_UiLvRnDep[playerid][n] = deposit < 0 ? 0 : deposit;
	g_UiLvRnLevel[playerid][n] = minLevel;
	g_UiLvRnAvail[playerid][n] = available;
	g_UiLvRnCount[playerid] = n + 1;
	return 0;
}

UI_LvRentModelShow(playerid)
{
	new body[2048], line[384], title[576], sFee[48], sDep[48];
	format(body, 2048, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\t\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90; / %d \xE1;\x83;\xAC;\xE1;\x83;\x97;\t\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\t\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;\n", g_UiLvRnBlockMin[playerid]);
	for (new i = 0; i < g_UiLvRnCount[playerid]; i++)
	{
		new bool:ok = g_UiLvRnAvail[playerid][i];
		UI_LvFmt(g_UiLvRnFee[playerid][i], sFee, 48);
		UI_LvFmt(g_UiLvRnDep[playerid][i], sDep, 48);
		format(line, 384, "%s%s\t%s$%s\t%s$%s\t%s%d\n", ok ? "{FFFFFF}" : "{888888}", g_UiLvRnName[playerid][i], ok ? "{66DD66}" : "{888888}", sFee, ok ? "{FFD24D}" : "{888888}", sDep, ok ? "{AAAAAA}" : "{888888}", g_UiLvRnLevel[playerid][i]);
		strcat(body, line, 2048);
	}
	if (g_UiLvRnDisc[playerid] > 0)
	{
		format(title, 576, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; - \xE1;\x83;\x9B;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; %d%%", g_UiLvRnDisc[playerid]);
	}
