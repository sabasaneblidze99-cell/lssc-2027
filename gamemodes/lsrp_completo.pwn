		}
	}
	return 1;
}

Hub_RequestRefresh(bool:force)
{
	if (!DB_IsReady())
	{
		return 0;
	}
	new now = GetTickCount();
	if (!force && g_HubRefreshed && now - g_HubLastRefresh < 60000)
	{
		return 0;
	}
	g_HubRefreshed = true;
	g_HubLastRefresh = now;
	DB_LivingLoadDistricts();
	return 0;
}

Hub_Broadcast(color, const text[])
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i))
		{
			Util_Send(i, color, text);
		}
	}
}

Hub_CheckFestivals()
{
	new msg[768], dname[48], opId[111];
	for (new d = 1; d <= 3; d++)
	{
		if (DB_LivingDistrictGet(d, E_LD_DISTRICT:0) == 0)
		{
			continue;
		}
		new fest = DB_LivingDistrictGet(d, E_LD_DISTRICT:4), prj = DB_LivingDistrictGet(d, E_LD_DISTRICT:6);
		if (!g_HubFestInit[d])
		{
			g_HubFestInit[d] = true;
			g_HubFestSeen[d] = fest;
			g_HubPrjSeen[d] = prj;
			g_HubGoalSeen[d] = DB_LivingDistrictGet(d, E_LD_DISTRICT:7);
			DB_LivingProjectName(d, g_HubPrjNameSeen[d], 65);
			continue;
		}
		if (fest == g_HubFestSeen[d] && prj == g_HubPrjSeen[d])
		{
			continue;
		}
		LD_DistrictName(d, dname, 48);
		if (fest > g_HubFestSeen[d] && g_HubPrjSeen[d] > 0)
		{
			format(msg, 768, "%s-\xE1;\x83;\x9B; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x9D;: \"%s\" \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;, \xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xAA; \xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;. \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98; %d \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;!", dname, g_HubPrjNameSeen[d], 72);
			Hub_Broadcast(0x66DD66FF, msg);
			format(opId, 111, "pj%d-done", g_HubPrjSeen[d]);
			LD_Emit(8, d, 0, g_HubGoalSeen[d], opId);
		}
		else if (prj > 0 && prj != g_HubPrjSeen[d])
		{
			new name[195];
			DB_LivingProjectName(d, name, 195);
			format(msg, 768, "%s-\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;: \"%s\". \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\xAE;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", dname, name);
			Hub_Broadcast(0x99CCFFFF, msg);
		}
		g_HubFestSeen[d] = fest;
		g_HubPrjSeen[d] = prj;
		g_HubGoalSeen[d] = DB_LivingDistrictGet(d, E_LD_DISTRICT:7);
		DB_LivingProjectName(d, g_HubPrjNameSeen[d], 65);
	}
}

public Hub_OnDistrictEvent(type, districtId, charId, value, const opId[])
{
	switch (type)
	{
		case 106:
		{
			if (value != 2 && value != 4 && value != 5)
			{
				return 1;
			}
			new playerid = Hub_PlayerByChar(charId);
			if (playerid != INVALID_PLAYER_ID)
			{
				Hub_Advance(playerid, value);
			}
		}
		case 108:
		{
			new playerid = Hub_PlayerByChar(charId);
			if (playerid != INVALID_PLAYER_ID)
			{
				Hub_TryLoad(playerid);
			}
		}
		case 105:
		{
			Hub_CheckFestivals();
		}
	}
	return 1;
}

Hub_GreetBoard(playerid, board)
{
	if (g_HubGreeted[playerid] & Hub_Bit(board))
	{
		return 0;
	}
	g_HubGreeted[playerid] |= Hub_Bit(board);
	if (board == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90; (/contratti), \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; (/contribuisci), \xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; (/quartiere).");
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x90;\xE1;\x83;\xA5; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9C;, \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\xAE;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;, \xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;. \xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98;: /aiuto servizi.");
		return 0;
	}
	new msg[768], dname[48];
	LD_DistrictName(s_HubBoardDistrict[board], dname, 48);
	format(msg, 768, "%s-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\xA5; \xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; (/contratti) \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x96;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\xA1; (/contribuisci).", dname);
	Util_Send(playerid, 0x99CCFFFF, msg);
	return 0;
}

Hub_PlayerTick(playerid, now)
{
	if (g_HubOnb[playerid] == 0)
	{
		Hub_TryLoad(playerid);
	}
	new board = Hub_NearBoard(playerid);
	if (board + 1 != g_HubAtBoard[playerid])
	{
		g_HubAtBoard[playerid] = board + 1;
		if (board != -1)
		{
			Hub_GreetBoard(playerid, board);
			if (g_HubOnb[playerid] == 1 && Hub_CurStep(playerid) == 3 && gPlayer[playerid][pFreightWelcome] == 0)
			{
				Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /aiuto consegna.");
			}
		}
	}
	if (g_HubTarget[playerid] != 0)
	{
		if (g_HubCpOn[playerid] && LD_ActiveFlow(playerid) != 0)
		{
			g_HubCpOn[playerid] = false;
		}
		new Float:x, Float:y, Float:z;
		if (Hub_TargetPos(g_HubTarget[playerid], x, y, z) && IsPlayerInRangeOfPoint(playerid, 6.0, x, y, z))
		{
			new target = g_HubTarget[playerid];
			Hub_ClearTarget(playerid);
			if (target == 2)
			{
				Util_Send(playerid, 0x99CCFFFF, "Job Center-\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;: \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;, \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x98;: /lavoro.");
			}
			else if (target == 3)
			{
				Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;: \xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93; /noleggio.");
			}
		}
	}
	if (g_HubOnb[playerid] == 1)
	{
		new cur = Hub_CurStep(playerid);
		if (g_HubOpBusy[playerid])
		{
			if (g_HubOpRetryAt[playerid] != 0 && now - g_HubOpRetryAt[playerid] >= 0)
			{
				Hub_SendStep(playerid, g_HubOpStep[playerid], false);
			}
		}
		else if (cur == 1 && board == 0)
		{
			Hub_Advance(playerid, 1);
		}
		else if (g_HubAhead[playerid] & Hub_Bit(cur))
		{
			Hub_Advance(playerid, cur);
		}
		if (Hub_HintsOn(playerid) && g_HubHintDue[playerid] != 0 && now - g_HubHintDue[playerid] >= 0 && !g_HubOpBusy[playerid])
		{
			new last = gPlayer[playerid][pLastHintTick];
			if (g_HubHintShown[playerid] & Hub_Bit(cur))
			{
				g_HubHintDue[playerid] = 0;
			}
			else if (last == 0 || now - last >= 90000)
			{
				UI_LivingHint(playerid, cur);
				gPlayer[playerid][pLastHintTick] = now != 0 ? now : 1;
				g_HubHintShown[playerid] |= Hub_Bit(cur);
				g_HubHintDue[playerid] = 0;
			}
		}
	}
	Hub_KitTick(playerid, now);
}

public Hub_OnTick()
{
	if (!LD_IsReady())
	{
		return 1;
	}
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!Util_IsPlaying(i) || gPlayer[i][pLivingReady] == 0 || gPlayer[i][pCharId] <= 0)
		{
			continue;
		}
		Hub_PlayerTick(i, now);
	}
	if (++g_HubTickCount >= 5)
	{
		g_HubTickCount = 0;
		Hub_CheckFestivals();
	}
	return 1;
}

// ===== modules/cef/cef_bridge.inc =====
new g_CefNonce[MAX_PLAYERS];

CefBridge_OnInit()
{
#if defined LSRP_CEF
	cef_subscribe("lssc:ready", "Cef_OnReady");
	cef_subscribe("lssc:close", "Cef_OnClose");
	cef_subscribe("lssc:accept", "Cef_OnAccept");
	cef_subscribe("lssc:abandon", "Cef_OnAbandon");
	cef_subscribe("lssc:board_refresh", "Cef_OnBoardRefresh");
	cef_subscribe("lssc:district", "Cef_OnDistrict");
	cef_subscribe("lssc:project_open", "Cef_OnProjectOpen");
	cef_subscribe("lssc:contribute", "Cef_OnContribute");
	cef_subscribe("lssc:bank_req", "Cef_OnBankReq");
	cef_subscribe("lssc:rep_req", "Cef_OnRepReq");
	cef_subscribe("lssc:job_waypoint", "Cef_OnJobWaypoint");
	cef_subscribe("lssc:login", "Cef_OnLogin");
	cef_subscribe("lssc:register", "Cef_OnRegister");
	cef_subscribe("lssc:gender", "Cef_OnGender");
	cef_subscribe("lssc:skin", "Cef_OnSkin");
	cef_subscribe("lssc:story", "Cef_OnStory");
	cef_subscribe("lssc:quit", "Cef_OnQuit");
	cef_subscribe("lssc:chat_send", "Cef_OnChatSend");
	cef_subscribe("lssc:quick", "Cef_OnQuick");
	cef_subscribe("lssc:quick_close", "Cef_OnQuickClose");
	cef_subscribe("lssc:spawn_pick", "Cef_OnSpawnPick");
	cef_subscribe("lssc:char_pick", "Cef_OnCharPick");
	cef_subscribe("lssc:view_ok", "Cef_OnViewOk");
	cef_subscribe("lssc:char_create", "Cef_OnCharCreate");
	cef_subscribe("lssc:char_back", "Cef_OnCharBack");
	SetTimer("CefBridge_ClockTick", 30000, true);
	Log_Write("CEF", "interfaccia CEF attiva: pagine da <GTA>/cef/assets/index.html");
#endif
}

CefBridge_OnPlayerConnect(playerid)
{
	CefUI_Reset(playerid);
#if defined LSRP_CEF
	g_CefNonce[playerid]++;
	SetTimerEx("CefBridge_DecideTimeout", 9000, false, "dd", playerid, g_CefNonce[playerid]);
#endif
}

CefBridge_Decided(playerid)
{
	if (CefUI_Decide(playerid))
	{
		Account_ShowPrompt(playerid);
	}
}

public CefBridge_DecideTimeout(playerid, nonce)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || g_CefNonce[playerid] != nonce || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (!CefUI_IsDecided(playerid))
	{
		CefBridge_Decided(playerid);
	}
	return 1;
}

CefBridge_OnPlayerDisconnect(playerid)
{
	CefUI_Reset(playerid);
#if defined LSRP_CEF
}

CefBridge_OnInitialize(playerid, success)
{
	if (!IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!success)
	{
		if (CefUI_State(playerid) != 2)
		{
			CefUI_SetState(playerid, 0);
		}
		CefBridge_Decided(playerid);
		return 0;
	}
	CefUI_SetState(playerid, 1);
	cef_create_browser(playerid, 1, "index.html", false, false);
#endif
	return 0;
}

CefBridge_Arg(const arguments[], idx, def)
{
	new pos = 0, tok[48];
	for (new i = 0; i <= idx; i++)
	{
		tok[0] = 0;
		Util_NextToken(arguments, pos, tok, 48);
		if (tok[0] == 0)
		{
			return def;
		}
	}
	return strval(tok);
}

bool:CefBridge_Ok(playerid)
{
	return IsPlayerConnected(playerid) && CefUI_Active(playerid) && Util_IsPlaying(playerid);
}

CefBridge_SendProfile(playerid)
{
	if (!CefBridge_Ok(playerid))
	{
		return 0;
	}
	new name[75], job[96];
	GetPlayerName(playerid, name, 75);
	Job_NameOf(gPlayer[playerid][pJob], job, 96);
	cef_emit_event(playerid, "lssc:profile", 0, name, 0, job);
	return 0;
}

CefBridge_CmdTelefono(playerid)
{
	if (!CefUI_Active(playerid))
	{
		Util_Send(playerid, 0x99CCFFFF, "CityOS \xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA1; CEF \xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;. \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;: /contratti \xC2;\xB7; /contratto \xC2;\xB7; /quartiere \xC2;\xB7; /reputazione \xC2;\xB7; /saldo");
		return 0;
	}
	CefBridge_SendProfile(playerid);
	CefUI_HudSend(playerid);
	CefUI_Open(playerid, "phone", "home");
	return 0;
}

public CefBridge_ClockTick()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && CefUI_Active(i) && CefUI_HudIsOn(i))
		{
			CefUI_HudSend(i);
		}
	}
	return 1;
}

public Cef_OnReady(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || CefUI_State(playerid) == 0)
	{
		return 1;
	}
	CefUI_SetState(playerid, 2);
	CefUI_Decide(playerid);
	switch (gPlayer[playerid][pAuthState])
	{
		case 1, 3, 5, 6:
		{
			HidePlayerDialog(playerid);
			Account_ShowPrompt(playerid);
		}
		case 15:
		{
			HidePlayerDialog(playerid);
			if (gPlayer[playerid][pClassRequested])
			{
				Intro_StoryBegin(playerid);
			}
		}
	}
	new msg[192];
	format(msg, 192, "pagina pronta per il giocatore %d", playerid);
	Log_Write("CEF", msg);
	if (UI_HudIsActive(playerid))
	{
		UI_HudDestroy(playerid);
		CefUI_HudShow(playerid, true);
	}
	else
	{
		CefUI_HudShow(playerid, CefUI_HudIsOn(playerid));
	}
	CefBridge_SendProfile(playerid);
	return 1;
}

public Cef_OnClose(playerid, const arguments[])
{
	if (IsPlayerConnected(playerid))
	{
		CefUI_OnPageClosed(playerid);
	}
	return 1;
}

public Cef_OnAccept(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid))
	{
		return 1;
	}
	new id = CefBridge_Arg(arguments, 0, 0);
	if (id > 0)
	{
		UI_OnContractAccept(playerid, id);
	}
	return 1;
}

public Cef_OnAbandon(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid))
	{
		return 1;
	}
	new id = CefBridge_Arg(arguments, 0, 0);
	if (id > 0)
	{
		UI_OnContractAbandon(playerid, id);
	}
	return 1;
}

public Cef_OnBoardRefresh(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid))
	{
		return 1;
	}
	if (!LD_IsReady())
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	CityOS_CmdContratti(playerid, "");
	return 1;
}

public Cef_OnDistrict(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid) || !LD_IsReady())
	{
		return 1;
	}
	new d = CefBridge_Arg(arguments, 0, 0);
	if (d < 0 || d > 3)
	{
		d = 0;
	}
	if (d == 0)
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		d = GetPlayerInterior(playerid) == 0 ? District_At(x, y) : 0;
		if (d < 1 || d > 3)
		{
			d = 1;
		}
	}
	UI_OnDistrictPick(playerid, d);
	LD_OnboardAction(playerid, 2);
	return 1;
}

public Cef_OnProjectOpen(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid) || !LD_IsReady())
	{
		return 1;
	}
	new d = CefBridge_Arg(arguments, 0, 1);
	if (d < 1 || d > 3)
	{
		d = 1;
	}
	UI_OnProjectOpen(playerid, d);
	return 1;
}

public Cef_OnContribute(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid) || !LD_IsReady())
	{
		return 1;
	}
	new pid = CefBridge_Arg(arguments, 0, 0), amount = CefBridge_Arg(arguments, 1, 0);
	if (pid > 0 && amount > 0)
	{
		UI_OnProjectContribute(playerid, pid, amount);
	}
	return 1;
}

public Cef_OnBankReq(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid))
	{
		return 1;
	}
	CefUI_HudSend(playerid);
	cef_emit_event(playerid, "lssc:bank_begin");
	cef_emit_event(playerid, "lssc:bank_end");
	return 1;
}

public Cef_OnRepReq(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid) || !LD_IsReady())
	{
		return 1;
	}
	CefBridge_SendProfile(playerid);
	CityOS_CmdReputazione(playerid, "");
	LD_OnboardAction(playerid, 4);
	return 1;
}

public Cef_OnJobWaypoint(playerid, const arguments[])
{
	if (!CefBridge_Ok(playerid) || !LD_IsReady())
	{
		return 1;
	}
	Hub_CmdAiuto(playerid, "lavoro");
	CefUI_Toast(playerid, "Job Center \xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x90;", 1);
	return 1;
}

bool:CefBridge_HexDecode(const hex[], dest[], size)
{
	dest[0] = 0;
	new len = strlen(hex);
	if (len == 0 || len % 2 != 0 || len / 2 >= size)
	{
		return false;
	}
	for (new i = 0, o = 0; i < len; i += 2, o++)
	{
		new hi = CefBridge_HexVal(hex[i]), lo = CefBridge_HexVal(hex[i + 1]);
		if (hi < 0 || lo < 0 || (hi == 0 && lo == 0))
		{
			dest[0] = 0;
			return false;
		}
		dest[o] = hi * 16 + lo;
		dest[o + 1] = 0;
	}
	return true;
}

CefBridge_HexVal(c)
{
	if (c >= 48 && c <= 57)
	{
		return c - 48;
	}
	if (c >= 97 && c <= 102)
	{
		return c - 97 + 10;
	}
	if (c >= 65 && c <= 70)
	{
		return c - 65 + 10;
	}
	return -1;
}

bool:CefBridge_AuthOk(playerid)
{
	return IsPlayerConnected(playerid) && CefUI_Active(playerid) && !gPlayer[playerid][pLoggedIn];
}

public Cef_OnLogin(playerid, const arguments[])
{
	if (!CefBridge_AuthOk(playerid) || gPlayer[playerid][pAuthState] != 3)
	{
		return 1;
	}
	new hex[204], pw[102], pos = 0;
	Util_NextToken(arguments, pos, hex, 204);
	if (!CefBridge_HexDecode(hex, pw, 102))
	{
		pw[0] = 0;
	}
	UI_CefLoginSubmit(playerid, pw);
	for (new i = 0; i < sizeof pw; i++)
	{
		pw[i] = 0;
	}
	for (new i = 0; i < sizeof hex; i++)
	{
		hex[i] = 0;
	}
	return 1;
}

public Cef_OnRegister(playerid, const arguments[])
{
	if (!CefBridge_AuthOk(playerid) || gPlayer[playerid][pAuthState] != 1)
	{
		return 1;
	}
	new hex[204], pw[102], pos = 0;
	Util_NextToken(arguments, pos, hex, 204);
	if (!CefBridge_HexDecode(hex, pw, 102))
	{
		pw[0] = 0;
	}
	new email[255];
	Util_NextToken(arguments, pos, email, 255);
	Account_SetPendingEmail(playerid, email[0] == 45 && email[1] == 0 ? "" : email);
	UI_CefRegisterSubmit(playerid, pw);
	for (new i = 0; i < sizeof pw; i++)
	{
		pw[i] = 0;
	}
	for (new i = 0; i < sizeof hex; i++)
	{
		hex[i] = 0;
	}
	return 1;
}

public Cef_OnGender(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid) || gPlayer[playerid][pAuthState] != 5)
	{
		return 1;
	}
	UI_OnGenderChosen(playerid, CefBridge_Arg(arguments, 0, -1));
	return 1;
}

public Cef_OnSkin(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid) || gPlayer[playerid][pAuthState] != 6)
	{
		return 1;
	}
	UI_CefSkinPick(playerid, CefBridge_Arg(arguments, 0, -1));
	return 1;
}

public Cef_OnStory(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid) || gPlayer[playerid][pAuthState] != 15)
	{
		return 1;
	}
	UI_OnStoryChosen(playerid, CefBridge_Arg(arguments, 0, 0), CefBridge_Arg(arguments, 1, 0));
	return 1;
}

public Cef_OnQuit(playerid, const arguments[])
{
	// "??????": in qualunque momento prima dello spawn (login, registrazione, personaggio, storia)
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid) || gPlayer[playerid][pSpawned])
	{
		return 1;
	}
	cef_emit_event(playerid, "lssc:close", 0, "");   // via la pagina: si vede la disconnessione
	CefUI_OnPageClosed(playerid);
	Account_Kick(playerid, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1;! \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x94; /q");
	return 1;
}

// ===== modules/ui/hud_cef.inc =====
// =============================================================================
// ui/hud_cef.inc - HUD "Street Crime's Glass UI" (CEF), lato server.
//
// Il server resta l'autorita': legge salute, armatura, fame, veicolo, quartiere e li invia alla pagina
// SOLO quando cambiano (protocollo: cef/assets/PROTOCOLLO.md, sezione HUD Glass UI).
//  - un unico timer a 250 ms; tachimetro a 4 Hz solo per chi guida; stato/zona/interazioni a 1 Hz;
//  - giocatori senza CEF: niente eventi, restano TextDraw e dialog di prima.
// Tasti (OnPlayerKeyStateChange): Y = interazione col punto vicino, N = azioni rapide.
// =============================================================================

#define HUDC_TICK_MS      (250)
#define HUDC_DANGER_CRIME (70)    // stessa soglia della scheda quartiere (living_ui: hazard)
#define HUDC_SAFE_SEC     (60)
#define HUDC_CHAT_CD_MS   (700)

// punti interattivi (comando esistente eseguito con il tasto Y)
#define HUDC_IA_NONE      (0)
#define HUDC_IA_BANK      (1)
#define HUDC_IA_ATM       (2)
#define HUDC_IA_JOB       (3)
#define HUDC_IA_RENTAL    (4)
#define HUDC_IA_TAXI      (5)
#define HUDC_IA_BOARD     (6)
#define HUDC_IA_HOUSE     (7)
#define HUDC_IA_EXIT      (8)
#define HUDC_IA_SHOP      (9)
#define HUDC_IA_DEALER    (10)
#define HUDC_IA_STATION   (11)

// azioni rapide (bit della maschera inviata con lssc:quick_open)
#define HUDC_Q_INVENTORY  (1)
#define HUDC_Q_PHONE      (2)
#define HUDC_Q_MAP        (4)
#define HUDC_Q_ANIMS      (8)
#define HUDC_Q_VEHICLES   (16)

static const s_HcIaCmd[12][16] = {
	"", "/banca", "/atm", "/lavoro", "/noleggio", "/taxi", "/contratti", "/casa", "/esci", "/compra", "/concessionario", "/refuel"
};
static const s_HcIaLabel[12][80] = {
	"", "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x98;", "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x98;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x98;", "\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;", "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x99;\xE1;\x83;\x98;", "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90;",
	"\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90;", "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;", "\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;", "\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98;"
};

new bool:g_HcOn[MAX_PLAYERS];          // pagina pronta e HUD visibile
new g_HcHp[MAX_PLAYERS], g_HcArmor[MAX_PLAYERS], g_HcHunger[MAX_PLAYERS];
new g_HcVeh[MAX_PLAYERS];              // veicolo mostrato nel tachimetro (0 = nessuno)
new g_HcVSpeed[MAX_PLAYERS], g_HcVFuel[MAX_PLAYERS], g_HcVFlags[MAX_PLAYERS], g_HcVHealth[MAX_PLAYERS];
new g_HcZone[MAX_PLAYERS];             // ultimo stato zona inviato (codificato)
new g_HcIa[MAX_PLAYERS];               // punto interattivo mostrato
new g_HcVoice[MAX_PLAYERS];
new g_HcClockMin[MAX_PLAYERS];
new g_HcLastMoney[MAX_PLAYERS], g_HcLastBank[MAX_PLAYERS], g_HcLastLevel[MAX_PLAYERS];
new g_HcChatTick[MAX_PLAYERS];
new g_HcTicks;
new g_HcTimer;

HudCef_OnInit()
{
	if (!g_HcTimer)
	{
		g_HcTimer = SetTimer("HudCef_OnTick", HUDC_TICK_MS, true);
	}
}

HudCef_OnExit()
{
	if (g_HcTimer)
	{
		KillTimer(g_HcTimer);
		g_HcTimer = 0;
	}
}

HudCef_Reset(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_HcOn[playerid] = false;
	g_HcHp[playerid] = g_HcArmor[playerid] = g_HcHunger[playerid] = -2;
	g_HcVeh[playerid] = 0;
	g_HcVSpeed[playerid] = g_HcVFuel[playerid] = g_HcVFlags[playerid] = g_HcVHealth[playerid] = -2;
	g_HcZone[playerid] = -2;
	g_HcIa[playerid] = HUDC_IA_NONE;
	g_HcVoice[playerid] = -2;
	g_HcClockMin[playerid] = -1;
	g_HcLastMoney[playerid] = g_HcLastBank[playerid] = cellmin;
	g_HcLastLevel[playerid] = 0;
	g_HcChatTick[playerid] = 0;
	Chat_SetCef(playerid, false);
	return 1;
}

HudCef_OnPlayerConnect(playerid)
{
	HudCef_Reset(playerid);
}

HudCef_OnPlayerDisconnect(playerid)
{
	HudCef_Reset(playerid);
}

// chiamata da CefUI_HudShow: la pagina e' pronta e l'HUD e' visibile (o viene nascosto)
HudCef_OnVisible(playerid, bool:show)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!show || !CefUI_Active(playerid))
	{
		if (g_HcOn[playerid])
		{
			HudCef_HideVehicle(playerid);
			HudCef_SetInteract(playerid, HUDC_IA_NONE);
		}
		g_HcOn[playerid] = false;
		return 0;
	}
	if (g_HcOn[playerid])
	{
		return 1;
	}
	g_HcOn[playerid] = true;
	// tutto ripartira' con un invio completo
	g_HcHp[playerid] = g_HcArmor[playerid] = g_HcHunger[playerid] = -2;
	g_HcZone[playerid] = -2;
	g_HcVoice[playerid] = -2;
	g_HcClockMin[playerid] = -1;
	new name[MAX_PLAYER_NAME + 1];
	GetPlayerName(playerid, name, sizeof name);
	cef_emit_event(playerid, "lssc:identity", 0, name, 1, playerid);
	// chat CEF: attiva di default per chi ha la pagina (si torna alla chat SA-MP con /chatsamp)
	if (!gPlayer[playerid][pChatSamp])
	{
		Chat_SetCef(playerid, true);
	}
	cef_emit_event(playerid, "lssc:chat_mode", 1, Chat_IsCef(playerid) ? 1 : 0);
	// i tasti arrivano alla pagina anche senza focus (F6 = scrivi in chat)
	#if defined LSRP_CEF
		cef_always_listen_keys(playerid, 1, true);
	#endif
	HudCef_Update(playerid, true);
	return 1;
}

public HudCef_OnTick()
{
	g_HcTicks++;
	new slow = g_HcTicks % (1000 / HUDC_TICK_MS) == 0;
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (!g_HcOn[p])
		{
			continue;
		}
		if (!IsPlayerConnected(p))
		{
			g_HcOn[p] = false;
			continue;
		}
		HudCef_UpdateVehicle(p);
		if (slow)
		{
			HudCef_Update(p, false);
		}
	}
}

HudCef_Update(playerid, bool:full)
{
	HudCef_UpdateStatus(playerid);
	HudCef_UpdateZone(playerid);
	HudCef_UpdateInteract(playerid);
	HudCef_UpdateVoice(playerid);
	new h, m, s, y, mo, d;
	gettime(h, m, s);
	if (full || m != g_HcClockMin[playerid])
	{
		g_HcClockMin[playerid] = m;
		getdate(y, mo, d);
		cef_emit_event(playerid, "lssc:clock", 1, h, 1, m, 1, d, 1, mo, 1, y);
	}
	if (full)
	{
		HudCef_UpdateVehicle(playerid);
	}
}

// ---------------------------------------------------------------- salute, armatura, fame
HudCef_UpdateStatus(playerid)
{
	new Float:hp, Float:ar;
	GetPlayerHealth(playerid, hp);
	GetPlayerArmour(playerid, ar);
	new ihp = clamp(floatround(hp, floatround_ceil), 0, 100), iar = clamp(floatround(ar, floatround_ceil), 0, 100);
	new ihu = gPlayer[playerid][pSpawned] ? clamp(g_HPl[playerid][hpHunger], 0, 100) : -1;
	if (ihp == g_HcHp[playerid] && iar == g_HcArmor[playerid] && ihu == g_HcHunger[playerid])
	{
		return 0;
	}
	g_HcHp[playerid] = ihp;
	g_HcArmor[playerid] = iar;
	g_HcHunger[playerid] = ihu;
	// sete: il gamemode non ha un sistema di sete -> -1 (la pagina non mostra l'indicatore)
	cef_emit_event(playerid, "lssc:status", 1, ihp, 1, iar, 1, ihu, 1, -1);
	return 1;
}

// ---------------------------------------------------------------- tachimetro
HudCef_HideVehicle(playerid)
{
	if (g_HcVeh[playerid] == 0)
	{
		return 0;
	}
	g_HcVeh[playerid] = 0;
	g_HcVSpeed[playerid] = g_HcVFuel[playerid] = g_HcVFlags[playerid] = g_HcVHealth[playerid] = -2;
	cef_emit_event(playerid, "lssc:veh_show", 1, 0, 0, "");
	return 1;
}

HudCef_UpdateVehicle(playerid)
{
	new vid = GetPlayerState(playerid) == PLAYER_STATE_DRIVER ? GetPlayerVehicleID(playerid) : 0;
	if (vid == 0)
	{
		HudCef_HideVehicle(playerid);
		return 0;
	}
	if (vid != g_HcVeh[playerid])
	{
		g_HcVeh[playerid] = vid;
		g_HcVSpeed[playerid] = g_HcVFuel[playerid] = g_HcVFlags[playerid] = g_HcVHealth[playerid] = -2;
		new name[24];
		Veh_StdModelName(GetVehicleModel(vid), name);
		cef_emit_event(playerid, "lssc:veh_show", 1, 1, 0, name);
	}
	new speed = Veh_SpeedKmh(vid);
	// carburante: solo per i veicoli personali (sistema carburante di vehicle.inc); altrimenti -1
	new fuel = -1, owner = INVALID_PLAYER_ID, slot = -1;
	if (Veh_Lookup(vid, owner, slot) && owner >= 0 && owner < MAX_PLAYERS && slot >= 0)
	{
		fuel = Veh_FuelPct(owner, slot);
	}
	new engine, lights, alarm, doors, bonnet, boot, objective;
	GetVehicleParamsEx(vid, engine, lights, alarm, doors, bonnet, boot, objective);
	new flags = (engine != 0 ? 1 : 0) | (lights == 1 ? 2 : 0) | (doors == 1 ? 4 : 0);   // -1 = non impostato: motore acceso, luci spente
	new Float:vh;
	GetVehicleHealth(vid, vh);
	new health = clamp(floatround((vh - 250.0) * 100.0 / 750.0), 0, 100);
	if (speed == g_HcVSpeed[playerid] && fuel == g_HcVFuel[playerid] && flags == g_HcVFlags[playerid] && health == g_HcVHealth[playerid])
	{
		return 1;
	}
	g_HcVSpeed[playerid] = speed;
	g_HcVFuel[playerid] = fuel;
	g_HcVFlags[playerid] = flags;
	g_HcVHealth[playerid] = health;
	cef_emit_event(playerid, "lssc:veh", 1, speed, 1, fuel, 1, flags & 1, 1, (flags >> 1) & 1, 1, health, 1, (flags >> 2) & 1);
	return 1;
}

// ---------------------------------------------------------------- quartiere / zona
HudCef_UpdateZone(playerid)
{
	new indoor = GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0;
	new d = 0, danger = -1;
	if (!indoor)
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		d = District_At(x, y);
		if (d > 0)
		{
			// sicurezza dai dati reali del quartiere (Living Los Santos)
			new crime = District_GetCrime(d), sec = District_GetSecurity(d);
			danger = crime >= HUDC_DANGER_CRIME ? 2 : (sec >= HUDC_SAFE_SEC ? 0 : 1);
		}
	}
	new code = (d * 10 + (danger + 1)) * 2 + (indoor ? 1 : 0);
	if (code == g_HcZone[playerid])
	{
		return 0;
	}
	g_HcZone[playerid] = code;
	cef_emit_event(playerid, "lssc:zone", 1, d, 1, danger, 1, indoor ? 1 : 0);
	return 1;
}

// ---------------------------------------------------------------- voce (SampVoice, opzionale)
HudCef_UpdateVoice(playerid)
{
	new st = Voice_State(playerid);
	if (st == g_HcVoice[playerid])
	{
		return 0;
	}
	g_HcVoice[playerid] = st;
	cef_emit_event(playerid, "lssc:voice", 1, st, 0, "B");
	return 1;
}

// ---------------------------------------------------------------- interazioni
HudCef_FindInteract(playerid)
{
	if (!gPlayer[playerid][pSpawned])
	{
		return HUDC_IA_NONE;
	}
	new PLAYER_STATE:st = GetPlayerState(playerid);
	if (st == PLAYER_STATE_DRIVER)
	{
		return Veh_NearStation(playerid) ? HUDC_IA_STATION : HUDC_IA_NONE;
	}
	if (st != PLAYER_STATE_ONFOOT)
	{
		return HUDC_IA_NONE;
	}
	new inside = House_FindInside(playerid);
	if (inside != -1)
	{
		return House_NearExit(playerid, inside) ? HUDC_IA_EXIT : HUDC_IA_NONE;
	}
	if (Bank_NearPoint(playerid, true) >= 0) return HUDC_IA_BANK;
	if (Bank_NearPoint(playerid, false) >= 0) return HUDC_IA_ATM;
	if (Job_NearCenter(playerid)) return HUDC_IA_JOB;
	if (Rental_AtOffice(playerid, 3.0)) return HUDC_IA_RENTAL;
	if (Taxi_AtDepot(playerid)) return HUDC_IA_TAXI;
	if (Hub_NearBoard(playerid) >= 0) return HUDC_IA_BOARD;
	if (House_FindNear(playerid) != -1) return HUDC_IA_HOUSE;
	if (House_NearShop(playerid)) return HUDC_IA_SHOP;
	if (Veh_NearDealer(playerid)) return HUDC_IA_DEALER;
	return HUDC_IA_NONE;
}

HudCef_SetInteract(playerid, ia)
{
	if (ia == g_HcIa[playerid])
	{
		return 0;
	}
	g_HcIa[playerid] = ia;
	if (!CefUI_Active(playerid))
	{
		return 0;
	}
	if (ia == HUDC_IA_NONE)
	{
		cef_emit_event(playerid, "lssc:interact", 1, 0, 0, "", 0, "", 1, -1);
	}
	else
	{
		cef_emit_event(playerid, "lssc:interact", 1, 1, 0, "Y", 0, s_HcIaLabel[ia], 1, -1);
	}
	return 1;
}

HudCef_UpdateInteract(playerid)
{
	HudCef_SetInteract(playerid, HudCef_FindInteract(playerid));
}

// ---------------------------------------------------------------- tasti
HudCef_OnKeyStateChange(playerid, KEY:newkeys, KEY:oldkeys)
{
	if (!g_HcOn[playerid] || !gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	// Y: esegue il comando del punto interattivo (lo stesso che il giocatore potrebbe scrivere)
	if ((newkeys & KEY_YES) && !(oldkeys & KEY_YES))
	{
		new ia = HudCef_FindInteract(playerid);
		if (ia != HUDC_IA_NONE)
		{
			new cmd[48];
			strcat(cmd, s_HcIaCmd[ia]);      // copia: Cmd_Dispatch vuole un array modificabile (errore con pawncc 3.10.11)
			Cmd_Dispatch(playerid, cmd);
			return 1;
		}
	}
	// N: menu azioni rapide (solo a piedi, nessuna vista CEF aperta)
	if ((newkeys & KEY_NO) && !(oldkeys & KEY_NO) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && g_CefView[playerid] == 0)
	{
		cef_emit_event(playerid, "lssc:quick_open", 1, HUDC_Q_INVENTORY | HUDC_Q_PHONE | HUDC_Q_VEHICLES);
		return 1;
	}
	return 0;
}

// pagina -> server: azione rapida scelta (stessi comandi del gioco: il server rivalida tutto)
public Cef_OnQuick(playerid, const arguments[])
{
	if (!g_HcOn[playerid])
	{
		return 1;
	}
	if (!strcmp(arguments, "inventory", true))
	{
		Cmd_Dispatch(playerid, "/inventario");
	}
	else if (!strcmp(arguments, "phone", true))
	{
		Cmd_Dispatch(playerid, "/telefono");
	}
	else if (!strcmp(arguments, "vehicles", true))
	{
		Cmd_Dispatch(playerid, "/v list");
	}
	return 1;
}

public Cef_OnQuickClose(playerid, const arguments[])
{
	return 1;
}

// pagina -> server: messaggio dalla chat CEF (UTF-8 in esadecimale). Comandi '/' come OnPlayerCommandText,
// testo normale come OnPlayerText (stesse verifiche: login, mute).
public Cef_OnChatSend(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid))
	{
		return 1;
	}
	new now = GetTickCount();
	if (g_HcChatTick[playerid] != 0 && now - g_HcChatTick[playerid] < HUDC_CHAT_CD_MS)
	{
		return 1;
	}
	g_HcChatTick[playerid] = now;
	new text[400];
	if (!CefBridge_HexDecode(arguments, text, sizeof text) || text[0] == 0)
	{
		return 1;
	}
	// niente caratteri di controllo
	for (new i = 0; text[i] != 0; i++)
	{
		if (text[i] < 32 && text[i] >= 0)
		{
			text[i] = ' ';
		}
	}
	if (text[0] == '/')
	{
		if (!Cmd_Dispatch(playerid, text))
		{
			Util_Send(playerid, 0xFF6347FF, "\xE1;\x83;\xA3;\xE1;\x83;\xAA;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;. \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x94; /help.");
		}
		return 1;
	}
	if (Char_OnText(playerid) && Admin_OnText(playerid))
	{
		Chat_Broadcast(playerid, text);
	}
	return 1;
}

// /chatsamp e /chatcef: scelta della chat (preferenza salvata solo per la sessione)
HudCef_CmdChat(playerid, bool:cef)
{
	if (!CefUI_Active(playerid))
	{
		Util_Send(playerid, 0x99CCFFFF, "CEF \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93; CEF-\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	gPlayer[playerid][pChatSamp] = !cef;
	Chat_SetCef(playerid, cef);
	cef_emit_event(playerid, "lssc:chat_mode", 1, cef ? 1 : 0);
	Util_Send(playerid, 0x66DD66FF, cef ? "\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x98;: CEF (F6 - \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;)." : "\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x98;: SA-MP (T - \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;).");
	return 1;
}

// ---------------------------------------------------------------- denaro e livello (feedback)
// Chiamata dopo ogni aggiornamento dell'HUD (CefUI_HudData): +$ / -$ e nuovo livello solo su valori reali del server.
HudCef_OnHudData(playerid, money, bank, level)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (g_HcOn[playerid] && g_HcLastMoney[playerid] != cellmin)
	{
		if (money != g_HcLastMoney[playerid])
		{
			cef_emit_event(playerid, "lssc:money_delta", 1, money - g_HcLastMoney[playerid], 1, 0);
		}
		if (bank != g_HcLastBank[playerid])
		{
			cef_emit_event(playerid, "lssc:money_delta", 1, bank - g_HcLastBank[playerid], 1, 1);
		}
		if (level > g_HcLastLevel[playerid] && g_HcLastLevel[playerid] > 0)
		{
			cef_emit_event(playerid, "lssc:levelup", 1, level);
		}
	}
	g_HcLastMoney[playerid] = money;
	g_HcLastBank[playerid] = bank;
	g_HcLastLevel[playerid] = level;
	return 1;
}

// notifica generica (kind: 0 successo, 1 info, 2 avviso, 3 errore, 4 soldi ricevuti, 5 soldi spesi, 6 missione, 7 lavoro, 8 RP)
stock HudCef_Notify(playerid, kind, const title[], const text[], ms = 0)
{
	if (!CefUI_Active(playerid))
	{
		return 0;
	}
	cef_emit_event(playerid, "lssc:notify", 1, kind, 0, title, 0, text, 1, ms);
	return 1;
}

// ===== modules/voice/voice.inc =====
// =============================================================================
// voice/voice.inc - ponte verso la chat vocale (filterscripts/lsrp_voce.pwn).
//
// La voce NON e' nel gamemode: se il componente SampVoice manca, il gamemode parte lo stesso.
// Qui solo i dati per il filterscript e lo stato per l'HUD.
// =============================================================================

Voice_OnInit() {}
Voice_OnExit() {}
Voice_OnPlayerSpawn(playerid)
{
	#pragma unused playerid
}
Voice_OnPlayerDisconnect(playerid)
{
	#pragma unused playerid
}

// 0 voce assente (filterscript o plugin client mancante), 1 niente microfono, 2 pronto
Voice_State(playerid)
{
	return CallRemoteFunction("VoiceFS_State", "d", playerid);
}

// dati per il filterscript della voce
public LSRP_VoiceInfo(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new f = gPlayer[playerid][pFaction];
	return (gPlayer[playerid][pSpawned] ? 1 : 0) | (gPlayer[playerid][pOnDuty] ? 2 : 0) | ((f & 0xFF) << 8);
}

