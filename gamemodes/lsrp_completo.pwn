Veh_OnInit()
{
	for (new v = 0; v < 2001; v++)
	{
		g_VMapOwner[v] = 65535;
		g_VMapSlot[v] = -1;
		g_VMapSession[v] = 0;
	}
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Veh_ResetPlayer(p);
	}
	g_VPool = 0;
	g_VSaveTimer = SetTimer("Veh_OnSaveTick", 120000, true);
	CreatePickup(1239, 1, 1655.0, -1665.0, 22.5, 0);
	Lang_Create3DTextLabel("\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x98;\n\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /concessionario", -2994689, 1655.0, -1665.0, (22.5 + 1.0), 15.0, 0, false);
	for (new i = 0; i < 3; i++)
	{
		Lang_Create3DTextLabel("\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;\n\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /refuel [\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x98;]", -2994689, g_VehStations[i][0], g_VehStations[i][1], (1.0 + g_VehStations[i][2]), 15.0, 0, false);
	}
}

Veh_OnExit()
{
	Veh_SaveAll();
	if (g_VSaveTimer != 0)
	{
		KillTimer(g_VSaveTimer);
	}
	if (g_VFuelTimer != 0)
	{
		KillTimer(g_VFuelTimer);
	}
	if (g_VHudTimer != 0)
	{
		KillTimer(g_VHudTimer);
	}
	g_VSaveTimer = 0;
	g_VFuelTimer = 0;
	g_VHudTimer = 0;
}

Veh_OnPlayerConnect(playerid)
{
	Veh_ResetPlayer(playerid);
	g_VSessionSeq++;
	g_VPl[playerid][vpSession] = g_VSessionSeq;
	g_VPl[playerid][vpCmdTick] = GetTickCount() - 2000;
}

Veh_OnPlayerSpawn(playerid)
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	if (g_VPl[playerid][vpLoadState] == 0 || g_VPl[playerid][vpLoadState] == 3)
	{
		Veh_BeginLoad(playerid);
	}
	return 0;
}

Veh_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (g_VPl[playerid][vpFindTimer] != 0)
	{
		KillTimer(g_VPl[playerid][vpFindTimer]);
	}
	Veh_HudStop(playerid);
	for (new s = 0; s < 4; s++)
	{
		if (!g_VSlot[playerid][s][vsUsed])
		{
			continue;
		}
		if (g_VSlot[playerid][s][vsVehicleId] != 65535)
		{
			if (g_VSlot[playerid][s][vsEngineOn])
			{
				g_VSlot[playerid][s][vsEngineOn] = 0;
			}
			Veh_SaveSlot(playerid, s);
			Veh_Despawn(playerid, s);
		}
	}
	Veh_ResetPlayer(playerid);
	Veh_SyncTimers();
	return 0;
}

Veh_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	new o = 65535, s = -1;
	if (!Veh_Lookup(vehicleid, o, s) || o == playerid)
	{
		return 0;
	}
	if (ispassenger == 0)
	{
		ClearAnimations(playerid, SYNC_NONE);
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
	}
	return 0;
}

Veh_OnPlayerExitVehicle(playerid, vehicleid)
{
	#pragma unused playerid
	new o = 65535, s = -1;
	if (Veh_Lookup(vehicleid, o, s))
	{
		Veh_SaveSlot(o, s);
	}
}

Veh_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (oldstate == PLAYER_STATE_DRIVER && g_VPl[playerid][vpLastVehicle] != 0)
	{
		new vid = g_VPl[playerid][vpLastVehicle], o = 65535, s = -1;
		Veh_HudStop(playerid);
		if (Veh_Lookup(vid, o, s) && o == playerid)
		{
			if (g_VSlot[o][s][vsEngineOn])
			{
				Veh_SetEngine(o, s, false);
			}
			Veh_SaveSlot(o, s);
		}
	}
	if (newstate == PLAYER_STATE_DRIVER)
	{
		new vid = GetPlayerVehicleID(playerid), o = 65535, s = -1;
		if (!Veh_Lookup(vid, o, s))
		{
			return 0;
		}
		if (o != playerid)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
			RemovePlayerFromVehicle(playerid, false);
			return 0;
		}
		Veh_SetParams(vid, g_VSlot[o][s][vsEngineOn] ? 1 : 0, -1, -1);
		Veh_HudStart(playerid, vid);
		if (!g_VSlot[o][s][vsEngineOn])
		{
			Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x94; N \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x94; /v engine.");
		}
	}
	return 0;
}

Veh_OnVehicleDeath(vehicleid, killerid)
{
	#pragma unused killerid
	new o = 65535, s = -1;
	if (!Veh_Lookup(vehicleid, o, s) || g_VSlot[o][s][vsDestroyed])
	{
		return 0;
	}
	if (g_VSlot[o][s][vsEngineOn])
	{
		Veh_SetEngine(o, s, false);
	}
	g_VSlot[o][s][vsDestroyed] = 1;
	g_VSlot[o][s][vsHealth] = 350.0;
	Veh_SaveSlot(o, s);
	SetTimerEx("Veh_OnWreckRemove", 10000, false, "ddd", vehicleid, o, g_VMapSession[vehicleid]);
	new mname[36], pname[75], msg[256];
	Veh_ModelName(g_VSlot[o][s][vsModel], mname, 36);
	SendClientMessage(o, -10270721, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; %s (\xE1;\x83;\xA1;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x98; %d) \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x94; /v recover %d-\xE1;\x83;\x98;\xE1;\x83;\x97;.", mname, s + 1, s + 1);
	GetPlayerName(o, pname, 75);
	format(msg, 256, "DISTRUTTO %s: %s dbId %d", pname, mname, g_VSlot[o][s][vsDbId]);
	Log_Write("VEH", msg);
	return 0;
}

