	UI_FcMoney(g_UiFcRankPay[faction][rank], pay, 48);
	format(body, 768, "{FFD24D}%s{FFFFFF}\n\n\xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;: %s\n\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: %s (%d/%d)\n\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;: %s{FFFFFF}\n\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {66DD66}$%s{FFFFFF} \xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A; %d \xE1;\x83;\xAC;\xE1;\x83;\x97; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x96;\xE1;\x83;\x94;", name, g_UiFcFull[faction], rankName, rank, 6, status, pay, 15);
	Lang_ShowPlayerDialog(playerid, 9323, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;", body, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;", "");
}

UI_FcConfirmShow(playerid, idx)
{
	new faction = g_UiFcFaction[playerid], mode = g_UiFcMode[playerid];
	new rank = g_UiFcMemInfo[playerid][idx] & 255;
	new body[1024], name[75], oldName[72], newName[72], verb[48];
	UI_FcMemberName(playerid, idx, name, 75);
