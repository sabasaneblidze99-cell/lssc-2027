// motore dei veicoli che non sono personali: noleggio, auto di strada, lavoro, merci
Veh_DoEngineOther(playerid)
{
	if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xAB;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
