			{
				UI_LivingToast(playerid, shop ? "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x98;." : "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x98;.", 0);
			}
		}
		new need = shop ? 5000 : 6000;
		new waited = now - gPlayer[playerid][pFreightDwellTick];
		if (waited >= need)
		{
			g_FrtDwell[playerid] = false;
			gPlayer[playerid][pFreightDwellTick] = 0;
			if (shop)
			{
				Freight_DoDeliver(playerid);
			}
			else
			{
				Freight_DoPickup(playerid);
			}
			if (!g_FrtActive[playerid])
			{
				return 0;
			}
		}
		else
		{
			dwellSec = Freight_SecCeil(need - waited);
		}
	}
	else
	{
		g_FrtDwell[playerid] = false;
		gPlayer[playerid][pFreightDwellTick] = 0;
	}
	Freight_Hud(playerid, floatround(dist, floatround_method:1), dwellSec);
	return 0;
}

public Freight_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!g_FrtActive[i])
		{
			continue;
		}
		if (!IsPlayerConnected(i))
		{
			Freight_End(i, 2);
			continue;
		}
		Freight_TickPlayer(i, now);
	}
	return 1;
}

Freight_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Freight_ResetPlayer(i);
	}
	if (g_FrtTimer != 0)
	{
		KillTimer(g_FrtTimer);
	}
	g_FrtTimer = SetTimer("Freight_OnTick", 1000, true);
}

Freight_OnExit()
{
	if (g_FrtTimer != 0)
	{
		KillTimer(g_FrtTimer);
	}
	g_FrtTimer = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FrtActive[i])
		{
			Freight_End(i, 6);
		}
	}
}

Freight_OnPlayerConnect(playerid)
{
	if (!Freight_ValidId(playerid))
	{
		return 0;
	}
	Freight_ResetPlayer(playerid);
	return 0;
}

Freight_OnCharReady(playerid)
{
	#pragma unused playerid
}

Freight_OnPlayerDisconnect(playerid, reason)
{
	#pragma unused reason
	if (!Freight_ValidId(playerid))
	{
		return 0;
	}
	if (g_FrtActive[playerid])
	{
		Freight_End(playerid, 2);
	}
	Freight_ResetPlayer(playerid);
	return 0;
}

Freight_OnPlayerDeath(playerid)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid])
	{
		return 0;
	}
	Freight_Stop(playerid, 3, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;: \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;, Mule \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;.");
	return 0;
}

Freight_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if (LD_VehModule(vehicleid) != 3)
	{
		return 0;
	}
	new owner = LD_VehOwner(vehicleid);
	if (owner == playerid || ispassenger != 0)
	{
		return 0;
	}
	ClearAnimations(playerid, SYNC_NONE);
	Util_Send(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9D; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;.");
	return 0;
}

Freight_OnPlayerExitVehicle(playerid, vehicleid)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid] || g_FrtVeh[playerid] != vehicleid || !g_FrtBoarded[playerid])
	{
		return 0;
	}
	if (!g_FrtOff[playerid])
	{
		g_FrtOff[playerid] = true;
		gPlayer[playerid][pFreightLeftVehTick] = GetTickCount();
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x98; Mule-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; %d \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; (\xE1;\x83;\x93;\xE1;\x83;\x90; %.0f \xE1;\x83;\x9B;-\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;), \xE1;\x83;\x97;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9B; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.", 45, 0x43160000);
	}
	return 0;
}

Freight_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	#pragma unused oldstate
	if (newstate != PLAYER_STATE_DRIVER)
	{
		return 0;
	}
	new veh = GetPlayerVehicleID(playerid);
	if (LD_VehModule(veh) != 3)
	{
		return 0;
	}
	if (LD_VehOwner(veh) != playerid)
