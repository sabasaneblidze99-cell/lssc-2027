		{
			if (g_UiLvRpRCnt[playerid][t] > 0)
			{
				new avg10 = g_UiLvRpRSum[playerid][t] * 10 / g_UiLvRpRCnt[playerid][t];
				format(line, 576, "  {AAAAAA}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90; %d, \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90; %d, \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; %d,%d/5, \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\xA1; +%d\n", g_UiLvRpDone[playerid][t], g_UiLvRpFail[playerid][t], avg10 / 10, avg10 % 10, g_UiLvRpDay[playerid][t]);
			}
			else
			{
				format(line, 576, "  {AAAAAA}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90; %d, \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90; %d, \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\xA1; +%d\n", g_UiLvRpDone[playerid][t], g_UiLvRpFail[playerid][t], g_UiLvRpDay[playerid][t]);
			}
		}
		else
		{
			strcopy(line, "  {AAAAAA}\xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.\n", 192);
		}
		strcat(body, line, 2560);
	}
	strcat(body, "\n{FFD24D}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA8;\xE1;\x83;\x98;\n", 2560);
	for (new d = 1; d <= 3; d++)
	{
		new rep = g_UiLvRpLHas[playerid][d] ? g_UiLvRpLocal[playerid][d] : 0;
		UI_LvLocalLabel(rep, lrep, 240);
