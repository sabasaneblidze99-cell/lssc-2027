Admin_LevelName(level, name[], size)
{
	switch (level)
	{
		case 1:
		{
			strmid(name, "\xE1;\x83;\xB0;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;", 0, strlen("\xE1;\x83;\xB0;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;"), size);
		}
		case 2:
		{
			strmid(name, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;", 0, strlen("\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;"), size);
		}
		case 3:
		{
			strmid(name, "\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;", 0, strlen("\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;"), size);
		}
		default:
		{
			name[0] = 0;
		}
	}
}

bool:Admin_CanTarget(staffid, targetid, bool:allowSelf)
{
	if (staffid == targetid)
	{
		return allowSelf;
	}
	return Util_GetAdmin(targetid) < Util_GetAdmin(staffid);
}

Admin_ActorName(playerid, name[], size)
{
	if (playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid))
	{
		GetPlayerName(playerid, name, size);
	}
	else
	{
		strmid(name, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98;", 0, strlen("\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98;"), size);
	}
}

Admin_ActorAccount(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	return gPlayer[playerid][pAccountId];
}

Admin_Reply(playerid, color, const text[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	Util_Send(playerid, color, text);
	return 0;
}

Admin_Notify(const text[], color)
{
	new lines[3][128];
	new count = Util_SplitText(text, lines, 3);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || Util_GetAdmin(i) < 1)
		{
			continue;
		}
		for (new l = 0; l < count; l++)
		{
			Util_Send(i, color, lines[l]);
		}
	}
}

Admin_PublicNotice(const text[])
{
	new lines[3][128];
	new count = Util_SplitText(text, lines, 3);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || !gPlayer[i][pLoggedIn] || Util_GetAdmin(i) >= 1)
		{
			continue;
		}
		for (new l = 0; l < count; l++)
		{
			Util_Send(i, -5963521, lines[l]);
		}
	}
}

Admin_AdmCmd(const staffName[], const action[], const targetName[], const reason[], const participle[])
{
	new msg[768];
	if (reason[0] != 0)
	{
		format(msg, 768, "AdmCmd: \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s: %s %s: %s", staffName, action, targetName, reason);
	}
	else
	{
		format(msg, 768, "AdmCmd: \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s: %s %s", staffName, action, targetName);
	}
	Admin_Notify(msg, -5963521);
	if (participle[0] != 0)
	{
		if (reason[0] != 0)
		{
			format(msg, 768, "AdmCmd: %s \xE2;\x80;\x94; %s (\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s): %s", targetName, participle, staffName, reason);
		}
		else
		{
			format(msg, 768, "AdmCmd: %s \xE2;\x80;\x94; %s (\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; %s)", targetName, participle, staffName);
		}
		Admin_PublicNotice(msg);
	}
}

Admin_LogRaw(staffAcc, const staffName[], targetAcc, const action[], const reason[])
{
	new line[320];
	DB_AdminLog(staffAcc, targetAcc, action, reason);
	format(line, 320, "%s (acc %d) %s -> acc %d: %s", staffName, staffAcc, action, targetAcc, reason);
	Log_Write("ADMIN", line);
}

Admin_Log(staffid, targetAcc, const action[], const reason[])
{
	new name[75];
	Admin_ActorName(staffid, name, 75);
	Admin_LogRaw(Admin_ActorAccount(staffid), name, targetAcc, action, reason);
}

bool:Admin_ParseReason(const params[], pos, reason[], size)
{
	while (params[pos] == 32)
	{
		pos++;
	}
	reason[0] = 0;
	if (!Util_SanitizeText(params[pos], reason, min(size - 1, 64)))
	{
		return false;
	}
	for (new i = 0; reason[i] != 0; i++)
	{
		if (reason[i] == 37)
		{
			reason[i] = 35;
		}
	}
	return strlen(reason) >= 3;
}

Admin_FindByAccount(accountId)
{
	if (accountId <= 0)
	{
		return 65535;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && gPlayer[i][pLoggedIn] && gPlayer[i][pAccountId] == accountId)
		{
			return i;
		}
	}
	return 65535;
}

Admin_FindByName(const name[])
{
	new cur[75];
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		GetPlayerName(i, cur, 75);
		if (!strcmp(cur, name, true, 0x7FFFFFFF))
		{
			return i;
		}
	}
	return 65535;
}

Admin_FormatDuration(seconds, dest[], size)
{
	new minutes = (seconds + 60 - 1) / 60;
	if (minutes < 1)
	{
		minutes = 1;
	}
	if (minutes >= 1440)
	{
		format(dest, size, "%d \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;", (minutes + 1440 - 1) / 1440);
	}
	else if (minutes >= 60)
	{
		format(dest, size, "%d \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;", (minutes + 60 - 1) / 60);
	}
	else
	{
		format(dest, size, "%d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x98;", minutes);
	}
}

Admin_Notify_One(playerid, const text[])
{
	new lines[3][128];
	new count = Util_SplitText(text, lines, 3);
	for (new l = 0; l < count; l++)
	{
		Util_Send(playerid, -5963521, lines[l]);
	}
}

Admin_SendHelp(playerid)
{
	new level = Util_GetAdmin(playerid);
	if (level < 1)
	{
		return 0;
	}
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; ---");
	new line[256], name[75];
	for (new lv = 1; lv <= level && lv <= 3; lv++)
	{
		line[0] = 0;
		for (new i = 0; i < 19; i++)
		{
			if (g_AdmHelpLevel[i] != lv)
			{
				continue;
			}
			if (line[0] != 0)
			{
				strcat(line, " \xC2;\xB7; ", 256);
			}
			strcat(line, g_AdmHelpText[i], 256);
		}
		if (line[0] == 0)
		{
			continue;
		}
		Admin_LevelName(lv, name, 75);
		new out[256];
		format(out, 256, "[%s] %s", name, line);
		Admin_Notify_One(playerid, out);
	}
	return 0;
}

bool:Admin_IsMuted(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return false;
	}
	new until = gPlayer[playerid][pMutedUntil];
	if (until == 0)
	{
		return false;
	}
	if (until > gettime())
	{
		return true;
	}
	gPlayer[playerid][pMutedUntil] = 0;
	if (gPlayer[playerid][pAccountId] > 0)
	{
		DB_SetMute(gPlayer[playerid][pAccountId], 0);
	}
	return false;
}

bool:Admin_CheckMuted(playerid)
{
	if (!Admin_IsMuted(playerid))
	{
		return false;
	}
	new left[72];
	Admin_FormatDuration(gPlayer[playerid][pMutedUntil] - gettime(), left, 72);
	SendClientMessage(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x95; %s \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.", left);
	return true;
}

Admin_OnText(playerid)
{
	return Admin_CheckMuted(playerid) ? 0 : 1;
}

Admin_PendSet(requesterid, op, targetAcc, const targetName[], val, const reason[])
{
	new slot = DB_ReqSlot(requesterid);
	g_AdmPend[slot][apActive] = 1;
	g_AdmPend[slot][apOp] = op;
	g_AdmPend[slot][apTargetAcc] = targetAcc;
	g_AdmPend[slot][apStaffAcc] = Admin_ActorAccount(requesterid);
	g_AdmPend[slot][apValue] = val;
	strmid(g_AdmPend[slot][apTargetName], targetName, 0, strlen(targetName), 25);
	Admin_ActorName(requesterid, g_AdmPend[slot][apStaffName], 25);
	strmid(g_AdmPend[slot][apReason], reason, 0, strlen(reason), 65);
}

bool:Admin_Busy(requesterid)
{
	return g_DBAdminPending[DB_ReqSlot(requesterid)] != 0;
}

Admin_PendTake(op, accountKey, const nameKey[])
{
	for (new i = 0; i <= 1000; i++)
	{
		if (!g_AdmPend[i][apActive] || g_AdmPend[i][apOp] != op)
		{
			continue;
		}
		if (accountKey > 0 && g_AdmPend[i][apTargetAcc] != accountKey)
		{
			continue;
		}
		if (accountKey <= 0 && nameKey[0] != 0 && strcmp(g_AdmPend[i][apTargetName], nameKey, true, 0x7FFFFFFF) != 0)
		{
			continue;
		}
		g_AdmPend[i][apActive] = 0;
		return i;
	}
	return -1;
}

Admin_ApplyLevel(accountId, level)
{
	DB_SetAdminLevel(accountId, level);
	new online = Admin_FindByAccount(accountId);
	if (online == 65535)
	{
		for (new i = 0; i < MAX_PLAYERS; i++)
		{
			if (IsPlayerConnected(i) && gPlayer[i][pAccountId] == accountId)
			{
				gPlayer[i][pAdminLevel] = level;
			}
		}
		return 65535;
	}
	gPlayer[online][pAdminLevel] = level;
	return online;
}

public Admin_OnBanChecked(playerid, bool:banned, const reason[], expiresAt)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (gPlayer[playerid][pAuthState] != 11)
	{
		return 1;
	}
	if (!banned)
	{
		Account_ContinueConnect(playerid);
		return 1;
	}
	new msg[432], name[75], when[360];
	GetPlayerName(playerid, name, 75);
	if (expiresAt > 0)
	{
		new left = expiresAt - gettime();
		new dur[72];
		Admin_FormatDuration(left, dur, 72);
		format(when, 360, "\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;: %s", dur);
	}
	else
	{
		strmid(when, "permanente", 0, 10, 40);
	}
	format(msg, 432, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0; (%s). \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x96;\xE1;\x83;\x98;: %s", when, reason);
