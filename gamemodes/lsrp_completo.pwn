public UI_OnHelpWaypoint(playerid, step)
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	if (g_HubOnb[playerid] != 1 || step != Hub_CurStep(playerid))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;: \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;, \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94; /aiuto-\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
