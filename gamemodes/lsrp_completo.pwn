}

UI_ShowGenderSelect(playerid)
{
	if (CefUI_Active(playerid))
	{
		CefUI_AuthStep(playerid, "gender", "", 0);
		return 0;
	}
	Lang_ShowPlayerDialog(playerid, 9003, DIALOG_STYLE_LIST, "\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x9C;\xE1;\x83;\x90; - \xE1;\x83;\xA1;\xE1;\x83;\xA5;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x98;", "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\n\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;", "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;", "");
