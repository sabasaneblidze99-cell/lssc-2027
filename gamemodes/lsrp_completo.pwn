		gPlayer[playerid][pFridgeFoodBefore] = Inv_Count(playerid, 1);
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;: \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1;...");
		Inv_Reload(playerid);
		return 1;
