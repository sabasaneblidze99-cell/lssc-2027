	}
	Lang_ShowPlayerDialog(playerid, 9400, DIALOG_STYLE_TABLIST_HEADERS, title, body, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA1;\xE1;\x83;\x9C;\xE1;\x83;\x90;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
