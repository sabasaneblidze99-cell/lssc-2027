		return 1;
	}
	g_HouseRows[idx][hrFridgeUnits]--;
	House_FridgeChanged(playerid, idx, -1);
	g_HPl[playerid][hpCookCooldown] = GetTickCount() + 300000;
	if (g_HPl[playerid][hpCookCooldown] == 0)
	{
		g_HPl[playerid][hpCookCooldown] = 1;
	}
	SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;: \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /mangia %d \xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", 5);
	return 1;
}

