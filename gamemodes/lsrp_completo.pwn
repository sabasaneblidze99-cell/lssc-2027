UI_HsMoney(value, out[], size)
{
	new raw[48], len = 0, pos = 0;
	if (value < 0)
	{
		value = 0;
	}
	format(raw, 48, "%d", value);
	len = strlen(raw);
	out[0] = 0;
	for (new i = 0; i < len && pos < size - 2; i++)
	{
		if (i > 0 && (len - i) % 3 == 0)
		{
			out[pos++] = 46;
		}
		out[pos++] = raw[i];
	}
	out[pos] = 0;
}

UI_HsValid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

UI_HsFridgeCap(playerid)
{
	new t = g_UiHsTier[playerid];
	return g_UiHsTierFridge[t];
}

UI_HsUtilText(ustate, out[], size)
{
	switch (ustate)
	{
		case 1:
		{
			format(out, size, "{66DD66}ON");
		}
		case 2:
		{
			format(out, size, "{FF6666}\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;");
		}
		default:
		{
			format(out, size, "{FFD24D}\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;.");
		}
	}
}

UI_HsTitle(playerid, const prefix[], out[], size)
{
	format(out, size, "%s - \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98; %d", prefix, g_UiHsHouse[playerid]);
}

UI_HouseDataSet(playerid, houseId, role, tier, interiorIdx, bool:locked, lightState, gasState, fridgeUnits, bagUnits, keysUsed, level, money, bank)
{
	if (!UI_HsValid(playerid))
	{
		return 0;
	}
	if (tier < 0)
	{
		tier = 0;
	}
	if (tier >= 4)
	{
		tier = 3;
	}
	if (interiorIdx < 0)
	{
		interiorIdx = 0;
	}
	if (interiorIdx >= 8)
	{
		interiorIdx = 7;
	}
	if (role < 0 || role > 3)
	{
		role = 3;
	}
	g_UiHsHouse[playerid] = houseId;
	g_UiHsRole[playerid] = role;
	g_UiHsTier[playerid] = tier;
	g_UiHsInt[playerid] = interiorIdx;
	g_UiHsLocked[playerid] = locked;
	g_UiHsLight[playerid] = lightState;
	g_UiHsGas[playerid] = gasState;
	g_UiHsFridge[playerid] = fridgeUnits < 0 ? 0 : fridgeUnits;
	g_UiHsBag[playerid] = bagUnits < 0 ? 0 : bagUnits;
	g_UiHsKeys[playerid] = keysUsed;
	g_UiHsLevel[playerid] = level;
	g_UiHsMoney[playerid] = money;
	g_UiHsBank[playerid] = bank;
	return 0;
}

UI_HouseBillsSet(playerid, lightDue, lightCount, gasDue, gasCount)
{
	if (!UI_HsValid(playerid))
	{
		return 0;
	}
	g_UiHsLightDue[playerid] = lightDue < 0 ? 0 : lightDue;
	g_UiHsLightCnt[playerid] = lightCount < 0 ? 0 : lightCount;
	g_UiHsGasDue[playerid] = gasDue < 0 ? 0 : gasDue;
	g_UiHsGasCnt[playerid] = gasCount < 0 ? 0 : gasCount;
	return 0;
}

UI_HsBillsTotal(playerid)
{
	new total = g_UiHsLightDue[playerid] + g_UiHsGasDue[playerid];
	if (g_UiHsLight[playerid] == 2)
	{
		total += 40;
	}
	if (g_UiHsGas[playerid] == 2)
	{
		total += 40;
	}
	return total;
}

UI_HsMenuRow(playerid, &n, act, const line[], body[], size)
{
	if (n >= 10)
	{
		return 0;
	}
	g_UiHsItemAct[playerid][n++] = act;
	strcat(body, line, size);
	return 0;
}

UI_HouseMenuShow(playerid)
{
	if (!UI_HsValid(playerid))
	{
		return 0;
	}
	new body[1024], line[480], title[576], price[48], tmp[48], st[72];
	new n = 0, t = g_UiHsTier[playerid], role = g_UiHsRole[playerid];
	for (new i = 0; i < 10; i++)
	{
		g_UiHsItemAct[playerid][i] = 0;
	}
	UI_HsMoney(g_UiHsTierPrice[t], price, 48);
	format(title, 576, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98; %d - %s", g_UiHsHouse[playerid], g_UiHsIntName[g_UiHsInt[playerid]]);
	format(line, 480, "{AAAAAA}\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;: {FFFFFF}%s (%s)\n", g_UiHsIntName[g_UiHsInt[playerid]], g_UiHsTierName[t]);
	UI_HsMenuRow(playerid, n, 0, line, body, 1024);
	format(line, 480, "{AAAAAA}\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {66DD66}$%s{AAAAAA}  (\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;. \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d)\n", price, g_UiHsTierLevel[t]);
	UI_HsMenuRow(playerid, n, 0, line, body, 1024);
	if (role == 0)
	{
		UI_HsMenuRow(playerid, n, 0, "{AAAAAA}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {FFD24D}\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\n", body, 1024);
		UI_HsMenuRow(playerid, n, 100, "{66DD66}> \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\n", body, 1024);
	}
	else if (role == 3)
	{
		UI_HsMenuRow(playerid, n, 0, "{AAAAAA}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {FF6666}\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x9D; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\n", body, 1024);
	}
	else
	{
		UI_HsMenuRow(playerid, n, 0, role == 1 ? "{AAAAAA}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {66DD66}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\n" : "{AAAAAA}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x98;: {66AAFF}\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;\n", body, 1024);
		UI_HsUtilText(g_UiHsLight[playerid], st, 72);
		format(line, 480, "{AAAAAA}\xE1;\x83;\xA8;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x98;: %s{AAAAAA}   \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;: ", st);
		UI_HsUtilText(g_UiHsGas[playerid], st, 72);
		strcat(line, st, 480);
		strcat(line, "\n", 480);
		UI_HsMenuRow(playerid, n, 0, line, body, 1024);
		new bills = g_UiHsLightCnt[playerid] + g_UiHsGasCnt[playerid];
		new due = g_UiHsLightDue[playerid] + g_UiHsGasDue[playerid];
		UI_HsMoney(due, tmp, 48);
		if (role == 1)
		{
