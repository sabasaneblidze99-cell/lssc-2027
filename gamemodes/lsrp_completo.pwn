	g_UiBkOp[playerid] = op;
	new title[576], body[1024], sLo[48], sHi[48], sCash[48], sBank[48], sub[288];
	UI_BankFmt(lo, sLo, 48);
	UI_BankFmt(hi, sHi, 48);
