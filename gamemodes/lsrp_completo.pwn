	}
	Inv_BeginOp(playerid, 1, itemId, 1, 0);
	DB_InvUse(playerid, gPlayer[playerid][pCharId], itemId, gPlayer[playerid][pInvOpId]);
	return 0;
}

Inv_RpUse(playerid, const action[])
{
	new name[75], msg[256];
	GetPlayerName(playerid, name, 75);
	format(msg, 256, "* %s %s", name, action);
	Util_SendNear(playerid, 0xC2A2DAFF, 20.0, msg);
}

Inv_ApplyUse(playerid, itemId)
{
	new Float:hp;
	switch (itemId)
	{
		case 2 .. 4:
		{
			new gain = itemId == 2 ? 30 : (itemId == 3 ? 8 : 10);
			new value = House_InvHungerAdd(playerid, gain);
			Inv_RpUse(playerid, itemId == 2 ? "\xE1;\x83;\x9B;\xE1;\x83;\x96;\xE1;\x83;\x90; \xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA1;." : (itemId == 3 ? "\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;." : "\xE1;\x83;\xA1;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA1; \xE1;\x83;\xAD;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;."));
			if (value >= 0)
			{
				SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAB;\xE1;\x83;\xA6;\xE1;\x83;\xA0;\xE1;\x83;\x94;: %d%%.", value);
			}
		}
		case 5, 6:
		{
			GetPlayerHealth(playerid, hp);
			hp += float(itemId == 5 ? 25 : 8);
			if ((hp > 100.0))
			{
				hp = 100.0;
			}
			SetPlayerHealth(playerid, hp);
			Inv_RpUse(playerid, itemId == 5 ? "\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;." : "\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
			SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\xAF;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x9B;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: %d.", floatround(hp, floatround_method:0));
		}
		case 7:
		{
			Inv_RpUse(playerid, "\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;.");
		}
	}
	new cd = s_InvCooldown[itemId];
	if (cd > 0)
	{
		new until = GetTickCount() + cd;
		gPlayer[playerid][pInvItemCdUntil][itemId] = until != 0 ? until : 1;
	}
}

public Inv_OnDBUsed(playerid, itemId, result)
{
	if (!Inv_OpIs(playerid, 1))
	{
		return 1;
	}
	Inv_EndOp(playerid);
	switch (result)
	{
		case 1:
		{
			Inv_Reload(playerid);
			UI_InvToast(playerid, itemId, -1);
			if (Util_IsPlaying(playerid) && !gPlayer[playerid][pWounded])
			{
				Inv_ApplyUse(playerid, itemId);
			}
			else
			{
				Inv_Say(playerid, -10270721, "\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x94;: \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;.");
			}
		}
		case 3:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
			Inv_Reload(playerid);
		}
		case -1:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;: \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x90;. \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x94; \xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
			Inv_Reload(playerid);
		}
		default:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		}
	}
	return 1;
}

public UI_OnInvUse(playerid, slot)
{
	if (!Inv_ValidPlayer(playerid) || slot < 0 || slot >= Inv_Capacity(playerid))
	{
		return 1;
	}
	new itemId = gPlayer[playerid][pInvItem][slot];
	if (itemId > 0)
	{
		Inv_UseStart(playerid, itemId);
	}
	return 1;
}

Inv_GroundCount(charId)
{
	new n = 0;
	for (new i = 0; i < 40; i++)
	{
		if (g_InvGround[i][igState] == 0)
		{
			continue;
		}
		if (charId == 0 || g_InvGround[i][igDropperChar] == charId)
		{
			n++;
		}
	}
	return n;
}

Inv_GroundFree(idx)
{
	if (idx < 0 || idx >= 40)
	{
		return 0;
	}
	if (g_InvGround[idx][igObject] != 65535)
	{
		DestroyObject(g_InvGround[idx][igObject]);
	}
	g_InvGround[idx][igState] = 0;
	g_InvGround[idx][igItemId] = 0;
	g_InvGround[idx][igQty] = 0;
	g_InvGround[idx][igObject] = 65535;
	g_InvGround[idx][igExpireTick] = 0;
	g_InvGround[idx][igDropper] = 0;
	g_InvGround[idx][igDropperChar] = 0;
	g_InvGround[idx][igPicker] = 0;
	return 0;
}

Inv_GroundSlot()
{
	for (new i = 0; i < 40; i++)
	{
		if (g_InvGround[i][igState] == 0)
		{
			return i;
		}
	}
	return -1;
}

Inv_GroundRelease(playerid)
{
	for (new i = 0; i < 40; i++)
	{
		if (g_InvGround[i][igState] == 1 && g_InvGround[i][igDropper] == playerid + 1)
		{
			Inv_GroundFree(i);
		}
		else if (g_InvGround[i][igPicker] == playerid + 1)
		{
			g_InvGround[i][igPicker] = 0;
		}
	}
