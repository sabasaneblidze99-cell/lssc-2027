		format(err, size, "{FF6666}\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: $%s-\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; $%s-\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;.\n\n", sLo, sHi);
		return false;
	}
	return true;
}

UI_LivingProjectContribute(playerid, amount)
{
	if (!UI_LvReady(playerid))
	{
		return 0;
	}
	new lo = 0, hi = 0, err[480];
	if (!UI_LvPrjRange(playerid, lo, hi))
	{
		UI_LivingProjectShow(playerid);
		return 0;
	}
	if (amount <= 0)
	{
		UI_LvPrjAmountShow(playerid, "");
		return 0;
	}
	if (!UI_LvPrjCheck(playerid, amount, err, 480))
	{
		UI_LvPrjAmountShow(playerid, err);
		return 0;
	}
	g_UiLvPjAmount[playerid] = amount;
	UI_LvPrjConfirmShow(playerid);
	return 0;
}

UI_LivingHelpSet(playerid, step, bool:hintsOff)
{
	if (!UI_LvValid(playerid))
	{
		return 0;
	}
	g_UiLvHpStep[playerid] = UI_LvClamp(step, 1, 6);
	g_UiLvHpOff[playerid] = hintsOff;
	return 0;
}

UI_LivingHelpShow(playerid)
{
	if (!UI_LvReady(playerid))
	{
		return 0;
	}
	new body[2048], line[384], title[576], cur = g_UiLvHpStep[playerid];
	if (cur < 1)
	{
		cur = 1;
	}
	body[0] = 0;
	for (new s = 1; s <= 5; s++)
	{
		if (s < cur)
		{
			format(line, 384, "{66DD66}[\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;] {AAAAAA}%d. %s\n", s, g_UiLvStepTitle[s]);
		}
		else if (s == cur)
		{
			format(line, 384, "{FFD24D}[\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90;] {FFFFFF}%d. %s\n", s, g_UiLvStepTitle[s]);
		}
		else
		{
			format(line, 384, "{888888}%d. %s\n", s, g_UiLvStepTitle[s]);
		}
		strcat(body, line, 2048);
	}
	g_UiLvHpOffRow[playerid] = -1;
	if (cur <= 5 && !g_UiLvHpOff[playerid])
	{
		strcat(body, "{AAAAAA}\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;", 2048);
		g_UiLvHpOffRow[playerid] = 5;
	}
	if (cur > 5)
	{
		strcopy(title, "\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94; - \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;", 64);
	}
	else
	{
		format(title, 576, "\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94; - \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x98; %d / %d", cur, 5);
	}
	Lang_ShowPlayerDialog(playerid, 9722, DIALOG_STYLE_LIST, title, body, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA1;\xE1;\x83;\x9C;\xE1;\x83;\x90;", "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x90;");
	return 0;
}

