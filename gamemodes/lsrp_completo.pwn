public Taxi_OnTick()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (g_TxRetryAt[i] != 0 && Taxi_TickReached(g_TxRetryAt[i]))
		{
			Taxi_RetrySend(i);
			continue;
		}
		if (g_TxCallUntil[i] != 0 && Taxi_TickReached(g_TxCallUntil[i]))
		{
			g_TxCallUntil[i] = 0;
			if (gPlayer[i][pTaxiPeer] == 0)
			{
				Util_Send(i, -1, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA3;\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xAE;\xE1;\x83;\x90;.");
			}
		}
		if (gPlayer[i][pTaxiOnDuty] != 0)
		{
			Taxi_TickDriver(i);
		}
	}
	return 1;
}

Taxi_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Taxi_ResetPlayer(i);
	}
	if (g_TxTimer != 0)
	{
		KillTimer(g_TxTimer);
	}
	g_TxTimer = SetTimer("Taxi_OnTick", 1000, true);
	LD_Listen("Taxi_OnDistrictEvent", 20);
	CreatePickup(1239, 1, 1771.0, -1895.0, 13.6, 0);
	Lang_Create3DTextLabel("\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\n/taxi on  \xC2;\xB7;  /taxi off", -2994689, 1771.0, -1895.0, (13.6 + 0.8), 20.0, 0, false);
}

Taxi_OnExit()
{
	if (g_TxTimer != 0)
	{
		KillTimer(g_TxTimer);
	}
	g_TxTimer = 0;
}

Taxi_OnPlayerConnect(playerid)
{
	Taxi_ResetPlayer(playerid);
}

Taxi_OnCharReady(playerid)
{
	#pragma unused playerid
}

Taxi_OnPlayerDisconnect(playerid, reason)
{
	#pragma unused reason
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0 || g_TxPhase[playerid] != 0)
	{
		Taxi_EndDuty(playerid, 2, true);
	}
	new d = Taxi_DriverOf(playerid);
	if (d != 65535)
	{
		Taxi_CancelRide(d, "\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;: \xE1;\x83;\x9B;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;.", "");
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (i != playerid && g_TxOfferCall[i] == playerid + 1)
		{
			Taxi_ClearOffer(i);
		}
	}
	Taxi_ResetPlayer(playerid);
	return 0;
}

Taxi_OnPlayerDeath(playerid)
{
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		Taxi_EndDuty(playerid, 3, true);
	}
	new d = Taxi_DriverOf(playerid);
	if (d != 65535)
	{
		Taxi_CancelRide(d, "\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x9B;\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;.", "");
	}
	g_TxCallUntil[playerid] = 0;
	return 0;
}

Taxi_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	#pragma unused ispassenger, playerid, vehicleid
}

Taxi_OnPlayerExitVehicle(playerid, vehicleid)
{
	#pragma unused playerid, vehicleid
}

Taxi_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	new d = Taxi_DriverOf(playerid);
	if (d == 65535)
	{
		return 0;
	}
	if (newstate == PLAYER_STATE_PASSENGER && g_TxPhase[d] == 2 && GetPlayerVehicleID(playerid) == Rental_GetVehicle(d))
	{
		DisablePlayerCheckpoint(d);
		Util_Send(d, 0x66DD66FF, "\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\x90;: /tassametro start.");
		return 0;
	}
	if (oldstate == PLAYER_STATE_PASSENGER && _:gPlayer[d][pTaxiMeterOn] != 0)
	{
		Taxi_MeterStop(d);
	}
	return 0;
}

Taxi_OnVehicleDeath(vehicleid, killerid)
{
	#pragma unused killerid
	if (LD_VehModule(vehicleid) != 2)
	{
		return 0;
	}
	new d = LD_VehOwner(vehicleid);
	if (d == 65535 || !Taxi_Valid(d) || gPlayer[d][pTaxiOnDuty] == 0)
	{
		return 0;
	}
	Util_Send(d, -10270721, "\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
	Taxi_EndDuty(d, 4, true);
	return 0;
}

// ===== modules/freight/freight.inc =====
new g_FrtTimer;
new bool:g_FrtActive[MAX_PLAYERS];
new bool:g_FrtWelcome[MAX_PLAYERS];
new g_FrtCt[MAX_PLAYERS];
new g_FrtFrom[MAX_PLAYERS];
new g_FrtTo[MAX_PLAYERS];
new g_FrtCargo[MAX_PLAYERS];
new g_FrtDist[MAX_PLAYERS];
new g_FrtPhase[MAX_PLAYERS];
new g_FrtVeh[MAX_PLAYERS];
new g_FrtSerial[MAX_PLAYERS];
new bool:g_FrtBoarded[MAX_PLAYERS];
new bool:g_FrtDwell[MAX_PLAYERS];
new bool:g_FrtOff[MAX_PLAYERS];
new g_FrtStartTick[MAX_PLAYERS];
new g_FrtWaitTick[MAX_PLAYERS];
new g_FrtDefer[MAX_PLAYERS];
new g_FrtInteg[MAX_PLAYERS];
