{
	new body[2048], launcher[25];
	GetPlayerName(playerid, launcher, sizeof launcher);
	format(body, sizeof body,
		"%s%s{FFFFFF}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; {66DD66}Saxeli_Gvari{FFFFFF} (\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x92;. Giorgi_Beridze).\n\n{AAAAAA}\xE1;\x83;\x9B;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93; \xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;, \xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.",
