	if (page < pages - 1)
	{
		strcat(body, "{FFD24D}>> \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x98;\t\t\n", 2048);
		g_UiInvNavNext[playerid] = idx++;
