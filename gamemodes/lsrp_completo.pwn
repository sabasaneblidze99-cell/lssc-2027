		return 0;
	}
	new body[2048];
	format(body, 2048, "{FFFFFF}\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; {33AA33}Los Santos Street Crime's{FFFFFF}-\xE1;\x83;\x96;\xE1;\x83;\x94;!\n\n%s\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98;:", wrongPassword ? "{FF4444}\xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;.\n{FFFFFF}" : "");
	Lang_ShowPlayerDialog(playerid, 9002, DIALOG_STYLE_PASSWORD, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90;", body, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90;", "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x90;");
