// ===== modules/database/db_inventory.inc =====
new g_InvRows[MAX_PLAYERS][20][E_INV_ROW];
new g_InvBag[MAX_PLAYERS];
new g_InvReq[MAX_PLAYERS][E_INV_REQ];
new g_InvTokenSeq;
new g_InvOpSeq;
new g_InvUndoNotify;
new s_InvStackTab[11] = {0, 12, 3, 6, 10, 3, 10, 5, 1, 1, 1};

DB_InvStackMax(itemId)
{
	if (itemId < 1 || itemId > 10)
	{
		return 0;
	}
	return s_InvStackTab[itemId];
}

bool:DB_InvItemMovable(itemId)
{
	return itemId >= 1 && itemId <= 8;
}

DB_InvCapacity(bool:hasBag)
{
	return (hasBag ? 8 : 0) + 12;
}

DB_InvMakeOpId(dest[], size, charId)
{
	g_InvOpSeq++;
	format(dest, size, "%08x%08x%08x%08x", charId, g_InvOpSeq, gettime(), GetTickCount());
}

bool:DB_InvOpIdOk(opId[])
{
	new len = strlen(opId);
	return len >= 1 && len <= 32;
}

bool:DB_InvItemOk(itemId)
{
	return itemId >= 1 && itemId <= 10;
}

bool:DB_InvAddKindOk(kind[])
{
	return !strcmp(kind, "add", 0, 0x7FFFFFFF) || !strcmp(kind, "pickup", 0, 0x7FFFFFFF);
}

bool:DB_InvLive(playerid, name[], charId, token, op)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 0;
	}
	if (!(g_DBPending[playerid] & 0x04000000))
	{
		return 0;
	}
	return g_InvReq[playerid][iqToken] == token && g_InvReq[playerid][iqOp] == op;
}

DB_InvStaleRelease(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid))
	{
		DB_PendingClear(playerid, 0x04000000);
	}
}

DB_InvDeliver(playerid, op, result, itemId, qty, dir, houseId, recv)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	switch (op)
	{
		case 1:
		{
			if (funcidx("Inv_OnDBAdded") != -1)
			{
				CallLocalFunction("Inv_OnDBAdded", "dddd", playerid, itemId, qty, result);
			}
		}
		case 2:
		{
			if (funcidx("Inv_OnDBBought") != -1)
			{
				CallLocalFunction("Inv_OnDBBought", "dddd", playerid, itemId, qty, result);
			}
		}
		case 3:
		{
			if (funcidx("Inv_OnDBRemoved") != -1)
			{
				CallLocalFunction("Inv_OnDBRemoved", "dddd", playerid, itemId, qty, result);
			}
		}
		case 4:
		{
			if (funcidx("Inv_OnDBUsed") != -1)
			{
				CallLocalFunction("Inv_OnDBUsed", "ddd", playerid, itemId, result);
			}
		}
		case 5:
		{
			if (funcidx("Inv_OnDBDropped") != -1)
			{
				CallLocalFunction("Inv_OnDBDropped", "dddd", playerid, itemId, qty, result);
			}
		}
		case 6:
		{
			if (funcidx("Inv_OnDBTransferred") != -1)
			{
				CallLocalFunction("Inv_OnDBTransferred", "ddddd", playerid, recv, itemId, qty, result);
			}
		}
		case 7:
		{
			if (funcidx("Inv_OnDBBag") != -1)
			{
				CallLocalFunction("Inv_OnDBBag", "dd", playerid, result);
			}
		}
		case 8:
		{
			if (funcidx("Inv_OnDBFridge") != -1)
			{
				CallLocalFunction("Inv_OnDBFridge", "ddddd", playerid, houseId, dir, qty, result);
			}
		}
	}
}

bool:DB_InvBegin(playerid, op, bool:valid, charId, itemId, qty, opId[], dir, houseId, recv, recvChar)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (g_DBPending[playerid] & 0x04000000)
	{
		DB_InvDeliver(playerid, op, 7, itemId, qty, dir, houseId, 65535);
		return 0;
	}
	if (!valid || charId <= 0 || gPlayer[playerid][pCharId] != charId || !DB_InvOpIdOk(opId))
	{
		DB_InvDeliver(playerid, op, 0, itemId, qty, dir, houseId, 65535);
		return 0;
	}
	g_InvReq[playerid][iqToken] = ++g_InvTokenSeq;
	g_InvReq[playerid][iqOp] = op;
	g_InvReq[playerid][iqItemId] = itemId;
	g_InvReq[playerid][iqQty] = qty;
	g_InvReq[playerid][iqDir] = dir;
	g_InvReq[playerid][iqHouseId] = houseId;
	g_InvReq[playerid][iqRecvPlayerId] = recv;
	g_InvReq[playerid][iqRecvChar] = recvChar;
	g_InvReq[playerid][iqRecvName][0] = 0;
	if (recv != 65535 && recv >= 0 && recv < 1000 && IsPlayerConnected(recv))
	{
		GetPlayerName(recv, g_InvReq[playerid][iqRecvName], 25);
	}
	g_InvReq[playerid][iqOpId][0] = 0;
	strcat(g_InvReq[playerid][iqOpId], opId, 33);
	if (!DB_IsReady())
	{
		DB_InvDeliver(playerid, op, -1, itemId, qty, dir, houseId, 65535);
		return 0;
	}
	DB_PendingSet(playerid, 0x04000000);
	return 1;
}

DB_InvRun(playerid, op, query[])
{
	new name[25];
	GetPlayerName(playerid, name, 25);
	mysql_tquery(g_DB, query, "DB_OnInvCalled", "dsddds", playerid, name, gPlayer[playerid][pCharId], g_InvReq[playerid][iqToken], op, g_InvReq[playerid][iqOpId]);
}

DB_InvCompensate(opId[], op)
{
	if (op != 1 && op != 2 && op != 3 && op != 5 && op != 7)
	{
		return 0;
	}
	if (!DB_IsReady() || !DB_InvOpIdOk(opId))
	{
		Log_Write("DBINV", "compensazione NON eseguita (db non pronto o op_id non valido): verificare a mano");
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL inv_undo('%e')", opId);
	mysql_tquery(g_DB, query, "DB_OnInvUndoCalled", "sd", opId, 0);
}

DB_InvLoad(playerid, charId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (g_DBPending[playerid] & 0x02000000)
	{
		return 0;
	}
	if (!DB_IsReady() || charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		DB_DeliverFailure(playerid, 0x02000000);
		return 0;
	}
	new name[25], query[512];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT c.inv_bag, COALESCE(i.slot, 0) AS slot, COALESCE(i.item_id, 0) AS item_id, COALESCE(i.quantity, 0) AS quantity FROM characters c LEFT JOIN inventory_items i ON i.character_id = c.id WHERE c.id = %d ORDER BY i.slot", charId);
	DB_PendingSet(playerid, 0x02000000);
	mysql_tquery(g_DB, query, "DB_OnInvLoaded", "dsd", playerid, name, charId);
}

public DB_OnInvLoaded(playerid, name[], charId)
{
	if (!DB_PlayerMatches(playerid, name) || charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		if (playerid >= 0 && playerid < MAX_PLAYERS && !IsPlayerConnected(playerid))
		{
			DB_PendingClear(playerid, 0x02000000);
		}
		return 1;
	}
	DB_PendingClear(playerid, 0x02000000);
	new rows = 0, count = 0, bag = 0, slot = 0, item = 0, qty = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		if (funcidx("Inv_OnDBLoaded") != -1)
		{
			CallLocalFunction("Inv_OnDBLoaded", "dd", playerid, -1);
		}
		return 1;
	}
	cache_get_value_name_int(0, "inv_bag", bag);
	g_InvBag[playerid] = bag != 0 ? 1 : 0;
	for (new r = 0; r < rows; r++)
	{
		item = 0;
		cache_get_value_name_int(r, "item_id", item);
		if (item <= 0)
		{
			continue;
		}
		if (count >= 20)
		{
			Log_Write("DBINV", "righe inventario oltre il massimo: troncate (anomalia)");
			break;
		}
		slot = 0;
		qty = 0;
		cache_get_value_name_int(r, "slot", slot);
		cache_get_value_name_int(r, "quantity", qty);
		g_InvRows[playerid][count][irSlot] = slot;
		g_InvRows[playerid][count][irItem] = item;
		g_InvRows[playerid][count][irQty] = qty;
		count++;
	}
	if (funcidx("Inv_OnDBLoaded") != -1)
	{
		CallLocalFunction("Inv_OnDBLoaded", "dd", playerid, count);
	}
	return 1;
}

DB_InvAddCommon(playerid, op, charId, itemId, qty, opId[], kind[], maxTotal)
{
	new bool:ok = DB_InvItemOk(itemId) && qty >= 1 && qty <= 1000 && maxTotal >= 0;
	if (!DB_InvBegin(playerid, op, ok, charId, itemId, qty, opId, 0, 0, 65535, 0))
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL inv_add('%e', %d, %d, %d, %d, %d, %d, %d, '%e')", opId, charId, itemId, qty, DB_InvStackMax(itemId), 12, 8, maxTotal, kind);
	DB_InvRun(playerid, op, query);
}

DB_InvAdd(playerid, charId, itemId, qty, opId[], kind[], maxTotal)
{
	if (!DB_InvAddKindOk(kind))
	{
		DB_InvDeliver(playerid, 1, 0, itemId, qty, 0, 0, 65535);
		return 0;
	}
	DB_InvAddCommon(playerid, 1, charId, itemId, qty, opId, kind, maxTotal);
}

DB_InvBuy(playerid, charId, itemId, qty, opId[], maxTotal)
{
	DB_InvAddCommon(playerid, 2, charId, itemId, qty, opId, "buy", maxTotal);
}

DB_InvRemoveCommon(playerid, op, charId, itemId, qty, opId[], kind[])
{
	new bool:ok = DB_InvItemOk(itemId) && qty >= 1 && qty <= 1000;
	if (!DB_InvBegin(playerid, op, ok, charId, itemId, qty, opId, 0, 0, 65535, 0))
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL inv_remove('%e', %d, %d, %d, %d, %d, %d, '%e')", opId, charId, itemId, qty, DB_InvStackMax(itemId), 12, 8, kind);
	DB_InvRun(playerid, op, query);
}

DB_InvUse(playerid, charId, itemId, opId[])
{
	DB_InvRemoveCommon(playerid, 4, charId, itemId, 1, opId, "use");
}

DB_InvDrop(playerid, charId, itemId, qty, opId[])
{
	if (DB_InvItemOk(itemId) && !DB_InvItemMovable(itemId))
	{
		DB_InvDeliver(playerid, 5, 4, itemId, qty, 0, 0, 65535);
		return 0;
	}
	DB_InvRemoveCommon(playerid, 5, charId, itemId, qty, opId, "drop");
}

DB_InvSetBag(playerid, charId, opId[])
{
	if (!DB_InvBegin(playerid, 7, 1, charId, 0, 1, opId, 0, 0, 65535, 0))
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL inv_set_bag('%e', %d, %d, %d)", opId, charId, 12, 8);
	DB_InvRun(playerid, 7, query);
}

DB_FridgeMove(playerid, charId, houseId, itemId, qty, direction, opId[], fridgeCap, carryMax)
{
	new bool:ok = houseId > 0 && itemId == 1 && qty >= 1 && qty <= 1000 && (direction == 1 || direction == 2) && fridgeCap >= 1 && fridgeCap <= 65535 && carryMax >= 0;
	if (!DB_InvBegin(playerid, 8, ok, charId, itemId, qty, opId, direction, houseId, 65535, 0))
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL inv_fridge('%e', %d, %d, %d, %d, %d, %d, %d, %d, %d, %d)", opId, charId, houseId, itemId, qty, direction, DB_InvStackMax(itemId), 12, 8, fridgeCap, carryMax);
	DB_InvRun(playerid, 8, query);
}

public DB_OnInvCalled(playerid, name[], charId, token, op, opId[])
{
	if (!DB_InvLive(playerid, name, charId, token, op))
	{
		DB_InvCompensate(opId, op);
		DB_InvStaleRelease(playerid);
		return 1;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT result FROM inventory_log WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnInvResult", "dsddds", playerid, name, charId, token, op, opId);
	return 1;
}

public DB_OnInvResult(playerid, name[], charId, token, op, opId[])
{
	new rows = 0, result = -1;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
	}
	if (!DB_InvLive(playerid, name, charId, token, op))
	{
		DB_InvCompensate(opId, op);
		DB_InvStaleRelease(playerid);
		return 1;
	}
	DB_PendingClear(playerid, 0x04000000);
	DB_InvDeliver(playerid, op, result, g_InvReq[playerid][iqItemId], g_InvReq[playerid][iqQty], g_InvReq[playerid][iqDir], g_InvReq[playerid][iqHouseId], 65535);
	return 1;
}

DB_InvTransfer(giverId, receiverId, itemId, qty, opId[])
{
	if (giverId < 0 || giverId >= 1000 || !IsPlayerConnected(giverId))
	{
		return 0;
	}
	new bool:ok = receiverId >= 0 && receiverId < 1000 && receiverId != giverId && IsPlayerConnected(receiverId) && DB_InvItemOk(itemId) && qty >= 1 && qty <= 1000;
	new giverChar = gPlayer[giverId][pCharId], recvChar = 0;
	if (ok)
	{
		recvChar = gPlayer[receiverId][pCharId];
		ok = recvChar > 0 && recvChar != giverChar;
	}
	if (ok && !DB_InvItemMovable(itemId))
	{
		DB_InvDeliver(giverId, 6, 4, itemId, qty, 0, 0, 65535);
		return 0;
	}
	if (!DB_InvBegin(giverId, 6, ok, giverChar, itemId, qty, opId, 0, 0, receiverId, recvChar))
	{
		return 0;
	}
	new query[512], gname[25];
	GetPlayerName(giverId, gname, 25);
	mysql_format(g_DB, query, 512, "CALL inv_transfer('%e', %d, %d, %d, %d, %d, %d, %d)", opId, giverChar, recvChar, itemId, qty, DB_InvStackMax(itemId), 12, 8);
	mysql_tquery(g_DB, query, "DB_OnInvGiveCalled", "dsdddsddds", giverId, gname, giverChar, g_InvReq[giverId][iqToken], receiverId, g_InvReq[giverId][iqRecvName], recvChar, itemId, qty, opId);
}

public DB_OnInvGiveCalled(playerid, name[], charId, token, recv, rname[], rchar, itemId, qty, opId[])
{
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT result FROM inventory_log WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnInvGiveResult", "dsdddsddds", playerid, name, charId, token, recv, rname, rchar, itemId, qty, opId);
	return 1;
}

public DB_OnInvGiveResult(playerid, name[], charId, token, recv, rname[], rchar, itemId, qty, opId[])
{
	new rows = 0, result = -1;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
	}
	new bool:gOk = DB_InvLive(playerid, name, charId, token, 6);
	new bool:rOk = result == 1 && recv >= 0 && recv < 1000 && DB_PlayerMatches(recv, rname) && rchar > 0 && gPlayer[recv][pCharId] == rchar;
	if (gOk)
	{
		DB_PendingClear(playerid, 0x04000000);
	}
	else
	{
		DB_InvStaleRelease(playerid);
	}
	if (!gOk && !rOk)
	{
		return 1;
	}
	DB_InvDeliver(gOk ? playerid : 65535, 6, result, itemId, qty, 0, 0, rOk ? recv : 65535);
	return 1;
}

DB_InvUndo(opId[])
{
	new query[512];
	if (!DB_IsReady() || !DB_InvOpIdOk(opId))
	{
		if (funcidx("Inv_OnDBUndone") != -1)
		{
			CallLocalFunction("Inv_OnDBUndone", "sd", opId, -1);
		}
		return 0;
	}
	g_InvUndoNotify++;
	mysql_format(g_DB, query, 512, "CALL inv_undo('%e')", opId);
	mysql_tquery(g_DB, query, "DB_OnInvUndoCalled", "sd", opId, 1);
}

public DB_OnInvUndoCalled(opId[], notify)
{
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT undo_result FROM inventory_log WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnInvUndoResult", "sd", opId, notify);
	return 1;
}

public DB_OnInvUndoResult(opId[], notify)
{
	new rows = 0, result = 8, msg[112];
	cache_get_row_count(rows);
	if (rows > 0)
	{
		new bool:isNull = 1;
		result = -1;
		cache_is_value_name_null(0, "undo_result", isNull);
		if (!isNull)
		{
			cache_get_value_name_int(0, "undo_result", result);
		}
	}
	format(msg, 112, "undo inventario op %s%s: esito %d%s", opId, notify ? "" : " (compensazione a sessione scaduta)", result, result == 1 ? "" : " ANOMALIA: verificare a mano");
	if (result != 1 || !notify)
	{
		Log_Write("DBINV", msg);
	}
	if (notify)
	{
		if (g_InvUndoNotify > 0)
		{
			g_InvUndoNotify--;
		}
		if (funcidx("Inv_OnDBUndone") != -1)
		{
			CallLocalFunction("Inv_OnDBUndone", "sd", opId, result);
		}
	}
	return 1;
}

public DB_InvFailure(playerid, op)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 1;
	}
	DB_PendingClear(playerid, op);
	if (op == 0x02000000)
	{
		if (funcidx("Inv_OnDBLoaded") != -1)
		{
			CallLocalFunction("Inv_OnDBLoaded", "dd", playerid, -1);
		}
		return 1;
	}
	DB_InvDeliver(playerid, g_InvReq[playerid][iqOp], -1, g_InvReq[playerid][iqItemId], g_InvReq[playerid][iqQty], g_InvReq[playerid][iqDir], g_InvReq[playerid][iqHouseId], 65535);
	return 1;
}

public DB_InvQueryError(callback[])
{
	if (!strcmp(callback, "DB_OnInvLoaded", 0, 0x7FFFFFFF))
	{
		DB_FailAllPending(0x02000000);
	}
	else if (!strcmp(callback, "DB_OnInvUndo", 0, 12))
	{
		Log_Write("DBINV", "errore query in annullamento inventario: verificare a mano");
		if (g_InvUndoNotify > 0)
		{
			g_InvUndoNotify--;
			if (funcidx("Inv_OnDBUndone") != -1)
			{
				CallLocalFunction("Inv_OnDBUndone", "sd", "", -1);
			}
		}
	}
	else
	{
		DB_FailAllPending(0x04000000);
	}
	return 1;
}

// ===== modules/database/db_bank.inc =====
new g_BankStmt[15][E_BANK_STMT];
new g_BankReq[MAX_PLAYERS][E_BANK_REQ];
new g_BankInfo[MAX_PLAYERS][E_BANK_INFO];
new g_BankTokenSeq;
new g_BankOpSeq;
new g_BankUndoNotify;

DB_BankMakeOpId(dest[], size, charId)
{
	g_BankOpSeq++;
	format(dest, size, "%08x%08x%08x%08x", charId, g_BankOpSeq, gettime(), GetTickCount());
}

DB_BankLastOpId(playerid, dest[], size)
{
	dest[0] = 0;
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	strcat(dest, g_BankReq[playerid][bqOpId], size);
}

DB_BankXferFee(amount)
{
	if (amount < 1)
	{
		return 0;
	}
	if (amount > 0x3B9ACA00)
	{
		amount = 0x3B9ACA00;
	}
	new fee = (amount * 2 + 99) / 100;
	return fee < 5 ? 5 : fee;
}

bool:DB_BankOpIdOk(opId[])
{
	new len = strlen(opId);
	return len >= 1 && len <= 36;
}

DB_BankMirror(playerid, delta)
{
	gPlayer[playerid][pBank] += delta;
	g_BankDb[playerid] += delta;
}

bool:DB_BankLive(playerid, name[], charId, token, op)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 0;
	}
	if (!(g_DBPending[playerid] & 0x08000000))
	{
		return 0;
	}
	return g_BankReq[playerid][bqToken] == token && g_BankReq[playerid][bqOp] == op && g_BankReq[playerid][bqGen] == g_BankGen[playerid];
}

bool:DB_BankInfoLive(playerid, name[], charId, token, infoOp)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 0;
	}
	if (!(g_DBPending[playerid] & 0x10000000))
	{
		return 0;
	}
	return g_BankInfo[playerid][biToken] == token && g_BankInfo[playerid][biInfoOp] == infoOp;
}

DB_BankStaleRelease(playerid, bit)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid))
	{
		DB_PendingClear(playerid, bit);
	}
}

DB_BankDeliver(playerid, op, result, amount, fee, balance, recv)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		playerid = INVALID_PLAYER_ID;
	}
	switch (op)
	{
		case 1:
		{
			if (funcidx("Bank_OnDBDeposit") != -1)
			{
				CallLocalFunction("Bank_OnDBDeposit", "dddd", playerid, amount, result, balance);
			}
		}
		case 2:
		{
			if (funcidx("Bank_OnDBWithdraw") != -1)
			{
				CallLocalFunction("Bank_OnDBWithdraw", "dddd", playerid, amount, result, balance);
			}
		}
		case 3:
		{
			if (funcidx("Bank_OnDBTransfer") != -1)
			{
				CallLocalFunction("Bank_OnDBTransfer", "dddddd", playerid, recv, amount, fee, result, balance);
			}
		}
	}
}

DB_BankFlush(playerid)
{
	if (gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	new d = DB_BankDeltaTake(playerid);
	if (d == 0)
	{
		return 0;
	}
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "UPDATE characters SET bank = GREATEST(0, LEAST(%d, CAST(bank AS SIGNED) + (%d))) WHERE id = %d", 0x3B9ACA00, d, gPlayer[playerid][pCharId]);
	mysql_tquery(g_DB, query, "DB_OnBankDeltaSaved", "dsddd", playerid, name, gPlayer[playerid][pCharId], g_BankGen[playerid], d);
}

bool:DB_BankBegin(playerid, op, bool:valid, charId, amount, opId[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (g_DBPending[playerid] & 0x08000000)
	{
		DB_BankDeliver(playerid, op, 7, amount, 0, 0, 65535);
		return 0;
	}
	if (!valid || charId <= 0 || gPlayer[playerid][pCharId] != charId || !DB_BankOpIdOk(opId))
	{
		DB_BankDeliver(playerid, op, 0, amount, 0, 0, 65535);
		return 0;
	}
	g_BankReq[playerid][bqToken] = ++g_BankTokenSeq;
	g_BankReq[playerid][bqOp] = op;
	g_BankReq[playerid][bqAmount] = amount;
	g_BankReq[playerid][bqGen] = g_BankGen[playerid];
	g_BankReq[playerid][bqXferPending] = 0;
	g_BankReq[playerid][bqOpId][0] = 0;
	strcat(g_BankReq[playerid][bqOpId], opId, 37);
	if (!DB_IsReady())
	{
		DB_BankDeliver(playerid, op, -1, amount, 0, 0, 65535);
		return 0;
	}
	DB_PendingSet(playerid, 0x08000000);
	return 1;
}

DB_BankCompensate(opId[], op)
{
	if (op != 1 && op != 2)
	{
		return 0;
	}
	if (!DB_IsReady() || !DB_BankOpIdOk(opId))
	{
		Log_Write("DBBANK", "compensazione NON eseguita (db non pronto o op_id non valido): verificare a mano");
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "CALL bank_undo('%e', %d)", opId, 0x3B9ACA00);
	mysql_tquery(g_DB, query, "DB_OnBankUndoCalled", "sd", opId, 0);
}

DB_BankInfoDeliver(playerid, infoOp, result, page, a, b, c, d, bool:more)
{
	switch (infoOp)
	{
		case 1:
		{
			if (funcidx("Bank_OnDBLimits") != -1)
			{
				CallLocalFunction("Bank_OnDBLimits", "dddddd", playerid, result, a, b, c, d);
			}
		}
		case 2:
		{
			if (funcidx("Bank_OnDBStatement") != -1)
			{
				CallLocalFunction("Bank_OnDBStatement", "ddddd", playerid, result, page, a, more);
			}
		}
		case 3:
		{
			if (funcidx("Bank_OnDBSynced") != -1)
			{
				CallLocalFunction("Bank_OnDBSynced", "ddd", playerid, result, a);
			}
		}
	}
}

bool:DB_BankInfoBegin(playerid, infoOp, charId, page)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (g_DBPending[playerid] & 0x10000000)
	{
		DB_BankInfoDeliver(playerid, infoOp, 7, page, 0, 0, 0, -1, 0);
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		DB_BankInfoDeliver(playerid, infoOp, 0, page, 0, 0, 0, -1, 0);
		return 0;
	}
	g_BankInfo[playerid][biToken] = ++g_BankTokenSeq;
	g_BankInfo[playerid][biInfoOp] = infoOp;
	g_BankInfo[playerid][biPage] = page;
	if (!DB_IsReady())
	{
		DB_BankInfoDeliver(playerid, infoOp, -1, page, 0, 0, 0, -1, 0);
		return 0;
	}
	DB_PendingSet(playerid, 0x10000000);
	return 1;
}

DB_BankLimits(playerid, charId)
{
	if (!DB_BankInfoBegin(playerid, 1, charId, 0))
	{
		return 0;
	}
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT LEAST(bank_day_withdrawn(c.id, %d), 2147483647) AS wd, LEAST(bank_day_xfer_out(c.id, %d), 2147483647) AS xo, LEAST(bank_day_xfer_in(c.id, %d), 2147483647) AS xi, COALESCE(TIMESTAMPDIFF(SECOND, (SELECT MAX(ts) FROM bank_ledger WHERE character_id = c.id AND kind = 'xfer_out'), NOW()), -1) AS since FROM characters c WHERE c.id = %d", 24, 24, 24, charId);
	mysql_tquery(g_DB, query, "DB_OnBankLimits", "dsdd", playerid, name, charId, g_BankInfo[playerid][biToken]);
}

public DB_OnBankLimits(playerid, name[], charId, token)
{
	if (!DB_BankInfoLive(playerid, name, charId, token, 1))
	{
		DB_BankStaleRelease(playerid, 0x10000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x10000000);
	new rows = 0, wd = 0, xo = 0, xi = 0, since = -1, result = -1;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		result = 1;
		cache_get_value_name_int(0, "wd", wd);
		cache_get_value_name_int(0, "xo", xo);
		cache_get_value_name_int(0, "xi", xi);
		cache_get_value_name_int(0, "since", since);
	}
	DB_BankInfoDeliver(playerid, 1, result, 0, wd, xo, xi, since, 0);
	return 1;
}

DB_BankStatement(playerid, charId, page)
{
	if (page < 0 || page >= 5)
	{
		if (playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid))
		{
			DB_BankInfoDeliver(playerid, 2, 0, page, 0, 0, 0, 0, 0);
		}
		return 0;
	}
	if (!DB_BankInfoBegin(playerid, 2, charId, page))
	{
		return 0;
	}
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT UNIX_TIMESTAMP(l.ts) AS ts, l.kind AS kind, l.delta AS delta, l.balance_after AS balance, COALESCE(a.name, '') AS other, COALESCE(l.ref, '') AS ref FROM bank_ledger l LEFT JOIN characters oc ON oc.id = l.other_character_id LEFT JOIN accounts a ON a.id = oc.account_id WHERE l.character_id = %d ORDER BY l.id DESC LIMIT %d OFFSET %d", charId, 16, page * 15);
	mysql_tquery(g_DB, query, "DB_OnBankStatement", "dsdd", playerid, name, charId, g_BankInfo[playerid][biToken]);
}

public DB_OnBankStatement(playerid, name[], charId, token)
{
	if (!DB_BankInfoLive(playerid, name, charId, token, 2))
	{
		DB_BankStaleRelease(playerid, 0x10000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x10000000);
	new rows = 0, count = 0;
	cache_get_row_count(rows);
	for (new r = 0; r < rows && count < 15; r++)
	{
		g_BankStmt[count][bsTimestamp] = 0;
		g_BankStmt[count][bsDelta] = 0;
		g_BankStmt[count][bsBalance] = 0;
		cache_get_value_name_int(r, "ts", g_BankStmt[count][bsTimestamp]);
		cache_get_value_name(r, "kind", g_BankStmt[count][bsKind], 13);
		cache_get_value_name_int(r, "delta", g_BankStmt[count][bsDelta]);
		cache_get_value_name_int(r, "balance", g_BankStmt[count][bsBalance]);
		cache_get_value_name(r, "other", g_BankStmt[count][bsOther], 25);
		cache_get_value_name(r, "ref", g_BankStmt[count][bsRef], 33);
		count++;
	}
	DB_BankInfoDeliver(playerid, 2, 1, g_BankInfo[playerid][biPage], count, 0, 0, 0, rows > 15);
	return 1;
}

DB_BankResync(playerid, charId)
{
	if (!DB_BankInfoBegin(playerid, 3, charId, 0))
	{
		return 0;
	}
	DB_BankFlush(playerid);
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT bank FROM characters WHERE id = %d", charId);
	mysql_tquery(g_DB, query, "DB_OnBankSynced", "dsdd", playerid, name, charId, g_BankInfo[playerid][biToken]);
}

public DB_OnBankSynced(playerid, name[], charId, token)
{
	if (!DB_BankInfoLive(playerid, name, charId, token, 3))
	{
		DB_BankStaleRelease(playerid, 0x10000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x10000000);
	new rows = 0, bank = 0, result = -1;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		result = 1;
		cache_get_value_name_int(0, "bank", bank);
		DB_BankMirror(playerid, bank - g_BankDb[playerid]);
	}
	DB_BankInfoDeliver(playerid, 3, result, 0, bank, 0, 0, 0, 0);
	return 1;
}

DB_BankDeposit(playerid, charId, amount, channel, opId[])
{
	new bool:ok = amount >= 1 && amount <= 0x3B9ACA00 && (channel == 0 || channel == 1);
	if (!DB_BankBegin(playerid, 1, ok, charId, amount, opId))
	{
		return 0;
	}
	DB_BankFlush(playerid);
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "CALL bank_deposit('%e', %d, %d, %d, %d, %d)", opId, charId, amount, channel, channel == 0 ? 20000 : 0, 0x3B9ACA00);
	mysql_tquery(g_DB, query, "DB_OnBankCalled", "dsddds", playerid, name, charId, g_BankReq[playerid][bqToken], 1, opId);
}

DB_BankWithdraw(playerid, charId, amount, channel, opId[])
{
	new bool:ok = amount >= 1 && amount <= 0x3B9ACA00 && (channel == 0 || channel == 1);
	if (!DB_BankBegin(playerid, 2, ok, charId, amount, opId))
	{
		return 0;
	}
	DB_BankFlush(playerid);
	new query[512], name[25], bool:atm = channel == 0;
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "CALL bank_withdraw('%e', %d, %d, %d, %d, %d, %d)", opId, charId, amount, channel, atm ? 5000 : 50000, atm ? 15000 : 100000, 24);
	mysql_tquery(g_DB, query, "DB_OnBankCalled", "dsddds", playerid, name, charId, g_BankReq[playerid][bqToken], 2, opId);
}

public DB_OnBankCalled(playerid, name[], charId, token, op, opId[])
{
	if (!DB_BankLive(playerid, name, charId, token, op))
	{
		DB_BankCompensate(opId, op);
		DB_BankStaleRelease(playerid, 0x08000000);
		return 1;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT result, balance_after FROM bank_ops WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnBankResult", "dsddds", playerid, name, charId, token, op, opId);
	return 1;
}

public DB_OnBankResult(playerid, name[], charId, token, op, opId[])
{
	new rows = 0, result = -1, balance = 0;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
		cache_get_value_name_int(0, "balance_after", balance);
	}
	if (!DB_BankLive(playerid, name, charId, token, op))
	{
		DB_BankCompensate(opId, op);
		DB_BankStaleRelease(playerid, 0x08000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x08000000);
	new amount = g_BankReq[playerid][bqAmount];
	if (result == 1)
	{
		DB_BankMirror(playerid, op == 1 ? amount : -amount);
		g_BankReq[playerid][bqXferPending] = 1;
	}
	else if (result == -1)
	{
		DB_BankCompensate(opId, op);
	}
	DB_BankDeliver(playerid, op, result, amount, 0, balance, 65535);
	return 1;
}

DB_BankTransfer(playerid, toPlayerid, amount, opId[], flag)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new bool:ok = amount >= 1 && amount <= 0x3B9ACA00 && toPlayerid >= 0 && toPlayerid < MAX_PLAYERS && toPlayerid != playerid && IsPlayerConnected(toPlayerid);
	new fromChar = gPlayer[playerid][pCharId], toChar = 0;
	if (ok)
	{
		toChar = gPlayer[toPlayerid][pCharId];
		ok = toChar > 0 && toChar != fromChar;
	}
	if (!DB_BankBegin(playerid, 3, ok, fromChar, amount, opId))
	{
		return 0;
	}
	DB_BankFlush(playerid);
	new query[512], name[25], rname[25];
	GetPlayerName(playerid, name, 25);
	GetPlayerName(toPlayerid, rname, 25);
	mysql_format(g_DB, query, 512, "CALL bank_transfer('%e', %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d)", opId, fromChar, toChar, amount, 2, 5, 10, 25000, 50000, 100000, 0x3B9ACA00, 24, flag != 0 ? 1 : 0);
	mysql_tquery(g_DB, query, "DB_OnBankXferCalled", "dsdddsddds", playerid, name, fromChar, g_BankReq[playerid][bqToken], toPlayerid, rname, toChar, g_BankGen[toPlayerid], amount, opId);
}

public DB_OnBankXferCalled(playerid, name[], charId, token, recv, rname[], rchar, rgen, amount, opId[])
{
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT result, fee, balance_after FROM bank_ops WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnBankXferResult", "dsdddsddds", playerid, name, charId, token, recv, rname, rchar, rgen, amount, opId);
	return 1;
}

public DB_OnBankXferResult(playerid, name[], charId, token, recv, rname[], rchar, rgen, amount, opId[])
{
	new rows = 0, result = -1, fee = 0, balance = 0;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
		cache_get_value_name_int(0, "fee", fee);
		cache_get_value_name_int(0, "balance_after", balance);
	}
	new bool:gOk = DB_BankLive(playerid, name, charId, token, 3);
	new bool:rOk = result == 1 && recv >= 0 && recv < 1000 && DB_PlayerMatches(recv, rname) && rchar > 0 && gPlayer[recv][pCharId] == rchar && g_BankGen[recv] == rgen;
	if (gOk)
	{
		DB_PendingClear(playerid, 0x08000000);
	}
	else
	{
		DB_BankStaleRelease(playerid, 0x08000000);
	}
	if (result == 1)
	{
		if (gOk)
		{
			DB_BankMirror(playerid, -(amount + fee));
		}
		if (rOk)
		{
			DB_BankMirror(recv, amount);
		}
	}
	if (!gOk && !rOk)
	{
		return 1;
	}
	DB_BankDeliver(gOk ? playerid : 65535, 3, result, amount, fee, gOk ? balance : 0, rOk ? recv : 65535);
	if (gOk && result == -1)
	{
		DB_BankResync(playerid, charId);
	}
	return 1;
}

DB_BankUndo(opId[])
{
	if (!DB_IsReady() || !DB_BankOpIdOk(opId))
	{
		if (funcidx("Bank_OnDBUndone") != -1)
		{
			CallLocalFunction("Bank_OnDBUndone", "dsd", 65535, opId, -1);
		}
		return 0;
	}
	new query[512];
	g_BankUndoNotify++;
	mysql_format(g_DB, query, 512, "CALL bank_undo('%e', %d)", opId, 0x3B9ACA00);
	mysql_tquery(g_DB, query, "DB_OnBankUndoCalled", "sd", opId, 1);
}

public DB_OnBankUndoCalled(opId[], notify)
{
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT undo_result, kind, amount FROM bank_ops WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnBankUndoResult", "sd", opId, notify);
	return 1;
}

public DB_OnBankUndoResult(opId[], notify)
{
	new rows = 0, result = 8, msg[126], kind[13], amount = 0, owner = 65535;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		new bool:isNull = 1;
		result = -1;
		cache_is_value_name_null(0, "undo_result", isNull);
		if (!isNull)
		{
			cache_get_value_name_int(0, "undo_result", result);
		}
		cache_get_value_name(0, "kind", kind, 13);
		cache_get_value_name_int(0, "amount", amount);
	}
	if (notify)
	{
		if (g_BankUndoNotify > 0)
		{
			g_BankUndoNotify--;
		}
		if (result == 1)
		{
			for (new i = 0; i < MAX_PLAYERS; i++)
			{
				if (!IsPlayerConnected(i) || !g_BankReq[i][bqXferPending] || strcmp(g_BankReq[i][bqOpId], opId, 0, 0x7FFFFFFF) != 0)
				{
					continue;
				}
				if (g_BankReq[i][bqGen] != g_BankGen[i])
				{
					break;
				}
				DB_BankMirror(i, !strcmp(kind, "deposit", 0, 0x7FFFFFFF) ? -amount : amount);
				g_BankReq[i][bqXferPending] = 0;
				owner = i;
				break;
			}
		}
	}
	format(msg, 126, "undo banca op %s%s: esito %d%s", opId, notify ? "" : " (compensazione a sessione scaduta)", result, result == 1 ? "" : " ANOMALIA: verificare a mano");
	if (result != 1 || !notify)
	{
		Log_Write("DBBANK", msg);
	}
	if (notify && funcidx("Bank_OnDBUndone") != -1)
	{
		CallLocalFunction("Bank_OnDBUndone", "dsd", owner, opId, result);
	}
	return 1;
}

bool:DB_BankSystemKindOk(kind[])
{
	return !strcmp(kind, "paycheck", 0, 0x7FFFFFFF) || !strcmp(kind, "job", 0, 0x7FFFFFFF) || !strcmp(kind, "faction", 0, 0x7FFFFFFF) || !strcmp(kind, "bill", 0, 0x7FFFFFFF) || !strcmp(kind, "house", 0, 0x7FFFFFFF) || !strcmp(kind, "vehicle", 0, 0x7FFFFFFF) || !strcmp(kind, "fine", 0, 0x7FFFFFFF) || !strcmp(kind, "refund", 0, 0x7FFFFFFF) || !strcmp(kind, "admin", 0, 0x7FFFFFFF);
}

DB_BankLog(opId[], charId, otherCharId, kind[], delta, balAfter, channel, ref[])
{
	if (!DB_IsReady() || charId <= 0 || delta == 0 || !DB_BankOpIdOk(opId) || !DB_BankSystemKindOk(kind) || channel < 0 || channel > 2)
	{
		return 0;
	}
	if (strlen(ref) >= 33)
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "INSERT IGNORE INTO bank_ledger (op_id, character_id, other_character_id, kind, delta, balance_after, channel, ref) VALUES ('%e', %d, NULLIF(%d, 0), '%e', %d, %d, %d, NULLIF('%e', ''))", opId, charId, otherCharId > 0 ? otherCharId : 0, kind, delta, balAfter, channel, ref);
	mysql_tquery(g_DB, query, "", "");
}

public DB_BankFailure(playerid, op)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 1;
	}
	DB_PendingClear(playerid, op);
	if (op == 0x10000000)
	{
		DB_BankInfoDeliver(playerid, g_BankInfo[playerid][biInfoOp], -1, g_BankInfo[playerid][biPage], 0, 0, 0, -1, 0);
		return 1;
	}
	new reqOp = g_BankReq[playerid][bqOp];
	DB_BankDeliver(playerid, reqOp, -1, g_BankReq[playerid][bqAmount], 0, 0, 65535);
	if (reqOp == 1 || reqOp == 2)
	{
		DB_BankCompensate(g_BankReq[playerid][bqOpId], reqOp);
	}
	else if (reqOp == 3 && !(g_DBPending[playerid] & 0x10000000) && IsPlayerConnected(playerid))
	{
		DB_BankResync(playerid, gPlayer[playerid][pCharId]);
	}
	return 1;
}

public DB_BankQueryError(callback[])
{
	if (!strcmp(callback, "DB_OnBankLimits", 0, 0x7FFFFFFF) || !strcmp(callback, "DB_OnBankStatement", 0, 0x7FFFFFFF) || !strcmp(callback, "DB_OnBankSynced", 0, 0x7FFFFFFF))
	{
		DB_FailAllPending(0x10000000);
	}
	else if (!strcmp(callback, "DB_OnBankUndo", 0, 13))
	{
		Log_Write("DBBANK", "errore query in annullamento banca: verificare a mano");
		if (g_BankUndoNotify > 0)
		{
			g_BankUndoNotify--;
			if (funcidx("Bank_OnDBUndone") != -1)
			{
				CallLocalFunction("Bank_OnDBUndone", "dsd", 65535, "", -1);
			}
		}
	}
	else
	{
		DB_FailAllPending(0x08000000);
	}
	return 1;
}

// ===== modules/database/db_story.inc =====
new g_StoryReq[MAX_PLAYERS][E_STORY_REQ];
new g_StoryInfo[MAX_PLAYERS][E_STORY_INFO];
new g_StoryTokenSeq;
new g_StoryOpSeq;

DB_StoryMakeOpId(dest[], size, charId)
{
	g_StoryOpSeq++;
	format(dest, size, "%08x%08x%08x%08x", charId, g_StoryOpSeq, gettime(), GetTickCount());
}

DB_StoryLastOpId(playerid, dest[], size)
{
	dest[0] = 0;
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	strcat(dest, g_StoryReq[playerid][sqOpId], size);
}

DB_StoryCash(motive)
{
	switch (motive)
	{
		case 2:
		{
			return 2000;
		}
		case 3:
		{
			return 3500;
		}
		case 4:
		{
			return 3000;
		}
	}
	return 2500;
}

DB_StoryBankStart(motive)
{
	return 7500 - DB_StoryCash(motive);
}

bool:DB_StoryOpIdOk(opId[])
{
	new len = strlen(opId);
	return len >= 1 && len <= 36;
}

DB_StoryApply(playerid, origin, motive)
{
	gPlayer[playerid][pStoryOrigin] = origin;
	gPlayer[playerid][pStoryMotive] = motive;
}

bool:DB_StoryInfoLive(playerid, name[], token, kind)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (!(g_DBPending[playerid] & 0x20000000))
	{
		return 0;
	}
	return g_StoryInfo[playerid][siToken] == token && g_StoryInfo[playerid][siKind] == kind;
}

bool:DB_StoryOpLive(playerid, name[], charId, token)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 0;
	}
	if (!(g_DBPending[playerid] & 0x40000000))
	{
		return 0;
	}
	return g_StoryReq[playerid][sqToken] == token && g_StoryReq[playerid][sqGen] == g_BankGen[playerid];
}

DB_StoryStaleRelease(playerid, bit)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid))
	{
		DB_PendingClear(playerid, bit);
	}
}

DB_StoryDeliverLoad(playerid, result, introSeen, origin, motive, bool:hasStory)
{
	if (funcidx("Story_OnDBLoaded") != -1)
	{
		CallLocalFunction("Story_OnDBLoaded", "dddddd", playerid, result, introSeen, origin, motive, hasStory);
	}
}

DB_StoryDeliverRead(playerid, targetid, purpose, result, origin, motive, bool:hasStory)
{
	if (funcidx("Story_OnDBRead") != -1)
	{
		CallLocalFunction("Story_OnDBRead", "ddddddd", playerid, targetid, purpose, result, origin, motive, hasStory);
	}
}

DB_StoryDeliverSaved(playerid, result, origin, motive, moneyDelta)
{
	if (funcidx("Story_OnDBSaved") != -1)
	{
		CallLocalFunction("Story_OnDBSaved", "ddddd", playerid, result, origin, motive, moneyDelta);
	}
}

bool:DB_StoryInfoBegin(playerid, kind, bool:valid, accountId, charId, targetid, purpose)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new tchar = 0, tgen = 0;
	if (kind == 2 && targetid >= 0 && targetid < MAX_PLAYERS && IsPlayerConnected(targetid))
	{
		tchar = gPlayer[targetid][pCharId];
		tgen = g_BankGen[targetid];
	}
	if (g_DBPending[playerid] & 0x20000000)
	{
		if (kind == 1)
		{
			DB_StoryDeliverLoad(playerid, 5, 0, 0, 0, 0);
		}
		else
		{
			DB_StoryDeliverRead(playerid, targetid, purpose, 5, 0, 0, 0);
		}
		return 0;
	}
	if (!valid)
	{
		if (kind == 1)
		{
			DB_StoryDeliverLoad(playerid, 0, 0, 0, 0, 0);
		}
		else
		{
			DB_StoryDeliverRead(playerid, targetid, purpose, 0, 0, 0, 0);
		}
		return 0;
	}
	g_StoryInfo[playerid][siToken] = ++g_StoryTokenSeq;
	g_StoryInfo[playerid][siKind] = kind;
	g_StoryInfo[playerid][siAccountId] = accountId;
	g_StoryInfo[playerid][siCharId] = charId;
	g_StoryInfo[playerid][siTargetId] = targetid;
	g_StoryInfo[playerid][siTargetChar] = tchar;
	g_StoryInfo[playerid][siTargetGen] = tgen;
	g_StoryInfo[playerid][siPurpose] = purpose;
	if (!DB_IsReady())
	{
		if (kind == 1)
		{
			DB_StoryDeliverLoad(playerid, -1, 0, 0, 0, 0);
		}
		else
		{
			DB_StoryDeliverRead(playerid, targetid, purpose, -1, 0, 0, 0);
		}
		return 0;
	}
	DB_PendingSet(playerid, 0x20000000);
	return 1;
}

DB_StoryLoad(playerid, accountId, charId)
{
	new bool:ok = 0;
	if (playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid))
	{
		ok = accountId > 0 && gPlayer[playerid][pAccountId] == accountId && charId >= 0 && gPlayer[playerid][pCharId] == charId;
	}
	if (!DB_StoryInfoBegin(playerid, 1, ok, accountId, charId, 65535, 0))
	{
		return 0;
	}
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT a.intro_seen AS intro_seen, COALESCE(s.origin, 0) AS origin, COALESCE(s.motive, 0) AS motive, (s.character_id IS NOT NULL) AS has_story FROM accounts a LEFT JOIN character_story s ON s.character_id = %d WHERE a.id = %d", charId, accountId);
	mysql_tquery(g_DB, query, "DB_OnStoryLoaded", "dsddd", playerid, name, accountId, charId, g_StoryInfo[playerid][siToken]);
}

public DB_OnStoryLoaded(playerid, name[], accountId, charId, token)
{
	if (!DB_StoryInfoLive(playerid, name, token, 1))
	{
		DB_StoryStaleRelease(playerid, 0x20000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x20000000);
	if (gPlayer[playerid][pAccountId] != accountId || gPlayer[playerid][pCharId] != charId)
	{
		return 1;
	}
	new rows = 0, intro = 0, origin = 0, motive = 0, has = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		DB_StoryDeliverLoad(playerid, 0, 0, 0, 0, 0);
		return 1;
	}
	cache_get_value_name_int(0, "intro_seen", intro);
	cache_get_value_name_int(0, "origin", origin);
	cache_get_value_name_int(0, "motive", motive);
	cache_get_value_name_int(0, "has_story", has);
	if (intro != 0)
	{
		intro = 1;
	}
	gPlayer[playerid][pIntroSeen] = intro;
	DB_StoryApply(playerid, origin, motive);
	DB_StoryDeliverLoad(playerid, 1, intro, origin, motive, has != 0);
	return 1;
}

DB_StoryRead(playerid, targetid, purpose)
{
	new bool:ok = 0;
	if (playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid) && targetid >= 0 && targetid < MAX_PLAYERS && IsPlayerConnected(targetid))
	{
		ok = gPlayer[targetid][pCharId] > 0 && gPlayer[playerid][pCharId] > 0;
	}
	if (!DB_StoryInfoBegin(playerid, 2, ok, 0, 0, targetid, purpose))
	{
		return 0;
	}
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "SELECT COALESCE(s.origin, 0) AS origin, COALESCE(s.motive, 0) AS motive, (s.character_id IS NOT NULL) AS has_story FROM characters c LEFT JOIN character_story s ON s.character_id = c.id WHERE c.id = %d", g_StoryInfo[playerid][siTargetChar]);
	mysql_tquery(g_DB, query, "DB_OnStoryRead", "dsd", playerid, name, g_StoryInfo[playerid][siToken]);
}

public DB_OnStoryRead(playerid, name[], token)
{
	if (!DB_StoryInfoLive(playerid, name, token, 2))
	{
		DB_StoryStaleRelease(playerid, 0x20000000);
		return 1;
	}
	DB_PendingClear(playerid, 0x20000000);
	new target = g_StoryInfo[playerid][siTargetId], purpose = g_StoryInfo[playerid][siPurpose];
	if (target < 0 || target >= MAX_PLAYERS || !IsPlayerConnected(target))
	{
		return 1;
	}
	if (gPlayer[target][pCharId] != g_StoryInfo[playerid][siTargetChar] || g_BankGen[target] != g_StoryInfo[playerid][siTargetGen])
	{
		return 1;
	}
	new rows = 0, origin = 0, motive = 0, has = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		DB_StoryDeliverRead(playerid, target, purpose, 0, 0, 0, 0);
		return 1;
	}
	cache_get_value_name_int(0, "origin", origin);
	cache_get_value_name_int(0, "motive", motive);
	cache_get_value_name_int(0, "has_story", has);
	DB_StoryDeliverRead(playerid, target, purpose, 1, origin, motive, has != 0);
	return 1;
}

DB_StorySave(playerid, charId, origin, motive, opId[], bool:creation)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (g_DBPending[playerid] & 0x40000000)
	{
		DB_StoryDeliverSaved(playerid, 5, 0, 0, 0);
		return 0;
	}
	new bool:ok = charId > 0 && gPlayer[playerid][pCharId] == charId && DB_StoryOpIdOk(opId) && origin >= 0 && origin <= 5 && motive >= 0 && motive <= 4 && (creation || origin != 0 || motive != 0);
	if (!ok)
	{
		DB_StoryDeliverSaved(playerid, 0, 0, 0, 0);
		return 0;
	}
	g_StoryReq[playerid][sqToken] = ++g_StoryTokenSeq;
	g_StoryReq[playerid][sqGen] = g_BankGen[playerid];
	g_StoryReq[playerid][sqCreation] = creation;
	g_StoryReq[playerid][sqOpId][0] = 0;
	strcat(g_StoryReq[playerid][sqOpId], opId, 37);
	if (!DB_IsReady())
	{
		DB_StoryDeliverSaved(playerid, -1, 0, 0, 0);
		return 0;
	}
	DB_PendingSet(playerid, 2.0);
	new query[512], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 512, "CALL story_save('%e', %d, %d, %d, %d)", opId, charId, origin, motive, creation ? 0 : 1);
	mysql_tquery(g_DB, query, "DB_OnStoryCalled", "dsdds", playerid, name, charId, g_StoryReq[playerid][sqToken], opId);
}

public DB_OnStoryCalled(playerid, name[], charId, token, opId[])
{
	if (!DB_StoryOpLive(playerid, name, charId, token))
	{
		DB_StoryStaleRelease(playerid, 2.0);
		return 1;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT o.result AS result, o.money_delta AS money_delta, COALESCE(s.origin, 0) AS origin, COALESCE(s.motive, 0) AS motive FROM story_ops o LEFT JOIN character_story s ON s.character_id = o.character_id WHERE o.op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnStoryResult", "dsdds", playerid, name, charId, token, opId);
	return 1;
}

public DB_OnStoryResult(playerid, name[], charId, token, opId[])
{
	new rows = 0, result = -1, delta = 0, origin = 0, motive = 0;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
		cache_get_value_name_int(0, "money_delta", delta);
		cache_get_value_name_int(0, "origin", origin);
		cache_get_value_name_int(0, "motive", motive);
	}
	if (!DB_StoryOpLive(playerid, name, charId, token))
	{
		if (result == 3)
		{
			Log_Write("DBSTORY", "sessione scaduta dopo una ripartizione dei soldi iniziali: verificare i saldi del personaggio (story_ops)");
		}
		DB_StoryStaleRelease(playerid, 2.0);
		return 1;
	}
	DB_PendingClear(playerid, 2.0);
	if (result == 1 || result == 3 || result == 4 || result == 2)
	{
		DB_StoryApply(playerid, origin, motive);
		if (result == 3 && delta != 0)
		{
			gPlayer[playerid][pMoney] += delta;
			gPlayer[playerid][pBank] -= delta;
			g_BankDb[playerid] -= delta;
		}
		else
		{
			delta = 0;
		}
	}
	else
	{
		delta = 0;
	}
	DB_StoryDeliverSaved(playerid, result, origin, motive, delta);
	return 1;
}

DB_StoryIntroSeen(accountId, playerid)
{
	if (accountId <= 0)
	{
		return 0;
	}
	if (playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid) && gPlayer[playerid][pAccountId] == accountId)
	{
		gPlayer[playerid][pIntroSeen] = 1;
	}
	if (!DB_IsReady())
	{
		Log_Write("DBSTORY", "intro_seen non salvato (db non pronto)");
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET intro_seen = 1 WHERE id = %d", accountId);
	mysql_tquery(g_DB, query, "DB_OnStoryIntroSet", "d", accountId);
}

public DB_OnStoryIntroSet(accountId)
{
	return 1;
}

public DB_StoryFailure(playerid, op)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 1;
	}
	DB_PendingClear(playerid, op);
	if (op == 0x20000000)
	{
		if (g_StoryInfo[playerid][siKind] == 1)
		{
			DB_StoryDeliverLoad(playerid, -1, 0, 0, 0, 0);
		}
		else
		{
			DB_StoryDeliverRead(playerid, g_StoryInfo[playerid][siTargetId], g_StoryInfo[playerid][siPurpose], -1, 0, 0, 0);
		}
		return 1;
	}
	DB_StoryDeliverSaved(playerid, -1, 0, 0, 0);
	return 1;
}

public DB_StoryQueryError(callback[])
{
	if (!strcmp(callback, "DB_OnStoryLoaded", 0, 0x7FFFFFFF) || !strcmp(callback, "DB_OnStoryRead", 0, 0x7FFFFFFF))
	{
		DB_FailAllPending(0x20000000);
	}
	else if (!strcmp(callback, "DB_OnStoryIntroSet", 0, 0x7FFFFFFF))
	{
		Log_Write("DBSTORY", "errore query: intro_seen non salvato");
	}
	else
	{
		DB_FailAllPending(2.0);
	}
	return 1;
}

// ===== modules/database/db_living.inc =====
new g_LdBoard[24][E_LD_BOARD];
new g_LdHist[8][E_LD_HIST];
new g_LdDistrict[4][E_LD_DISTRICT];
new g_LdBucketSlots = 4;
new g_LdPlayer[MAX_PLAYERS][E_LD_PLAYER];
new g_LdReq[6000][E_LD_REQ];
new g_LdPending[MAX_PLAYERS];
new g_LdTokenSeq;
new g_LdOpSeq;
new g_LdBoardToken;

DB_LivingMakeOpId(dest[], size, tag[], ref, charId)
{
	g_LdOpSeq++;
	format(dest, size, "%.2s%d-%d-%08x", tag, ref, charId, gettime() << 8 | g_LdOpSeq & 255);
	if (strlen(dest) > 32)
	{
		dest[32] = 0;
	}
}

bool:DB_LivingBusy(playerid, cat)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || cat < 0 || cat >= 6)
	{
		return 0;
	}
	return (g_LdPending[playerid] & 1 << cat) != 0;
}

DB_LivingDistrictGet(districtId, E_LD_DISTRICT:field)
{
	if (districtId < 1 || districtId > 3 || field == 10)
	{
		return 0;
	}
	return g_LdDistrict[districtId][field];
}

DB_LivingProjectName(districtId, dest[], size)
{
	dest[0] = 0;
	if (districtId < 1 || districtId > 3)
	{
		return 0;
	}
	strcat(dest, g_LdDistrict[districtId][ldProjectName], size);
}

DB_LivingBucketSlots()
{
	return g_LdBucketSlots;
}

DB_LivingPlayerGet(playerid, E_LD_PLAYER:field)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	return g_LdPlayer[playerid][field];
}

DB_LivingPlayerReset(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	for (new i = 0; i < 8; i++)
	{
		g_LdPlayer[playerid][i] = 0;
	}
	g_LdPlayer[playerid][lpSecsSincePayout] = -1;
}

DB_LdIdx(playerid, cat)
{
	return playerid * 6 + cat;
}

bool:DB_LdOpIdOk(opId[])
{
	new len = strlen(opId);
	return len >= 1 && len <= 36;
}

DB_LdCatOf(action)
{
	switch (action)
	{
		case 1 .. 4:
		{
			return 0;
		}
		case 5, 6:
		{
			return 1;
		}
		case 7 .. 10:
		{
			return 2;
		}
		case 11:
		{
			return 3;
		}
		case 12:
		{
			return 4;
		}
	}
	return 5;
}

DB_LdCharOnline(charId)
{
	if (charId <= 0)
	{
		return 65535;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && gPlayer[i][pCharId] == charId)
		{
			return i;
		}
	}
	return 65535;
}

bool:DB_LdLive(playerid, name[], cat, token, charId)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 0;
	}
	if (charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 0;
	}
	if (!(g_LdPending[playerid] & 1 << cat))
	{
		return 0;
	}
	new idx = DB_LdIdx(playerid, cat);
	return g_LdReq[idx][lqToken] == token && g_LdReq[idx][lqGen] == g_BankGen[playerid];
}

DB_LdStaleRelease(playerid, cat)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid))
	{
		g_LdPending[playerid] &= ~(1 << cat);
	}
}

DB_LdDeliver(playerid, action, result, ref, amount, balance, a, b, c)
{
	switch (DB_LdCatOf(action))
	{
		case 0:
		{
			if (funcidx("Living_OnDBContract") != -1)
			{
				CallLocalFunction("Living_OnDBContract", "ddddddddd", playerid, action, result, ref, amount, balance, a, b, c);
			}
		}
		case 1:
		{
			if (funcidx("Living_OnDBRental") != -1)
			{
				CallLocalFunction("Living_OnDBRental", "dddddddd", playerid, action, result, ref, amount, balance, a, b);
			}
		}
		case 2:
		{
			if (funcidx("Living_OnDBTaxi") != -1)
			{
				CallLocalFunction("Living_OnDBTaxi", "dddddddd", playerid, action, result, ref, amount, balance, a, b);
			}
		}
		case 3:
		{
			if (funcidx("Living_OnDBProject") != -1)
			{
				CallLocalFunction("Living_OnDBProject", "dddddddd", playerid, result, ref, amount, balance, a, b, c);
			}
		}
		case 4:
		{
			if (funcidx("Living_OnDBOnboard") != -1)
			{
				CallLocalFunction("Living_OnDBOnboard", "ddddddd", playerid, result, a, amount, balance, b, c);
			}
		}
		case 5:
		{
			switch (action)
			{
				case 13:
				{
					if (funcidx("Living_OnDBPlayer") != -1)
					{
						CallLocalFunction("Living_OnDBPlayer", "ddd", playerid, result, amount);
					}
				}
				case 14:
				{
					if (funcidx("Living_OnDBBoard") != -1)
					{
						CallLocalFunction("Living_OnDBBoard", "ddd", playerid, result, a);
					}
				}
				case 15:
				{
					if (funcidx("Living_OnDBHistory") != -1)
					{
						CallLocalFunction("Living_OnDBHistory", "dddd", playerid, result, ref, a);
					}
				}
			}
		}
	}
}

bool:DB_LdBegin(playerid, action, bool:valid, ref, aux, opId[], bool:needOp)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new cat = DB_LdCatOf(action);
	if (g_LdPending[playerid] & 1 << cat)
	{
		DB_LdDeliver(playerid, action, 10, ref, 0, 0, 0, 0, 0);
		return 0;
	}
	new charId = gPlayer[playerid][pCharId];
	if (!valid || charId <= 0 || (needOp && !DB_LdOpIdOk(opId)))
	{
		DB_LdDeliver(playerid, action, 9, ref, 0, 0, 0, 0, 0);
		return 0;
	}
	new idx = DB_LdIdx(playerid, cat);
	g_LdReq[idx][lqToken] = ++g_LdTokenSeq;
	g_LdReq[idx][lqGen] = g_BankGen[playerid];
	g_LdReq[idx][lqAction] = action;
	g_LdReq[idx][lqCharId] = charId;
	g_LdReq[idx][lqRef] = ref;
	g_LdReq[idx][lqAux] = aux;
	g_LdReq[idx][lqOpId][0] = 0;
	strcat(g_LdReq[idx][lqOpId], opId, 37);
	if (!DB_IsReady())
	{
		DB_LdDeliver(playerid, action, -1, ref, 0, 0, 0, 0, 0);
		return 0;
	}
	g_LdPending[playerid] |= 1 << cat;
	DB_BankFlush(playerid);
	return 1;
}

DB_LdSend(playerid, action, query[], other)
{
	new cat = DB_LdCatOf(action), idx = DB_LdIdx(playerid, cat), name[25], ogen = 0;
	GetPlayerName(playerid, name, 25);
	if (other != INVALID_PLAYER_ID)
	{
		ogen = g_BankGen[other];
		DB_BankFlush(other);
	}
	mysql_tquery(g_DB, query, "DB_OnLdCalled", "dsddddddds", playerid, name, cat, g_LdReq[idx][lqToken], action, g_LdReq[idx][lqCharId], g_LdReq[idx][lqAux], other, ogen, g_LdReq[idx][lqOpId]);
}

DB_LdCompensate(action, charId, aux, opId[], bool:stale)
{
	if (!DB_IsReady() || charId <= 0)
	{
		Log_Write("DBLIVING", "compensazione NON eseguita (db non pronto): verificare a mano");
		return 0;
	}
	new query[1024];
	if (action == 5 && DB_LdOpIdOk(opId))
	{
		mysql_format(g_DB, query, 1024, "CALL sp_rental_undo('%e', %d, %d)", opId, charId, aux > 0 ? aux : 0);
		mysql_tquery(g_DB, query, "DB_OnLdCleanup", "d", charId);
	}
	if (stale && DB_LdCharOnline(charId) == 65535)
	{
		mysql_format(g_DB, query, 1024, "CALL sp_ld_char_cleanup(%d, NULL)", charId);
		mysql_tquery(g_DB, query, "DB_OnLdCleanup", "d", charId);
	}
}

public DB_OnLdCleanup(charId)
{
	return 1;
}

public DB_OnLdCalled(playerid, name[], cat, token, action, charId, aux, other, otherGen, opId[])
{
	new query[1024];
	mysql_format(g_DB, query, 1024, "SELECT result, ref, amount, balance_after, other_character_id, other_amount, other_balance_after, v1, v2, v3 FROM ld_ops WHERE op_id = '%e'", opId);
	mysql_tquery(g_DB, query, "DB_OnLdResult", "dsddddddds", playerid, name, cat, token, action, charId, aux, other, otherGen, opId);
	return 1;
}

public DB_OnLdResult(playerid, name[], cat, token, action, charId, aux, other, otherGen, opId[])
{
	new rows = 0, result = -1, ref = 0, amount = 0, balance = 0, ochar = 0, oamount = 0, obalance = 0, v1 = 0, v2 = 0, v3 = 0;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "result", result);
		cache_get_value_name_int(0, "ref", ref);
		cache_get_value_name_int(0, "amount", amount);
		cache_get_value_name_int(0, "balance_after", balance);
		cache_get_value_name_int(0, "other_character_id", ochar);
		cache_get_value_name_int(0, "other_amount", oamount);
		cache_get_value_name_int(0, "other_balance_after", obalance);
		cache_get_value_name_int(0, "v1", v1);
		cache_get_value_name_int(0, "v2", v2);
		cache_get_value_name_int(0, "v3", v3);
	}
	new bool:live = DB_LdLive(playerid, name, cat, token, charId);
	new bool:paid = result == 1 || result == 6;
	if (action == 8 && other >= 0 && other < MAX_PLAYERS && IsPlayerConnected(other) && ochar > 0 && gPlayer[other][pCharId] == ochar && g_BankGen[other] == otherGen)
	{
		if (paid && oamount > 0)
		{
			DB_BankMirror(other, -oamount);
		}
		if (funcidx("Living_OnDBTaxiCharged") != -1)
		{
			CallLocalFunction("Living_OnDBTaxiCharged", "ddddd", other, ref, result, paid ? oamount : 0, obalance);
		}
	}
	if (!live)
	{
		DB_LdCompensate(action, charId, aux, opId, 1);
		DB_LdStaleRelease(playerid, cat);
		return 1;
	}
	g_LdPending[playerid] &= ~(1 << cat);
	if (result == -1)
	{
		if (action == 5)
		{
			DB_LivingRentUndo(playerid, charId, aux, opId);
		}
		DB_LdDeliver(playerid, action, -1, g_LdReq[DB_LdIdx(playerid, cat)][lqRef], 0, 0, 0, 0, 0);
		return 1;
	}
	switch (action)
	{
		case 4:
		{
			if (paid && amount > 0)
			{
				DB_BankMirror(playerid, amount);
			}
		}
		case 5:
		{
			if (result == 1)
			{
				DB_BankMirror(playerid, -(amount - oamount));
				if (aux > oamount)
				{
					gPlayer[playerid][pMoney] += aux - oamount;
				}
			}
			else if (aux > 0)
			{
				gPlayer[playerid][pMoney] += aux;
			}
		}
		case 6:
		{
			if (result == 1 || result == 5)
			{
				if (amount > 0)
				{
					DB_BankMirror(playerid, amount);
				}
			}
		}
		case 8:
		{
			if (paid && amount > 0)
			{
				DB_BankMirror(playerid, amount);
			}
		}
		case 11:
		{
			if (result == 1)
			{
				DB_BankMirror(playerid, -amount);
			}
		}
		case 12:
		{
			if (result == 1 && amount > 0)
			{
				DB_BankMirror(playerid, amount);
			}
		}
	}
	switch (action)
	{
		case 5:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, oamount, v1, 0);
		}
		case 6:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, 0, 0);
		}
		case 8:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, v3, 0);
		}
		case 7, 9, 10:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, v2, 0);
		}
		case 11:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, v2, v3);
		}
		case 12:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, v2, v3);
		}
		default:
		{
			DB_LdDeliver(playerid, action, result, ref, amount, balance, v1, v2, v3);
		}
	}
	return 1;
}

DB_LivingRentUndo(playerid, charId, cash, opId[])
{
	if (!DB_IsReady() || !DB_LdOpIdOk(opId))
	{
		Log_Write("DBLIVING", "undo noleggio NON eseguito (db non pronto): verificare a mano");
		return 0;
	}
	new query[1024], name[25];
	GetPlayerName(playerid, name, 25);
	mysql_format(g_DB, query, 1024, "CALL sp_rental_undo('%e', %d, %d)", opId, charId, cash > 0 ? cash : 0);
	mysql_tquery(g_DB, query, "DB_OnLdUndoCalled", "dsdds", playerid, name, g_BankGen[playerid], charId, opId);
}

public DB_OnLdUndoCalled(playerid, name[], gen, charId, opId[])
{
	new query[1024];
	mysql_format(g_DB, query, 1024, "SELECT amount FROM ld_ops WHERE op_id = CONCAT('%e', '-x')", opId);
