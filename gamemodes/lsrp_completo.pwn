public Job_OnDBPayout(playerid, jobId, amount, result)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (!g_JpPending[playerid] || g_JpJob[playerid] != jobId || g_JpAmount[playerid] != amount)
	{
		return 1;
	}
	g_JpPending[playerid] = false;
	new cap = g_JpCap[playerid];
	new bool:completed = g_JpCompleted[playerid];
	g_JpCap[playerid] = 0;
	g_JpAmount[playerid] = 0;
	if (result != 1)
	{
		Job_RollHour(playerid);
		g_JcHourEarned[playerid][jobId] -= cap;
		if (g_JcHourEarned[playerid][jobId] < 0)
		{
			g_JcHourEarned[playerid][jobId] = 0;
		}
		SendClientMessage(playerid, -10270721, result < 0 ? "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;." : "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;.");
		new msg[384];
		format(msg, 384, "payout non accreditato job %d importo %d esito %d char %d", jobId, amount, result, gPlayer[playerid][pCharId]);
		Log_Write("JOB", msg);
		return 1;
	}
	new paid = Economy_PaycheckPaid(amount, Money_BankRoom(playerid));
	if (paid > 0 && Money_GiveBank(playerid, paid, "job", ""))
	{
		SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: $%d \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA8;\xE1;\x83;\x98;. \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x98;: $%d.", paid, gPlayer[playerid][pBank]);
		if (paid < amount)
		{
			SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9B;\xE1;\x83;\x90; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\x90;.");
		}
	}
	else
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x90;.");
	}
	g_JcSessEarned[playerid] += amount;
	if (completed)
	{
		g_JcSessRuns[playerid]++;
		Job_RollHour(playerid);
		if (g_JcHourExp[playerid] < 4)
		{
			new gain = 1;
			if (g_JcHourExp[playerid] + gain > 4)
			{
				gain = 4 - g_JcHourExp[playerid];
			}
			g_JcHourExp[playerid] += gain;
			Level_AddExp(playerid, gain);
		}
	}
	Char_Save(playerid);
	return 1;
}

Job_StepDone(playerid, now)
{
	new job = g_JsJob[playerid], total = g_JobSteps[job];
	new Float:tx, Float:ty, Float:tz;
	Job_TargetPos(playerid, tx, ty, tz);
	new Float:dx = (tx - g_JsLastPos[playerid][0]), Float:dy = (ty - g_JsLastPos[playerid][1]), Float:dz = (tz - g_JsLastPos[playerid][2]);
	new Float:dist = floatsqroot((((dx * dx) + (dy * dy)) + (dz * dz))), elapsedMs = now - g_JsLastCpTick[playerid];
	if (elapsedMs < 400 || ((dist * float(1000)) > (40.0 * float(elapsedMs))))
	{
		new name[75], msg[384];
		GetPlayerName(playerid, name, 75);
		format(msg, 384, "tratta non valida: %s job %d tappa %d dist %.0f m in %d ms", name, job, g_JsStep[playerid], dist, elapsedMs);
		Log_Write("JOB", msg);
		Job_Cancel(playerid, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94; (\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98;-\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\x96; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;).");
		return 0;
	}
	g_JsLastPos[playerid][0] = tx;
	g_JsLastPos[playerid][1] = ty;
	g_JsLastPos[playerid][2] = tz;
	g_JsLastCpTick[playerid] = now;
	g_JsDwelling[playerid] = false;
	if (g_JsStep[playerid] >= total)
