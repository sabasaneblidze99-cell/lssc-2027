Inv_ShopList(playerid)
{
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\x98;: /compra [\xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;] [\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;] ---");
	new line[256], part[192];
	line[0] = 0;
	for (new i = 1; i <= 11; i++)
	{
		if (s_InvPrice[i] <= 0)
		{
			continue;
		}
		format(part, 192, "%s $%d  ", s_InvShopKey[i], s_InvPrice[i]);
		strcat(line, part, 256);
	}
	Util_Send(playerid, 0x99CCFFFF, line);
	Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x93; (\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;. 12 \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;) \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\x98;; \xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98; /usa pasto-\xE1;\x83;\x97;\xE1;\x83;\x98;.");
}

Inv_Buy(playerid, itemId, qty)
{
	if (!Inv_Guard(playerid))
	{
		return 0;
	}
	if (itemId == 11)
	{
		Inv_BuyBag(playerid);
		return 0;
	}
	if (itemId < 1 || itemId > 10 || s_InvPrice[itemId] <= 0)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		return 0;
	}
	new stack = DB_InvStackMax(itemId);
	if (qty < 1 || qty > stack)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; (1-%d).", stack);
		return 0;
	}
	new maxTotal = 0;
	if (itemId == 1)
	{
		maxTotal = 12;
	}
	else if (itemId == 9)
	{
		maxTotal = 1;
	}
	if (maxTotal > 0 && Inv_Count(playerid, itemId) + qty > maxTotal)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\x9B; %d \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\xA5;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA1;.", maxTotal);
		return 0;
	}
	new cost = s_InvPrice[itemId] * qty;
	if (!Money_Can(playerid, cost))
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x90; $%d \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;.", cost);
		return 0;
	}
	Inv_BeginOp(playerid, 5, itemId, qty, cost);
	DB_InvBuy(playerid, gPlayer[playerid][pCharId], itemId, qty, gPlayer[playerid][pInvOpId], maxTotal);
	return 0;
}

Inv_BuyBag(playerid)
{
	if (gPlayer[playerid][pInvHasBag] != 0)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x96;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x92;\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x97;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return 0;
	}
	if (!Money_Can(playerid, 350))
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x90; $%d \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;.", 350);
		return 0;
	}
	Inv_BeginOp(playerid, 6, 11, 1, 350);
	DB_InvSetBag(playerid, gPlayer[playerid][pCharId], gPlayer[playerid][pInvOpId]);
	return 0;
}

Inv_UndoPurchase(playerid)
{
	gPlayer[playerid][pInvUndoOpId][0] = 0;
	strcat(gPlayer[playerid][pInvUndoOpId], gPlayer[playerid][pInvOpId], 33);
	Inv_Say(playerid, -10270721, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;: \xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
	DB_InvUndo(gPlayer[playerid][pInvUndoOpId]);
}

public Inv_OnDBBought(playerid, itemId, qty, result)
{
	if (!Inv_OpIs(playerid, 5))
	{
		return 1;
	}
	new cost = gPlayer[playerid][pInvOpAux];
	if (result == 1)
	{
		if (!Money_Take(playerid, cost))
		{
			Inv_UndoPurchase(playerid);
			return 1;
		}
		Char_Save(playerid);
		Inv_EndOp(playerid);
		Inv_Reload(playerid);
		UI_InvToast(playerid, itemId, qty);
		SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94; %s x%d $%d-\xE1;\x83;\x90;\xE1;\x83;\x93;.", s_InvName[itemId], qty, cost);
		return 1;
	}
	Inv_EndOp(playerid);
	switch (result)
	{
		case 2:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; (\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;).");
		}
