{
	if (!UI_FcValid(playerid) || !g_UiFHudCreated[playerid] || !g_UiFHudShown[playerid])
	{
		return 0;
	}
	if (faction < 1 || faction > 2 || rank < 1 || rank > 6)
	{
		return 0;
	}
	UI_FhApply(playerid, faction, rank, kitCharges);
	return 0;
}

