new g_FacTimer;

Fac_CdLeftMs(bool:isSet, last, cooldownMs)
{
	if (!isSet)
	{
		return 0;
	}
	new elapsed = GetTickCount() - last;
	if (elapsed < 0 || elapsed >= cooldownMs)
	{
		return 0;
	}
	return cooldownMs - elapsed;
}

Fac_SecCeil(ms)
{
	if (ms <= 0)
	{
		return 0;
	}
	return (ms + 1000 - 1) / 1000;
}

Faction_ResetPlayer(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_FcCmdSet[playerid] = 0;
	g_FcCmdLast[playerid] = 0;
	g_FcDutySet[playerid] = 0;
	g_FcDutyLast[playerid] = 0;
	g_FcRadioSet[playerid] = 0;
	g_FcRadioLast[playerid] = 0;
	g_FcCuffSet[playerid] = 0;
	g_FcCuffLast[playerid] = 0;
	g_FcHealSet[playerid] = 0;
	g_FcHealLast[playerid] = 0;
	g_FcHealTgtSet[playerid] = 0;
	g_FcHealTgtLast[playerid] = 0;
	g_FcPrevArmor[playerid] = 0.0;
	g_FcPayMs[playerid] = 0;
	g_FcStillMs[playerid] = 0;
	g_FcLastPos[playerid][0] = 0.0;
	g_FcLastPos[playerid][1] = 0.0;
	g_FcLastPos[playerid][2] = 0.0;
	g_FcKit[playerid] = 0;
	g_FcKitSet[playerid] = 0;
	g_FcKitRefillLast[playerid] = 0;
	g_FcCuffBy[playerid] = 65535;
	g_FcCuffTick[playerid] = 0;
	g_FcInjLeftMs[playerid] = 0;
	g_FcInjSec[playerid] = -1;
	g_FcHospPending[playerid] = 0;
	g_FcRevTarget[playerid] = 65535;
	g_FcRevTargetChar[playerid] = 0;
	g_FcRevStart[playerid] = 0;
	g_FcReviveBucket[playerid] = 0;
	g_FcReviveCount[playerid] = 0;
	g_FcInvActive[playerid] = 0;
	g_FcInvFrom[playerid] = 65535;
	g_FcInvFromChar[playerid] = 0;
	g_FcInvFac[playerid] = 0;
	g_FcInvStart[playerid] = 0;
	g_FcJoinPending[playerid] = 0;
	g_FcFineBusy[playerid] = 0;
	g_FcFineTarget[playerid] = 0;
	g_FcFineReason[playerid][0] = 0;
	g_FcFinePend[playerid] = 0;
	g_FcFineTgtSet[playerid] = 0;
	g_FcFineTgtLast[playerid] = 0;
	g_FcFineBucket[playerid] = 0;
	g_FcFineSum[playerid] = 0;
	g_FcMemBusy[playerid] = 0;
	g_FcMemBusyTick[playerid] = 0;
	g_FcMemMode[playerid] = 0;
	g_FcMemCount[playerid] = 0;
	g_FcOpName[playerid][0] = 0;
	g_FcSetActive[playerid] = 0;
	g_FcSetTargetChar[playerid] = 0;
	g_FcSetTargetAcc[playerid] = 0;
	g_FcSetStaffAcc[playerid] = 0;
	g_FcSetFac[playerid] = 0;
	g_FcSetRank[playerid] = 0;
	g_FcSetName[playerid][0] = 0;
	g_FcSetStaffName[playerid][0] = 0;
}

Fac_ShortName(faction, out[], size)
{
	out[0] = 0;
	if (faction < 0 || faction > 2)
	{
		faction = 0;
	}
	strcat(out, g_FacShort[faction], size);
}

Fac_RankName(faction, rank, out[], size)
{
	if (faction < 1 || faction > 2 || rank < 1 || rank > 6)
	{
		format(out, size, "-");
		return 0;
	}
	format(out, size, "%s", g_FacRankName[faction][rank]);
}

Faction_UpdateControl(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	new bool:lock = gPlayer[playerid][pFrozen] || gPlayer[playerid][pCuffed] || gPlayer[playerid][pWounded];
	TogglePlayerControllable(playerid, !lock);
}

Fac_FindByChar(charId)
{
	if (charId <= 0)
	{
		return 65535;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && gPlayer[i][pLoggedIn] && gPlayer[i][pCharId] == charId)
		{
			return i;
		}
	}
	return 65535;
}

bool:Fac_ValidPlayer(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid);
}

bool:Fac_CmdBlocked(playerid)
{
	new left = Fac_CdLeftMs(g_FcCmdSet[playerid], g_FcCmdLast[playerid], 1500);
	if (left > 0)
	{
		SendClientMessage(playerid, -10270721, "Attendi %d secondi prima di un altro comando di fazione.", Fac_SecCeil(left));
		return 1;
	}
	g_FcCmdSet[playerid] = 1;
	g_FcCmdLast[playerid] = GetTickCount();
	return 0;
}

bool:Fac_NeedMember(playerid, faction)
{
	new f = gPlayer[playerid][pFaction];
	if (f < 1 || f > 2 || gPlayer[playerid][pFactionRank] < 1 || (faction != 0 && f != faction))
	{
		Util_Send(playerid, -10270721, "Non sei autorizzato a usare questo comando.");
		return 0;
	}
	return 1;
}

bool:Fac_NeedActive(playerid)
{
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed])
	{
		Util_Send(playerid, -10270721, "Non puoi farlo nelle tue condizioni.");
		return 0;
	}
	return 1;
}

bool:Fac_NeedDuty(playerid)
{
	if (!gPlayer[playerid][pOnDuty])
	{
		Util_Send(playerid, -10270721, "Devi essere in servizio (/duty vicino alla sede).");
		return 0;
	}
	return 1;
}

bool:Fac_ParseTarget(playerid, token[], &targetid)
{
	if (!Util_ParsePlayerId(token, targetid) || !Util_IsPlaying(targetid))
	{
		Util_Send(playerid, -10270721, "Giocatore non valido.");
		return 0;
	}
	return 1;
}

Fac_Emote(playerid, text[])
{
	new name[25], msg[256];
	GetPlayerName(playerid, name, 25);
	format(msg, 256, "* %s %s", name, text);
	Util_SendNear(playerid, 0xC2A2DAFF, 20.0, msg);
}

Fac_FineCap(rank)
{
	switch (rank)
	{
		case 2:
		{
			return 500;
		}
		case 3:
		{
			return 1000;
		}
		case 4:
		{
			return 2500;
		}
		case 5:
		{
			return 5000;
		}
		case 6:
		{
			return 5000;
		}
	}
	return 0;
}

Fac_KitHudValue(playerid)
{
	return gPlayer[playerid][pFaction] == 2 ? g_FcKit[playerid] : -1;
}

Fac_Radio(faction, bool:both, color, text[])
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!Util_IsPlaying(i) || !gPlayer[i][pOnDuty])
		{
			continue;
		}
		if (!both && gPlayer[i][pFaction] != faction)
		{
			continue;
		}
		Util_Send(i, color, text);
	}
}

Fac_UniformSkin(playerid)
{
	new f = gPlayer[playerid][pFaction], r = gPlayer[playerid][pFactionRank];
	if (f < 1 || f > 2 || r < 1 || r > 6)
	{
		return gPlayer[playerid][pCivilSkin];
	}
	if (Valid_SkinAllowed(1, gPlayer[playerid][pCivilSkin]))
	{
		return g_FacSkinFemale[f];
	}
	return g_FacRankSkin[f][r];
}

Fac_ApplyUniform(playerid)
{
	new skin = Fac_UniformSkin(playerid);
	SetPlayerSkin(playerid, skin);
	gPlayer[playerid][pSkin] = skin;
}

Fac_GiveKit(playerid)
{
	if (gPlayer[playerid][pFaction] == 1)
	{
		ResetPlayerWeapons(playerid);
		GivePlayerWeapon(playerid, 3, 1);
		GivePlayerWeapon(playerid, 22, 51);
		GivePlayerWeapon(playerid, 41, 100);
		SetPlayerArmour(playerid, 50.0);
		return 0;
	}
	if (!g_FcKitSet[playerid] || Fac_CdLeftMs(1, g_FcKitRefillLast[playerid], 900000) == 0)
	{
		g_FcKitSet[playerid] = 1;
		g_FcKit[playerid] = 8;
		g_FcKitRefillLast[playerid] = GetTickCount();
	}
}

Fac_ReleaseCuffedBy(agentid)
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (gPlayer[i][pCuffed] && g_FcCuffBy[i] == agentid)
		{
			Fac_Uncuff(i);
		}
	}
}

Faction_ForceOff(playerid, bool:applyWorld)
{
	if (!gPlayer[playerid][pOnDuty])
	{
		return 0;
	}
	gPlayer[playerid][pOnDuty] = 0;
	g_FcRevTarget[playerid] = 65535;
	g_FcPayMs[playerid] = 0;
	g_FcStillMs[playerid] = 0;
	if (IsPlayerConnected(playerid))
	{
		UI_FactionHudHide(playerid);
		if (applyWorld)
		{
			SetPlayerSkin(playerid, gPlayer[playerid][pCivilSkin]);
			ResetPlayerWeapons(playerid);
			SetPlayerArmour(playerid, g_FcPrevArmor[playerid]);
		}
	}
	gPlayer[playerid][pSkin] = gPlayer[playerid][pCivilSkin];
	Fac_ReleaseCuffedBy(playerid);
}

Fac_DutyOn(playerid)
{
	new f = gPlayer[playerid][pFaction];
	new Float:ar;
	GetPlayerArmour(playerid, ar);
	g_FcPrevArmor[playerid] = ar;
	gPlayer[playerid][pOnDuty] = 1;
	g_FcPayMs[playerid] = 0;
	g_FcStillMs[playerid] = 0;
	GetPlayerPos(playerid, g_FcLastPos[playerid][0], g_FcLastPos[playerid][1], g_FcLastPos[playerid][2]);
	Fac_ApplyUniform(playerid);
	Fac_GiveKit(playerid);
	UI_FactionHudShow(playerid, f, gPlayer[playerid][pFactionRank]);
	UI_FactionHudUpdate(playerid, f, gPlayer[playerid][pFactionRank], Fac_KitHudValue(playerid));
	new rn[24];
	Fac_RankName(f, gPlayer[playerid][pFactionRank], rn, 24);
	SendClientMessage(playerid, 0x66DD66FF, "Sei in servizio (%s - %s).", g_FacShort[f], rn);
	Fac_Emote(playerid, "indossa la divisa ed entra in servizio");
}

Faction_CmdDuty(playerid)
{
	if (!Fac_NeedMember(playerid, 0) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed] || Job_IsOnShift(playerid))
	{
		Util_Send(playerid, -10270721, "Non puoi cambiare servizio adesso (ferito, ammanettato o turno di lavoro in corso).");
		return 0;
	}
	new f = gPlayer[playerid][pFaction];
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0 || (GetPlayerDistanceFromPoint(playerid, g_FacHq[f][0], g_FacHq[f][1], g_FacHq[f][2]) > 15.0))
	{
		Util_Send(playerid, -10270721, "Devi essere vicino alla sede della tua fazione.");
		return 0;
	}
	new left = Fac_CdLeftMs(g_FcDutySet[playerid], g_FcDutyLast[playerid], 120000);
	if (left > 0)
	{
		SendClientMessage(playerid, -10270721, "Attendi ancora %d secondi prima di cambiare servizio.", Fac_SecCeil(left));
		return 0;
	}
	if (!gPlayer[playerid][pOnDuty] && Admin_CheckMuted(playerid))
	{
		return 0;
	}
	g_FcDutySet[playerid] = 1;
	g_FcDutyLast[playerid] = GetTickCount();
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, 1);
		Util_Send(playerid, 0x66DD66FF, "Sei fuori servizio.");
		Fac_Emote(playerid, "si toglie la divisa ed esce dal servizio");
	}
	else
	{
		Fac_DutyOn(playerid);
	}
}

Fac_PayTick(playerid, now)
{
	if (now - gPlayer[playerid][pLastActiveTick] > 10000)
	{
		return 0;
	}
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	new Float:dx = (x - g_FcLastPos[playerid][0]), Float:dy = (y - g_FcLastPos[playerid][1]), Float:dz = (z - g_FcLastPos[playerid][2]);
	if ((floatsqroot((((dx * dx) + (dy * dy)) + (dz * dz))) < 0.5))
	{
		g_FcStillMs[playerid] += 500;
	}
	else
	{
		g_FcStillMs[playerid] = 0;
		g_FcLastPos[playerid][0] = x;
		g_FcLastPos[playerid][1] = y;
		g_FcLastPos[playerid][2] = z;
	}
	if (g_FcStillMs[playerid] > 120000)
	{
		return 0;
	}
	g_FcPayMs[playerid] += 500;
	if (g_FcPayMs[playerid] < 900000)
	{
		return 0;
	}
	g_FcPayMs[playerid] -= 900000;
	new f = gPlayer[playerid][pFaction], amount = g_FacRankPay[f][gPlayer[playerid][pFactionRank]];
	new paid = Economy_PaycheckPaid(amount, Money_BankRoom(playerid));
	if (paid > 0 && Money_GiveBank(playerid, paid, "faction", ""))
	{
		SendClientMessage(playerid, 0x66DD66FF, "Stipendio %s: $%d versati in banca (in aggiunta al paycheck). Saldo: $%d.", g_FacShort[f], paid, gPlayer[playerid][pBank]);
		Char_Save(playerid);
	}
	else
	{
		Util_Send(playerid, -10270721, "Il conto bancario e' al limite: stipendio di fazione non versato.");
	}
}

Fac_Uncuff(targetid)
{
	if (!gPlayer[targetid][pCuffed])
	{
		return 0;
	}
	gPlayer[targetid][pCuffed] = 0;
	g_FcCuffBy[targetid] = 65535;
	g_FcCuffTick[targetid] = 0;
	if (IsPlayerConnected(targetid))
	{
		SetPlayerSpecialAction(targetid, 0);
		ClearAnimations(targetid, 0);
		Faction_UpdateControl(targetid);
		Util_Send(targetid, 0x66DD66FF, "Sei stato liberato dalle manette.");
	}
}

Faction_CmdAmmanetta(playerid, params[], bool:cuff)
{
	if (!Fac_NeedMember(playerid, 1) || !Fac_NeedDuty(playerid) || !Fac_NeedActive(playerid) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new pos = 0, tok[12], target = 0;
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, cuff ? "Uso: /ammanetta id" : "Uso: /smanetta id");
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tok, target))
	{
		return 0;
	}
	if (target == playerid || !Util_InRange(playerid, target, 2.0))
	{
		Util_Send(playerid, -10270721, "Bersaglio non valido o troppo lontano.");
		return 0;
	}
	new tn[25], an[25], msg[128];
	GetPlayerName(playerid, an, 25);
	GetPlayerName(target, tn, 25);
	if (cuff)
	{
		new left = Fac_CdLeftMs(g_FcCuffSet[playerid], g_FcCuffLast[playerid], 10000);
		if (left > 0)
		{
			SendClientMessage(playerid, -10270721, "Attendi ancora %d secondi.", Fac_SecCeil(left));
			return 0;
		}
		if (gPlayer[target][pCuffed] || gPlayer[target][pWounded] || GetPlayerState(target) != 1)
		{
			Util_Send(playerid, -10270721, "Il bersaglio non puo' essere ammanettato (gia' ammanettato, ferito o non a piedi).");
			return 0;
		}
		g_FcCuffSet[playerid] = 1;
		g_FcCuffLast[playerid] = GetTickCount();
		gPlayer[target][pCuffed] = 1;
		g_FcCuffBy[target] = playerid;
		g_FcCuffTick[target] = GetTickCount();
		Job_Cancel(target, "sei stato ammanettato.");
		Faction_UpdateControl(target);
		SetPlayerSpecialAction(target, 24);
		format(msg, 128, "ammanetta %s", tn);
		Fac_Emote(playerid, msg);
		DB_FactionLogAdd(1, gPlayer[playerid][pCharId], gPlayer[target][pCharId], "cuff", "");
		return 0;
	}
	if (!gPlayer[target][pCuffed])
	{
		Util_Send(playerid, -10270721, "Il bersaglio non e' ammanettato.");
		return 0;
	}
	Fac_Uncuff(target);
	format(msg, 128, "toglie le manette a %s", tn);
	Fac_Emote(playerid, msg);
	DB_FactionLogAdd(1, gPlayer[playerid][pCharId], gPlayer[target][pCharId], "uncuff", "");
}

Faction_CmdRadio(playerid, params[], bool:interdept)
{
	if (!Fac_NeedMember(playerid, 0) || !Fac_NeedDuty(playerid) || !Fac_NeedActive(playerid))
	{
		return 0;
	}
	if (Admin_CheckMuted(playerid))
	{
		return 0;
	}
	new text[97];
	if (!Util_SanitizeText(params, text, 96))
	{
		Util_Send(playerid, 0x99CCFFFF, interdept ? "Uso: /dep testo" : "Uso: /r testo");
		return 0;
	}
	new left = Fac_CdLeftMs(g_FcRadioSet[playerid], g_FcRadioLast[playerid], 1000);
	if (left > 0)
	{
		Util_Send(playerid, -10270721, "Rallenta con la radio.");
		return 0;
	}
	g_FcRadioSet[playerid] = 1;
	g_FcRadioLast[playerid] = GetTickCount();
	new f = gPlayer[playerid][pFaction], rn[24], name[25], msg[256];
	Fac_RankName(f, gPlayer[playerid][pFactionRank], rn, 24);
	GetPlayerName(playerid, name, 25);
	if (interdept)
	{
		format(msg, 256, "[DIP] %s %s %s: %s", g_FacShort[f], rn, name, text);
		Fac_Radio(f, 1, -4698625, msg);
	}
	else
	{
		format(msg, 256, "[RADIO] %s %s: %s", rn, name, text);
		Fac_Radio(f, 0, 0x8D8DFFFF, msg);
	}
}

Faction_CmdMulta(playerid, params[])
{
	if (!Fac_NeedMember(playerid, 1) || !Fac_NeedDuty(playerid) || !Fac_NeedActive(playerid) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new rank = gPlayer[playerid][pFactionRank], cap = Fac_FineCap(rank);
	if (cap <= 0)
	{
		SendClientMessage(playerid, -10270721, "Il tuo grado non consente di emettere multe (minimo grado 2).");
		return 0;
	}
	new pos = 0, tid[12], tam[12], target = 0, amount = 0, reason[65];
	Util_NextToken(params, pos, tid, 12);
	Util_NextToken(params, pos, tam, 12);
	if (tid[0] == 0 || tam[0] == 0 || !Util_ParseInt(tam, amount) || !Util_SanitizeText(params[pos], reason, 64))
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /multa id importo motivo");
		return 0;
	}
	if (strlen(reason) < 3)
	{
		SendClientMessage(playerid, -10270721, "Motivo troppo corto (minimo %d caratteri).", 3);
		return 0;
	}
	for (new i = 0; reason[i] != 0; i++)
	{
		if (reason[i] == 37)
		{
			reason[i] = 35;
		}
	}
	if (amount < 50 || amount > cap)
	{
		SendClientMessage(playerid, -10270721, "Importo non valido: da $%d a $%d per il tuo grado.", 50, cap);
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tid, target))
	{
		return 0;
	}
	if (target == playerid || !Util_InRange(playerid, target, 5.0))
	{
		Util_Send(playerid, -10270721, "Bersaglio non valido o troppo lontano.");
		return 0;
	}
	if (g_FcFineBusy[playerid] || g_FcFinePend[target])
	{
		Util_Send(playerid, -10270721, "Una multa e' gia' in corso di registrazione: attendi.");
		return 0;
	}
	new left = Fac_CdLeftMs(g_FcFineTgtSet[target], g_FcFineTgtLast[target], 600000);
	if (left > 0)
	{
		SendClientMessage(playerid, -10270721, "Questo cittadino e' stato multato da poco: riprova tra %d minuti.", (Fac_SecCeil(left) + 60 - 1) / 60);
		return 0;
	}
	new bucket = gPlayer[playerid][pSessionMs] / 3600000;
	if (bucket != g_FcFineBucket[playerid])
	{
		g_FcFineBucket[playerid] = bucket;
		g_FcFineSum[playerid] = 0;
	}
	if (g_FcFineSum[playerid] + amount > 10000)
	{
		SendClientMessage(playerid, -10270721, "Hai raggiunto il limite orario di multe ($%d).", 10000);
		return 0;
	}
	if (gPlayer[target][pMoney] + gPlayer[target][pBank] < amount)
	{
		Util_Send(playerid, -10270721, "Il cittadino non ha fondi sufficienti: multa rifiutata.");
		return 0;
	}
	g_FcFineBusy[playerid] = 1;
	g_FcFineTarget[playerid] = gPlayer[target][pCharId];
	g_FcFinePend[target] = 1;
	strmid(g_FcFineReason[playerid], reason, 0, strlen(reason), 65);
	DB_AddFine(playerid, gPlayer[playerid][pCharId], gPlayer[target][pCharId], 1, amount, reason);
}

Fac_Debit(playerid, amount)
{
	new taken = 0, cash = gPlayer[playerid][pMoney] < amount ? gPlayer[playerid][pMoney] : amount;
	if (cash > 0 && Money_Take(playerid, cash))
	{
		taken += cash;
	}
	new rest = amount - taken;
	if (rest > 0)
	{
		new bank = gPlayer[playerid][pBank] < rest ? gPlayer[playerid][pBank] : rest;
		if (bank > 0 && Money_TakeBank(playerid, bank, "fine", ""))
		{
			taken += bank;
		}
	}
	return taken;
}

public Fine_OnDBAdded(playerid, targetChar, fineId, amount)
{
	new target = Fac_FindByChar(targetChar), issuer = Fac_ValidPlayer(playerid) ? playerid : 65535;
	new reason[65], bool:hasReason = 0;
	if (issuer != INVALID_PLAYER_ID)
	{
		if (g_FcFineBusy[issuer] && g_FcFineTarget[issuer] == targetChar)
		{
			g_FcFineBusy[issuer] = 0;
			strmid(reason, g_FcFineReason[issuer], 0, strlen(g_FcFineReason[issuer]), 65);
			hasReason = 1;
		}
		else
		{
			issuer = INVALID_PLAYER_ID;
		}
	}
	if (target != INVALID_PLAYER_ID)
	{
		g_FcFinePend[target] = 0;
	}
	new an[25], msg[128];
	if (issuer != INVALID_PLAYER_ID)
	{
		GetPlayerName(issuer, an, 25);
	}
	else
	{
		format(an, 25, "un agente");
	}
	if (fineId <= 0)
	{
		if (issuer != INVALID_PLAYER_ID)
		{
			Util_Send(issuer, -10270721, fineId < 0 ? "Errore del servizio: multa non registrata, nessun addebito." : "Multa rifiutata dal sistema: nessun addebito.");
		}
		return 1;
	}
	if (target == INVALID_PLAYER_ID)
	{
		format(msg, 128, "multa %d ($%d) registrata ma bersaglio char %d non piu' online: nessun addebito", fineId, amount, targetChar);
		Log_Write("FINE", msg);
		if (issuer != INVALID_PLAYER_ID)
		{
			Util_Send(issuer, -10270721, "Il cittadino si e' disconnesso: la multa e' registrata ma non e' stato possibile addebitarla.");
		}
		return 1;
	}
	new taken = Fac_Debit(target, amount);
	if (taken < amount)
	{
		format(msg, 128, "multa %d: addebitati $%d su $%d (fondi cambiati durante la registrazione)", fineId, taken, amount);
		Log_Write("FINE", msg);
	}
	g_FcFineTgtSet[target] = 1;
	g_FcFineTgtLast[target] = GetTickCount();
	Char_Save(target);
	SendClientMessage(target, -10270721, "Hai ricevuto una multa di $%d da %s%s%s.", taken, an, hasReason ? ": " : "", reason);
	if (issuer != INVALID_PLAYER_ID)
	{
		new bucket = gPlayer[issuer][pSessionMs] / 3600000;
		if (bucket != g_FcFineBucket[issuer])
		{
			g_FcFineBucket[issuer] = bucket;
			g_FcFineSum[issuer] = 0;
		}
		g_FcFineSum[issuer] += amount;
		new tn[25];
		GetPlayerName(target, tn, 25);
		SendClientMessage(issuer, 0x66DD66FF, "Multa #%d di $%d a %s registrata.", fineId, taken, tn);
		format(msg, 128, "consegna una multa a %s", tn);
		Fac_Emote(issuer, msg);
	}
	return 1;
}

Faction_CmdMulte(playerid)
{
	if (gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	DB_LoadFines(playerid, gPlayer[playerid][pCharId]);
}

public Fine_OnDBLoaded(playerid, count)
{
	if (!Fac_ValidPlayer(playerid))
	{
		return 1;
	}
	if (count < 0)
	{
		Util_Send(playerid, -10270721, "Servizio temporaneamente non disponibile: riprova piu' tardi.");
		return 1;
	}
	if (count == 0)
	{
		Util_Send(playerid, -1, "Non hai multe registrate.");
		return 1;
	}
	SendClientMessage(playerid, -2994689, "--- Ultime multe ricevute ---");
	new now = gettime(), ago[24];
	for (new i = 0; i < count && i < 5; i++)
	{
		Admin_FormatDuration(now - g_FineRows[i][frTimestamp], ago, 24);
		SendClientMessage(playerid, -1, "#%d  $%d  %s  (%s)  %s fa", g_FineRows[i][frId], g_FineRows[i][frAmount], g_FineRows[i][frReason], g_FineRows[i][frIssuer], ago);
	}
	return 1;
}

Fac_UseCharge(playerid)
{
	if (g_FcKit[playerid] > 0)
	{
		g_FcKit[playerid]--;
	}
	UI_FactionHudUpdate(playerid, gPlayer[playerid][pFaction], gPlayer[playerid][pFactionRank], g_FcKit[playerid]);
}

Faction_CmdCura(playerid, params[])
{
	if (!Fac_NeedMember(playerid, 2) || !Fac_NeedDuty(playerid) || !Fac_NeedActive(playerid) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new pos = 0, tok[12], target = 0;
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /cura id");
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tok, target))
	{
		return 0;
	}
	if (target == playerid || !Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "Bersaglio non valido o troppo lontano.");
		return 0;
	}
	if (gPlayer[target][pWounded])
	{
		Util_Send(playerid, -10270721, "Il bersaglio e' ferito: usa /rianima.");
		return 0;
	}
	if (g_FcKit[playerid] <= 0)
	{
		Util_Send(playerid, -10270721, "Il kit medico e' esaurito (si ricarica a /duty on).");
		return 0;
	}
	new left = Fac_CdLeftMs(g_FcHealSet[playerid], g_FcHealLast[playerid], 20000);
	if (left > 0)
	{
		SendClientMessage(playerid, -10270721, "Attendi ancora %d secondi.", Fac_SecCeil(left));
		return 0;
	}
	left = Fac_CdLeftMs(g_FcHealTgtSet[target], g_FcHealTgtLast[target], 60000);
	if (left > 0)
	{
		SendClientMessage(playerid, -10270721, "Il paziente e' stato curato da poco: attendi %d secondi.", Fac_SecCeil(left));
		return 0;
	}
	new Float:hp;
	GetPlayerHealth(target, hp);
	if ((hp >= 100.0))
	{
		Util_Send(playerid, -10270721, "Il bersaglio e' in piena salute.");
		return 0;
	}
	hp = (40.0 + hp);
	if ((hp > 100.0))
	{
		hp = 100.0;
	}
	SetPlayerHealth(target, hp);
	g_FcHealSet[playerid] = 1;
	g_FcHealLast[playerid] = GetTickCount();
	g_FcHealTgtSet[target] = 1;
	g_FcHealTgtLast[target] = GetTickCount();
	Fac_UseCharge(playerid);
	new tn[25], msg[128];
	GetPlayerName(target, tn, 25);
	format(msg, 128, "presta le prime cure a %s", tn);
	Fac_Emote(playerid, msg);
	SendClientMessage(target, 0x66DD66FF, "Sei stato curato (salute %.0f).", hp);
	DB_FactionLogAdd(2, gPlayer[playerid][pCharId], gPlayer[target][pCharId], "heal", "");
}

Fac_ReviveCancel(medic, reason[])
{
	g_FcRevTarget[medic] = 65535;
	g_FcRevTargetChar[medic] = 0;
	if (IsPlayerConnected(medic))
	{
		ClearAnimations(medic, 0);
		if (reason[0] != 0)
		{
			Util_Send(medic, -10270721, reason);
		}
	}
}

Faction_CmdRianima(playerid, params[])
{
	if (!Fac_NeedMember(playerid, 2) || !Fac_NeedDuty(playerid) || !Fac_NeedActive(playerid) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new pos = 0, tok[12], target = 0;
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /rianima id");
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tok, target))
	{
		return 0;
	}
	if (target == playerid || !Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "Bersaglio non valido o troppo lontano.");
		return 0;
	}
	if (!gPlayer[target][pWounded])
	{
		Util_Send(playerid, -10270721, "Il bersaglio non e' ferito.");
		return 0;
	}
	if (g_FcKit[playerid] <= 0)
	{
		Util_Send(playerid, -10270721, "Il kit medico e' esaurito (si ricarica a /duty on).");
		return 0;
	}
	if (g_FcRevTarget[playerid] != 65535)
	{
		Util_Send(playerid, -10270721, "Stai gia' rianimando qualcuno.");
		return 0;
	}
	g_FcRevTarget[playerid] = target;
	g_FcRevTargetChar[playerid] = gPlayer[target][pCharId];
	g_FcRevStart[playerid] = GetTickCount();
	ApplyAnimation(playerid, "MEDIC", "CPR", 4.1, 1, 0, 0, 0, 0, 0);
	new tn[25], msg[128];
	GetPlayerName(target, tn, 25);
	format(msg, 128, "inizia a rianimare %s", tn);
	Fac_Emote(playerid, msg);
	SendClientMessage(playerid, -1, "Rianimazione in corso (%d secondi): non allontanarti.", 8);
}

Fac_ReviveDone(medic, target)
{
	g_FcRevTarget[medic] = 65535;
	g_FcRevTargetChar[medic] = 0;
	ClearAnimations(medic, 0);
	gPlayer[target][pWounded] = 0;
	g_FcInjLeftMs[target] = 0;
	SetPlayerHealth(target, 60.0);
	ClearAnimations(target, 0);
	Faction_UpdateControl(target);
	UI_InjuryEndShow(target, 2, 0);
	Fac_UseCharge(medic);
	new mn[25], tn[25], msg[128];
	GetPlayerName(medic, mn, 25);
	GetPlayerName(target, tn, 25);
	SendClientMessage(target, 0x66DD66FF, "%s ti ha rianimato.", mn);
	format(msg, 128, "rianima %s", tn);
	Fac_Emote(medic, msg);
	DB_FactionLogAdd(2, gPlayer[medic][pCharId], gPlayer[target][pCharId], "revive", "");
	new bucket = gPlayer[medic][pSessionMs] / 3600000;
	if (bucket != g_FcReviveBucket[medic])
	{
		g_FcReviveBucket[medic] = bucket;
		g_FcReviveCount[medic] = 0;
	}
	if (g_FcReviveCount[medic] < 6 && Money_GiveBank(medic, 100, "faction", ""))
	{
		g_FcReviveCount[medic]++;
		SendClientMessage(medic, 0x66DD66FF, "Bonus rianimazione: $%d versati in banca.", 100);
		Char_Save(medic);
	}
}

Fac_ApplyInjuredPose(playerid)
{
	ApplyAnimation(playerid, "CRACK", "crckidle2", 4.1, 1, 0, 0, 1, 0, 0);
}

Faction_Hospitalize(playerid)
{
	new fee = Fac_Debit(playerid, 200);
	gPlayer[playerid][pWounded] = 0;
	g_FcInjLeftMs[playerid] = 0;
	g_FcHospPending[playerid] = 0;
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid, 1182.0, -1330.0, 13.9);
	SetPlayerFacingAngle(playerid, 270.0);
	SetCameraBehindPlayer(playerid);
	ClearAnimations(playerid, 0);
	SetPlayerHealth(playerid, 100.0);
	Faction_UpdateControl(playerid);
	UI_InjuryEndShow(playerid, 1, fee);
	Char_Save(playerid);
	new name[25], msg[128];
	GetPlayerName(playerid, name, 25);
	format(msg, 128, "ricovero %s: addebitati $%d", name, fee);
	Log_Write("INJURY", msg);
}

Fac_ClearInvite(targetid, bool:closeDialog)
{
	g_FcInvActive[targetid] = 0;
	g_FcInvFrom[targetid] = 65535;
	g_FcInvFromChar[targetid] = 0;
	g_FcInvFac[targetid] = 0;
	g_FcInvStart[targetid] = 0;
	if (closeDialog && IsPlayerConnected(targetid))
	{
		UI_FactionInviteClose(targetid);
	}
}

Fac_DoInvite(playerid, target)
{
	new f = gPlayer[playerid][pFaction];
	if (f < 1 || gPlayer[playerid][pFactionRank] < 5)
	{
		Util_Send(playerid, -10270721, "Non sei autorizzato a invitare.");
		return 0;
	}
	if (!Fac_NeedActive(playerid))
	{
		return 0;
	}
	if (!Util_IsPlaying(target) || target == playerid)
	{
		Util_Send(playerid, -10270721, "Giocatore non valido.");
		return 0;
	}
	if (!Util_InRange(playerid, target, 5.0))
	{
		Util_Send(playerid, -10270721, "Il giocatore e' troppo lontano.");
		return 0;
	}
	if (gPlayer[target][pFaction] != 0)
	{
		Util_Send(playerid, -10270721, "Il giocatore appartiene gia' a una fazione.");
		return 0;
	}
	if (gPlayer[target][pLevel] < 3)
	{
		SendClientMessage(playerid, -10270721, "Il giocatore deve essere almeno livello %d.", 3);
		return 0;
	}
	if ((g_FcInvActive[target] && Fac_CdLeftMs(1, g_FcInvStart[target], 60000) > 0) || g_FcJoinPending[target])
	{
		Util_Send(playerid, -10270721, "Il giocatore ha gia' un invito in sospeso.");
		return 0;
	}
	g_FcInvActive[target] = 1;
	g_FcInvFrom[target] = playerid;
	g_FcInvFromChar[target] = gPlayer[playerid][pCharId];
	g_FcInvFac[target] = f;
	g_FcInvStart[target] = GetTickCount();
	new an[25], tn[25];
	GetPlayerName(playerid, an, 25);
	GetPlayerName(target, tn, 25);
	UI_FactionInviteShow(target, f, an, 60);
	SendClientMessage(target, -1, "%s ti invita in %s. Accetta dal pannello o con /accetta (valido %d secondi).", an, g_FacShort[f], 60);
	SendClientMessage(playerid, 0x66DD66FF, "Invito inviato a %s.", tn);
}

Faction_CmdInvita(playerid, params[])
{
	if (!Fac_NeedMember(playerid, 0) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new pos = 0, tok[12], target = 0;
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /invita id");
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tok, target))
	{
		return 0;
	}
	Fac_DoInvite(playerid, target);
}

public UI_OnFactionInviteTarget(playerid, targetId)
{
	if (!Util_IsPlaying(playerid) || Fac_CmdBlocked(playerid))
	{
		return 1;
	}
	Fac_DoInvite(playerid, targetId);
	return 1;
}

Fac_InviteReply(playerid, bool:accept)
{
	if (!g_FcInvActive[playerid])
	{
		return 0;
	}
	new from = g_FcInvFrom[playerid], fromChar = g_FcInvFromChar[playerid], f = g_FcInvFac[playerid];
	new bool:expired = Fac_CdLeftMs(1, g_FcInvStart[playerid], 60000) <= 0;
	Fac_ClearInvite(playerid, 0);
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	if (expired)
	{
		Util_Send(playerid, -10270721, "L'invito e' scaduto.");
		return 0;
	}
	if (!accept)
	{
		Util_Send(playerid, -1, "Hai rifiutato l'invito.");
		if (Fac_ValidPlayer(from) && gPlayer[from][pCharId] == fromChar)
		{
			Util_Send(from, -1, "L'invito e' stato rifiutato.");
		}
		return 0;
	}
	if (!Util_IsPlaying(from) || gPlayer[from][pCharId] != fromChar || gPlayer[from][pFaction] != f || gPlayer[from][pFactionRank] < 5)
	{
		Util_Send(playerid, -10270721, "Chi ti ha invitato non e' piu' disponibile.");
		return 0;
	}
	if (gPlayer[playerid][pFaction] != 0 || gPlayer[playerid][pLevel] < 3 || g_FcJoinPending[playerid])
	{
		Util_Send(playerid, -10270721, "Non puoi entrare in una fazione adesso.");
		return 0;
	}
	g_FcJoinPending[playerid] = 1;
	GetPlayerName(playerid, g_FcOpName[from], 25);
	DB_FactionJoin(from, fromChar, gPlayer[playerid][pCharId], f);
}

public UI_OnFactionInviteReply(playerid, accept)
{
	Fac_InviteReply(playerid, accept != 0);
	return 1;
}

Faction_CmdAccetta(playerid)
{
	if (!g_FcInvActive[playerid])
	{
		Util_Send(playerid, -10270721, "Non hai inviti in sospeso.");
		return 0;
	}
	UI_FactionInviteClose(playerid);
	Fac_InviteReply(playerid, 1);
}

Fac_DoRankOp(playerid, action, targetChar, targetRank, targetName[])
{
	new f = gPlayer[playerid][pFaction], own = gPlayer[playerid][pFactionRank];
	if (f < 1 || own < 5)
	{
		Util_Send(playerid, -10270721, "Non sei autorizzato.");
		return 0;
	}
	if (!Fac_NeedActive(playerid))
	{
		return 0;
	}
	if (targetChar <= 0 || targetChar == gPlayer[playerid][pCharId])
	{
		Util_Send(playerid, -10270721, "Bersaglio non valido.");
		return 0;
	}
	if (targetRank < 1 || targetRank >= own)
	{
		Util_Send(playerid, -10270721, "Puoi agire solo su membri di grado inferiore al tuo.");
		return 0;
	}
	strmid(g_FcOpName[playerid], targetName, 0, strlen(targetName), 25);
	switch (action)
	{
		case 4:
		{
			if (targetRank + 1 >= own)
			{
				Util_Send(playerid, -10270721, "Il nuovo grado deve restare inferiore al tuo.");
				return 0;
			}
			DB_FactionPromote(playerid, gPlayer[playerid][pCharId], targetChar, f, targetRank + 1);
		}
		case 5:
		{
			if (targetRank <= 1)
			{
				Util_Send(playerid, -10270721, "Il membro e' gia' al grado minimo.");
				return 0;
			}
			DB_FactionDemote(playerid, gPlayer[playerid][pCharId], targetChar, f, targetRank - 1);
		}
		case 6:
		{
			DB_FactionFire(playerid, gPlayer[playerid][pCharId], targetChar, f);
		}
	}
}

Faction_CmdRankOp(playerid, params[], action)
{
	if (!Fac_NeedMember(playerid, 0) || Fac_CmdBlocked(playerid))
	{
		return 0;
	}
	new pos = 0, tok[12], target = 0;
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, action == 4 ? "Uso: /promuovi id" : (action == 5 ? "Uso: /degrada id" : "Uso: /licenzia id"));
		return 0;
	}
	if (!Fac_ParseTarget(playerid, tok, target))
	{
		return 0;
	}
	if (gPlayer[target][pFaction] != gPlayer[playerid][pFaction])
	{
		Util_Send(playerid, -10270721, "Il giocatore non appartiene alla tua fazione.");
		return 0;
	}
	new tn[25];
	GetPlayerName(target, tn, 25);
	Fac_DoRankOp(playerid, action, gPlayer[target][pCharId], gPlayer[target][pFactionRank], tn);
}

public UI_OnFactionMemberAction(playerid, action, memberId)
{
	if (!Util_IsPlaying(playerid) || Fac_CmdBlocked(playerid))
	{
		return 1;
	}
	for (new i = 0; i < g_FcMemCount[playerid]; i++)
	{
		if (g_FcMemChar[playerid][i] != memberId)
		{
			continue;
		}
		new name[25];
		strunpack(name, g_FcMemName[playerid][i], 25);
		Fac_DoRankOp(playerid, action, memberId, g_FcMemRank[playerid][i], name);
		return 1;
	}
	Util_Send(playerid, -10270721, "Membro non piu' in lista: riapri il menu.");
	return 1;
}

Fac_ApplyChange(target, cmd, faction, rank)
{
	new oldFac = gPlayer[target][pFaction], rn[24];
	switch (cmd)
	{
		case 1:
		{
			gPlayer[target][pFaction] = faction;
			gPlayer[target][pFactionRank] = rank;
		}
		case 2, 3:
		{
			gPlayer[target][pFactionRank] = rank;
		}
		case 4, 5:
		{
			gPlayer[target][pFaction] = 0;
			gPlayer[target][pFactionRank] = 0;
		}
		case 6:
		{
			gPlayer[target][pFaction] = faction;
			gPlayer[target][pFactionRank] = faction == 0 ? 0 : rank;
		}
	}
	new nf = gPlayer[target][pFaction], nr = gPlayer[target][pFactionRank];
	if (gPlayer[target][pOnDuty])
	{
		if (nf != oldFac || nf == 0)
		{
			Faction_ForceOff(target, Util_IsPlaying(target));
			Util_Send(target, -1, "Sei stato messo fuori servizio.");
		}
		else
		{
			Fac_ApplyUniform(target);
			UI_FactionHudShow(target, nf, nr);
			UI_FactionHudUpdate(target, nf, nr, Fac_KitHudValue(target));
		}
	}
	Fac_RankName(nf, nr, rn, 24);
	switch (cmd)
	{
		case 1:
		{
			SendClientMessage(target, 0x66DD66FF, "Sei entrato in %s con il grado %s.", g_FacShort[nf], rn);
		}
		case 2:
		{
			SendClientMessage(target, 0x66DD66FF, "Sei stato promosso a %s (%s).", rn, g_FacShort[nf]);
		}
		case 3:
		{
			SendClientMessage(target, -10270721, "Sei stato degradato a %s (%s).", rn, g_FacShort[nf]);
		}
		case 4:
		{
			SendClientMessage(target, -10270721, "Sei stato licenziato da %s.", g_FacShort[faction]);
		}
		case 5:
		{
			SendClientMessage(target, -1, "Hai lasciato %s.", g_FacShort[faction]);
		}
		case 6:
		{
			if (nf == 0)
			{
				Util_Send(target, -5963521, "Sei stato rimosso dalla fazione da uno staff.");
			}
			else
			{
				SendClientMessage(target, -5963521, "Uno staff ti ha assegnato a %s con il grado %s.", g_FacShort[nf], rn);
			}
		}
	}
}

Fac_SetCtxByTarget(targetChar)
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FcSetActive[i] && g_FcSetTargetChar[i] == targetChar)
		{
			return i;
		}
	}
	return 65535;
}

public Faction_OnDBChanged(playerid, targetChar, cmd, faction, rank, result)
{
	new target = Fac_FindByChar(targetChar);
	if (target != INVALID_PLAYER_ID && cmd == 1)
	{
		g_FcJoinPending[target] = 0;
	}
	new req = Fac_ValidPlayer(playerid) ? playerid : 65535;
	new ctx = cmd == 6 ? Fac_SetCtxByTarget(targetChar) : 65535;
	if (result == 1)
	{
		if (target != INVALID_PLAYER_ID)
		{
			Fac_ApplyChange(target, cmd, faction, rank);
		}
		new rn[24], tn[25];
		if (target != INVALID_PLAYER_ID)
		{
			GetPlayerName(target, tn, 25);
		}
		else if (req != INVALID_PLAYER_ID)
		{
			strmid(tn, g_FcOpName[req], 0, strlen(g_FcOpName[req]), 25);
		}
		if (ctx != 65535)
		{
			strmid(tn, g_FcSetName[ctx], 0, strlen(g_FcSetName[ctx]), 25);
		}
		Fac_RankName(faction, rank, rn, 24);
		if (cmd == 6 && ctx != 65535)
		{
			new detail[128], logDetail[128];
			if (faction == 0)
			{
				format(detail, 128, "rimosso dalla fazione");
			}
			else
			{
				format(detail, 128, "%s grado %d", g_FacShort[faction], rank);
			}
			format(logDetail, 128, "%s: %s", tn, detail);
			Admin_LogRaw(g_FcSetStaffAcc[ctx], g_FcSetStaffName[ctx], g_FcSetTargetAcc[ctx], "setfazione", logDetail);
			Admin_AdmCmd(g_FcSetStaffName[ctx], "impostato la fazione di", tn, detail, "");
		}
		else if (req != INVALID_PLAYER_ID)
		{
			switch (cmd)
			{
				case 1:
				{
					SendClientMessage(req, 0x66DD66FF, "%s e' entrato in %s.", tn, g_FacShort[faction]);
				}
				case 2:
				{
					SendClientMessage(req, 0x66DD66FF, "%s promosso a %s.", tn, rn);
				}
				case 3:
				{
					SendClientMessage(req, 0x66DD66FF, "%s degradato a %s.", tn, rn);
				}
				case 4:
				{
					SendClientMessage(req, 0x66DD66FF, "%s licenziato.", tn);
				}
			}
		}
		new msg[128];
		format(msg, 128, "cmd %d char %d fazione %d grado %d", cmd, targetChar, faction, rank);
		Log_Write("FACTION", msg);
	}
	else
	{
		new notify = ctx != 65535 && IsPlayerConnected(ctx) ? ctx : req;
		if (notify != 65535)
		{
			if (result < 0)
			{
				Util_Send(notify, -10270721, "Servizio temporaneamente non disponibile: operazione non eseguita.");
			}
			else
			{
				Util_Send(notify, -10270721, "Operazione rifiutata (gradi, fazione o livello non idonei, o un'altra operazione e' in corso).");
			}
		}
		if (target != INVALID_PLAYER_ID && cmd == 1)
		{
			Util_Send(target, -10270721, "Non e' stato possibile completare l'ingresso in fazione.");
		}
	}
	if (ctx != 65535)
	{
		g_FcSetActive[ctx] = 0;
	}
	return 1;
}

Fac_RequestMembers(playerid, mode)
{
	new f = gPlayer[playerid][pFaction];
	if (f < 1)
	{
		Util_Send(playerid, -10270721, "Non appartieni a nessuna fazione.");
		return 0;
	}
	if (g_FcMemBusy[playerid] && Fac_CdLeftMs(1, g_FcMemBusyTick[playerid], 10000) > 0)
	{
		Util_Send(playerid, -10270721, "Richiesta gia' in corso: attendi.");
		return 0;
	}
	g_FcMemBusy[playerid] = 1;
	g_FcMemBusyTick[playerid] = GetTickCount();
	g_FcMemMode[playerid] = mode;
	DB_FactionMembers(playerid, f);
}

Faction_CmdFazione(playerid, params[])
{
	if (gPlayer[playerid][pFaction] < 1 || gPlayer[playerid][pFactionRank] < 1)
	{
		Util_Send(playerid, -10270721, "Non appartieni a nessuna fazione.");
		return 0;
	}
	new pos = 0, sub[16];
	Util_NextToken(params, pos, sub, 16);
	if (sub[0] == 0 || !strcmp(sub, "info", 1, 0x7FFFFFFF))
	{
		Fac_RequestMembers(playerid, 0);
		return 0;
	}
	if (!strcmp(sub, "membri", 1, 0x7FFFFFFF))
	{
		Fac_RequestMembers(playerid, 2);
		return 0;
	}
	if (!strcmp(sub, "lascia", 1, 0x7FFFFFFF))
	{
		if (Fac_CmdBlocked(playerid) || !Fac_NeedActive(playerid))
		{
			return 0;
		}
		GetPlayerName(playerid, g_FcOpName[playerid], 25);
		DB_FactionLeave(playerid, gPlayer[playerid][pCharId], gPlayer[playerid][pFaction]);
		return 0;
	}
	Util_Send(playerid, 0x99CCFFFF, "Uso: /fazione [info|membri|lascia]");
}

public UI_OnFactionMenuAction(playerid, action)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pFaction] < 1)
	{
		return 1;
	}
	if (action != 2 && gPlayer[playerid][pFactionRank] < 5)
	{
		return 1;
	}
	Fac_RequestMembers(playerid, action);
	return 1;
}

public Faction_OnDBMembers(playerid, faction, count)
{
	if (!Fac_ValidPlayer(playerid))
	{
		return 1;
	}
	g_FcMemBusy[playerid] = 0;
	if (count < 0)
	{
		Util_Send(playerid, -10270721, "Servizio temporaneamente non disponibile: riprova piu' tardi.");
		return 1;
	}
	if (gPlayer[playerid][pFaction] != faction || faction < 1)
	{
		return 1;
	}
	new mode = g_FcMemMode[playerid], online = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i) && gPlayer[i][pFaction] == faction)
		{
			online++;
		}
	}
	if (mode == 0)
	{
		UI_FactionMenuShow(playerid, faction, gPlayer[playerid][pFactionRank], gPlayer[playerid][pOnDuty], online, count);
		return 1;
	}
	UI_FactionMemberListClear(playerid);
	g_FcMemCount[playerid] = 0;
	for (new i = 0; i < count; i++)
	{
		new other = Fac_FindByChar(g_FacMembers[i][fmCharId]), status = 0;
		if (other != INVALID_PLAYER_ID)
		{
			status = gPlayer[other][pOnDuty] ? 2 : 1;
		}
		if (!UI_FactionMemberListAdd(playerid, g_FacMembers[i][fmCharId], g_FacMembers[i][fmName], g_FacMembers[i][fmRank], status))
		{
			break;
		}
		new n = g_FcMemCount[playerid];
		if (n >= 32)
		{
			break;
		}
		g_FcMemChar[playerid][n] = g_FacMembers[i][fmCharId];
		g_FcMemRank[playerid][n] = g_FacMembers[i][fmRank];
		strpack(g_FcMemName[playerid][n], g_FacMembers[i][fmName], 7);
		g_FcMemCount[playerid] = n + 1;
	}
	UI_FactionMembersShow(playerid, faction, gPlayer[playerid][pFactionRank], mode);
	return 1;
}

Fac_SetStart(staff, targetChar, targetAcc, targetName[], faction, rank)
{
	g_FcSetActive[staff] = 1;
	g_FcSetTargetChar[staff] = targetChar;
	g_FcSetTargetAcc[staff] = targetAcc;
	g_FcSetStaffAcc[staff] = gPlayer[staff][pAccountId];
	g_FcSetFac[staff] = faction;
	g_FcSetRank[staff] = rank;
	strmid(g_FcSetName[staff], targetName, 0, strlen(targetName), 25);
	GetPlayerName(staff, g_FcSetStaffName[staff], 25);
	DB_FactionSet(staff, targetChar, faction, rank);
}

bool:Faction_CmdSetfazione(playerid, params[])
{
	if (Util_GetAdmin(playerid) < 3)
	{
		return 0;
	}
	new pos = 0, who[25], tf[12], tr[12], faction = 0, rank = 0;
	Util_NextToken(params, pos, who, 25);
	Util_NextToken(params, pos, tf, 12);
	Util_NextToken(params, pos, tr, 12);
	if (who[0] == 0 || !Util_ParseInt(tf, faction) || faction < 0 || faction > 2 || (faction != 0 && (!Util_ParseInt(tr, rank) || rank < 1 || rank > 6)))
	{
		SendClientMessage(playerid, 0x99CCFFFF, "Uso: /setfazione id|Nome_Cognome fazione(%d-%d, 0 = rimuovi) grado(1-%d)", 0, 2, 6);
		return 1;
	}
	if (faction == 0)
	{
		rank = 0;
	}
	if (g_FcSetActive[playerid])
	{
		Util_Send(playerid, -10270721, "Hai gia' un'operazione /setfazione in corso.");
		return 1;
	}
	new targetid = INVALID_PLAYER_ID;
	if (Util_ParsePlayerId(who, targetid))
	{
		if (!Util_IsPlaying(targetid) || gPlayer[targetid][pCharId] <= 0)
		{
			Util_Send(playerid, -10270721, "Giocatore non valido.");
			return 1;
		}
	}
	else
	{
		targetid = Admin_FindByName(who);
	}
	if (targetid != INVALID_PLAYER_ID && gPlayer[targetid][pLoggedIn] && gPlayer[targetid][pCharId] > 0)
	{
		new tn[25];
		GetPlayerName(targetid, tn, 25);
		Fac_SetStart(playerid, gPlayer[targetid][pCharId], gPlayer[targetid][pAccountId], tn, faction, rank);
		return 1;
	}
	if (!Util_IsValidRPName(who))
	{
		Util_Send(playerid, -10270721, "Giocatore non valido (usa id oppure Nome_Cognome).");
		return 1;
	}
	g_FcSetActive[playerid] = 1;
	g_FcSetTargetChar[playerid] = 0;
	g_FcSetTargetAcc[playerid] = 0;
	g_FcSetStaffAcc[playerid] = gPlayer[playerid][pAccountId];
	g_FcSetFac[playerid] = faction;
	g_FcSetRank[playerid] = rank;
	strmid(g_FcSetName[playerid], who, 0, strlen(who), 25);
	GetPlayerName(playerid, g_FcSetStaffName[playerid], 25);
	DB_FactionFindByName(playerid, who, 1);
	return 1;
}

public Faction_OnDBFound(playerid, tag, charId, name[], faction, rank, level)
{
	if (tag != 1 || !Fac_ValidPlayer(playerid) || !g_FcSetActive[playerid] || g_FcSetTargetChar[playerid] != 0)
	{
		return 1;
	}
	if (charId <= 0)
	{
		g_FcSetActive[playerid] = 0;
		Util_Send(playerid, -10270721, charId < 0 ? "Servizio temporaneamente non disponibile: riprova piu' tardi." : "Personaggio non trovato.");
		return 1;
	}
	new f = g_FcSetFac[playerid], r = g_FcSetRank[playerid];
	Fac_SetStart(playerid, charId, 0, name, f, r);
	return 1;
}

public Faction_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (g_FcInvActive[i] && Fac_CdLeftMs(1, g_FcInvStart[i], 60000) <= 0)
		{
			new from = g_FcInvFrom[i], fromChar = g_FcInvFromChar[i];
			Fac_ClearInvite(i, 1);
			Util_Send(i, -1, "L'invito in fazione e' scaduto.");
			if (Fac_ValidPlayer(from) && gPlayer[from][pCharId] == fromChar)
			{
				Util_Send(from, -1, "Il tuo invito e' scaduto.");
			}
		}
		if (!gPlayer[i][pSpawned] || !Util_IsPlaying(i))
		{
			continue;
		}
		if (gPlayer[i][pCuffed])
		{
			new by = g_FcCuffBy[i];
			if (Fac_CdLeftMs(1, g_FcCuffTick[i], 600000) <= 0 || !Util_IsPlaying(by) || !gPlayer[by][pOnDuty])
			{
				Fac_Uncuff(i);
			}
		}
		if (gPlayer[i][pOnDuty])
		{
			if (gPlayer[i][pFaction] < 1 || Admin_IsMuted(i))
			{
				Faction_ForceOff(i, 1);
				Util_Send(i, -10270721, "Sei stato messo fuori servizio.");
			}
			else
			{
				Fac_PayTick(i, now);
			}
		}
		if (g_FcRevTarget[i] != 65535)
		{
			new t = g_FcRevTarget[i];
			if (!gPlayer[i][pOnDuty] || gPlayer[i][pWounded] || gPlayer[i][pCuffed])
			{
				Fac_ReviveCancel(i, "Rianimazione interrotta.");
			}
			else if (!Util_IsPlaying(t) || gPlayer[t][pCharId] != g_FcRevTargetChar[i] || !gPlayer[t][pWounded])
			{
				Fac_ReviveCancel(i, "Rianimazione interrotta: il paziente non e' piu' ferito.");
			}
			else if (!Util_InRange(i, t, (3.0 + 1.0)))
			{
				Fac_ReviveCancel(i, "Rianimazione interrotta: ti sei allontanato.");
			}
			else if (now - g_FcRevStart[i] >= 8000)
			{
				if (g_FcKit[i] > 0)
				{
					Fac_ReviveDone(i, t);
				}
				else
				{
					Fac_ReviveCancel(i, "Kit medico esaurito.");
				}
			}
		}
		if (gPlayer[i][pWounded])
		{
			g_FcInjLeftMs[i] -= 500;
			if (g_FcInjLeftMs[i] <= 0)
			{
				Faction_Hospitalize(i);
				continue;
			}
			new sec = Fac_SecCeil(g_FcInjLeftMs[i]);
			if (sec != g_FcInjSec[i])
			{
				g_FcInjSec[i] = sec;
				UI_InjuryHudUpdate(i, sec);
				Fac_ApplyInjuredPose(i);
			}
		}
	}
	return 1;
}

Faction_OnInit()
{
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Faction_ResetPlayer(p);
	}
	g_FacTimer = SetTimer("Faction_OnTick", 500, 1);
}

Faction_OnExit()
{
	if (g_FacTimer != 0)
	{
		KillTimer(g_FacTimer);
	}
	g_FacTimer = 0;
}

Faction_OnPlayerConnect(playerid)
{
	Faction_ResetPlayer(playerid);
}

Faction_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	Fac_ReleaseCuffedBy(playerid);
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, 1);
	}
	if (g_FcInvActive[playerid])
	{
		Fac_ClearInvite(playerid, 0);
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FcInvActive[i] && g_FcInvFrom[i] == playerid)
		{
			Fac_ClearInvite(i, 1);
		}
		if (g_FcRevTarget[i] == playerid)
		{
			Fac_ReviveCancel(i, "Rianimazione interrotta: il paziente si e' scollegato.");
		}
	}
	if (gPlayer[playerid][pWounded])
	{
		gPlayer[playerid][pWounded] = 0;
		gPlayer[playerid][pPosX] = 1182.0;
		gPlayer[playerid][pPosY] = -1330.0;
		gPlayer[playerid][pPosZ] = 13.9;
		gPlayer[playerid][pAngle] = 270.0;
		gPlayer[playerid][pInterior] = 0;
		gPlayer[playerid][pWorld] = 0;
		gPlayer[playerid][pHealth] = 100.0;
		gPlayer[playerid][pArmor] = 0.0;
		gPlayer[playerid][pSpawned] = 0;
	}
	gPlayer[playerid][pSkin] = gPlayer[playerid][pCivilSkin];
	Faction_ResetPlayer(playerid);
}

Faction_OnPlayerDeath(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	Fac_ReleaseCuffedBy(playerid);
	if (gPlayer[playerid][pCuffed])
	{
		gPlayer[playerid][pCuffed] = 0;
		g_FcCuffBy[playerid] = 65535;
	}
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, 0);
	}
	g_FcRevTarget[playerid] = 65535;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FcRevTarget[i] == playerid)
		{
			Fac_ReviveCancel(i, "Rianimazione interrotta.");
		}
	}
	if (gPlayer[playerid][pWounded])
	{
		g_FcHospPending[playerid] = 1;
		return 0;
	}
	gPlayer[playerid][pWounded] = 1;
	g_FcInjLeftMs[playerid] = 180000;
	g_FcInjSec[playerid] = -1;
	UI_InjuryHudHide(playerid);
}

Faction_OnPlayerSpawn(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, 1);
	}
	if (g_FcHospPending[playerid])
	{
		Faction_Hospitalize(playerid);
		return 0;
	}
	if (!gPlayer[playerid][pWounded])
	{
		return 0;
	}
	SetPlayerHealth(playerid, 25.0);
	Faction_UpdateControl(playerid);
	Fac_ApplyInjuredPose(playerid);
	g_FcInjLeftMs[playerid] = 180000;
	g_FcInjSec[playerid] = 180;
	UI_InjuryHudShow(playerid, 180);
	SendClientMessage(playerid, -10270721, "Sei ferito. Attendi i soccorsi (EMS): senza aiuto verrai ricoverato tra %d secondi ($%d).", 180, 200);
}

Faction_SendHelp(playerid)
{
	new f = gPlayer[playerid][pFaction], rank = gPlayer[playerid][pFactionRank];
	if (f < 1 || rank < 1)
	{
		return 0;
	}
	SendClientMessage(playerid, -2994689, "--- Fazione %s ---", g_FacShort[f]);
	Util_Send(playerid, 0x99CCFFFF, "/fazione [info|membri|lascia] · /duty (vicino alla sede) · /r testo · /dep testo");
	if (f == 1)
	{
		Util_Send(playerid, 0x99CCFFFF, "/ammanetta id · /smanetta id");
		if (rank >= 2)
		{
			Util_Send(playerid, 0x99CCFFFF, "/multa id importo motivo");
		}
	}
	else
	{
		Util_Send(playerid, 0x99CCFFFF, "/cura id · /rianima id");
	}
	if (rank >= 5)
	{
		Util_Send(playerid, 0x99CCFFFF, "/invita id · /promuovi id · /degrada id · /licenzia id");
	}
}

// ===== modules/inventory/inv_doc.inc =====

public Inv_ShowDocument(playerid, viewerid)
{
	if (!Inv_ValidPlayer(playerid) || !Inv_ValidPlayer(viewerid))
	{
		return 1;
	}
	new name[25], job[24], fac[24], rank[24];
	GetPlayerName(playerid, name, 25);
	Job_NameOf(gPlayer[playerid][pJob], job, 24);
	Fac_ShortName(gPlayer[playerid][pFaction], fac, 24);
	Fac_RankName(gPlayer[playerid][pFaction], gPlayer[playerid][pFactionRank], rank, 24);
	new total = gPlayer[playerid][pPlayedMs];
	SendClientMessage(viewerid, -2994689, "--- Documento d'identita' di San Andreas ---");
	SendClientMessage(viewerid, -1, "Nome: %s  Livello: %d  Ore di gioco: %dh %02dm", name, gPlayer[playerid][pLevel], total / 3600000, total % 3600000 / 60000);
	new origin[24];
	UI_StoryOriginName(gPlayer[playerid][pStoryOrigin], origin, 24);
	if (origin[0] != 0)
	{
		SendClientMessage(viewerid, -1, "Origine: %s", origin);
	}
	if (gPlayer[playerid][pFaction] > 0)
	{
		SendClientMessage(viewerid, -1, "Lavoro: %s  Fazione: %s (%s)", job, fac, rank);
	}
	else
	{
		SendClientMessage(viewerid, -1, "Lavoro: %s  Fazione: nessuna", job);
	}
	return 1;
}

Inv_CmdDocumento(playerid, params[])
{
	new pos = 0, tok[24], target = 0;
	Util_NextToken(params, pos, tok, 24);
	if (!strcmp(tok, "richiedi", 1, 0x7FFFFFFF))
	{
		Inv_DocRequest(playerid);
		return 0;
	}
	if (!Inv_Ready(playerid))
	{
		Util_Send(playerid, -10270721, "Inventario non disponibile: riprova tra poco (/inventario).");
		return 0;
	}
	if (Inv_Count(playerid, 10) < 1)
	{
		Util_Send(playerid, -10270721, "Non hai il documento d'identita': usa /documento richiedi.");
		return 0;
	}
	if (tok[0] == 0)
	{
		Inv_ShowDocument(playerid, playerid);
		return 0;
	}
	if (!Util_ParsePlayerId(tok, target) || !Util_IsPlaying(target))
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /documento · /documento [id] · /documento richiedi");
		return 0;
	}
	if (target != playerid && !Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "Il giocatore e' troppo lontano.");
		return 0;
	}
	new tname[25];
	GetPlayerName(target, tname, 25);
	Inv_ShowDocument(playerid, target);
	if (target != playerid)
	{
		SendClientMessage(playerid, 0x66DD66FF, "Hai mostrato il documento a %s.", tname);
	}
}

// ===== modules/living/living_calc.inc =====

LD_Clamp(v, lo, hi)
{
	if (v < lo)
	{
		return lo;
	}
	if (v > hi)
	{
		return hi;
	}
	return v;
}

LD_Hash32(a, b, c)
{
	new h = 0x811C9DC5, v[3];
	v[0] = a;
	v[1] = b;
	v[2] = c;
	for (new i = 0; i < 3; i++)
	{
		for (new s = 0; s < 32; s += 8)
		{
			h ^= v[i] >>> s & 255;
			h *= 0x01000193;
		}
	}
	return h;
}

LD_HashMod(h, n)
{
	if (n <= 0)
	{
		return 0;
	}
	return (h & 0x7FFFFFFF) % n;
}

LD_Bucket(unixTs)
{
	if (unixTs <= 0)
	{
		return 0;
	}
	return unixTs / 1800;
}

bool:LD_ContractSlot(bucket, slot, &fromD, &toD, &cargo)
{
	fromD = 0;
	toD = 0;
	cargo = 0;
	new h = LD_Hash32(bucket, slot, 1);
	fromD = LD_HashMod(h, 3) + 1;
	new off = LD_HashMod(h >>> 8, 2) + 1;
	toD = (fromD - 1 + off) % 3 + 1;
	cargo = LD_HashMod(h >>> 16, 3) + 1;
	return 1;
}

LD_ProTier(points)
{
	if (points >= 600)
	{
		return 3;
	}
	if (points >= 300)
	{
		return 2;
	}
	if (points >= 100)
	{
		return 1;
	}
	return 0;
}

LD_ProBonusPct(points)
{
	switch (LD_ProTier(points))
	{
		case 1:
		{
			return 5;
		}
		case 2:
		{
			return 10;
		}
		case 3:
		{
			return 15;
		}
	}
	return 0;
}

LD_LocalRepLevel(rep)
{
	if (rep >= 40)
	{
		return 2;
	}
	if (rep >= 10)
	{
		return 1;
	}
	return 0;
}

LD_DiscountPct(rep)
{
	switch (LD_LocalRepLevel(rep))
	{
		case 1:
		{
			return 5;
		}
		case 2:
		{
			return 10;
		}
	}
	return 0;
}

LD_ApplyDiscount(amount, rep)
{
	if (amount <= 0)
	{
		return 0;
	}
	new a = LD_Clamp(amount, 0, 10000000);
	return a - a * LD_DiscountPct(rep) / 100;
}

LD_FreightMinSeconds(distM)
{
	new d = LD_Clamp(distM, 0, 100000);
	new s = (d + 40 - 1) / 40;
	return s > 25 ? s : 25;
}

LD_FreightTimeLimit(distM)
{
	new d = LD_Clamp(distM, 0, 100000);
	return d * 10 / 60 + 120;
}

LD_TaxiFare(meters)
{
	new m = LD_Clamp(meters, 0, 100000);
	return m * 12 / 100 + 15;
}

LD_TaxiFareFor(meters, rep)
{
	return LD_ApplyDiscount(LD_TaxiFare(meters), rep);
}

LD_TaxiNpcPay(fare, proPoints)
{
	if (fare <= 0)
	{
		return 0;
	}
	return LD_Clamp(fare, 0, 10000000) * (LD_ProBonusPct(proPoints) + 100) / 100;
}

LD_RentalModel(vkind)
{
	switch (vkind)
	{
		case 1:
		{
			return 462;
		}
		case 2:
		{
			return 436;
		}
		case 3:
		{
			return 410;
		}
		case 4:
		{
			return 420;
		}
	}
	return 0;
}

LD_RentalDeposit(vkind)
{
	switch (vkind)
	{
		case 1:
		{
			return 200;
		}
		case 2:
		{
			return 400;
		}
		case 3:
		{
			return 450;
		}
		case 4:
		{
			return 300;
		}
	}
	return 0;
}

LD_RentalFee(vkind, blocks)
{
	if (blocks < 1 || blocks > 3)
	{
		return 0;
	}
	switch (vkind)
	{
		case 1:
		{
			return blocks * 30;
		}
		case 2:
		{
			return blocks * 60;
		}
		case 3:
		{
			return blocks * 70;
		}
	}
	return 0;
}

LD_RentalFeeFor(vkind, blocks, rep)
{
	return LD_ApplyDiscount(LD_RentalFee(vkind, blocks), rep);
}

LD_RentalRefund(deposit, health)
{
	if (deposit <= 0)
	{
		return 0;
	}
	new dep = LD_Clamp(deposit, 0, 10000);
	if (health >= 1000)
	{
		return dep;
	}
	if (health <= 300)
	{
		return 0;
	}
	new span = 700;
	new r = (dep * 2 * (health - 300) + span) / (span * 2);
	return LD_Clamp(r, 0, dep);
}

bool:LD_DonationValid(amount, donatedToday)
{
	if (amount < 50 || amount > 500)
	{
		return 0;
	}
	if (donatedToday < 0)
	{
		return 0;
	}
	return donatedToday + amount <= 1000;
}

LD_FloatKey(Float:f)
{
	new i = f;
	return i >= 0 ? i : cellmin - i;
}

bool:LD_InBox(kx, ky, Float:x1, Float:y1, Float:x2, Float:y2)
{
	return kx >= LD_FloatKey(x1) && kx <= LD_FloatKey(x2) && ky >= LD_FloatKey(y1) && ky <= LD_FloatKey(y2);
}

District_At(Float:x, Float:y)
{
	new kx = LD_FloatKey(x), ky = LD_FloatKey(y);
	if (LD_InBox(kx, ky, 1812.0, -1880.0, 1971.0, -1742.0))
	{
		return 1;
	}
	if (LD_InBox(kx, ky, 2222.0, -1852.0, 2632.0, -1628.0))
	{
		return 2;
	}
	if (LD_InBox(kx, ky, 2056.0, -1287.0, 2281.0, -1115.0))
	{
		return 3;
	}
	return 0;
}

bool:LD_StrEqI(a[], b[])
{
	new i = 0;
	while (a[i] != 0 && b[i] != 0)
	{
		if (tolower(a[i]) != tolower(b[i]))
		{
			return 0;
		}
		i++;
	}
	return a[i] == 0 && b[i] == 0;
}

LD_ParseDistrict(name[])
{
	if (name[0] >= 49 && name[0] < 52 && name[1] == 0)
	{
		return name[0] - 48;
	}
	if (LD_StrEqI(name, "idlewood"))
	{
		return 1;
	}
	if (LD_StrEqI(name, "ganton"))
	{
		return 2;
	}
	if (LD_StrEqI(name, "jefferson"))
	{
		return 3;
	}
	return 0;
}

LD_CopyStr(dest[], size, src[])
{
	if (size <= 0)
	{
		return 0;
	}
	new i = 0;
	while (src[i] != 0 && i < size - 1)
	{
		dest[i] = src[i];
		i++;
	}
	dest[i] = 0;
	return i;
}

LD_DistrictName(id, dest[], size)
{
	switch (id)
	{
		case 1:
		{
			return LD_CopyStr(dest, size, "Idlewood");
		}
		case 2:
		{
			return LD_CopyStr(dest, size, "Ganton");
		}
		case 3:
		{
			return LD_CopyStr(dest, size, "Jefferson");
		}
	}
	return LD_CopyStr(dest, size, "-");
}

// ===== modules/living/living_api.inc =====
new bool:g_LdReady;
new g_LdLsnName[8][32];
new g_LdLsnPrio[8];
new g_LdLsnCount;
new g_LdEmitDepth;
new g_LdVehMod[2000];
new g_LdVehOwner[2000];
new g_LdVehSerial[2000];
new g_LdVehSerialSeq;
new g_LdPool;

bool:LD_IsReady()
{
	return g_LdReady;
}

LD_SetReady(bool:ready)
{
	g_LdReady = ready;
	if (!ready)
	{
		return 0;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Living_TryCharReady(i);
	}
}

bool:LD_LsnBefore(prio, fn[], idx)
{
	if (prio != g_LdLsnPrio[idx])
	{
		return prio < g_LdLsnPrio[idx];
	}
	return strcmp(fn, g_LdLsnName[idx], 0, 0x7FFFFFFF) < 0;
}

bool:LD_Listen(fn[], prio)
{
	if (strlen(fn) >= 32 || funcidx(fn) == -1)
	{
		return 0;
	}
	for (new i = 0; i < g_LdLsnCount; i++)
	{
		if (!strcmp(fn, g_LdLsnName[i], 0, 0x7FFFFFFF))
		{
			return 0;
		}
	}
	if (g_LdLsnCount >= 8)
	{
		return 0;
	}
	new pos = g_LdLsnCount;
	while (pos > 0 && LD_LsnBefore(prio, fn, pos - 1))
	{
		g_LdLsnPrio[pos] = g_LdLsnPrio[pos - 1];
		strmid(g_LdLsnName[pos], g_LdLsnName[pos - 1], 0, 32, 32);
		pos--;
	}
	g_LdLsnPrio[pos] = prio;
	strmid(g_LdLsnName[pos], fn, 0, 32, 32);
	g_LdLsnCount++;
	return 1;
}

LD_Emit(type, districtId, charId, value, opId[])
{
	if (g_LdEmitDepth >= 2)
	{
		new msg[256];
		format(msg, 256, "evento %d scartato (annidamento): quartiere %d pers. %d valore %d", type, districtId, charId, value);
		Log_Write("LIVING", msg);
		return 0;
	}
	g_LdEmitDepth++;
	new n = g_LdLsnCount;
	for (new i = 0; i < n; i++)
	{
		if (opId[0] == 0)
		{
			CallLocalFunction(g_LdLsnName[i], "dddds", type, districtId, charId, value, "-");
		}
		else
		{
			CallLocalFunction(g_LdLsnName[i], "dddds", type, districtId, charId, value, opId);
		}
	}
	g_LdEmitDepth--;
	return n;
}

LD_OnboardAction(playerid, step)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	LD_Emit(106, 0, gPlayer[playerid][pCharId], step, "-");
}

LD_GetLocalRep(playerid, districtId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || districtId < 1 || districtId > 3)
	{
		return 0;
	}
	return gPlayer[playerid][pDistrictRep][districtId];
}

LD_GetProPoints(playerid, track)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || track < 1 || track > 2)
	{
		return 0;
	}
	return gPlayer[playerid][pProPoints][track];
}

LD_SetProPoints(playerid, track, points)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || track < 1 || track > 2)
	{
		return 0;
	}
	gPlayer[playerid][pProPoints][track] = points > 0 ? points : 0;
}

LD_ActiveFlow(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (Job_IsOnShift(playerid))
	{
		return 1;
	}
	if (gPlayer[playerid][pContractId] != 0 || gPlayer[playerid][pFreightWelcome] != 0)
	{
		return 2;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0 || gPlayer[playerid][pRentalClass] == 2)
	{
		return 3;
	}
	if (gPlayer[playerid][pRentalId] != 0)
	{
		return 4;
	}
	return 0;
}

LD_CheckStart(playerid)
{
	if (!g_LdReady || gPlayer[playerid][pLivingReady] == 0)
	{
		return 1;
	}
	if (gPlayer[playerid][pWounded])
	{
		return 2;
	}
	if (gPlayer[playerid][pCuffed])
	{
		return 3;
	}
	if (LD_ActiveFlow(playerid) != 0)
	{
		return 4;
	}
	return 0;
}

bool:LD_SendBlock(playerid, block)
{
	switch (block)
	{
		case 1:
		{
			Util_Send(playerid, -10270721, "I servizi della citta' si stanno avviando: riprova tra poco.");
		}
		case 2:
		{
			Util_Send(playerid, -10270721, "Sei ferito: non puoi farlo ora.");
		}
		case 3:
		{
			Util_Send(playerid, -10270721, "Sei ammanettato: non puoi farlo ora.");
		}
		case 4:
		{
			switch (LD_ActiveFlow(playerid))
			{
				case 1:
				{
					Util_Send(playerid, -10270721, "Sei in turno di lavoro: termina prima il turno (/fine).");
				}
				case 2:
				{
					Util_Send(playerid, -10270721, "Hai gia' un contratto attivo (/contratto).");
				}
				case 3:
				{
					Util_Send(playerid, -10270721, "Sei in servizio taxi: prima /taxi off.");
				}
				default:
				{
					Util_Send(playerid, -10270721, "Hai un noleggio in corso: prima /riconsegna.");
				}
			}
		}
		default:
		{
			return 0;
		}
	}
	return 1;
}

bool:LD_PoolHasRoom()
{
	return g_LdPool < 40;
}

LD_VehRegister(vehicleid, module, playerid)
{
	if (vehicleid <= 0 || vehicleid >= 2000 || module == 0)
	{
		return 0;
	}
	if (g_LdVehMod[vehicleid] != 0 || g_LdPool >= 40)
	{
		return 0;
	}
	g_LdVehSerialSeq++;
	if (g_LdVehSerialSeq <= 0)
	{
		g_LdVehSerialSeq = 1;
	}
	g_LdVehMod[vehicleid] = module;
	g_LdVehOwner[vehicleid] = playerid + 1;
	g_LdVehSerial[vehicleid] = g_LdVehSerialSeq;
	g_LdPool++;
	return g_LdVehSerialSeq;
}

LD_VehRelease(vehicleid)
{
	if (vehicleid <= 0 || vehicleid >= 2000 || g_LdVehMod[vehicleid] == 0)
	{
		return 0;
	}
	g_LdVehMod[vehicleid] = 0;
	g_LdVehOwner[vehicleid] = 0;
	g_LdVehSerial[vehicleid] = 0;
	if (g_LdPool > 0)
	{
		g_LdPool--;
	}
}

LD_VehModule(vehicleid)
{
	if (vehicleid <= 0 || vehicleid >= 2000)
	{
		return 0;
	}
	return g_LdVehMod[vehicleid];
}

LD_VehOwner(vehicleid)
{
	if (vehicleid <= 0 || vehicleid >= 2000 || g_LdVehOwner[vehicleid] == 0)
	{
		return 65535;
	}
	return g_LdVehOwner[vehicleid] - 1;
}

LD_VehSerial(vehicleid)
{
	if (vehicleid <= 0 || vehicleid >= 2000)
	{
		return 0;
	}
	return g_LdVehSerial[vehicleid];
}

LD_VehCleanupOwner(playerid)
{
	for (new v = 1; v < 2000; v++)
	{
		if (g_LdVehOwner[v] != playerid + 1)
		{
			continue;
		}
		new msg[256];
		format(msg, 256, "veicolo %d (modulo %d) non rilasciato dal modulo alla disconnessione di %d: distrutto", v, g_LdVehMod[v], playerid);
		Log_Write("LIVING", msg);
		LD_VehRelease(v);
		DestroyVehicle(v);
	}
}

Living_OnInit()
{
	g_LdReady = 0;
	g_LdLsnCount = 0;
	g_LdEmitDepth = 0;
	g_LdPool = 0;
	for (new v = 0; v < 2000; v++)
	{
		g_LdVehMod[v] = 0;
		g_LdVehOwner[v] = 0;
		g_LdVehSerial[v] = 0;
	}
	District_OnInit();
	Director_OnInit();
	CityOS_OnInit();
	Rental_OnInit();
	Taxi_OnInit();
	Freight_OnInit();
	Hub_OnInit();
}

Living_OnExit()
{
	Freight_OnExit();
	Taxi_OnExit();
	Rental_OnExit();
	Director_OnExit();
	Hub_OnExit();
	CityOS_OnExit();
	District_OnExit();
	g_LdReady = 0;
	g_LdLsnCount = 0;
}

Living_OnPlayerConnect(playerid)
{
	District_OnPlayerConnect(playerid);
	Director_OnPlayerConnect(playerid);
	CityOS_OnPlayerConnect(playerid);
	Rental_OnPlayerConnect(playerid);
	Taxi_OnPlayerConnect(playerid);
	Freight_OnPlayerConnect(playerid);
	Hub_OnPlayerConnect(playerid);
}

Living_OnPlayerDisconnect(playerid, reason)
{
	Freight_OnPlayerDisconnect(playerid, reason);
	Taxi_OnPlayerDisconnect(playerid, reason);
	Rental_OnPlayerDisconnect(playerid, reason);
	Director_OnPlayerDisconnect(playerid, reason);
	Hub_OnPlayerDisconnect(playerid, reason);
	CityOS_OnPlayerDisconnect(playerid, reason);
	District_OnPlayerDisconnect(playerid, reason);
	LD_VehCleanupOwner(playerid);
}

Living_TryCharReady(playerid)
{
	if (!g_LdReady || !Util_IsPlaying(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pCharId] <= 0 || gPlayer[playerid][pLivingReady] != 0)
	{
		return 0;
	}
	gPlayer[playerid][pLivingReady] = 1;
	District_OnCharReady(playerid);
	Director_OnCharReady(playerid);
	CityOS_OnCharReady(playerid);
	Rental_OnCharReady(playerid);
	Taxi_OnCharReady(playerid);
	Freight_OnCharReady(playerid);
	Hub_OnCharReady(playerid);
}

Living_OnPlayerSpawn(playerid)
{
	Living_TryCharReady(playerid);
}

Living_OnPlayerDeath(playerid)
{
	Freight_OnPlayerDeath(playerid);
	Taxi_OnPlayerDeath(playerid);
	Rental_OnPlayerDeath(playerid);
}

Living_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	Freight_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
	Taxi_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
	Rental_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger);
}

Living_OnPlayerExitVehicle(playerid, vehicleid)
{
	Freight_OnPlayerExitVehicle(playerid, vehicleid);
	Taxi_OnPlayerExitVehicle(playerid, vehicleid);
	Rental_OnPlayerExitVehicle(playerid, vehicleid);
}

Living_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	Freight_OnPlayerStateChange(playerid, newstate, oldstate);
	Taxi_OnPlayerStateChange(playerid, newstate, oldstate);
	Rental_OnPlayerStateChange(playerid, newstate, oldstate);
}

Living_OnVehicleDeath(vehicleid, killerid)
{
	Freight_OnVehicleDeath(vehicleid, killerid);
	Taxi_OnVehicleDeath(vehicleid, killerid);
	Rental_OnVehicleDeath(vehicleid, killerid);
}

// ===== modules/district/district.inc =====
new bool:g_DistBooted;
new bool:g_DistBootInFlight;
new bool:g_DistCycle;
new g_DistTimer;
new g_DistAct[4];
new g_DistSec[4];
new g_DistCrime[4];
new g_DistQType[16];
new g_DistQDist[16];
new g_DistQChar[16];
new g_DistQValue[16];
new g_DistQOp[16][41];
new g_DistQHead;
new g_DistQCount;
new g_DistSeen[32][41];
new g_DistSeenPos;
new g_DistHookHour[MAX_PLAYERS];
new g_DistHookCount[MAX_PLAYERS][4];
new g_DistLoadTry[MAX_PLAYERS];
new bool:g_DistQuietLoad[MAX_PLAYERS];
new g_DistAdminOp[MAX_PLAYERS][41];

bool:District_Valid(districtId)
{
	return districtId >= 1 && districtId <= 3;
}

District_CopyCache()
{
	for (new d = 1; d <= 3; d++)
	{
		if (!DB_LivingDistrictGet(d, 0))
		{
			continue;
		}
		new act = DB_LivingDistrictGet(d, 1);
		new bool:changed = g_DistBooted && act != g_DistAct[d];
		g_DistAct[d] = act;
		g_DistSec[d] = DB_LivingDistrictGet(d, 2);
		g_DistCrime[d] = DB_LivingDistrictGet(d, 3);
		if (changed)
		{
			LD_Emit(105, d, 0, act, "-");
		}
	}
}

bool:District_SeenOp(opId[])
{
	if (opId[0] == 0 || !strcmp(opId, "-", 0, 0x7FFFFFFF))
	{
		return 0;
	}
	for (new i = 0; i < 32; i++)
	{
		if (g_DistSeen[i][0] != 0 && !strcmp(g_DistSeen[i], opId, 0, 0x7FFFFFFF))
		{
			return 1;
		}
	}
	g_DistSeen[g_DistSeenPos][0] = 0;
	strcat(g_DistSeen[g_DistSeenPos], opId, 41);
	g_DistSeenPos = (g_DistSeenPos + 1) % 32;
	return 0;
}

bool:District_HookAllowed(districtId, charId)
{
	if (charId <= 0)
	{
		return 1;
	}
	new p = DB_LdCharOnline(charId);
	if (p == INVALID_PLAYER_ID)
	{
		return 1;
	}
	new hour = gettime() / 3600;
	if (g_DistHookHour[p] != hour)
	{
		g_DistHookHour[p] = hour;
		for (new d = 0; d <= 3; d++)
		{
			g_DistHookCount[p][d] = 0;
		}
	}
	if (g_DistHookCount[p][districtId] >= 3)
	{
		return 0;
	}
	g_DistHookCount[p][districtId]++;
	return 1;
}

District_ResetPlayer(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	g_DistHookHour[playerid] = 0;
	for (new d = 0; d <= 3; d++)
	{
		g_DistHookCount[playerid][d] = 0;
	}
	g_DistLoadTry[playerid] = 0;
	g_DistQuietLoad[playerid] = 0;
	g_DistAdminOp[playerid][0] = 0;
	DB_LivingPlayerReset(playerid);
}

District_StartBoot()
{
	if (g_DistBooted || g_DistBootInFlight)
	{
		return 0;
	}
	g_DistBootInFlight = 1;
	DB_LivingPushConfig();
	DB_LivingBoot();
}

District_OnInit()
{
	g_DistBooted = 0;
	g_DistBootInFlight = 0;
	g_DistCycle = 0;
	g_DistQHead = 0;
	g_DistQCount = 0;
	g_DistSeenPos = 0;
	for (new i = 0; i < 32; i++)
	{
		g_DistSeen[i][0] = 0;
	}
	for (new d = 0; d <= 3; d++)
	{
		g_DistAct[d] = 0;
		g_DistSec[d] = 0;
		g_DistCrime[d] = 0;
	}
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		District_ResetPlayer(p);
	}
	if (g_DistTimer != 0)
	{
		KillTimer(g_DistTimer);
	}
	g_DistTimer = SetTimer("District_OnTick", 30000, 1);
	District_StartBoot();
}

District_OnExit()
{
	if (g_DistTimer != 0)
	{
		KillTimer(g_DistTimer);
	}
	g_DistTimer = 0;
	g_DistBooted = 0;
	g_DistBootInFlight = 0;
	g_DistQCount = 0;
}

District_OnPlayerConnect(playerid)
{
	District_ResetPlayer(playerid);
}

District_OnCharReady(playerid)
{
	g_DistLoadTry[playerid] = 0;
	g_DistQuietLoad[playerid] = 0;
	DB_LivingLoadPlayer(playerid, 1);
}

District_OnPlayerDisconnect(playerid, reason)
{
	District_ResetPlayer(playerid);
}

District_ReloadPlayer(playerid)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pLivingReady] == 0)
	{
		return 0;
	}
	g_DistQuietLoad[playerid] = 1;
	DB_LivingLoadPlayer(playerid, 0);
}

public District_OnTick()
{
	if (!g_DistBooted)
	{
		District_StartBoot();
		return 1;
	}
	g_DistCycle = 1;
	DB_LivingTick();
	return 1;
}

public Living_OnDBBoot(result)
{
	if (result != 1)
	{
		g_DistBootInFlight = 0;
		Log_Write("DISTRICT", "boot living fallito (DB): nuovo tentativo al prossimo tick");
	}
	return 1;
}

public Living_OnDBDistricts(result, count)
{
	if (result != 1 || count <= 0)
	{
		if (!g_DistBooted && g_DistBootInFlight)
		{
			g_DistBootInFlight = 0;
			Log_Write("DISTRICT", "lettura quartieri fallita durante il boot: nuovo tentativo al prossimo tick");
		}
		g_DistCycle = 0;
		return 1;
	}
	District_CopyCache();
	if (!g_DistBooted)
	{
		if (!g_DistBootInFlight)
		{
			return 1;
		}
		g_DistBooted = 1;
		g_DistBootInFlight = 0;
		g_DistCycle = 1;
		new msg[160];
		format(msg, 160, "boot living completato: %d quartieri, %d contratti per bucket", count, DB_LivingBucketSlots());
		Log_Write("DISTRICT", msg);
		LD_SetReady(1);
	}
	if (g_DistCycle)
	{
		g_DistCycle = 0;
		if (funcidx("Director_OnCycle") != -1)
		{
			CallLocalFunction("Director_OnCycle", "");
		}
	}
	return 1;
}

District_GetActivity(districtId)
{
	return District_Valid(districtId) ? g_DistAct[districtId] : 0;
}

District_GetSecurity(districtId)
{
	return District_Valid(districtId) ? g_DistSec[districtId] : 0;
}

District_GetCrime(districtId)
{
	return District_Valid(districtId) ? g_DistCrime[districtId] : 0;
}

District_SetCache(districtId, activity, security, crime)
{
	if (!District_Valid(districtId))
	{
		return 0;
	}
	if (activity >= 0)
	{
		g_DistAct[districtId] = LD_Clamp(activity, 0, 1000);
	}
	if (security >= 0)
	{
		g_DistSec[districtId] = LD_Clamp(security, 0, 100);
	}
	if (crime >= 0)
	{
		g_DistCrime[districtId] = LD_Clamp(crime, 0, 100);
	}
	return 1;
}

District_Emit(type, districtId, charId, value, opId[])
{
	if (type >= 100)
	{
		return LD_Emit(type, districtId, charId, value, opId) >= 0 ? 1 : 0;
	}
	if (type < 1 || type > 9 || !District_Valid(districtId))
	{
		return 0;
	}
	if (type == 6 || type == 7)
	{
		if (!g_DistBooted || g_DistQCount >= 16)
		{
			return 0;
		}
		if (!District_HookAllowed(districtId, charId))
		{
			return 0;
		}
		new op[41];
		if (opId[0] == 0 || !strcmp(opId, "-", 0, 0x7FFFFFFF))
		{
			DB_LivingMakeOpId(op, 41, "le", districtId, charId > 0 ? charId : 0);
		}
		else
		{
			strcat(op, opId, 41);
		}
		new slot = (g_DistQHead + g_DistQCount) % 16;
		g_DistQType[slot] = type;
		g_DistQDist[slot] = districtId;
		g_DistQChar[slot] = charId;
		g_DistQValue[slot] = value;
		g_DistQOp[slot][0] = 0;
		strcat(g_DistQOp[slot], op, 41);
		g_DistQCount++;
		DB_LivingEmit(op, districtId, type, charId > 0 ? charId : 0, value);
		return 1;
	}
	if (District_SeenOp(opId))
	{
		return 0;
	}
	LD_Emit(type, districtId, charId, value, opId);
	if (g_DistBooted)
	{
		DB_LivingLoadDistricts();
	}
	return 1;
}

public Living_OnDBEmit(result, districtId, activity, security, crime)
{
	if (g_DistQCount <= 0)
	{
		return 1;
	}
	new slot = g_DistQHead;
	g_DistQHead = (g_DistQHead + 1) % 16;
	g_DistQCount--;
	if (result == 1 || result == 2)
	{
		new d = District_Valid(districtId) ? districtId : g_DistQDist[slot];
		District_SetCache(d, activity, security, crime);
		if (!District_SeenOp(g_DistQOp[slot]))
		{
			LD_Emit(g_DistQType[slot], d, g_DistQChar[slot], g_DistQValue[slot], g_DistQOp[slot]);
		}
		return 1;
	}
	new msg[160];
	format(msg, 160, "evento %d quartiere %d non registrato (esito %d, op %s)", g_DistQType[slot], g_DistQDist[slot], result, g_DistQOp[slot]);
	Log_Write("DISTRICT", msg);
	return 1;
}

public Living_OnDBPlayer(playerid, result, refund)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	new bool:quiet = g_DistQuietLoad[playerid];
	if (result == 1)
	{
		g_DistLoadTry[playerid] = 0;
		g_DistQuietLoad[playerid] = 0;
		if (refund > 0)
		{
			new msg[160];
			format(msg, 160, "Un noleggio rimasto aperto e' stato chiuso: $%d di cauzione sono tornati sul tuo conto.", refund);
			Util_Send(playerid, 0x66DD66FF, msg);
		}
		LD_Emit(108, 0, gPlayer[playerid][pCharId], refund, "-");
		return 1;
	}
	if (quiet && result != -1 && result != 10)
	{
		g_DistQuietLoad[playerid] = 0;
		return 1;
	}
	if (g_DistLoadTry[playerid] >= 3)
	{
		g_DistQuietLoad[playerid] = 0;
		if (!quiet)
		{
			Util_Send(playerid, -10270721, "Non e' stato possibile caricare la tua reputazione: riprova a rientrare piu' tardi.");
		}
		Log_Write("DISTRICT", "caricamento dati living del personaggio fallito dopo i tentativi");
		return 1;
	}
	g_DistLoadTry[playerid]++;
	SetTimerEx("District_OnLoadRetry", 3000, 0, "dd", playerid, gPlayer[playerid][pCharId]);
	return 1;
}

public District_OnLoadRetry(playerid, charId)
{
	if (!IsPlayerConnected(playerid) || charId <= 0 || gPlayer[playerid][pCharId] != charId)
	{
		return 1;
	}
	DB_LivingLoadPlayer(playerid, !g_DistQuietLoad[playerid]);
	return 1;
}

bool:District_ParseOpt(tok[], &value)
{
	value = -1;
	if (tok[0] == 0 || !strcmp(tok, "-", 0, 0x7FFFFFFF))
	{
		return 1;
	}
	if (!Util_ParseInt(tok, value))
	{
		return 0;
	}
	return value >= -1;
}

bool:District_CmdLdset(playerid, params[])
{
	if (Util_GetAdmin(playerid) < 3)
	{
		return 0;
	}
	if (!g_DistBooted)
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	new pos = 0, tName[16], tAct[16], tSec[16], tCrime[16];
	Util_NextToken(params, pos, tName, 16);
	Util_NextToken(params, pos, tAct, 16);
	Util_NextToken(params, pos, tSec, 16);
	Util_NextToken(params, pos, tCrime, 16);
	new d = LD_ParseDistrict(tName), act = 0, sec = 0, crime = 0;
	if (d == 0 || tAct[0] == 0 || !District_ParseOpt(tAct, act) || !District_ParseOpt(tSec, sec) || !District_ParseOpt(tCrime, crime))
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /ldset <idlewood|ganton|jefferson> <attivita' 0-1000> [sicurezza 0-100] [pressione 0-100]  (- = invariato)");
		return 1;
	}
	if (act > 1000 || sec > 100 || crime > 100)
	{
		Util_Send(playerid, -10270721, "Valori fuori range: attivita' 0-1000, sicurezza e pressione 0-100.");
		return 1;
	}
	DB_LivingMakeOpId(g_DistAdminOp[playerid], 41, "la", d, gPlayer[playerid][pCharId]);
	DB_LivingAdminSet(playerid, g_DistAdminOp[playerid], d, act, sec, crime);
	return 1;
}

public Living_OnDBAdminSet(playerid, result, districtId, activity, security, crime)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	new msg[160], name[16];
	if (result != 1 && result != 2)
	{
		format(msg, 160, "/ldset non applicato (esito %d).", result);
		Util_Send(playerid, -10270721, msg);
		return 1;
	}
	District_SetCache(districtId, activity, security, crime);
	LD_DistrictName(districtId, name, 16);
	format(msg, 160, "%s: attivita' %d, sicurezza %d, pressione %d", name, activity, security, crime);
	DB_AdminLog(gPlayer[playerid][pAccountId], 0, "ldset", msg);
	Util_Send(playerid, -5963521, msg);
	if (!District_SeenOp(g_DistAdminOp[playerid]))
	{
		LD_Emit(9, districtId, gPlayer[playerid][pCharId], activity, g_DistAdminOp[playerid]);
	}
	g_DistCycle = 1;
	DB_LivingLoadDistricts();
	return 1;
}

// ===== modules/director/director.inc =====
new g_DirBoard[24][E_DIR_BOARD];
new g_DirBoardCount;
new bool:g_DirBoardLoaded;
new g_DirExpAt[MAX_PLAYERS];
new g_DirRetry[MAX_PLAYERS];
new g_DirSeq[MAX_PLAYERS];
new g_DirRelAfter[MAX_PLAYERS];
new g_DirRelReason[MAX_PLAYERS];
new bool:g_DirRelSilent[MAX_PLAYERS];
new g_DirCompInteg[MAX_PLAYERS];
new g_DirCompSec[MAX_PLAYERS];
new g_DirCompOp[MAX_PLAYERS][41];
new g_DirCompCt[MAX_PLAYERS];
new g_DirLockCt[MAX_PLAYERS];
new g_DirLockAt[MAX_PLAYERS];

Director_WarehousePos(districtId, &Float:x, &Float:y)
{
	switch (districtId)
	{
		case 1:
		{
			x = 1880.0;
			y = -1780.0;
		}
		case 2:
		{
			x = 2400.0;
			y = -1740.0;
		}
		case 3:
		{
			x = 2145.0;
			y = -1215.0;
		}
		default:
		{
			x = 0.0;
			y = 0.0;
		}
	}
}

Director_ShopPos(districtId, &Float:x, &Float:y)
{
	switch (districtId)
	{
		case 1:
		{
			x = 1927.0;
			y = -1790.0;
		}
		case 2:
		{
			x = 2490.0;
			y = -1690.0;
		}
		case 3:
		{
			x = 2190.0;
			y = -1155.0;
		}
		default:
		{
			x = 0.0;
			y = 0.0;
		}
	}
}

Director_RouteMeters(fromD, toD)
{
	new Float:ax, Float:ay, Float:bx, Float:by;
	Director_WarehousePos(fromD, ax, ay);
	Director_ShopPos(toD, bx, by);
	new Float:dx = (bx - ax), Float:dy = (by - ay);
	return floatround(floatsqroot(((dx * dx) + (dy * dy))), 1);
}

Director_BoardFind(contractId)
{
	for (new i = 0; i < g_DirBoardCount; i++)
	{
		if (g_DirBoard[i][dbContractId] == contractId)
		{
			return i;
		}
	}
	return -1;
}

Director_BestLocal(playerid, fromD, toD)
{
	new a = LD_GetLocalRep(playerid, fromD), b = LD_GetLocalRep(playerid, toD);
	return a > b ? a : b;
}

bool:Director_PremiumOk(playerid, fromD, toD)
{
	return Director_BestLocal(playerid, fromD, toD) >= 20 || LD_GetProPoints(playerid, 1) >= 100;
}

bool:Director_TickBefore(untilTick)
{
	return untilTick != 0 && GetTickCount() - untilTick < 0;
}

Director_BlockCode(playerid, i)
{
	if (i < 0 || i >= g_DirBoardCount)
	{
		return 10;
	}
	if (gPlayer[playerid][pLevel] < g_DirBoard[i][dbMinLevel])
	{
		return 1;
	}
	if (LD_GetProPoints(playerid, 1) < g_DirBoard[i][dbMinRep])
	{
		return 2;
	}
	if (g_DirBoard[i][dbPremium] == 0 && Director_BestLocal(playerid, g_DirBoard[i][dbFromDistrict], g_DirBoard[i][dbToDistrict]) < g_DirBoard[i][dbMinLocalRep])
	{
		return 3;
	}
	if (gPlayer[playerid][pContractId] != 0 || gPlayer[playerid][pFreightWelcome] != 0)
	{
		return 4;
	}
	if (LD_ActiveFlow(playerid) != 0)
	{
		return 5;
	}
	if (Director_TickBefore(gPlayer[playerid][pContractCooldownUntil]))
	{
		return 6;
	}
	if (DB_LivingPlayerGet(playerid, 2) >= 8 || DB_LivingPlayerGet(playerid, 1) >= 2800)
	{
		return 7;
	}
	if (g_DirLockCt[playerid] == g_DirBoard[i][dbContractId] && gettime() - g_DirLockAt[playerid] < 600)
	{
		return 8;
	}
	if (g_DirBoard[i][dbExpiresAt] <= gettime())
	{
		return 9;
	}
	return 0;
}

bool:Director_BoardVisible(playerid, i)
{
	if (i < 0 || i >= g_DirBoardCount || g_DirBoard[i][dbExpiresAt] <= gettime())
	{
		return 0;
	}
	if (g_DirBoard[i][dbPremium] != 0 && !Director_PremiumOk(playerid, g_DirBoard[i][dbFromDistrict], g_DirBoard[i][dbToDistrict]))
	{
		return 0;
	}
	return 1;
}

Director_ClearContract(playerid)
{
	gPlayer[playerid][pContractId] = 0;
	gPlayer[playerid][pContractPhase] = 0;
	gPlayer[playerid][pContractFromDistrict] = 0;
	gPlayer[playerid][pContractToDistrict] = 0;
	gPlayer[playerid][pContractCargo] = 0;
	gPlayer[playerid][pContractDistance] = 0;
	gPlayer[playerid][pContractReward] = 0;
	gPlayer[playerid][pContractStartTick] = 0;
	gPlayer[playerid][pFreightLegTick] = 0;
	gPlayer[playerid][pContractPendOp] = 0;
	gPlayer[playerid][pContractOpId][0] = 0;
	g_DirExpAt[playerid] = 0;
	g_DirRetry[playerid] = 0;
	g_DirRelAfter[playerid] = 0;
	g_DirRelReason[playerid] = 0;
	g_DirRelSilent[playerid] = 0;
	g_DirCompOp[playerid][0] = 0;
	g_DirCompCt[playerid] = 0;
	g_DirSeq[playerid]++;
}

Director_ResetPlayer(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	Director_ClearContract(playerid);
	g_DirLockCt[playerid] = 0;
	g_DirLockAt[playerid] = 0;
	g_DirCompInteg[playerid] = 0;
	g_DirCompSec[playerid] = 0;
}

Director_SetOp(playerid, pend, tag[], ref)
{
	gPlayer[playerid][pContractPendOp] = pend;
	gPlayer[playerid][pContractOpId][0] = 0;
	DB_LivingMakeOpId(gPlayer[playerid][pContractOpId], 41, tag, ref, gPlayer[playerid][pCharId]);
	g_DirRetry[playerid] = 0;
}

Director_Send(playerid)
{
	new ct = gPlayer[playerid][pContractId];
	switch (gPlayer[playerid][pContractPendOp])
	{
		case 1:
		{
			DB_LivingCtAccept(playerid, ct, gPlayer[playerid][pContractOpId]);
		}
		case 2:
		{
			DB_LivingCtPickup(playerid, ct, gPlayer[playerid][pContractOpId]);
		}
		case 3:
		{
			DB_LivingCtComplete(playerid, ct, gPlayer[playerid][pContractOpId], g_DirCompInteg[playerid], g_DirCompSec[playerid]);
		}
		case 4:
		{
			new r = g_DirRelReason[playerid] == 1 || g_DirRelReason[playerid] == 4 ? 1 : 0;
			DB_LivingCtRelease(playerid, ct, gPlayer[playerid][pContractOpId], r);
		}
	}
}

bool:Director_ScheduleRetry(playerid)
{
	if (g_DirRetry[playerid] >= 3)
	{
		return 0;
	}
	g_DirRetry[playerid]++;
	SetTimerEx("Director_OnRetry", 2500, 0, "ddd", playerid, gPlayer[playerid][pCharId], g_DirSeq[playerid]);
	return 1;
}

public Director_OnRetry(playerid, charId, seq)
{
	if (!IsPlayerConnected(playerid) || charId <= 0 || gPlayer[playerid][pCharId] != charId || g_DirSeq[playerid] != seq)
	{
		return 1;
	}
	if (gPlayer[playerid][pContractPendOp] == 0 || gPlayer[playerid][pContractId] == 0)
	{
		return 1;
	}
	Director_Send(playerid);
	return 1;
}

Director_RunDeferred(playerid)
{
	new r = g_DirRelAfter[playerid];
	g_DirRelAfter[playerid] = 0;
	if (r != 0 && gPlayer[playerid][pContractId] != 0 && gPlayer[playerid][pContractPendOp] == 0)
	{
		Director_Release(playerid, r);
	}
}

Director_EndLocal(playerid, freightReason, bool:released, relReason)
{
	new ct = gPlayer[playerid][pContractId], charId = gPlayer[playerid][pCharId], fromD = gPlayer[playerid][pContractFromDistrict];
	Freight_End(playerid, freightReason);
	Director_ClearContract(playerid);
	if (released && ct > 0)
	{
		g_DirLockCt[playerid] = ct;
		g_DirLockAt[playerid] = gettime();
		LD_Emit(103, fromD, charId, relReason, "-");
	}
	DB_LivingBoard(65535);
}

Director_OnInit()
{
	g_DirBoardCount = 0;
	g_DirBoardLoaded = 0;
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Director_ResetPlayer(p);
	}
	LD_Listen("Director_OnDistrictEvent", 10);
}

Director_OnExit()
{
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Director_ClearContract(p);
	}
	g_DirBoardCount = 0;
}

Director_OnPlayerConnect(playerid)
{
	Director_ResetPlayer(playerid);
}

Director_OnCharReady(playerid)
{
	if (!g_DirBoardLoaded || g_DirBoardCount < 4)
	{
		Director_OnCycle();
	}
}

Director_OnPlayerDisconnect(playerid, reason)
{
	new ct = gPlayer[playerid][pContractId];
	if (ct != 0 && gPlayer[playerid][pContractPendOp] == 0 && gPlayer[playerid][pContractPhase] != 0)
	{
		new op[41];
		DB_LivingMakeOpId(op, 41, "cr", ct, gPlayer[playerid][pCharId]);
		DB_LivingCtRelease(playerid, ct, op, 0);
	}
	Director_ResetPlayer(playerid);
}

public Director_OnDistrictEvent(type, districtId, charId, value, opId[])
{
	if (type == 9 || type == 8)
	{
		DB_LivingBoard(65535);
	}
	return 1;
}

Director_PlayersInGame()
{
	new n = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i) && gPlayer[i][pLivingReady] != 0)
		{
			n++;
		}
	}
	return n;
}

Director_Generate(bucket)
{
	new slots = DB_LivingBucketSlots();
	for (new s = 0; s < slots; s++)
	{
		new fromD = 0, toD = 0, cargo = 0;
		if (!LD_ContractSlot(bucket, s, fromD, toD, cargo))
		{
			continue;
		}
		new meters = Director_RouteMeters(fromD, toD);
		if (meters < 300)
		{
			continue;
		}
		new bool:premium = 0;
		if (s >= 3)
		{
			new h = LD_Hash32(bucket, s, 2);
			premium = LD_HashMod(h >>> 24, 2) == 0;
		}
		DB_LivingGenerate(bucket, s, fromD, toD, fromD, toD, cargo, meters, 2, 0, 0, premium ? 1 : 0);
	}
}

public Director_OnCycle()
{
	if (!LD_IsReady())
	{
		return 1;
	}
	new now = gettime();
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (!IsPlayerConnected(p) || gPlayer[p][pContractId] == 0 || gPlayer[p][pContractPendOp] != 0)
		{
			continue;
		}
		if (gPlayer[p][pContractPhase] != 1 && gPlayer[p][pContractPhase] != 2)
		{
			continue;
		}
		if (g_DirExpAt[p] > 0 && now >= g_DirExpAt[p])
		{
			Director_Release(p, 5);
		}
	}
	if (Director_PlayersInGame() > 0)
	{
		Director_Generate(LD_Bucket(now));
	}
	DB_LivingBoard(65535);
	return 1;
}

public Living_OnDBBoard(playerid, result, count)
{
	if (playerid != INVALID_PLAYER_ID || result != 1)
	{
		return 1;
	}
	new n = 0;
	for (new i = 0; i < count && n < 24; i++)
	{
		if (g_LdBoard[i][lbState] != 0 && g_LdBoard[i][lbState] != 7)
		{
			continue;
		}
		g_DirBoard[n][dbContractId] = g_LdBoard[i][lbId];
		g_DirBoard[n][dbFromDistrict] = g_LdBoard[i][lbFromDistrict];
		g_DirBoard[n][dbToDistrict] = g_LdBoard[i][lbToDistrict];
		g_DirBoard[n][dbCargo] = g_LdBoard[i][lbCargo];
		g_DirBoard[n][dbDistanceM] = g_LdBoard[i][lbDistanceM];
		g_DirBoard[n][dbReward] = g_LdBoard[i][lbReward];
		g_DirBoard[n][dbExpiresAt] = g_LdBoard[i][lbExpiresAt];
		g_DirBoard[n][dbMinLevel] = g_LdBoard[i][lbMinLevel];
		g_DirBoard[n][dbMinRep] = g_LdBoard[i][lbMinRep];
		g_DirBoard[n][dbMinLocalRep] = g_LdBoard[i][lbMinLocalRep];
		g_DirBoard[n][dbPremium] = g_LdBoard[i][lbPremium];
		n++;
	}
	g_DirBoardCount = n;
	g_DirBoardLoaded = 1;
	LD_Emit(104, 0, 0, n, "-");
	return 1;
}

Director_BoardCount()
{
	return g_DirBoardCount;
}

bool:Director_BoardGet(index, &contractId, &fromD, &toD, &cargo, &reward, &distanceM, &expiresAt, &minLevel, &minRep, &minLocalRep, &premium)
{
	if (index < 0 || index >= g_DirBoardCount)
	{
		contractId = 0;
		fromD = 0;
		toD = 0;
		cargo = 0;
		reward = 0;
		distanceM = 0;
		expiresAt = 0;
		minLevel = 0;
		minRep = 0;
		minLocalRep = 0;
		premium = 0;
		return 0;
	}
	contractId = g_DirBoard[index][dbContractId];
	fromD = g_DirBoard[index][dbFromDistrict];
	toD = g_DirBoard[index][dbToDistrict];
	cargo = g_DirBoard[index][dbCargo];
	reward = g_DirBoard[index][dbReward];
	distanceM = g_DirBoard[index][dbDistanceM];
	expiresAt = g_DirBoard[index][dbExpiresAt];
	minLevel = g_DirBoard[index][dbMinLevel];
	minRep = g_DirBoard[index][dbMinRep];
	minLocalRep = g_DirBoard[index][dbMinLocalRep];
	premium = g_DirBoard[index][dbPremium];
	return 1;
}

Director_ExpiresAt(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	return g_DirExpAt[playerid];
}

Director_BlockMsg(playerid, code)
{
	switch (code)
	{
		case 1:
		{
			Util_Send(playerid, -10270721, "Serve un livello piu' alto per questo contratto.");
		}
		case 2:
		{
			Util_Send(playerid, -10270721, "La tua reputazione nei trasporti non basta ancora per questo contratto.");
		}
		case 3:
		{
			Util_Send(playerid, -10270721, "Il quartiere non ti conosce abbastanza per questo contratto.");
		}
		case 4:
		{
			Util_Send(playerid, -10270721, "Hai gia' un contratto attivo (/contratto).");
		}
		case 5:
		{
			LD_SendBlock(playerid, 4);
		}
		case 6:
		{
			Util_Send(playerid, -10270721, "Prenditi un attimo: potrai accettare un nuovo contratto tra poco.");
		}
		case 7:
		{
			Util_Send(playerid, -10270721, "Per quest'ora hai lavorato abbastanza: riprova piu' tardi.");
		}
		case 8:
		{
			Util_Send(playerid, -10270721, "Hai lasciato questo contratto da poco: scegline un altro.");
		}
		default:
		{
			Util_Send(playerid, -10270721, "Questo contratto non e' piu' disponibile.");
		}
	}
}

bool:Director_Accept(playerid, contractId)
{
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	if (!LD_IsReady() || gPlayer[playerid][pLivingReady] == 0)
	{
		LD_SendBlock(playerid, 1);
		return 0;
	}
	if (gPlayer[playerid][pContractPendOp] != 0 || DB_LivingBusy(playerid, 0))
	{
		Util_Send(playerid, -10270721, "Un'operazione sul contratto e' gia' in corso: attendi.");
		return 0;
	}
	if (Hub_NearBoard(playerid) < 0)
	{
		Util_Send(playerid, -10270721, "I contratti si accettano a una bacheca: Casa del Quartiere di Idlewood, magazzino di Ganton o di Jefferson.");
		return 0;
	}
	new block = LD_CheckStart(playerid);
	if (block != 0)
	{
		LD_SendBlock(playerid, block);
		return 0;
	}
	if (gPlayer[playerid][pLevel] < 2)
	{
		Director_BlockMsg(playerid, 1);
		return 0;
	}
	new i = Director_BoardFind(contractId);
	if (i < 0 || !Director_BoardVisible(playerid, i))
	{
		Director_BlockMsg(playerid, 9);
		return 0;
	}
	new code = Director_BlockCode(playerid, i);
	if (code != 0)
	{
		Director_BlockMsg(playerid, code);
		return 0;
	}
	gPlayer[playerid][pContractId] = contractId;
	gPlayer[playerid][pContractPhase] = 0;
	gPlayer[playerid][pContractFromDistrict] = g_DirBoard[i][dbFromDistrict];
	gPlayer[playerid][pContractToDistrict] = g_DirBoard[i][dbToDistrict];
	gPlayer[playerid][pContractCargo] = g_DirBoard[i][dbCargo];
	gPlayer[playerid][pContractDistance] = g_DirBoard[i][dbDistanceM];
	gPlayer[playerid][pContractReward] = g_DirBoard[i][dbReward];
	g_DirExpAt[playerid] = g_DirBoard[i][dbExpiresAt];
	Director_SetOp(playerid, 1, "ca", contractId);
	Director_Send(playerid);
	return 1;
}

bool:Director_Pickup(playerid)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pContractId] == 0 || gPlayer[playerid][pContractPhase] != 1)
	{
		return 0;
	}
	if (gPlayer[playerid][pContractPendOp] != 0)
	{
		return 0;
	}
	Director_SetOp(playerid, 2, "cp", gPlayer[playerid][pContractId]);
	Director_Send(playerid);
	return 1;
}

bool:Director_Complete(playerid, integrityPct, seconds)
{
	new ct = gPlayer[playerid][pContractId];
	if (!IsPlayerConnected(playerid) || ct == 0 || gPlayer[playerid][pContractPhase] != 2)
	{
		return 0;
	}
	if (gPlayer[playerid][pContractPendOp] != 0)
	{
		return 0;
	}
	g_DirCompInteg[playerid] = LD_Clamp(integrityPct, 0, 100);
	g_DirCompSec[playerid] = seconds > 0 ? seconds : 0;
	gPlayer[playerid][pContractPendOp] = 3;
	g_DirRetry[playerid] = 0;
	if (g_DirCompCt[playerid] == ct && g_DirCompOp[playerid][0] != 0)
	{
		gPlayer[playerid][pContractOpId][0] = 0;
		strcat(gPlayer[playerid][pContractOpId], g_DirCompOp[playerid], 41);
	}
	else
	{
		DB_LivingMakeOpId(gPlayer[playerid][pContractOpId], 41, "cc", ct, gPlayer[playerid][pCharId]);
		g_DirCompCt[playerid] = ct;
		g_DirCompOp[playerid][0] = 0;
		strcat(g_DirCompOp[playerid], gPlayer[playerid][pContractOpId], 41);
	}
	Director_Send(playerid);
	return 1;
}

bool:Director_Release(playerid, reason)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pContractId] == 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pContractPendOp] == 4)
	{
		return 1;
	}
	if (gPlayer[playerid][pContractPendOp] != 0)
	{
		g_DirRelAfter[playerid] = reason;
		return 1;
	}
	Freight_End(playerid, reason);
	g_DirRelReason[playerid] = reason;
	Director_SetOp(playerid, 4, "cr", gPlayer[playerid][pContractId]);
	Director_Send(playerid);
	return 1;
}

Director_OnAccept(playerid, result, contractId, v2)
{
	new charId = gPlayer[playerid][pCharId], msg[160];
	if (result == 1)
	{
		gPlayer[playerid][pContractPendOp] = 0;
		gPlayer[playerid][pContractPhase] = 1;
		gPlayer[playerid][pContractStartTick] = GetTickCount();
		gPlayer[playerid][pContractCooldownUntil] = GetTickCount() + 20000;
		if (v2 > 0)
		{
			g_DirExpAt[playerid] = v2;
		}
		if (!Freight_Begin(playerid, contractId, gPlayer[playerid][pContractFromDistrict], gPlayer[playerid][pContractToDistrict], gPlayer[playerid][pContractCargo], gPlayer[playerid][pContractDistance], 0))
		{
			Util_Send(playerid, -10270721, "Il magazzino non ha un mezzo disponibile adesso: contratto rimesso in bacheca senza penalita'.");
			Director_Release(playerid, 6);
			return 0;
		}
		LD_Emit(101, gPlayer[playerid][pContractFromDistrict], charId, contractId, gPlayer[playerid][pContractOpId]);
		DB_LivingBoard(65535);
		Director_RunDeferred(playerid);
		return 0;
	}
	if (result == -1)
	{
		if (Director_ScheduleRetry(playerid))
		{
			return 0;
		}
		g_DirRelSilent[playerid] = 1;
		g_DirRelReason[playerid] = 6;
		Director_SetOp(playerid, 4, "cr", contractId);
		Director_Send(playerid);
		Util_Send(playerid, -10270721, "Il servizio contratti non risponde: riprova tra poco.");
		return 0;
	}
	Director_ClearContract(playerid);
	switch (result)
	{
		case 2:
		{
			Util_Send(playerid, -10270721, "Hai gia' chiuso questo contratto.");
		}
		case 4:
		{
			Util_Send(playerid, -10270721, "Qualcun altro ha appena preso questo contratto.");
		}
		case 5:
		{
			Util_Send(playerid, -10270721, "Questo contratto e' scaduto.");
		}
		case 6:
		{
			Director_BlockMsg(playerid, 7);
		}
		case 7:
		{
			Util_Send(playerid, -10270721, "Non soddisfi ancora i requisiti di questo contratto (livello, reputazione o attesa tra contratti).");
		}
		case 10:
		{
			Util_Send(playerid, -10270721, "Un'operazione e' gia' in corso: attendi.");
		}
		default:
		{
			format(msg, 160, "Contratto non accettato (esito %d).", result);
			Util_Send(playerid, -10270721, msg);
		}
	}
	DB_LivingBoard(65535);
}

Director_AfterFreight(playerid, contractId, bool:terminal, relReason)
{
	if (gPlayer[playerid][pContractId] != contractId || gPlayer[playerid][pContractPendOp] != 0)
	{
		return 0;
	}
	if (terminal)
	{
		Director_Release(playerid, relReason);
	}
	else
	{
		Director_RunDeferred(playerid);
	}
}

Director_OnPickup(playerid, result)
{
	new ct = gPlayer[playerid][pContractId];
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	gPlayer[playerid][pContractPendOp] = 0;
	if (result == 1 || result == 2)
	{
		gPlayer[playerid][pContractPhase] = 2;
		if (gPlayer[playerid][pFreightLegTick] == 0)
		{
			gPlayer[playerid][pFreightLegTick] = GetTickCount();
		}
		LD_Emit(102, gPlayer[playerid][pContractFromDistrict], gPlayer[playerid][pCharId], ct, gPlayer[playerid][pContractOpId]);
		Freight_OnPickupResult(playerid, 1);
		Director_AfterFreight(playerid, ct, 0, 0);
		return 0;
	}
	new bool:terminal = result != -1 && result != 10;
	Freight_OnPickupResult(playerid, result);
	Director_AfterFreight(playerid, ct, terminal, 5);
}

Director_OnComplete(playerid, result, amount, balance, v1, v2)
{
	new ct = gPlayer[playerid][pContractId], toD = gPlayer[playerid][pContractToDistrict], charId = gPlayer[playerid][pCharId];
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	gPlayer[playerid][pContractPendOp] = 0;
	new bool:paid = result == 1 || result == 6;
	if (result == -1 || result == 10 || result == 4)
	{
		if (result == 4)
		{
			g_DirCompOp[playerid][0] = 0;
			g_DirCompCt[playerid] = 0;
		}
		Freight_OnCompleteResult(playerid, result, 0, 0);
		Director_AfterFreight(playerid, ct, 0, 0);
		return 0;
	}
	new op[41];
	strcat(op, gPlayer[playerid][pContractOpId], 41);
	if (paid || result == 8)
	{
		LD_SetProPoints(playerid, 1, v1);
	}
	if (paid && v2 > 0)
	{
		District_SetCache(toD, v2, -1, -1);
	}
	if (paid || result == 8 || result == 2)
	{
		Freight_OnCompleteResult(playerid, result, paid ? amount : 0, balance);
		Director_EndLocal(playerid, 0, 0, 0);
		gPlayer[playerid][pContractCooldownUntil] = GetTickCount() + 90000;
		if (paid)
		{
			District_Emit(1, toD, charId, amount, op);
		}
		else if (result == 8)
		{
			District_Emit(2, toD, charId, ct, op);
		}
		District_ReloadPlayer(playerid);
		return 0;
	}
	g_DirCompOp[playerid][0] = 0;
	g_DirCompCt[playerid] = 0;
	Freight_OnCompleteResult(playerid, result, 0, balance);
	Director_AfterFreight(playerid, ct, 1, 5);
}

Director_OnReleased(playerid, result, v2)
{
	if (result == -1 && Director_ScheduleRetry(playerid))
	{
		return 0;
	}
	if (result == 1 && v2 >= 0)
	{
		LD_SetProPoints(playerid, 1, v2);
	}
	new reason = g_DirRelReason[playerid], bool:silent = g_DirRelSilent[playerid];
	if (result == -1)
	{
		Log_Write("DIRECTOR", "rilascio contratto senza esito dal DB: lo completa la pulizia al prossimo login/boot");
	}
	if (!silent && result == 1)
	{
		if (reason == 1 || reason == 4)
		{
			Util_Send(playerid, -10270721, "Hai lasciato il contratto: nessuna perdita di denaro, ma la tua reputazione nei trasporti ne risente.");
		}
		else if (reason != 5)
		{
			Util_Send(playerid, -1, "Contratto interrotto senza penalita': e' tornato in bacheca.");
		}
	}
	Director_EndLocal(playerid, reason, 1, reason);
}

public Living_OnDBContract(playerid, action, result, contractId, amount, balance, v1, v2, v3)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (gPlayer[playerid][pContractId] == 0 || (contractId != 0 && contractId != gPlayer[playerid][pContractId]))
	{
		if (result != 10)
		{
			new msg[160];
			format(msg, 160, "esito contratto fuori sequenza: azione %d contratto %d esito %d", action, contractId, result);
			Log_Write("DIRECTOR", msg);
		}
		return 1;
	}
	switch (action)
	{
		case 1:
		{
			if (gPlayer[playerid][pContractPendOp] == 1)
			{
				Director_OnAccept(playerid, result, gPlayer[playerid][pContractId], v2);
			}
		}
		case 2:
		{
			if (gPlayer[playerid][pContractPendOp] == 2)
			{
				Director_OnPickup(playerid, result);
			}
		}
		case 4:
		{
			if (gPlayer[playerid][pContractPendOp] == 3)
			{
				Director_OnComplete(playerid, result, amount, balance, v1, v2);
			}
		}
		case 3:
		{
			if (gPlayer[playerid][pContractPendOp] == 4)
			{
				Director_OnReleased(playerid, result, v2);
			}
		}
	}
	return 1;
}

// ===== modules/rental/street_rental.inc =====
// =============================================================================
// rental/street_rental.inc - auto a noleggio parcheggiate per la citta' ("noleggio di strada").
//
// Berline di classe base (Landstalker, Premier, Admiral, ...) parcheggiate in punti casuali di Los Santos.
// Il giocatore sale al volante -> offerta $179 per 60 minuti (nessuna cauzione). Il pagamento passa dallo
// stesso sistema dei noleggi (sp_rental_open, vkind 5, migrazione sql/migrations/013_street_rental.sql):
// stesse regole (un solo noleggio alla volta, op_id idempotente, banca + contanti), stessa scadenza e riconsegna.
// La riconsegna si fa ovunque con /riconsegna (o scade da sola); poi l'auto sparisce e un'altra compare altrove.
// =============================================================================

#define SRENT_VKIND        (5)
#define SRENT_PRICE        (179)          // deve coincidere con ld_config RENT_FEE_STREET (il DB decide l'addebito)
#define SRENT_MINUTES      (60)           // = RENT_STREET_MIN
#define SRENT_ACTIVE       (10)           // auto disponibili in contemporanea
#define SRENT_RESPAWN_S    (180)          // dopo un noleggio, un'auto nuova compare entro ~3 minuti
#define SRENT_DIALOG       (9800)

static const s_SrModels[] = { 400, 426, 445, 421, 405, 507, 546, 547, 404, 439, 492, 551, 529, 540, 585, 550 };

// punti di parcheggio all'aperto (interior 0, mondo 0): x, y, z, angolo
static const Float:s_SrSpots[][4] = {
	{1524.0, -1716.0, 13.4, 90.0},      // Pershing Square, vicino all'agenzia
	{1546.0, -1676.0, 13.4, 90.0},      // parcheggio LSPD, Pershing Square
	{1773.0, -1916.0, 13.4, 270.0},     // Unity Station
	{1745.0, -1862.0, 13.4, 0.0},       // Unity Station, uscita
	{1936.0, -1789.0, 13.4, 270.0},     // distributore di Idlewood
	{2079.0, -1808.0, 13.4, 90.0},      // Idlewood, strada principale
	{2228.0, -1735.0, 13.4, 270.0},     // Ganton, palestra
	{2486.0, -1667.0, 13.2, 90.0},      // Grove Street
	{2408.0, -1720.0, 13.5, 0.0},       // Ganton
	{2215.0, -1150.0, 25.7, 270.0},     // Jefferson, motel
	{2128.0, -1196.0, 23.8, 180.0},     // Jefferson
	{1971.0, -1197.0, 25.6, 0.0},       // Glen Park
	{1180.0, -1340.0, 13.6, 270.0},     // All Saints General Hospital
	{1185.0, -1338.0, 13.6, 270.0},     // All Saints, secondo posto
	{1004.0, -946.0, 42.0, 0.0},        // distributore di Mulholland
	{2116.0, -1903.0, 13.4, 0.0},       // distributore di Willowfield
	{1685.0, -2245.0, 13.4, 180.0},     // aeroporto, parcheggio
	{1835.0, -1855.0, 13.4, 90.0}       // El Corona, negozio
};

new g_SrVeh[sizeof s_SrSpots];            // veicolo libero su quel punto (0 = vuoto)
new g_SrPend[MAX_PLAYERS];                // auto per cui il giocatore ha accettato l'offerta (attesa DB)
new g_SrOffer[MAX_PLAYERS];               // auto offerta (dialog aperto)
new g_SrNextSpawn;                        // gettime() del prossimo riempimento
new g_SrTimer;

StreetRental_OnInit()
{
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		g_SrVeh[i] = 0;
	}
	for (new n = 0; n < SRENT_ACTIVE; n++)
	{
		StreetRental_SpawnOne();
	}
	g_SrTimer = SetTimer("StreetRental_OnTick", 10000, true);
}

StreetRental_OnExit()
{
	if (g_SrTimer)
	{
		KillTimer(g_SrTimer);
		g_SrTimer = 0;
	}
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] != 0 && IsValidVehicle(g_SrVeh[i]))
		{
			DestroyVehicle(g_SrVeh[i]);
		}
		g_SrVeh[i] = 0;
	}
}

StreetRental_Count()
{
	new n = 0;
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] != 0)
		{
			n++;
		}
	}
	return n;
}

StreetRental_SpotOf(vehicleid)
{
	if (vehicleid <= 0)
	{
		return -1;
	}
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] == vehicleid)
		{
			return i;
		}
	}
	return -1;
}

bool:StreetRental_Watched(spot)
{
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		if (IsPlayerConnected(p) && GetPlayerInterior(p) == 0 &&
			GetPlayerDistanceFromPoint(p, s_SrSpots[spot][0], s_SrSpots[spot][1], s_SrSpots[spot][2]) < 25.0)
		{
			return true;
		}
	}
	return false;
}

// un'auto nuova su un punto libero scelto a caso (niente se un giocatore e' a meno di 25 m: non compare sotto gli occhi)
StreetRental_SpawnOne()
{
	new free[sizeof s_SrSpots], n = 0;
	for (new i = 0; i < sizeof s_SrSpots; i++)
	{
		if (g_SrVeh[i] == 0 && !StreetRental_Watched(i))
		{
			free[n++] = i;
		}
	}
	if (n == 0 || !LD_PoolHasRoom())
	{
		return 0;
	}
	new s = free[random(n)], model = s_SrModels[random(sizeof s_SrModels)];
	new col = random(126);
	new veh = CreateVehicle(model, s_SrSpots[s][0], s_SrSpots[s][1], s_SrSpots[s][2], s_SrSpots[s][3], col, col, -1, false);
	if (veh == INVALID_VEHICLE_ID || veh <= 0)
	{
		return 0;
	}
	SetVehicleParamsEx(veh, 0, 0, 0, 0, 0, 0, 0);
	SetVehicleNumberPlate(veh, "RENT");
	g_SrVeh[s] = veh;
	return 1;
}

public StreetRental_OnTick()
{
	if (StreetRental_Count() < SRENT_ACTIVE && gettime() >= g_SrNextSpawn)
	{
		if (StreetRental_SpawnOne())
		{
			g_SrNextSpawn = gettime() + 20;
		}
	}
}

StreetRental_OnPlayerConnect(playerid)
{
	g_SrPend[playerid] = 0;
	g_SrOffer[playerid] = 0;
}

StreetRental_OnPlayerDisconnect(playerid)
{
	g_SrPend[playerid] = 0;
	g_SrOffer[playerid] = 0;
}

// al volante di un'auto libera: motore spento finche' non si noleggia
StreetRental_OnStateChange(playerid, PLAYER_STATE:newstate)
{
	if (newstate != PLAYER_STATE_DRIVER)
	{
		if (g_SrOffer[playerid] != 0)
		{
			g_SrOffer[playerid] = 0;
			HidePlayerDialog(playerid);
		}
		return 0;
	}
	new veh = GetPlayerVehicleID(playerid);
	if (StreetRental_SpotOf(veh) < 0)
	{
		return 0;
	}
	SetVehicleParamsEx(veh, 0, 0, 0, 0, 0, 0, 0);
	if (!Util_IsPlaying(playerid))
	{
		RemovePlayerFromVehicle(playerid);
		return 1;
	}
	if (gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		Util_Send(playerid, 0xFF6347FF, "უკვე გაქვს ნაქირავები მანქანა. დააბრუნე /riconsegna-ით.");
		RemovePlayerFromVehicle(playerid);
		return 1;
	}
	new name[24], body[1024];
	Veh_StdModelName(GetVehicleModel(veh), name);
	format(body, sizeof body,
		"{FFFFFF}%s\n\n{AAAAAA}ქირა: {66DD66}$%d{AAAAAA} - %d წუთი\nგირაო არ არის. გადახდა: ბანკიდან ან ნაღდით.\n\n{AAAAAA}დაბრუნება ნებისმიერ ადგილას: /riconsegna",
		name, SRENT_PRICE, SRENT_MINUTES);
	g_SrOffer[playerid] = veh;
	Lang_ShowPlayerDialog(playerid, SRENT_DIALOG, DIALOG_STYLE_MSGBOX, "მანქანის ქირაობა", body, "ქირაობა", "გასვლა");
	return 1;
}

bool:StreetRental_OnDialogResponse(playerid, dialogid, response)
{
	if (dialogid != SRENT_DIALOG)
	{
		return false;
	}
	new veh = g_SrOffer[playerid];
	g_SrOffer[playerid] = 0;
	if (veh == 0 || GetPlayerVehicleID(playerid) != veh || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
		return true;
	}
	if (!response)
	{
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	if (StreetRental_SpotOf(veh) < 0 || gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	new have = (gPlayer[playerid][pBank] > 0 ? gPlayer[playerid][pBank] : 0) + (gPlayer[playerid][pMoney] > 0 ? gPlayer[playerid][pMoney] : 0);
	if (have < SRENT_PRICE)
	{
		Util_Send(playerid, 0xFF6347FF, "არ გაქვს საკმარისი თანხა (ბანკი + ნაღდი).");
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	g_SrPend[playerid] = veh;
	if (!Rental_BeginOpen(playerid, SRENT_VKIND, 1, 1, GetVehicleModel(veh)))
	{
		g_SrPend[playerid] = 0;
		Util_Send(playerid, 0xFF6347FF, "ქირაობა ახლა შეუძლებელია, სცადე მოგვიანებით.");
		RemovePlayerFromVehicle(playerid);
		return true;
	}
	Util_Send(playerid, -1, "ქირაობის დამუშავება...");
	return true;
}

// chiamata da Rental_SpawnVehicle per vkind 5: l'auto c'e' gia', si consegna quella parcheggiata
bool:StreetRental_Take(playerid)
{
	new veh = g_SrPend[playerid];
	g_SrPend[playerid] = 0;
	new s = StreetRental_SpotOf(veh);
	if (s < 0 || !IsValidVehicle(veh))
	{
		return false;
	}
	if (LD_VehRegister(veh, 1, playerid) == 0)
	{
		return false;
	}
	g_SrVeh[s] = 0;                       // non piu' libera: il punto si riempira' con un'altra auto
	g_SrNextSpawn = gettime() + SRENT_RESPAWN_S;
	SetVehicleParamsEx(veh, 1, 0, 0, 0, 0, 0, 0);
	gPlayer[playerid][pRentalVehicle] = veh;
	if (GetPlayerVehicleID(playerid) != veh)
	{
		PutPlayerInVehicle(playerid, veh, 0);
	}
	return true;
}

// l'auto libera e' stata distrutta (incidente, esplosione): si libera il punto
StreetRental_OnVehicleDeath(vehicleid)
{
	new s = StreetRental_SpotOf(vehicleid);
	if (s < 0)
	{
		return 0;
	}
	g_SrVeh[s] = 0;
	DestroyVehicle(vehicleid);
	return 1;
}

// ===== modules/rental/rental.inc =====
new g_RtTimer;
new g_RtFee[MAX_PLAYERS];
new g_RtDeposit[MAX_PLAYERS];
new g_RtOpenTs[MAX_PLAYERS];
new g_RtBlocks[MAX_PLAYERS];
new bool:g_RtAbortOpen[MAX_PLAYERS];
new g_RtCloseMode[MAX_PLAYERS];
new g_RtCloseHealth[MAX_PLAYERS];
new g_RtCloseReason[MAX_PLAYERS];
new g_RtRetry[MAX_PLAYERS];
new g_RtRetryAt[MAX_PLAYERS];

Rental_KindName(vkind, dest[], size)
{
	dest[0] = 0;
	switch (vkind)
	{
		case 1:
		{
			strcat(dest, "Faggio", size);
		}
		case 2:
		{
			strcat(dest, "Previon", size);
		}
		case 3:
		{
			strcat(dest, "Manana", size);
		}
		case 4:
		{
			strcat(dest, "Taxi", size);
		}
		default:
		{
			strcat(dest, "veicolo", size);
		}
	}
}

bool:Rental_ValidPlayer(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

Rental_MaxLocalRep(playerid)
{
	new best = 0;
	for (new d = 1; d <= 3; d++)
	{
		new r = LD_GetLocalRep(playerid, d);
		if (d == 1 || r > best)
		{
			best = r;
		}
	}
	return best;
}

Rental_VehHealth(vehicleid)
{
	if (vehicleid <= 0 || !IsValidVehicle(vehicleid))
	{
		return 0;
	}
	new Float:hp;
	GetVehicleHealth(vehicleid, hp);
	return LD_Clamp(floatround(hp, 1), 0, 1000);
}

Rental_ResetPlayer(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	g_RtFee[playerid] = 0;
	g_RtDeposit[playerid] = 0;
	g_RtOpenTs[playerid] = 0;
	g_RtBlocks[playerid] = 0;
	g_RtAbortOpen[playerid] = 0;
	g_RtCloseMode[playerid] = 0;
	g_RtCloseHealth[playerid] = 0;
	g_RtCloseReason[playerid] = 0;
	g_RtRetry[playerid] = 0;
	g_RtRetryAt[playerid] = 0;
}

Rental_VehDestroy(playerid)
{
	new veh = gPlayer[playerid][pRentalVehicle];
	gPlayer[playerid][pRentalVehicle] = 0;
	if (veh <= 0 || veh >= 2000)
	{
		return 0;
	}
	if (LD_VehOwner(veh) == playerid)
	{
		LD_VehRelease(veh);
	}
	if (IsValidVehicle(veh))
	{
		if (IsPlayerConnected(playerid) && GetPlayerVehicleID(playerid) == veh)
		{
			RemovePlayerFromVehicle(playerid, 0);
		}
		DestroyVehicle(veh);
	}
}

Rental_ClearLocal(playerid)
{
	Rental_VehDestroy(playerid);
	gPlayer[playerid][pRentalId] = 0;
	gPlayer[playerid][pRentalClass] = 0;
	gPlayer[playerid][pRentalKind] = 0;
	gPlayer[playerid][pRentalDueAt] = 0;
	gPlayer[playerid][pRentalWarnFlags] = 0;
	gPlayer[playerid][pRentalPendOp] = 0;
	gPlayer[playerid][pRentalOpId][0] = 0;
	Rental_ResetPlayer(playerid);
}

Rental_ScheduleRetry(playerid)
{
	g_RtRetry[playerid]++;
	g_RtRetryAt[playerid] = GetTickCount() + 3000;
	if (g_RtRetryAt[playerid] == 0)
	{
		g_RtRetryAt[playerid] = 1;
	}
}

bool:Rental_BeginOpen(playerid, vkind, blocks, rentClass, streetModel = 0)
{
	new model = vkind == SRENT_VKIND ? streetModel : LD_RentalModel(vkind);
	if (model <= 0 || gPlayer[playerid][pRentalId] != 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	if (DB_LivingBusy(playerid, 1))
	{
		return 0;
	}
	Rental_ResetPlayer(playerid);
	gPlayer[playerid][pRentalClass] = rentClass;
	gPlayer[playerid][pRentalKind] = vkind;
	gPlayer[playerid][pRentalPendOp] = 5;
	g_RtBlocks[playerid] = blocks;
	DB_LivingMakeOpId(gPlayer[playerid][pRentalOpId], 41, "ro", vkind, gPlayer[playerid][pCharId]);
	DB_LivingRentOpen(playerid, vkind, model, blocks, gPlayer[playerid][pRentalOpId]);
	return 1;
}

bool:Rental_SpawnVehicle(playerid)
{
	if (gPlayer[playerid][pRentalKind] == SRENT_VKIND)
	{
		return StreetRental_Take(playerid);   // auto di strada: si consegna quella parcheggiata
	}
	new vkind = gPlayer[playerid][pRentalKind], model = LD_RentalModel(vkind);
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new Float:x = 1512.0, Float:y = -1708.0, Float:z = 13.5, Float:a = 180.0;
	if (pro)
	{
		GetPlayerPos(playerid, x, y, z);
		GetPlayerFacingAngle(playerid, a);
	}
	if (model <= 0 || !LD_PoolHasRoom())
	{
		return 0;
	}
	new veh = CreateVehicle(model, x, y, z, a, pro ? 6 : 1, pro ? 6 : 1, -1, 0);
	if (veh == 65535 || veh <= 0 || veh >= 2000)
	{
		return 0;
	}
	if (LD_VehRegister(veh, pro ? 2 : 1, playerid) == 0)
	{
		DestroyVehicle(veh);
		return 0;
	}
	SetVehicleHealth(veh, float(1000));
	SetVehicleParamsEx(veh, 1, 0, 0, 0, 0, 0, 0);
	gPlayer[playerid][pRentalVehicle] = veh;
	PutPlayerInVehicle(playerid, veh, 0);
	return 1;
}

bool:Rental_SendClose(playerid, mode, health, reason)
{
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	Rental_VehDestroy(playerid);
	g_RtCloseMode[playerid] = mode;
	g_RtCloseHealth[playerid] = LD_Clamp(health, 0, 1000);
	g_RtCloseReason[playerid] = reason;
	g_RtRetry[playerid] = 0;
	g_RtRetryAt[playerid] = 0;
	gPlayer[playerid][pRentalPendOp] = 6;
	DB_LivingMakeOpId(gPlayer[playerid][pRentalOpId], 41, "rc", gPlayer[playerid][pRentalId], gPlayer[playerid][pCharId]);
	DB_LivingRentClose(playerid, gPlayer[playerid][pRentalId], mode, g_RtCloseHealth[playerid], gPlayer[playerid][pRentalOpId]);
	return 1;
}

bool:Rental_CloseInterrupted(playerid, reason)
{
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh > 0 && IsValidVehicle(veh))
	{
		return Rental_SendClose(playerid, 1, Rental_VehHealth(veh), reason);
	}
	return Rental_SendClose(playerid, 3, 0, reason);
}

Rental_NotifyClosed(playerid, result, refund, newState)
{
	new name[16];
	Rental_KindName(gPlayer[playerid][pRentalKind], name, 16);
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new reason = g_RtCloseReason[playerid];
	if (pro)
	{
		if (reason != 100)
		{
			Taxi_OnProRentalClosed(playerid, result, refund);
		}
		return 0;
	}
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	switch (result)
	{
		case 1:
		{
			if (reason == 100)
			{
				Util_Send(playerid, -10270721, "Nessun mezzo disponibile al momento: noleggio annullato e importo restituito sul conto.");
				return 0;
			}
			new minutes = (gettime() - g_RtOpenTs[playerid]) / 60;
			if (g_RtOpenTs[playerid] <= 0)
			{
				minutes = 0;
			}
			if (newState == 3)
			{
				SendClientMessage(playerid, -1, "Noleggio interrotto: cauzione di $%d restituita sul conto.", refund);
			}
			else
			{
				UI_LivingRentalReceipt(playerid, name, g_RtFee[playerid], g_RtDeposit[playerid], refund, minutes);
			}
		}
		case 5:
		{
			if (refund > 0)
			{
				SendClientMessage(playerid, -1, "Noleggio chiuso oltre la tolleranza: restituiti $%d.", refund);
			}
			else
			{
				Util_Send(playerid, -10270721, "Noleggio scaduto oltre la tolleranza: il mezzo e' tornato all'agenzia e la cauzione e' stata trattenuta.");
			}
		}
		case 2:
		{
			Util_Send(playerid, -1, "Il noleggio risultava gia' chiuso.");
		}
		default:
		{
			Util_Send(playerid, -10270721, "Chiusura del noleggio non riuscita: verra' sistemata automaticamente al prossimo accesso.");
		}
	}
}

Rental_OnOpenResult(playerid, result, rentalId, amount, dueAt)
{
	if (gPlayer[playerid][pRentalPendOp] != 5)
	{
		if (result == 1)
		{
			Log_Write("RENTAL", "apertura confermata senza richiesta in attesa: lasciata al cleanup del DB");
		}
		return 0;
	}
	gPlayer[playerid][pRentalPendOp] = 0;
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	if (result != 1)
	{
		gPlayer[playerid][pRentalClass] = 0;
		gPlayer[playerid][pRentalKind] = 0;
		gPlayer[playerid][pRentalOpId][0] = 0;
		g_RtAbortOpen[playerid] = 0;
		if (pro)
		{
			Taxi_OnProRental(playerid, result, 0);
			return 0;
		}
		switch (result)
		{
			case 3:
			{
				Util_Send(playerid, -10270721, "Fondi insufficienti (banca + contanti) per canone e cauzione.");
			}
			case 7:
			{
				Util_Send(playerid, -10270721, "Non puoi noleggiare ora: hai gia' un noleggio o un contratto attivo, oppure livello insufficiente.");
			}
			case 10:
			{
				Util_Send(playerid, -10270721, "Un'altra operazione di noleggio e' in corso: riprova tra poco.");
			}
			case 9:
			{
				Util_Send(playerid, -10270721, "Richiesta di noleggio non valida.");
			}
			default:
			{
				Util_Send(playerid, -10270721, "Servizio noleggi momentaneamente non raggiungibile: nessun addebito, riprova tra poco.");
			}
		}
		return 0;
	}
	gPlayer[playerid][pRentalId] = rentalId;
	gPlayer[playerid][pRentalDueAt] = dueAt;
	gPlayer[playerid][pRentalWarnFlags] = 0;
	g_RtDeposit[playerid] = LD_RentalDeposit(gPlayer[playerid][pRentalKind]);
	g_RtFee[playerid] = amount > g_RtDeposit[playerid] ? amount - g_RtDeposit[playerid] : 0;
	g_RtOpenTs[playerid] = gettime();
	if (g_RtAbortOpen[playerid] || !Util_IsPlaying(playerid))
	{
		g_RtAbortOpen[playerid] = 0;
		Rental_SendClose(playerid, 3, 0, pro ? 3 : 1);
		return 0;
	}
	if (!Rental_SpawnVehicle(playerid))
	{
		Log_Write("RENTAL", "veicolo non creato dopo l'apertura: noleggio annullato con rimborso totale");
		Rental_SendClose(playerid, 5, 0, 100);
		if (pro)
		{
			Taxi_OnProRental(playerid, -1, 0);
		}
		return 0;
	}
	if (pro)
	{
		Taxi_OnProRental(playerid, 1, gPlayer[playerid][pRentalVehicle]);
		return 0;
	}
	new name[24], minutes = (dueAt - gettime() + 60 - 1) / 60;
	if (gPlayer[playerid][pRentalKind] == SRENT_VKIND)
	{
		Veh_StdModelName(GetVehicleModel(gPlayer[playerid][pRentalVehicle]), name);
		SendClientMessage(playerid, 0x66DD66FF, "ქირაობა აქტიურია: %s - %d წუთი ($%d). დაბრუნება ნებისმიერ ადგილას: /riconsegna", name, minutes > 0 ? minutes : 0, g_RtFee[playerid]);
		return 1;
	}
	Rental_KindName(gPlayer[playerid][pRentalKind], name, 16);
	SendClientMessage(playerid, 0x66DD66FF, "Noleggio attivo: %s per %d minuti (canone $%d, cauzione $%d). Riportalo qui con /riconsegna.", name, minutes > 0 ? minutes : 0, g_RtFee[playerid], g_RtDeposit[playerid]);
}

Rental_OnCloseResult(playerid, result, amount, newState)
{
	if (gPlayer[playerid][pRentalPendOp] != 6)
	{
		return 0;
	}
	if (result == -1 || result == 10)
	{
		if (g_RtRetry[playerid] < 3 && IsPlayerConnected(playerid))
		{
			Rental_ScheduleRetry(playerid);
			return 0;
		}
		Log_Write("RENTAL", "chiusura noleggio senza esito dopo i tentativi: la sistema il cleanup del DB (login/avvio)");
	}
	gPlayer[playerid][pRentalPendOp] = 0;
	Rental_NotifyClosed(playerid, result, amount > 0 ? amount : 0, newState);
	Rental_ClearLocal(playerid);
}

public Living_OnDBRental(playerid, action, result, rentalId, amount, balance, cashUsed, dueAt)
{
	if (!Rental_ValidPlayer(playerid) || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	switch (action)
	{
		case 5:
		{
			Rental_OnOpenResult(playerid, result, rentalId, amount, dueAt);
		}
		case 6:
		{
			Rental_OnCloseResult(playerid, result, amount, cashUsed);
		}
	}
	return 1;
}

bool:Rental_AtOffice(playerid, Float:radius)
{
	return GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && IsPlayerInRangeOfPoint(playerid, radius, 1505.0, -1700.0, 13.5);
}

bool:Rental_CanStart(playerid)
{
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] != 0)
	{
		Util_Send(playerid, -10270721, "Pratica di noleggio gia' in corso: attendi.");
		return 0;
	}
	new block = LD_CheckStart(playerid);
	if (block != 0)
	{
		LD_SendBlock(playerid, block);
		return 0;
	}
	if (!Rental_AtOffice(playerid, 4.0))
	{
		Util_Send(playerid, -10270721, "Devi trovarti all'agenzia di noleggio di Pershing Square.");
		return 0;
	}
	if (GetPlayerState(playerid) != 1)
	{
		Util_Send(playerid, -10270721, "Scendi dal veicolo per noleggiare.");
		return 0;
	}
	if (gPlayer[playerid][pLevel] < 1)
	{
		SendClientMessage(playerid, -10270721, "Serve almeno il livello %d per noleggiare.", 1);
		return 0;
	}
	return 1;
}

Rental_CmdNoleggio(playerid, params[])
{
	if (!Rental_CanStart(playerid))
	{
		return 1;
	}
	new rep = Rental_MaxLocalRep(playerid), name[16];
	new bool:room = LD_PoolHasRoom();
	UI_LivingRentalBegin(playerid, 20, 3, LD_DiscountPct(rep));
	for (new k = 1; k <= 3; k++)
	{
		Rental_KindName(k, name, 16);
		UI_LivingRentalAddModel(playerid, k, name, LD_RentalFeeFor(k, 1, rep), LD_RentalDeposit(k), 1, room && gPlayer[playerid][pLevel] >= 1);
	}
	UI_LivingRentalShow(playerid);
	if (!room)
	{
		Util_Send(playerid, -10270721, "Al momento non ci sono mezzi disponibili: riprova tra poco.");
	}
	return 1;
}

public UI_OnRentalConfirm(playerid, modelIdx, blocks)
{
	if (!Rental_CanStart(playerid))
	{
		return 1;
	}
	if (modelIdx < 1 || modelIdx > 3 || blocks < 1 || blocks > 3)
	{
		UI_LivingReject(playerid, "Scelta di noleggio non valida.");
		return 1;
	}
	if (!LD_PoolHasRoom())
	{
		UI_LivingReject(playerid, "Al momento non ci sono mezzi disponibili: riprova tra poco.");
		return 1;
	}
	new total = LD_RentalFeeFor(modelIdx, blocks, Rental_MaxLocalRep(playerid)) + LD_RentalDeposit(modelIdx);
	new have = (gPlayer[playerid][pBank] > 0 ? gPlayer[playerid][pBank] : 0) + (gPlayer[playerid][pMoney] > 0 ? gPlayer[playerid][pMoney] : 0);
	if (have < total)
	{
		new msg[160];
		format(msg, 160, "Fondi insufficienti: servono $%d (canone + cauzione) tra banca e contanti.", total);
		UI_LivingReject(playerid, msg);
		return 1;
	}
	if (!Rental_BeginOpen(playerid, modelIdx, blocks, 1))
	{
		UI_LivingReject(playerid, "Pratica di noleggio gia' in corso: attendi.");
		return 1;
	}
	Util_Send(playerid, -1, "Pratica di noleggio in corso...");
	return 1;
}

bool:Rental_CanReturn(playerid, bool:verbose)
{
	if (!Util_IsPlaying(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalId] == 0)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "Non hai un noleggio attivo.");
		}
		return 0;
	}
	if (gPlayer[playerid][pRentalClass] == 2)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "Il taxi si restituisce al deposito con /taxi off.");
		}
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] != 0)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "Pratica di noleggio gia' in corso: attendi.");
		}
		return 0;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || GetPlayerVehicleID(playerid) != veh || GetPlayerState(playerid) != 2)
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "Devi essere al volante del mezzo noleggiato.");
		}
		return 0;
	}
	if (gPlayer[playerid][pRentalKind] != SRENT_VKIND && !Rental_AtOffice(playerid, 12.0))
	{
		if (verbose)
		{
			Util_Send(playerid, -10270721, "Riporta il mezzo all'agenzia di noleggio di Pershing Square.");
		}
		return 0;
	}
	return 1;
}

Rental_CmdRiconsegna(playerid, params[])
{
	if (!Rental_CanReturn(playerid, 1))
	{
		return 1;
	}
	new name[16], health = Rental_VehHealth(gPlayer[playerid][pRentalVehicle]);
	Rental_KindName(gPlayer[playerid][pRentalKind], name, 16);
	new deposit = g_RtDeposit[playerid];
	new refund = LD_RentalRefund(deposit, health);
	if (gPlayer[playerid][pRentalDueAt] > 0 && gettime() > gPlayer[playerid][pRentalDueAt] + 300)
	{
		refund = 0;
	}
	UI_LivingRentalReturnConfirm(playerid, gPlayer[playerid][pRentalId], name, health / 10, deposit, refund);
	return 1;
}

public UI_OnRentalReturnConfirm(playerid, rentalId)
{
	if (rentalId <= 0 || rentalId != gPlayer[playerid][pRentalId])
	{
		UI_LivingReject(playerid, "Questo noleggio non e' piu' attivo.");
		return 1;
	}
	if (!Rental_CanReturn(playerid, 1))
	{
		return 1;
	}
	Rental_SendClose(playerid, 1, Rental_VehHealth(gPlayer[playerid][pRentalVehicle]), 1);
	Util_Send(playerid, -1, "Riconsegna in corso...");
	return 1;
}

Rental_GetVehicle(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || !IsValidVehicle(veh))
	{
		return 0;
	}
	return veh;
}

bool:Rental_OpenPro(playerid, vkind)
{
	if (!Rental_ValidPlayer(playerid) || !Util_IsPlaying(playerid) || vkind != 4)
	{
		return 0;
	}
	if (!LD_PoolHasRoom())
	{
		return 0;
	}
	return Rental_BeginOpen(playerid, vkind, 1, 2);
}

bool:Rental_ClosePro(playerid, reason)
{
	if (!Rental_ValidPlayer(playerid) || gPlayer[playerid][pRentalClass] != 2)
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] == 5)
	{
		g_RtAbortOpen[playerid] = 1;
		return 1;
	}
	if (gPlayer[playerid][pRentalId] == 0)
	{
		return 0;
	}
	new veh = gPlayer[playerid][pRentalVehicle];
	switch (reason)
	{
		case 1, 4, 5:
		{
			return Rental_SendClose(playerid, 1, Rental_VehHealth(veh), reason);
		}
		case 2, 3:
		{
			return Rental_CloseInterrupted(playerid, reason);
		}
	}
	return Rental_SendClose(playerid, 3, 0, reason);
}

Rental_RetrySend(playerid)
{
	g_RtRetryAt[playerid] = 0;
	if (gPlayer[playerid][pRentalPendOp] != 6 || gPlayer[playerid][pRentalId] == 0)
	{
		return 0;
	}
	DB_LivingRentClose(playerid, gPlayer[playerid][pRentalId], g_RtCloseMode[playerid], g_RtCloseHealth[playerid], gPlayer[playerid][pRentalOpId]);
}

Rental_TickPlayer(playerid, now, nowTick)
{
	if (g_RtRetryAt[playerid] != 0 && nowTick - g_RtRetryAt[playerid] >= 0)
	{
		Rental_RetrySend(playerid);
		return 0;
	}
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	new bool:pro = gPlayer[playerid][pRentalClass] == 2;
	new veh = gPlayer[playerid][pRentalVehicle];
	if (veh <= 0 || !IsValidVehicle(veh))
	{
		Log_Write("RENTAL", "veicolo a noleggio scomparso senza OnVehicleDeath: noleggio interrotto (cauzione 100%)");
		if (pro)
		{
			Rental_ClosePro(playerid, 7);
		}
		else
		{
			Rental_SendClose(playerid, 3, 0, 7);
		}
		return 0;
	}
	new due = gPlayer[playerid][pRentalDueAt];
	if (due <= 0)
	{
		return 0;
	}
	new left = due - now;
	if (left <= 300 && !(gPlayer[playerid][pRentalWarnFlags] & 1))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 1;
		SendClientMessage(playerid, -2994689, "Il tuo noleggio scade tra %d minuti.", (left + 60 - 1) / 60);
	}
	if (left <= 60 && !(gPlayer[playerid][pRentalWarnFlags] & 2))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 2;
		Util_Send(playerid, -2994689, pro ? "Il turno di noleggio del taxi scade tra un minuto." : "Il tuo noleggio scade tra un minuto: riportalo all'agenzia (/riconsegna).");
	}
	if (left <= 0 && !(gPlayer[playerid][pRentalWarnFlags] & 4))
	{
		gPlayer[playerid][pRentalWarnFlags] |= 4;
		if (!pro)
		{
			SendClientMessage(playerid, -10270721, "Noleggio scaduto: hai %d minuti di tolleranza per la riconsegna, poi la cauzione resta all'agenzia.", 5);
		}
	}
	if (pro)
	{
		if (left <= 0 && (gPlayer[playerid][pTaxiRideId] == 0 || -left >= 150))
		{
			Util_Send(playerid, -1, "Il noleggio del taxi e' scaduto: il turno si conclude.");
			Rental_ClosePro(playerid, 5);
		}
		return 0;
	}
	if (-left >= 300)
	{
		Util_Send(playerid, -10270721, "Tolleranza scaduta: il mezzo torna all'agenzia.");
		Rental_SendClose(playerid, 2, 0, 5);
	}
}

public Rental_OnTick()
{
	new now = gettime(), nowTick = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (gPlayer[i][pRentalId] == 0 && g_RtRetryAt[i] == 0)
		{
			continue;
		}
		Rental_TickPlayer(i, now, nowTick);
	}
	return 1;
}

Rental_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Rental_ResetPlayer(i);
	}
	if (g_RtTimer != 0)
	{
		KillTimer(g_RtTimer);
	}
	g_RtTimer = SetTimer("Rental_OnTick", 1000, 1);
	CreatePickup(1239, 1, 1505.0, -1700.0, 13.5, 0);
	Lang_Create3DTextLabel("Noleggio veicoli\n/noleggio  ·  /riconsegna", -2994689, 1505.0, -1700.0, (13.5 + 0.8), 20.0, 0, 0);
}

Rental_OnExit()
{
	if (g_RtTimer != 0)
	{
		KillTimer(g_RtTimer);
	}
	g_RtTimer = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (gPlayer[i][pRentalVehicle] != 0)
		{
			Rental_VehDestroy(i);
		}
	}
}

Rental_OnPlayerConnect(playerid)
{
	Rental_ResetPlayer(playerid);
}

Rental_OnCharReady(playerid)
{
}

Rental_OnPlayerDisconnect(playerid, reason)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] == 0 && gPlayer[playerid][pRentalId] != 0)
	{
		if (gPlayer[playerid][pRentalClass] == 2)
		{
			Rental_ClosePro(playerid, 2);
		}
		else
		{
			Rental_CloseInterrupted(playerid, 2);
		}
	}
	Rental_VehDestroy(playerid);
	Rental_ResetPlayer(playerid);
}

Rental_OnPlayerDeath(playerid)
{
	if (!Rental_ValidPlayer(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalPendOp] == 5)
	{
		g_RtAbortOpen[playerid] = 1;
		return 0;
	}
	if (gPlayer[playerid][pRentalId] == 0 || gPlayer[playerid][pRentalPendOp] != 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pRentalClass] == 2)
	{
		return 0;
	}
	if (Rental_CloseInterrupted(playerid, 3))
	{
		Util_Send(playerid, -1, "Noleggio interrotto: il mezzo torna all'agenzia.");
	}
}

Rental_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	new mod = LD_VehModule(vehicleid);
	if (mod != 1 && mod != 2)
	{
		return 0;
	}
	new owner = LD_VehOwner(vehicleid);
	if (ispassenger != 0 || owner == playerid || owner == 65535)
	{
		return 0;
	}
	ClearAnimations(playerid, 0);
	Util_Send(playerid, -10270721, mod == 2 ? "Questo taxi e' in servizio: puoi salire solo come passeggero." : "Questo mezzo e' a noleggio di un altro cliente.");
}

Rental_OnPlayerExitVehicle(playerid, vehicleid)
{
}

Rental_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (newstate != 2)
	{
		return 0;
	}
	new veh = GetPlayerVehicleID(playerid), mod = LD_VehModule(veh);
	if (mod != 1 && mod != 2)
	{
		return 0;
	}
	new owner = LD_VehOwner(veh);
	if (owner == playerid)
	{
		return 0;
	}
	RemovePlayerFromVehicle(playerid, 0);
	Util_Send(playerid, -10270721, "Solo chi ha noleggiato questo mezzo puo' guidarlo.");
}

Rental_OnVehicleDeath(vehicleid, killerid)
{
	new mod = LD_VehModule(vehicleid);
	if (mod != 1 && mod != 2)
	{
		return 0;
	}
	new owner = LD_VehOwner(vehicleid);
	if (owner == 65535 || !Rental_ValidPlayer(owner) || gPlayer[owner][pRentalVehicle] != vehicleid)
	{
		LD_VehRelease(vehicleid);
		DestroyVehicle(vehicleid);
		return 0;
	}
	if (gPlayer[owner][pRentalClass] == 2)
	{
		Rental_ClosePro(owner, 4);
		return 0;
	}
	if (Rental_SendClose(owner, 1, 0, 4))
	{
		Util_Send(owner, -10270721, "Il mezzo a noleggio e' stato distrutto: la cauzione copre i danni.");
	}
}

// ===== modules/taxi/taxi.inc =====
new Float:g_TxNpcX[6] = {1950.0, 1840.0, 2490.0, 2420.0, 2145.0, 2200.0};
new Float:g_TxNpcY[6] = {-1770.0, -1850.0, -1690.0, -1740.0, -1215.0, -1160.0};
new Float:g_TxNpcZ[6] = {13.5, 13.6, 13.5, 13.5, 24.0, 24.0};
new g_TxNpcD[6] = {1, 1, 2, 2, 3, 3};
new g_TxTimer;
new g_TxPhase[MAX_PLAYERS];
new g_TxOfferCall[MAX_PLAYERS];
new g_TxOfferUntil[MAX_PLAYERS];
new g_TxOfferFromPt[MAX_PLAYERS];
new g_TxOfferToPt[MAX_PLAYERS];
new g_TxPickPt[MAX_PLAYERS];
new g_TxDestPt[MAX_PLAYERS];
new g_TxDwellTick[MAX_PLAYERS];
new g_TxOffTick[MAX_PLAYERS];
new g_TxStartHealth[MAX_PLAYERS];
new g_TxStraightM[MAX_PLAYERS];
new g_TxPeerChar[MAX_PLAYERS];
new Float:g_TxMeterF[MAX_PLAYERS];
new Float:g_TxStartX[MAX_PLAYERS];
new Float:g_TxStartY[MAX_PLAYERS];
new bool:g_TxMeterStarted[MAX_PLAYERS];
new g_TxBoardUntil[MAX_PLAYERS];
new g_TxPayPrompts[MAX_PLAYERS];
new g_TxPayMeters[MAX_PLAYERS];
new g_TxPayToD[MAX_PLAYERS];
new g_TxPayFare[MAX_PLAYERS];
new bool:g_TxPayAccept[MAX_PLAYERS];
new g_TxPayRating[MAX_PLAYERS];
new g_TxStartKind[MAX_PLAYERS];
new g_TxStartPeer[MAX_PLAYERS];
new g_TxStartFromD[MAX_PLAYERS];
new g_TxCancelRide[MAX_PLAYERS];
new bool:g_TxAbort[MAX_PLAYERS];
new g_TxCdUntil[MAX_PLAYERS];
new g_TxRetry[MAX_PLAYERS];
new g_TxRetryAt[MAX_PLAYERS];
new g_TxCallUntil[MAX_PLAYERS];
new g_TxRateRide[MAX_PLAYERS];
new g_TxRateStars[MAX_PLAYERS];
new g_TxRateDriverChar[MAX_PLAYERS];

bool:Taxi_Valid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

Taxi_TickAfter(ms)
{
	new t = GetTickCount() + ms;
	return t == 0 ? 1 : t;
}

bool:Taxi_TickReached(tick)
{
	return tick != 0 && GetTickCount() - tick >= 0;
}

Taxi_Dist2D(Float:x1, Float:y1, Float:x2, Float:y2)
{
	new Float:dx = (x2 - x1), Float:dy = (y2 - y1);
	return floatround(floatsqroot(((dx * dx) + (dy * dy))), 1);
}

Taxi_MaxLocalRep(playerid)
{
	new best = 0;
	for (new d = 1; d <= 3; d++)
	{
		new r = LD_GetLocalRep(playerid, d);
		if (d == 1 || r > best)
		{
			best = r;
		}
	}
	return best;
}

Taxi_VehHealth(vehicleid)
{
	if (vehicleid <= 0 || !IsValidVehicle(vehicleid))
	{
		return 0;
	}
	new Float:hp;
	GetVehicleHealth(vehicleid, hp);
	return floatround(hp, 1);
}

Taxi_PassengerOf(driverid)
{
	if (gPlayer[driverid][pTaxiRideKind] != 2)
	{
		return 65535;
	}
	new p = gPlayer[driverid][pTaxiPeer] - 1;
	if (p < 0 || p >= MAX_PLAYERS || !IsPlayerConnected(p) || gPlayer[p][pCharId] != g_TxPeerChar[driverid] || g_TxPeerChar[driverid] <= 0)
	{
		return 65535;
	}
	return p;
}

Taxi_DriverOf(passengerid)
{
	new d = gPlayer[passengerid][pTaxiPeer] - 1;
	if (d < 0 || d >= 1000 || !IsPlayerConnected(d) || gPlayer[d][pTaxiOnDuty] == 0)
	{
		return 65535;
	}
	if (gPlayer[d][pTaxiPeer] - 1 != passengerid || g_TxPeerChar[d] != gPlayer[passengerid][pCharId])
	{
		return 65535;
	}
	return d;
}

bool:Taxi_AtDepot(playerid)
{
	return GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld(playerid) == 0 && IsPlayerInRangeOfPoint(playerid, 6.0, 1771.0, -1895.0, 13.6);
}

bool:Taxi_InTaxi(driverid, vehicleid)
{
	return vehicleid > 0 && GetPlayerVehicleID(driverid) == vehicleid && GetPlayerState(driverid) == 2;
}

Taxi_ResetPlayer(playerid)
{
	g_TxPhase[playerid] = 0;
	g_TxOfferCall[playerid] = 0;
	g_TxOfferUntil[playerid] = 0;
	g_TxOfferFromPt[playerid] = 0;
	g_TxOfferToPt[playerid] = 0;
	g_TxPickPt[playerid] = 0;
	g_TxDestPt[playerid] = 0;
	g_TxDwellTick[playerid] = 0;
	g_TxOffTick[playerid] = 0;
	g_TxStartHealth[playerid] = 0;
	g_TxStraightM[playerid] = 0;
	g_TxPeerChar[playerid] = 0;
	g_TxMeterF[playerid] = 0.0;
	g_TxStartX[playerid] = 0.0;
	g_TxStartY[playerid] = 0.0;
	g_TxMeterStarted[playerid] = 0;
	g_TxBoardUntil[playerid] = 0;
	g_TxPayPrompts[playerid] = 0;
	g_TxPayMeters[playerid] = 0;
	g_TxPayToD[playerid] = 0;
	g_TxPayFare[playerid] = 0;
	g_TxPayAccept[playerid] = 0;
	g_TxPayRating[playerid] = 0;
	g_TxStartKind[playerid] = 0;
	g_TxStartPeer[playerid] = 65535;
	g_TxStartFromD[playerid] = 0;
	g_TxCancelRide[playerid] = 0;
	g_TxAbort[playerid] = 0;
	g_TxCdUntil[playerid] = 0;
	g_TxRetry[playerid] = 0;
	g_TxRetryAt[playerid] = 0;
	g_TxCallUntil[playerid] = 0;
	g_TxRateRide[playerid] = 0;
	g_TxRateStars[playerid] = 0;
	g_TxRateDriverChar[playerid] = 0;
}

Taxi_ScheduleRetry(playerid)
{
	g_TxRetry[playerid]++;
	g_TxRetryAt[playerid] = Taxi_TickAfter(3000);
}

Taxi_ClearOffer(driverid)
{
	if (g_TxOfferCall[driverid] == 0)
	{
		return 0;
	}
	g_TxOfferCall[driverid] = 0;
	g_TxOfferUntil[driverid] = 0;
	UI_LivingTaxiOfferClose(driverid);
}

Taxi_ScheduleNpc(driverid)
{
	new span = 45001;
	new h = LD_Hash32(gPlayer[driverid][pCharId], gPlayer[driverid][pTaxiOpSeq] + 1, LD_Bucket(gettime()) ^ 11);
	gPlayer[driverid][pTaxiNpcOfferAt] = Taxi_TickAfter(LD_HashMod(h, span) + 45000);
}

Taxi_ResetRide(driverid)
{
	new p = Taxi_PassengerOf(driverid);
	if (p != INVALID_PLAYER_ID)
	{
		UI_LivingTaxiMeterHide(p);
		UI_LivingTaxiPayClose(p);
		gPlayer[p][pTaxiPeer] = 0;
	}
	if (IsPlayerConnected(driverid))
	{
		DisablePlayerCheckpoint(driverid);
		UI_LivingTaxiMeterHide(driverid);
	}
	gPlayer[driverid][pTaxiRideId] = 0;
	gPlayer[driverid][pTaxiRideKind] = 0;
	gPlayer[driverid][pTaxiRideState] = 0;
	gPlayer[driverid][pTaxiMeterM] = 0;
	gPlayer[driverid][pTaxiMeterOn] = 0;
	gPlayer[driverid][pTaxiPeer] = 0;
	gPlayer[driverid][pTaxiFromDistrict] = 0;
	gPlayer[driverid][pTaxiToDistrict] = 0;
	g_TxPhase[driverid] = 0;
	g_TxDwellTick[driverid] = 0;
	g_TxOffTick[driverid] = 0;
	g_TxPeerChar[driverid] = 0;
	g_TxMeterF[driverid] = 0.0;
	g_TxMeterStarted[driverid] = 0;
	g_TxBoardUntil[driverid] = 0;
	g_TxPayPrompts[driverid] = 0;
	g_TxCdUntil[driverid] = Taxi_TickAfter(10000);
	if (gPlayer[driverid][pTaxiOnDuty] != 0)
	{
		Taxi_ScheduleNpc(driverid);
	}
}

Taxi_CancelRide(driverid, driverMsg[], passengerMsg[])
{
	if (g_TxPhase[driverid] == 0 && gPlayer[driverid][pTaxiRideId] == 0)
	{
		return 0;
	}
	if (gPlayer[driverid][pTaxiPendOp] == 7)
	{
		return 0;
	}
	new p = Taxi_PassengerOf(driverid);
	if (p == INVALID_PLAYER_ID && g_TxPhase[driverid] == 1 && g_TxStartKind[driverid] == 2)
	{
		new sp = g_TxStartPeer[driverid];
		if (sp >= 0 && sp < 1000 && IsPlayerConnected(sp) && gPlayer[sp][pTaxiPeer] - 1 == driverid)
		{
			p = sp;
		}
	}
	if (p != INVALID_PLAYER_ID && passengerMsg[0] != 0)
	{
		Util_Send(p, -10270721, passengerMsg);
	}
	if (driverMsg[0] != 0 && IsPlayerConnected(driverid))
	{
		Util_Send(driverid, -10270721, driverMsg);
	}
	if (g_TxPhase[driverid] == 1)
	{
		g_TxAbort[driverid] = 1;
		if (p != INVALID_PLAYER_ID)
		{
			gPlayer[p][pTaxiPeer] = 0;
		}
		return 0;
	}
	new ride = gPlayer[driverid][pTaxiRideId];
	if (ride > 0 && gPlayer[driverid][pTaxiPendOp] == 0)
	{
		g_TxCancelRide[driverid] = ride;
		g_TxRetry[driverid] = 0;
		gPlayer[driverid][pTaxiPendOp] = 4;
		DB_LivingMakeOpId(gPlayer[driverid][pTaxiOpId], 41, "tx", ride, gPlayer[driverid][pCharId]);
		DB_LivingTaxiCancel(driverid, ride, gPlayer[driverid][pTaxiOpId]);
	}
	Taxi_ResetRide(driverid);
}

Taxi_EndDuty(driverid, reason, bool:closeRental)
{
	Taxi_CancelRide(driverid, "", "La corsa e' stata annullata: il taxi non e' piu' in servizio.");
	Taxi_ClearOffer(driverid);
	if (gPlayer[driverid][pTaxiOnDuty] != 0)
	{
		gPlayer[driverid][pTaxiOnDuty] = 0;
		LD_Emit(107, 0, gPlayer[driverid][pCharId], 0, "-");
	}
	gPlayer[driverid][pTaxiNpcOfferAt] = 0;
	if (closeRental)
	{
		Rental_ClosePro(driverid, reason);
	}
}

Taxi_PointsIn(districtId)
{
	new n = 0;
	for (new i = 0; i < 6; i++)
	{
		if (g_TxNpcD[i] == districtId)
		{
			n++;
		}
	}
	return n;
}

Taxi_PickDistrict(h, exclude)
{
	new sum = 0;
	for (new d = 1; d <= 3; d++)
	{
		if (d == exclude || Taxi_PointsIn(d) == 0)
		{
			continue;
		}
		sum += LD_Clamp(District_GetActivity(d), 0, 1000) + 100;
	}
	if (sum <= 0)
	{
		return 0;
	}
	new r = LD_HashMod(h, sum);
	for (new d = 1; d <= 3; d++)
	{
		if (d == exclude || Taxi_PointsIn(d) == 0)
		{
			continue;
		}
		r -= LD_Clamp(District_GetActivity(d), 0, 1000) + 100;
		if (r < 0)
		{
			return d;
		}
	}
	return 0;
}

Taxi_PickPoint(h, districtId)
{
	new n = Taxi_PointsIn(districtId);
	if (n <= 0)
	{
		return -1;
	}
	new k = LD_HashMod(h, n);
	for (new i = 0; i < 6; i++)
	{
		if (g_TxNpcD[i] != districtId)
		{
			continue;
		}
		if (k == 0)
		{
			return i;
		}
		k--;
	}
	return -1;
}

Taxi_NpcOffer(driverid)
{
	new charId = gPlayer[driverid][pCharId];
	new seq = ++gPlayer[driverid][pTaxiOpSeq];
	new h = LD_Hash32(charId, seq, LD_Bucket(gettime()));
	new fromD = Taxi_PickDistrict(h, 0);
	new h2 = LD_Hash32(h, seq, 12);
	new toD = Taxi_PickDistrict(h2, fromD);
	new fromPt = Taxi_PickPoint(h >>> 8, fromD), toPt = Taxi_PickPoint(h2 >>> 8, toD);
	Taxi_ScheduleNpc(driverid);
	if (fromPt < 0 || toPt < 0)
	{
		return 0;
	}
	new straight = Taxi_Dist2D(g_TxNpcX[fromPt], g_TxNpcY[fromPt], g_TxNpcX[toPt], g_TxNpcY[toPt]);
	new est = LD_TaxiNpcPay(LD_TaxiFare(straight), LD_GetProPoints(driverid, 2));
	g_TxOfferCall[driverid] = (seq & 65535) + 1001;
	g_TxOfferUntil[driverid] = Taxi_TickAfter(30000);
	g_TxOfferFromPt[driverid] = fromPt;
	g_TxOfferToPt[driverid] = toPt;
	UI_LivingTaxiOffer(driverid, g_TxOfferCall[driverid], 1, "Cliente", fromD, toD, straight, est, 30);
	new a[16], b[16];
	LD_DistrictName(fromD, a, 16);
	LD_DistrictName(toD, b, 16);
	SendClientMessage(driverid, -2994689, "[Taxi] Chiamata: cliente a %s diretto a %s (~$%d). /accettacorsa entro %d s.", a, b, est, 30);
}

bool:Taxi_CanAccept(driverid, bool:verbose)
{
	if (gPlayer[driverid][pTaxiOnDuty] == 0)
	{
		if (verbose)
		{
			Util_Send(driverid, -10270721, "Non sei in servizio come tassista (/taxi on al deposito di Unity).");
		}
		return 0;
	}
	if (g_TxPhase[driverid] != 0 || gPlayer[driverid][pTaxiRideId] != 0)
	{
		if (verbose)
		{
			Util_Send(driverid, -10270721, "Hai gia' una corsa in corso.");
		}
		return 0;
	}
	if (gPlayer[driverid][pTaxiPendOp] != 0)
	{
		if (verbose)
		{
			Util_Send(driverid, -10270721, "Operazione taxi in corso: attendi.");
		}
		return 0;
	}
	if (Rental_GetVehicle(driverid) == 0)
	{
		if (verbose)
		{
			Util_Send(driverid, -10270721, "Il tuo taxi non e' disponibile.");
		}
		return 0;
	}
	if (g_TxCdUntil[driverid] != 0 && !Taxi_TickReached(g_TxCdUntil[driverid]))
	{
		if (verbose)
		{
			Util_Send(driverid, -10270721, "Attendi qualche secondo prima di accettare una nuova corsa.");
		}
		return 0;
	}
	return 1;
}

Taxi_SendStart(driverid)
{
	DB_LivingTaxiStart(driverid, g_TxStartKind[driverid], g_TxStartPeer[driverid], g_TxStartFromD[driverid], gPlayer[driverid][pTaxiOpId]);
}

Taxi_AcceptNpc(driverid)
{
	if (!Taxi_CanAccept(driverid, 1))
	{
		return 0;
	}
	if (g_TxOfferCall[driverid] < 1001 || Taxi_TickReached(g_TxOfferUntil[driverid]))
	{
		Util_Send(driverid, -10270721, "Nessuna chiamata da accettare (o e' scaduta).");
		return 0;
	}
	new fromPt = g_TxOfferFromPt[driverid], toPt = g_TxOfferToPt[driverid];
	Taxi_ClearOffer(driverid);
	gPlayer[driverid][pTaxiRideKind] = 1;
	gPlayer[driverid][pTaxiFromDistrict] = g_TxNpcD[fromPt];
	gPlayer[driverid][pTaxiToDistrict] = g_TxNpcD[toPt];
	g_TxPickPt[driverid] = fromPt;
	g_TxDestPt[driverid] = toPt;
	g_TxStraightM[driverid] = Taxi_Dist2D(g_TxNpcX[fromPt], g_TxNpcY[fromPt], g_TxNpcX[toPt], g_TxNpcY[toPt]);
	g_TxPhase[driverid] = 1;
	g_TxAbort[driverid] = 0;
	g_TxStartKind[driverid] = 1;
	g_TxStartPeer[driverid] = 65535;
	g_TxStartFromD[driverid] = g_TxNpcD[fromPt];
	g_TxRetry[driverid] = 0;
	gPlayer[driverid][pTaxiPendOp] = 1;
	DB_LivingMakeOpId(gPlayer[driverid][pTaxiOpId], 41, "ts", gPlayer[driverid][pTaxiOpSeq], gPlayer[driverid][pCharId]);
	Taxi_SendStart(driverid);
}

Taxi_AcceptPlayer(driverid, passengerid)
{
	if (!Taxi_CanAccept(driverid, 1))
	{
		return 0;
	}
	if (!Taxi_Valid(passengerid) || passengerid == driverid || !Util_IsPlaying(passengerid) || g_TxCallUntil[passengerid] == 0 || Taxi_TickReached(g_TxCallUntil[passengerid]))
	{
		Util_Send(driverid, -10270721, "Quella chiamata non e' piu' attiva.");
		return 0;
	}
	if (gPlayer[passengerid][pTaxiPeer] != 0)
	{
		Util_Send(driverid, -10270721, "La chiamata e' gia' stata presa da un altro taxi.");
		return 0;
	}
	if (!Util_InRange(driverid, passengerid, 600.0))
	{
		Util_Send(driverid, -10270721, "Il cliente e' troppo lontano.");
		return 0;
	}
	new Float:px, Float:py, Float:pz;
	GetPlayerPos(passengerid, px, py, pz);
	g_TxCallUntil[passengerid] = 0;
	gPlayer[passengerid][pTaxiPeer] = driverid + 1;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (i != driverid && g_TxOfferCall[i] == passengerid + 1)
		{
			Taxi_ClearOffer(i);
		}
	}
	Taxi_ClearOffer(driverid);
	gPlayer[driverid][pTaxiRideKind] = 2;
	gPlayer[driverid][pTaxiFromDistrict] = District_At(px, py);
	gPlayer[driverid][pTaxiToDistrict] = 0;
	gPlayer[driverid][pTaxiPeer] = passengerid + 1;
	g_TxPeerChar[driverid] = gPlayer[passengerid][pCharId];
	g_TxPhase[driverid] = 1;
	g_TxAbort[driverid] = 0;
	g_TxStartKind[driverid] = 2;
	g_TxStartPeer[driverid] = passengerid;
	g_TxStartFromD[driverid] = gPlayer[driverid][pTaxiFromDistrict];
	g_TxRetry[driverid] = 0;
	gPlayer[driverid][pTaxiPendOp] = 1;
	DB_LivingMakeOpId(gPlayer[driverid][pTaxiOpId], 41, "ts", gPlayer[passengerid][pCharId], gPlayer[driverid][pCharId]);
	Taxi_SendStart(driverid);
}

Taxi_OnStartResult(driverid, result, rideId)
{
	if (gPlayer[driverid][pTaxiPendOp] != 1)
	{
		return 0;
	}
	if ((result == -1 || result == 10) && g_TxRetry[driverid] < 3)
	{
		Taxi_ScheduleRetry(driverid);
		return 0;
	}
	gPlayer[driverid][pTaxiPendOp] = 0;
	g_TxRetry[driverid] = 0;
	g_TxRetryAt[driverid] = 0;
	new bool:npc = gPlayer[driverid][pTaxiRideKind] == 1;
	new p = Taxi_PassengerOf(driverid);
	if (result == 1 && rideId > 0)
	{
		gPlayer[driverid][pTaxiRideId] = rideId;
		gPlayer[driverid][pTaxiRideState] = 1;
		g_TxPhase[driverid] = 2;
		g_TxDwellTick[driverid] = 0;
		g_TxOffTick[driverid] = 0;
		if (g_TxAbort[driverid] || gPlayer[driverid][pTaxiOnDuty] == 0 || (!npc && p == INVALID_PLAYER_ID))
		{
			g_TxAbort[driverid] = 0;
			Taxi_CancelRide(driverid, "", "");
			return 0;
		}
		if (npc)
		{
			new pt = g_TxPickPt[driverid];
			SetPlayerCheckpoint(driverid, g_TxNpcX[pt], g_TxNpcY[pt], g_TxNpcZ[pt], 6.0);
			Util_Send(driverid, 0x66DD66FF, "Corsa accettata: raggiungi il cliente (checkpoint) e fermati qualche secondo per farlo salire.");
			return 0;
		}
		new name[25], Float:px, Float:py, Float:pz;
		GetPlayerName(driverid, name, 25);
		GetPlayerPos(p, px, py, pz);
		SetPlayerCheckpoint(driverid, px, py, pz, 6.0);
		g_TxBoardUntil[driverid] = Taxi_TickAfter(180000);
		SendClientMessage(p, 0x66DD66FF, "Il taxi di %s ha accettato la tua chiamata: aspettalo e sali come passeggero.", name);
		Util_Send(driverid, 0x66DD66FF, "Corsa accettata: raggiungi il cliente (checkpoint). Quando e' a bordo: /tassametro start.");
		return 0;
	}
	g_TxAbort[driverid] = 0;
	if (p != INVALID_PLAYER_ID)
	{
		Util_Send(p, -10270721, "Il taxi non ha potuto accettare la corsa: puoi chiamarne un altro.");
	}
	switch (result)
	{
		case 6:
		{
			Util_Send(driverid, -10270721, "Hai raggiunto il massimo di corse con clienti della citta' per quest'ora.");
			Taxi_ResetRide(driverid);
			gPlayer[driverid][pTaxiNpcOfferAt] = Taxi_TickAfter(300000);
			return 0;
		}
		case 7:
		{
			Util_Send(driverid, -10270721, npc ? "Requisiti del servizio taxi non soddisfatti." : "Limite orario di corse con questo cliente raggiunto (o requisiti non soddisfatti).");
		}
		case 4:
		{
			Util_Send(driverid, -10270721, "Risulta gia' una corsa aperta: attendi la sua chiusura.");
		}
		default:
		{
			Util_Send(driverid, -10270721, "Centrale taxi non raggiungibile: corsa non avviata.");
		}
	}
	Taxi_ResetRide(driverid);
}

Taxi_MeterSample(driverid, vehicleid, bool:count)
{
	new Float:x, Float:y, Float:z;
	GetVehiclePos(vehicleid, x, y, z);
	if (count)
	{
		new Float:dx = (x - gPlayer[driverid][pTaxiLastX]), Float:dy = (y - gPlayer[driverid][pTaxiLastY]);
		new Float:step = floatsqroot(((dx * dx) + (dy * dy)));
		if ((step <= 70.0))
		{
			g_TxMeterF[driverid] += step;
		}
		gPlayer[driverid][pTaxiMeterM] = floatround(g_TxMeterF[driverid], 1);
	}
	gPlayer[driverid][pTaxiLastX] = x;
	gPlayer[driverid][pTaxiLastY] = y;
}

Taxi_MeterShow(driverid, bool:running)
{
	new meters = gPlayer[driverid][pTaxiMeterM], p = Taxi_PassengerOf(driverid);
	if (gPlayer[driverid][pTaxiRideKind] == 1)
	{
		UI_LivingTaxiMeter(driverid, LD_TaxiFare(meters), meters, running);
		return 0;
	}
	new fare = p != INVALID_PLAYER_ID ? LD_TaxiFareFor(meters, Taxi_MaxLocalRep(p)) : LD_TaxiFare(meters);
	UI_LivingTaxiMeter(driverid, fare, meters, running);
	if (p != INVALID_PLAYER_ID)
	{
		UI_LivingTaxiMeter(p, fare, meters, running);
	}
}

Taxi_MeterBegin(driverid, vehicleid)
{
	Taxi_MeterSample(driverid, vehicleid, 0);
	if (!g_TxMeterStarted[driverid])
	{
		g_TxMeterStarted[driverid] = 1;
		g_TxStartX[driverid] = gPlayer[driverid][pTaxiLastX];
		g_TxStartY[driverid] = gPlayer[driverid][pTaxiLastY];
	}
	gPlayer[driverid][pTaxiMeterOn] = 1;
	Taxi_MeterShow(driverid, 1);
}

Taxi_NpcPay(driverid, vehicleid)
{
	gPlayer[driverid][pTaxiMeterOn] = 0;
	new maxM = g_TxStraightM[driverid] * 250 / 100 + 300;
	new meters = gPlayer[driverid][pTaxiMeterM];
	if (meters > maxM)
	{
		meters = maxM;
	}
	new now = Taxi_VehHealth(vehicleid), start = g_TxStartHealth[driverid], rating = 0;
	if (start > 0 && (start - now) * 100 / start < 10)
	{
		rating = 4;
	}
	g_TxPayMeters[driverid] = meters;
	g_TxPayToD[driverid] = g_TxNpcD[g_TxDestPt[driverid]];
	g_TxPayAccept[driverid] = 1;
	g_TxPayRating[driverid] = rating;
	g_TxPayFare[driverid] = LD_TaxiFare(meters);
	g_TxPhase[driverid] = 5;
	g_TxRetry[driverid] = 0;
	gPlayer[driverid][pTaxiToDistrict] = g_TxPayToD[driverid];
	gPlayer[driverid][pTaxiPendOp] = 7;
	DB_LivingMakeOpId(gPlayer[driverid][pTaxiOpId], 41, "tp", gPlayer[driverid][pTaxiRideId], gPlayer[driverid][pCharId]);
	DisablePlayerCheckpoint(driverid);
	Taxi_MeterShow(driverid, 0);
	DB_LivingTaxiPay(driverid, gPlayer[driverid][pTaxiRideId], 65535, meters, g_TxPayToD[driverid], 1, rating, gPlayer[driverid][pTaxiOpId]);
}

Taxi_PayPrompt(driverid)
{
	new p = Taxi_PassengerOf(driverid), veh = Rental_GetVehicle(driverid);
	if (p == INVALID_PLAYER_ID || veh == 0)
	{
		Taxi_CancelRide(driverid, "Corsa annullata: cliente o taxi non piu' disponibili.", "");
		return 0;
	}
	new Float:x, Float:y, Float:z;
	GetVehiclePos(veh, x, y, z);
	new meters = gPlayer[driverid][pTaxiMeterM];
	if (meters < 200 || Taxi_Dist2D(g_TxStartX[driverid], g_TxStartY[driverid], x, y) < 150)
	{
		Taxi_CancelRide(driverid, "Corsa troppo breve: annullata senza addebito.", "Corsa troppo breve: annullata senza addebito.");
		return 0;
	}
	new rep = Taxi_MaxLocalRep(p), name[25];
	GetPlayerName(driverid, name, 25);
	g_TxPayMeters[driverid] = meters;
	g_TxPayToD[driverid] = District_At(x, y);
	g_TxPayFare[driverid] = LD_TaxiFareFor(meters, rep);
	g_TxPayRating[driverid] = 0;
	gPlayer[driverid][pTaxiToDistrict] = g_TxPayToD[driverid];
	g_TxPhase[driverid] = 4;
	Taxi_MeterShow(driverid, 0);
	UI_LivingTaxiPayConfirm(p, gPlayer[driverid][pTaxiRideId], name, meters, g_TxPayFare[driverid], LD_DiscountPct(rep), 60);
	SendClientMessage(driverid, -1, "Tassametro fermo: $%d per %d m. In attesa della conferma del cliente.", g_TxPayFare[driverid], meters);
}

Taxi_MeterStop(driverid)
{
	if (gPlayer[driverid][pTaxiMeterOn] == 0)
	{
		return 0;
	}
	new veh = Rental_GetVehicle(driverid);
	if (veh != 0)
	{
		Taxi_MeterSample(driverid, veh, Taxi_InTaxi(driverid, veh));
	}
	gPlayer[driverid][pTaxiMeterOn] = 0;
	Taxi_PayPrompt(driverid);
}

Taxi_OnPayResult(driverid, result, rideId, net, points, tax)
{
	if (gPlayer[driverid][pTaxiPendOp] != 7)
	{
		return 0;
	}
	if ((result == -1 || result == 10) && g_TxRetry[driverid] < 3)
	{
		Taxi_ScheduleRetry(driverid);
		return 0;
	}
	gPlayer[driverid][pTaxiPendOp] = 0;
	g_TxRetry[driverid] = 0;
	g_TxRetryAt[driverid] = 0;
	new bool:npc = gPlayer[driverid][pTaxiRideKind] == 1;
	new p = Taxi_PassengerOf(driverid), other[25];
	if (npc || p == INVALID_PLAYER_ID)
	{
		format(other, 25, "%s", "Cliente");
	}
	else
	{
		GetPlayerName(p, other, 25);
	}
	switch (result)
	{
		case 1, 6:
		{
			gPlayer[driverid][pTaxiRideState] = 2;
			if (points > 0)
			{
				LD_SetProPoints(driverid, 2, points);
			}
			UI_LivingTaxiReceipt(driverid, 1, rideId, other, g_TxPayMeters[driverid], npc ? net : net + tax, tax, net);
			if (result == 6)
			{
				Util_Send(driverid, -2994689, "Tetto orario del lavoro dinamico raggiunto: e' stato pagato solo il residuo.");
			}
			LD_Emit(3, g_TxPayToD[driverid], gPlayer[driverid][pCharId], net, gPlayer[driverid][pTaxiOpId]);
		}
		case 8:
		{
			gPlayer[driverid][pTaxiRideState] = 3;
			Util_Send(driverid, -10270721, "Il cliente ha contestato la corsa: nessun pagamento, la verifichera' lo staff.");
		}
		case 3:
		{
			Taxi_CancelRide(driverid, "Il cliente non ha fondi sufficienti in banca: corsa annullata.", "");
			return 0;
		}
		case 2:
		{
			Util_Send(driverid, -1, "La corsa risultava gia' chiusa.");
		}
		case -1, 10:
		{
			Util_Send(driverid, -10270721, "Pagamento non confermato dalla centrale: la corsa verra' verificata.");
		}
		default:
		{
			Util_Send(driverid, -10270721, "Corsa non piu' valida: chiusa senza pagamento.");
		}
	}
	Taxi_ResetRide(driverid);
}

Taxi_RetrySend(playerid)
{
	g_TxRetryAt[playerid] = 0;
	switch (gPlayer[playerid][pTaxiPendOp])
	{
		case 1:
		{
			new sp = g_TxStartPeer[playerid];
			if (g_TxStartKind[playerid] == 2 && (sp < 0 || sp >= 1000 || !IsPlayerConnected(sp)))
			{
				g_TxStartPeer[playerid] = 65535;
			}
			Taxi_SendStart(playerid);
		}
		case 7:
		{
			new p = Taxi_PassengerOf(playerid);
			DB_LivingTaxiPay(playerid, gPlayer[playerid][pTaxiRideId], p, g_TxPayMeters[playerid], g_TxPayToD[playerid], g_TxPayAccept[playerid], g_TxPayRating[playerid], gPlayer[playerid][pTaxiOpId]);
		}
		case 4:
		{
			DB_LivingTaxiCancel(playerid, g_TxCancelRide[playerid], gPlayer[playerid][pTaxiOpId]);
		}
		case 8:
		{
			DB_LivingTaxiRate(playerid, g_TxRateRide[playerid], g_TxRateStars[playerid], gPlayer[playerid][pTaxiOpId]);
		}
	}
}

public Living_OnDBTaxi(playerid, action, result, rideId, amount, balance, v1, v2)
{
	if (!Taxi_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	switch (action)
	{
		case 7:
		{
			Taxi_OnStartResult(playerid, result, rideId);
		}
		case 8:
		{
			Taxi_OnPayResult(playerid, result, rideId, amount, v1, v2);
		}
		case 9:
		{
			if (gPlayer[playerid][pTaxiPendOp] != 4)
			{
				return 1;
			}
			if ((result == -1 || result == 10) && g_TxRetry[playerid] < 3)
			{
				Taxi_ScheduleRetry(playerid);
				return 1;
			}
			if (result == -1 || result == 10)
			{
				Log_Write("TAXI", "annullo corsa senza esito: la chiude il cleanup del DB (logout/avvio)");
			}
			gPlayer[playerid][pTaxiPendOp] = 0;
			g_TxCancelRide[playerid] = 0;
			g_TxRetry[playerid] = 0;
			g_TxRetryAt[playerid] = 0;
		}
		case 10:
		{
			if (gPlayer[playerid][pTaxiPendOp] != 8)
			{
				return 1;
			}
			if ((result == -1 || result == 10) && g_TxRetry[playerid] < 3)
			{
				Taxi_ScheduleRetry(playerid);
				return 1;
			}
			gPlayer[playerid][pTaxiPendOp] = 0;
			g_TxRetry[playerid] = 0;
			g_TxRetryAt[playerid] = 0;
			if (result == 1)
			{
				Util_Send(playerid, 0x66DD66FF, "Grazie per il tuo voto.");
				new d = DB_LdCharOnline(g_TxRateDriverChar[playerid]);
				if (d != 65535 && v2 > 0)
				{
					SendClientMessage(d, -1, "[Taxi] Nuovo voto: %d stelle (media %d.%02d).", v1, v2 / 100, v2 % 100);
				}
			}
			else if (result == 2)
			{
				Util_Send(playerid, -1, "Hai gia' votato questa corsa.");
			}
			g_TxRateRide[playerid] = 0;
			g_TxRateStars[playerid] = 0;
			g_TxRateDriverChar[playerid] = 0;
		}
	}
	return 1;
}

public Living_OnDBTaxiCharged(playerid, rideId, result, charged, balance)
{
	if (!Taxi_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	new d = Taxi_DriverOf(playerid);
	switch (result)
	{
		case 1, 6:
		{
			new name[25], meters = 0;
			name[0] = 0;
			if (d != 65535)
			{
				GetPlayerName(d, name, 25);
				meters = g_TxPayMeters[d];
				g_TxRateDriverChar[playerid] = gPlayer[d][pCharId];
			}
			UI_LivingTaxiMeterHide(playerid);
			UI_LivingTaxiReceipt(playerid, 0, rideId, name, meters, charged, 0, 0);
			if (g_TxRateDriverChar[playerid] > 0 && gPlayer[playerid][pTaxiPendOp] == 0)
			{
				g_TxRateRide[playerid] = rideId;
				UI_LivingTaxiRate(playerid, rideId, name);
			}
		}
		case 8:
		{
			Util_Send(playerid, -1, "Corsa contestata: nessun addebito, la verifichera' lo staff.");
		}
		case 3:
		{
			Util_Send(playerid, -10270721, "Fondi insufficienti in banca per pagare la corsa: corsa annullata.");
		}
	}
	return 1;
}

public UI_OnTaxiCallAccept(playerid, callId)
{
	if (callId <= 0)
	{
		return 1;
	}
	if (callId <= 1000)
	{
		Taxi_AcceptPlayer(playerid, callId - 1);
	}
	else if (callId == g_TxOfferCall[playerid])
	{
		Taxi_AcceptNpc(playerid);
	}
	else
	{
		Util_Send(playerid, -10270721, "Quella chiamata non e' piu' attiva.");
	}
	return 1;
}

public UI_OnTaxiPayConfirm(playerid, rideId, accept)
{
	new d = Taxi_DriverOf(playerid);
	if (d == 65535 || rideId <= 0 || gPlayer[d][pTaxiRideId] != rideId || g_TxPhase[d] != 4 || gPlayer[d][pTaxiPendOp] != 0)
	{
		UI_LivingReject(playerid, "Questa corsa non e' piu' in attesa di pagamento.");
		return 1;
	}
	g_TxPhase[d] = 5;
	g_TxPayAccept[d] = accept != 0;
	g_TxRetry[d] = 0;
	gPlayer[d][pTaxiPendOp] = 7;
	DB_LivingMakeOpId(gPlayer[d][pTaxiOpId], 41, "tp", rideId, gPlayer[d][pCharId]);
	Util_Send(playerid, -1, accept != 0 ? "Pagamento in corso..." : "Contestazione registrata: la corsa restera' in sospeso per lo staff.");
	DB_LivingTaxiPay(d, rideId, playerid, g_TxPayMeters[d], g_TxPayToD[d], g_TxPayAccept[d], 0, gPlayer[d][pTaxiOpId]);
	return 1;
}

public UI_OnTaxiPayExpired(playerid, rideId)
{
	new d = Taxi_DriverOf(playerid);
	if (d == 65535 || gPlayer[d][pTaxiRideId] != rideId || g_TxPhase[d] != 4)
	{
		return 1;
	}
	g_TxPayPrompts[d]++;
	if (g_TxPayPrompts[d] >= 2)
	{
		Taxi_CancelRide(d, "Il cliente non ha confermato il pagamento: corsa annullata.", "Non hai confermato il pagamento: corsa annullata.");
		return 1;
	}
	g_TxPhase[d] = 3;
	Util_Send(d, -2994689, "Il cliente non ha risposto: /tassametro stop per richiedere di nuovo il pagamento, /tassametro annulla per chiudere.");
	return 1;
}

public UI_OnTaxiRate(playerid, rideId, stars)
{
	if (rideId <= 0 || rideId != g_TxRateRide[playerid] || stars < 1 || stars > 5 || gPlayer[playerid][pTaxiPendOp] != 0)
	{
		return 1;
	}
	g_TxRateStars[playerid] = stars;
	g_TxRetry[playerid] = 0;
	gPlayer[playerid][pTaxiPendOp] = 8;
	DB_LivingMakeOpId(gPlayer[playerid][pTaxiOpId], 41, "tr", rideId, gPlayer[playerid][pCharId]);
	DB_LivingTaxiRate(playerid, rideId, stars, gPlayer[playerid][pTaxiOpId]);
	return 1;
}

Taxi_CmdTaxi(playerid, params[])
{
	new pos = 0, tok[16];
	Util_NextToken(params, pos, tok, 16);
	if (!strcmp(tok, "on", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		if (gPlayer[playerid][pTaxiOnDuty] != 0)
		{
			Util_Send(playerid, -10270721, "Sei gia' in servizio.");
			return 1;
		}
		if (gPlayer[playerid][pRentalPendOp] != 0 || gPlayer[playerid][pTaxiPendOp] != 0)
		{
			Util_Send(playerid, -10270721, "Pratica in corso: attendi.");
			return 1;
		}
		new block = LD_CheckStart(playerid);
		if (block != 0)
		{
			LD_SendBlock(playerid, block);
			return 1;
		}
		if (gPlayer[playerid][pLevel] < 2)
		{
			SendClientMessage(playerid, -10270721, "Serve almeno il livello %d per guidare un taxi.", 2);
			return 1;
		}
		if (!Taxi_AtDepot(playerid) || GetPlayerState(playerid) != 1)
		{
			Util_Send(playerid, -10270721, "Presentati a piedi al deposito taxi di Unity Station.");
			return 1;
		}
		new total = 360;
		if ((gPlayer[playerid][pBank] > 0 ? gPlayer[playerid][pBank] : 0) + (gPlayer[playerid][pMoney] > 0 ? gPlayer[playerid][pMoney] : 0) < total)
		{
			SendClientMessage(playerid, -10270721, "Servono $%d (canone $%d/h + cauzione $%d) tra banca e contanti.", total, 60, 300);
			return 1;
		}
		if (!LD_PoolHasRoom() || !Rental_OpenPro(playerid, 4))
		{
			Util_Send(playerid, -10270721, "Nessun taxi disponibile al momento: riprova tra poco.");
			return 1;
		}
		Util_Send(playerid, -1, "Pratica del taxi in corso...");
		return 1;
	}
	if (!strcmp(tok, "off", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		if (gPlayer[playerid][pTaxiOnDuty] == 0)
		{
			Util_Send(playerid, -10270721, "Non sei in servizio.");
			return 1;
		}
		if (g_TxPhase[playerid] != 0 || gPlayer[playerid][pTaxiRideId] != 0 || gPlayer[playerid][pTaxiPendOp] != 0)
		{
			Util_Send(playerid, -10270721, "Concludi o annulla prima la corsa in corso (/tassametro annulla).");
			return 1;
		}
		if (Rental_GetVehicle(playerid) != 0 && !Taxi_AtDepot(playerid))
		{
			Util_Send(playerid, -10270721, "Riporta il taxi al deposito di Unity Station per chiudere il turno.");
			return 1;
		}
		Taxi_EndDuty(playerid, 1, 1);
		Util_Send(playerid, -1, "Fine turno: riconsegna del taxi in corso...");
		return 1;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0)
	{
		SendClientMessage(playerid, -1, "In servizio. Punti taxi: %d. Comandi: /accettacorsa [id] · /tassametro start|stop|annulla · /taxi off (al deposito).", LD_GetProPoints(playerid, 2));
	}
	else
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /taxi on|off al deposito di Unity Station (canone orario + cauzione).");
	}
	return 1;
}

Taxi_CmdChiamataxi(playerid, params[])
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pLivingReady] == 0)
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0)
	{
		Util_Send(playerid, -10270721, "Sei in servizio come tassista.");
		return 1;
	}
	if (gPlayer[playerid][pTaxiPeer] != 0)
	{
		Util_Send(playerid, -10270721, "Un taxi ha gia' accettato la tua chiamata.");
		return 1;
	}
	if (gPlayer[playerid][pTaxiCallTick] != 0 && GetTickCount() - gPlayer[playerid][pTaxiCallTick] < 60000)
	{
		SendClientMessage(playerid, -10270721, "Hai gia' chiamato un taxi: attendi %d secondi.", (60000 - (GetTickCount() - gPlayer[playerid][pTaxiCallTick])) / 1000 + 1);
		return 1;
	}
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
		Util_Send(playerid, -10270721, "Devi trovarti all'aperto per chiamare un taxi.");
		return 1;
	}
	gPlayer[playerid][pTaxiCallTick] = GetTickCount();
	if (gPlayer[playerid][pTaxiCallTick] == 0)
	{
		gPlayer[playerid][pTaxiCallTick] = 1;
	}
	g_TxCallUntil[playerid] = Taxi_TickAfter(60000);
	new name[25], Float:px, Float:py, Float:pz, sent = 0, area[16];
	GetPlayerName(playerid, name, 25);
	GetPlayerPos(playerid, px, py, pz);
	new fromD = District_At(px, py);
	LD_DistrictName(fromD, area, 16);
	for (new d = 0; d < 1000; d++)
	{
		if (d == playerid || !IsPlayerConnected(d) || gPlayer[d][pTaxiOnDuty] == 0)
		{
			continue;
		}
		if (g_TxPhase[d] != 0 || gPlayer[d][pTaxiRideId] != 0 || gPlayer[d][pTaxiPendOp] != 0)
		{
			continue;
		}
		if (!Util_InRange(d, playerid, 600.0))
		{
			continue;
		}
		new Float:dx, Float:dy, Float:dz;
		GetPlayerPos(d, dx, dy, dz);
		SendClientMessage(d, -2994689, "[Taxi] %s (id %d) chiede un taxi a %s. /accettacorsa %d", name, playerid, area, playerid);
		if (g_TxOfferCall[d] == 0)
		{
			g_TxOfferCall[d] = playerid + 1;
			g_TxOfferUntil[d] = Taxi_TickAfter(30000);
			UI_LivingTaxiOffer(d, playerid + 1, 0, name, fromD, fromD, Taxi_Dist2D(dx, dy, px, py), LD_TaxiFare(0), 30);
		}
		sent++;
	}
	if (sent > 0)
	{
		SendClientMessage(playerid, 0x66DD66FF, "Chiamata inviata a %d taxi in zona: attendi una risposta.", sent);
	}
	else
	{
		Util_Send(playerid, -10270721, "Nessun taxi in servizio nelle vicinanze. Riprova piu' tardi.");
	}
	return 1;
}

Taxi_CmdAccettacorsa(playerid, params[])
{
	new pos = 0, tok[16], id = 0;
	Util_NextToken(params, pos, tok, 16);
	if (tok[0] != 0)
	{
		if (!Util_ParseInt(tok, id) || id < 0 || id >= 1000)
		{
			Util_Send(playerid, -10270721, "Uso: /accettacorsa [id giocatore]");
			return 1;
		}
		Taxi_AcceptPlayer(playerid, id);
		return 1;
	}
	new call = g_TxOfferCall[playerid];
	if (call <= 0 || Taxi_TickReached(g_TxOfferUntil[playerid]))
	{
		Util_Send(playerid, -10270721, "Nessuna chiamata da accettare. Per un giocatore: /accettacorsa id.");
		return 1;
	}
	if (call <= 1000)
	{
		Taxi_AcceptPlayer(playerid, call - 1);
	}
	else
	{
		Taxi_AcceptNpc(playerid);
	}
	return 1;
}

Taxi_CmdTassametro(playerid, params[])
{
	new pos = 0, tok[16];
	Util_NextToken(params, pos, tok, 16);
	if (gPlayer[playerid][pTaxiOnDuty] == 0 || gPlayer[playerid][pTaxiRideId] == 0)
	{
		Util_Send(playerid, -10270721, "Non hai una corsa in corso.");
		return 1;
	}
	if (gPlayer[playerid][pTaxiRideKind] != 2)
	{
		Util_Send(playerid, -1, "Con i clienti della citta' il tassametro e' automatico (prelievo -> arrivo).");
		return 1;
	}
	if (gPlayer[playerid][pTaxiPendOp] != 0)
	{
		Util_Send(playerid, -10270721, "Operazione taxi in corso: attendi.");
		return 1;
	}
	new veh = Rental_GetVehicle(playerid), p = Taxi_PassengerOf(playerid);
	if (!strcmp(tok, "start", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		if (g_TxPhase[playerid] != 2 && g_TxPhase[playerid] != 3)
		{
			Util_Send(playerid, -10270721, "In attesa della conferma di pagamento del cliente.");
			return 1;
		}
		if (gPlayer[playerid][pTaxiMeterOn] != 0)
		{
			Util_Send(playerid, -10270721, "Il tassametro e' gia' acceso.");
			return 1;
		}
		if (!Taxi_InTaxi(playerid, veh) || p == INVALID_PLAYER_ID || GetPlayerVehicleID(p) != veh || GetPlayerState(p) != 3)
		{
			Util_Send(playerid, -10270721, "Devi essere al volante del taxi con il cliente a bordo.");
			return 1;
		}
		DisablePlayerCheckpoint(playerid);
		g_TxPhase[playerid] = 3;
		Taxi_MeterBegin(playerid, veh);
		Util_Send(playerid, 0x66DD66FF, "Tassametro acceso. A destinazione: /tassametro stop.");
		Util_Send(p, -1, "Il tassametro e' acceso.");
		return 1;
	}
	if (!strcmp(tok, "stop", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		if (gPlayer[playerid][pTaxiMeterOn] != 0)
		{
			Taxi_MeterStop(playerid);
			return 1;
		}
		if (g_TxPhase[playerid] == 3 && g_TxMeterStarted[playerid])
		{
			Taxi_PayPrompt(playerid);
			return 1;
		}
		Util_Send(playerid, -10270721, "Il tassametro non e' acceso.");
		return 1;
	}
	if (!strcmp(tok, "annulla", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		Taxi_CancelRide(playerid, "Corsa annullata senza addebito.", "Il tassista ha annullato la corsa: nessun addebito.");
		return 1;
	}
	Util_Send(playerid, 0x99CCFFFF, "Uso: /tassametro start|stop|annulla");
	return 1;
}

Taxi_OnProRental(playerid, result, vehicleid)
{
	if (!Taxi_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (result != 1 || vehicleid <= 0)
	{
		switch (result)
		{
			case 3:
			{
				SendClientMessage(playerid, -10270721, "Fondi insufficienti: servono $%d (canone + cauzione).", 360);
			}
			case 7:
			{
				Util_Send(playerid, -10270721, "Non puoi prendere servizio: livello insufficiente o un altro noleggio/contratto attivo.");
			}
			default:
			{
				Util_Send(playerid, -10270721, "Nessun taxi assegnato: riprova tra poco (nessun addebito).");
			}
		}
		return 0;
	}
	Taxi_ResetPlayer(playerid);
	gPlayer[playerid][pTaxiOnDuty] = 1;
	gPlayer[playerid][pTaxiRideId] = 0;
	Taxi_ScheduleNpc(playerid);
	LD_Emit(107, 0, gPlayer[playerid][pCharId], 1, "-");
	SendClientMessage(playerid, 0x66DD66FF, "Sei in servizio (canone $%d/h, cauzione $%d). Le chiamate arrivano da sole: /accettacorsa. Fine turno: /taxi off al deposito.", 60, 300);
	return 1;
}

Taxi_OnProRentalClosed(playerid, result, refund)
{
	if (!Taxi_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0 || g_TxPhase[playerid] != 0)
	{
		Taxi_EndDuty(playerid, 5, 0);
	}
	if (!Util_IsPlaying(playerid))
	{
		return 1;
	}
	switch (result)
	{
		case 1:
		{
			SendClientMessage(playerid, -1, "Taxi riconsegnato: cauzione restituita $%d (in base alle condizioni del mezzo).", refund);
		}
		case 5:
		{
			Util_Send(playerid, -10270721, "Taxi riconsegnato oltre la tolleranza: cauzione trattenuta.");
		}
		case 2:
		{
			Util_Send(playerid, -1, "Il noleggio del taxi risultava gia' chiuso.");
		}
		default:
		{
			Util_Send(playerid, -10270721, "Chiusura del taxi non confermata: verra' sistemata al prossimo accesso.");
		}
	}
	return 1;
}

public Taxi_OnDistrictEvent(type, districtId, charId, value, opId[])
{
	return 1;
}

Taxi_TickNpc(driverid, vehicleid, bool:inVeh)
{
	new pt = g_TxPhase[driverid] == 2 ? g_TxPickPt[driverid] : g_TxDestPt[driverid];
	if (!inVeh || (GetVehicleDistanceFromPoint(vehicleid, g_TxNpcX[pt], g_TxNpcY[pt], g_TxNpcZ[pt]) > 6.0) || (float(Veh_SpeedKmh(vehicleid)) > 12.0))
	{
		g_TxDwellTick[driverid] = 0;
		return 0;
	}
	if (g_TxDwellTick[driverid] == 0)
	{
		g_TxDwellTick[driverid] = Taxi_TickAfter(4000);
		return 0;
	}
	if (!Taxi_TickReached(g_TxDwellTick[driverid]))
	{
		return 0;
	}
	g_TxDwellTick[driverid] = 0;
	if (g_TxPhase[driverid] == 2)
	{
		new d = g_TxDestPt[driverid], name[16];
		g_TxPhase[driverid] = 3;
		g_TxStartHealth[driverid] = Taxi_VehHealth(vehicleid);
		Taxi_MeterBegin(driverid, vehicleid);
		SetPlayerCheckpoint(driverid, g_TxNpcX[d], g_TxNpcY[d], g_TxNpcZ[d], 6.0);
		LD_DistrictName(g_TxNpcD[d], name, 16);
		SendClientMessage(driverid, 0x66DD66FF, "Cliente a bordo: portalo a %s (checkpoint).", name);
		return 0;
	}
	Taxi_NpcPay(driverid, vehicleid);
}

Taxi_TickDriver(driverid)
{
	new veh = Rental_GetVehicle(driverid);
	if (g_TxOfferCall[driverid] != 0 && Taxi_TickReached(g_TxOfferUntil[driverid]))
	{
		g_TxOfferCall[driverid] = 0;
		g_TxOfferUntil[driverid] = 0;
	}
	if (veh == 0)
	{
		if (gPlayer[driverid][pRentalId] == 0 && gPlayer[driverid][pRentalPendOp] == 0)
		{
			Util_Send(driverid, -10270721, "Il tuo taxi non e' piu' disponibile: fuori servizio.");
			Taxi_EndDuty(driverid, 4, 0);
		}
		else if (g_TxPhase[driverid] >= 2 && g_TxPhase[driverid] <= 4)
		{
			Taxi_CancelRide(driverid, "Taxi non disponibile: corsa annullata.", "Il taxi non e' piu' disponibile: corsa annullata.");
		}
		return 0;
	}
	new phase = g_TxPhase[driverid];
	new bool:inVeh = Taxi_InTaxi(driverid, veh);
	if (phase == 2 || phase == 3)
	{
		if (inVeh)
		{
			g_TxOffTick[driverid] = 0;
		}
		else if (g_TxOffTick[driverid] == 0)
		{
			g_TxOffTick[driverid] = Taxi_TickAfter(45000);
			SendClientMessage(driverid, -10270721, "Torna sul taxi entro %d secondi o la corsa sara' annullata.", 45);
		}
		else if (Taxi_TickReached(g_TxOffTick[driverid]))
		{
			Taxi_CancelRide(driverid, "Hai lasciato il taxi: corsa annullata.", "Il tassista ha lasciato il taxi: corsa annullata.");
			return 0;
		}
	}
	if (gPlayer[driverid][pTaxiMeterOn] != 0)
	{
		Taxi_MeterSample(driverid, veh, inVeh);
		Taxi_MeterShow(driverid, 1);
	}
	if (phase == 0)
	{
		if (gPlayer[driverid][pTaxiPendOp] == 0 && g_TxOfferCall[driverid] == 0 && gPlayer[driverid][pTaxiNpcOfferAt] != 0 && Taxi_TickReached(gPlayer[driverid][pTaxiNpcOfferAt]) && gPlayer[driverid][pRentalPendOp] == 0)
		{
			Taxi_NpcOffer(driverid);
		}
		return 0;
	}
	if (gPlayer[driverid][pTaxiRideKind] == 1)
	{
		if (phase == 2 || phase == 3)
		{
			Taxi_TickNpc(driverid, veh, inVeh);
		}
		return 0;
	}
	if (phase < 2 || phase > 4)
	{
		return 0;
	}
	new p = Taxi_PassengerOf(driverid);
	if (p == INVALID_PLAYER_ID)
	{
		Taxi_CancelRide(driverid, "Il cliente non e' piu' disponibile: corsa annullata.", "");
		return 0;
	}
	if (phase == 2 && !g_TxMeterStarted[driverid] && Taxi_TickReached(g_TxBoardUntil[driverid]))
	{
		Taxi_CancelRide(driverid, "Il cliente non e' salito in tempo: corsa annullata.", "Non sei salito sul taxi in tempo: corsa annullata.");
		return 0;
	}
	if (gPlayer[driverid][pTaxiMeterOn] != 0 && GetPlayerVehicleID(p) != veh)
	{
		Taxi_MeterStop(driverid);
	}
}

public Taxi_OnTick()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (g_TxRetryAt[i] != 0 && Taxi_TickReached(g_TxRetryAt[i]))
		{
			Taxi_RetrySend(i);
			continue;
		}
		if (g_TxCallUntil[i] != 0 && Taxi_TickReached(g_TxCallUntil[i]))
		{
			g_TxCallUntil[i] = 0;
			if (gPlayer[i][pTaxiPeer] == 0)
			{
				Util_Send(i, -1, "Nessun taxi ha risposto alla tua chiamata.");
			}
		}
		if (gPlayer[i][pTaxiOnDuty] != 0)
		{
			Taxi_TickDriver(i);
		}
	}
	return 1;
}

Taxi_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Taxi_ResetPlayer(i);
	}
	if (g_TxTimer != 0)
	{
		KillTimer(g_TxTimer);
	}
	g_TxTimer = SetTimer("Taxi_OnTick", 1000, 1);
	LD_Listen("Taxi_OnDistrictEvent", 20);
	CreatePickup(1239, 1, 1771.0, -1895.0, 13.6, 0);
	Lang_Create3DTextLabel("Deposito taxi\n/taxi on  ·  /taxi off", -2994689, 1771.0, -1895.0, (13.6 + 0.8), 20.0, 0, 0);
}

Taxi_OnExit()
{
	if (g_TxTimer != 0)
	{
		KillTimer(g_TxTimer);
	}
	g_TxTimer = 0;
}

Taxi_OnPlayerConnect(playerid)
{
	Taxi_ResetPlayer(playerid);
}

Taxi_OnCharReady(playerid)
{
}

Taxi_OnPlayerDisconnect(playerid, reason)
{
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0 || g_TxPhase[playerid] != 0)
	{
		Taxi_EndDuty(playerid, 2, 1);
	}
	new d = Taxi_DriverOf(playerid);
	if (d != 65535)
	{
		Taxi_CancelRide(d, "Il cliente si e' disconnesso: corsa annullata.", "");
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (i != playerid && g_TxOfferCall[i] == playerid + 1)
		{
			Taxi_ClearOffer(i);
		}
	}
	Taxi_ResetPlayer(playerid);
}

Taxi_OnPlayerDeath(playerid)
{
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0)
	{
		Util_Send(playerid, -10270721, "Turno di taxi interrotto.");
		Taxi_EndDuty(playerid, 3, 1);
	}
	new d = Taxi_DriverOf(playerid);
	if (d != 65535)
	{
		Taxi_CancelRide(d, "Il cliente non e' in condizione di proseguire: corsa annullata.", "");
	}
	g_TxCallUntil[playerid] = 0;
}

Taxi_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
}

Taxi_OnPlayerExitVehicle(playerid, vehicleid)
{
}

Taxi_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (!Taxi_Valid(playerid))
	{
		return 0;
	}
	new d = Taxi_DriverOf(playerid);
	if (d == 65535)
	{
		return 0;
	}
	if (newstate == 3 && g_TxPhase[d] == 2 && GetPlayerVehicleID(playerid) == Rental_GetVehicle(d))
	{
		DisablePlayerCheckpoint(d);
		Util_Send(d, 0x66DD66FF, "Il cliente e' a bordo: /tassametro start.");
		return 0;
	}
	if (oldstate == 3 && gPlayer[d][pTaxiMeterOn] != 0)
	{
		Taxi_MeterStop(d);
	}
}

Taxi_OnVehicleDeath(vehicleid, killerid)
{
	if (LD_VehModule(vehicleid) != 2)
	{
		return 0;
	}
	new d = LD_VehOwner(vehicleid);
	if (d == 65535 || !Taxi_Valid(d) || gPlayer[d][pTaxiOnDuty] == 0)
	{
		return 0;
	}
	Util_Send(d, -10270721, "Il taxi e' stato distrutto: fine del turno.");
	Taxi_EndDuty(d, 4, 1);
}

// ===== modules/freight/freight.inc =====
new g_FrtTimer;
new bool:g_FrtActive[MAX_PLAYERS];
new bool:g_FrtWelcome[MAX_PLAYERS];
new g_FrtCt[MAX_PLAYERS];
new g_FrtFrom[MAX_PLAYERS];
new g_FrtTo[MAX_PLAYERS];
new g_FrtCargo[MAX_PLAYERS];
new g_FrtDist[MAX_PLAYERS];
new g_FrtPhase[MAX_PLAYERS];
new g_FrtVeh[MAX_PLAYERS];
new g_FrtSerial[MAX_PLAYERS];
new bool:g_FrtBoarded[MAX_PLAYERS];
new bool:g_FrtDwell[MAX_PLAYERS];
new bool:g_FrtOff[MAX_PLAYERS];
new g_FrtStartTick[MAX_PLAYERS];
new g_FrtWaitTick[MAX_PLAYERS];
new g_FrtDefer[MAX_PLAYERS];
new g_FrtInteg[MAX_PLAYERS];
new Float:g_FrtPath[MAX_PLAYERS];
new Float:g_FrtLastX[MAX_PLAYERS];
new Float:g_FrtLastY[MAX_PLAYERS];
new Float:g_FrtLastZ[MAX_PLAYERS];
new g_FrtLastTick[MAX_PLAYERS];
new g_FrtRetryTick[MAX_PLAYERS];
new g_FrtStateRetry[MAX_PLAYERS];
new g_FrtNoteTick[MAX_PLAYERS];

bool:Freight_ValidId(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

Freight_ResetPlayer(playerid)
{
	g_FrtActive[playerid] = 0;
	g_FrtWelcome[playerid] = 0;
	g_FrtCt[playerid] = 0;
	g_FrtFrom[playerid] = 0;
	g_FrtTo[playerid] = 0;
	g_FrtCargo[playerid] = 0;
	g_FrtDist[playerid] = 0;
	g_FrtPhase[playerid] = 0;
	g_FrtVeh[playerid] = 65535;
	g_FrtSerial[playerid] = 0;
	g_FrtBoarded[playerid] = 0;
	g_FrtDwell[playerid] = 0;
	g_FrtOff[playerid] = 0;
	g_FrtStartTick[playerid] = 0;
	g_FrtWaitTick[playerid] = 0;
	g_FrtDefer[playerid] = 0;
	g_FrtInteg[playerid] = 100;
	g_FrtPath[playerid] = 0.0;
	g_FrtLastX[playerid] = 0.0;
	g_FrtLastY[playerid] = 0.0;
	g_FrtLastZ[playerid] = 0.0;
	g_FrtLastTick[playerid] = 0;
	g_FrtRetryTick[playerid] = 0;
	g_FrtStateRetry[playerid] = 0;
	g_FrtNoteTick[playerid] = 0;
}

bool:Freight_Point(d, bool:shop, &Float:x, &Float:y, &Float:z)
{
	switch (d)
	{
		case 1:
		{
			if (shop)
			{
				x = 1927.0;
				y = -1790.0;
				z = 13.5;
			}
			else
			{
				x = 1880.0;
				y = -1780.0;
				z = 13.5;
			}
		}
		case 2:
		{
			if (shop)
			{
				x = 2490.0;
				y = -1690.0;
				z = 13.5;
			}
			else
			{
				x = 2400.0;
				y = -1740.0;
				z = 13.5;
			}
		}
		case 3:
		{
			if (shop)
			{
				x = 2190.0;
				y = -1155.0;
				z = 24.0;
			}
			else
			{
				x = 2145.0;
				y = -1215.0;
				z = 24.0;
			}
		}
		default:
		{
			x = 0.0;
			y = 0.0;
			z = 0.0;
			return 0;
		}
	}
	return 1;
}

Freight_PairDistance(fromD, toD)
{
	new Float:ax, Float:ay, Float:az, Float:bx, Float:by, Float:bz;
	if (!Freight_Point(fromD, 0, ax, ay, az) || !Freight_Point(toD, 1, bx, by, bz))
	{
		return 0;
	}
	new Float:dx = (bx - ax), Float:dy = (by - ay);
	return floatround(floatsqroot(((dx * dx) + (dy * dy))), 1);
}

Freight_CargoName(cargo, dest[], size)
{
	switch (cargo)
	{
		case 2:
		{
			strcopy(dest, "merci alimentari", size);
		}
		case 3:
		{
			strcopy(dest, "materiali", size);
		}
		default:
		{
			strcopy(dest, "merci generiche", size);
		}
	}
}

Freight_SecCeil(ms)
{
	if (ms <= 0)
	{
		return 0;
	}
	return (ms + 1000 - 1) / 1000;
}

Freight_Note(playerid, text[])
{
	new now = GetTickCount();
	if (g_FrtNoteTick[playerid] != 0 && now - g_FrtNoteTick[playerid] < 4000)
	{
		return 0;
	}
	g_FrtNoteTick[playerid] = now;
	Util_Send(playerid, -10270721, text);
}

Freight_IntegrityOf(vehicleid)
{
	new Float:hp;
	GetVehicleHealth(vehicleid, hp);
	return LD_Clamp(floatround((hp / 10.0), 1), 0, 100);
}

bool:Freight_VehOk(playerid)
{
	new veh = g_FrtVeh[playerid];
	if (veh == 65535 || veh <= 0 || veh >= 2000 || !IsValidVehicle(veh))
	{
		return 0;
	}
	return LD_VehModule(veh) == 3 && LD_VehOwner(veh) == playerid && LD_VehSerial(veh) == g_FrtSerial[playerid];
}

bool:Freight_IsDriving(playerid)
{
	return Freight_VehOk(playerid) && GetPlayerVehicleID(playerid) == g_FrtVeh[playerid] && GetPlayerState(playerid) == 2;
}

Freight_RemoveVehicle(playerid)
{
	new veh = g_FrtVeh[playerid];
	if (veh != 65535 && veh > 0 && veh < 2000)
	{
		if (LD_VehModule(veh) == 3 && LD_VehOwner(veh) == playerid && LD_VehSerial(veh) == g_FrtSerial[playerid])
		{
			LD_VehRelease(veh);
			if (IsValidVehicle(veh))
			{
				if (IsPlayerConnected(playerid) && GetPlayerVehicleID(playerid) == veh)
				{
					RemovePlayerFromVehicle(playerid, 0);
				}
				DestroyVehicle(veh);
			}
		}
	}
	g_FrtVeh[playerid] = 65535;
	g_FrtSerial[playerid] = 0;
	gPlayer[playerid][pFreightVehicle] = 0;
}

Freight_ShowCheckpoint(playerid)
{
	if (!IsPlayerConnected(playerid))
	{
		return 0;
	}
	new Float:x, Float:y, Float:z;
	new bool:shop = g_FrtPhase[playerid] >= 3;
	if (!Freight_Point(shop ? g_FrtTo[playerid] : g_FrtFrom[playerid], shop, x, y, z))
	{
		return 0;
	}
	DisablePlayerCheckpoint(playerid);
	SetPlayerCheckpoint(playerid, x, y, z, 6.0);
}

Freight_TimeLeft(playerid)
{
	if (g_FrtPhase[playerid] < 3)
	{
		return -1;
	}
	new left = LD_FreightTimeLimit(g_FrtDist[playerid]) - (GetTickCount() - gPlayer[playerid][pFreightLegTick]) / 1000;
	return left > 0 ? left : 0;
}

Freight_Hud(playerid, distM, dwellSec)
{
	if (g_FrtWelcome[playerid] || g_FrtCt[playerid] <= 0)
	{
		return 0;
	}
	new name[16], goal[96], dest[96];
	new bool:shop = g_FrtPhase[playerid] >= 3;
	LD_DistrictName(shop ? g_FrtTo[playerid] : g_FrtFrom[playerid], name, 16);
	format(dest, 96, "%s %s", shop ? "Negozio" : "Magazzino", name);
	switch (g_FrtPhase[playerid])
	{
		case 2:
		{
			strcopy(goal, "Registrazione del carico...", 96);
		}
		case 4:
		{
			strcopy(goal, "Registrazione della consegna...", 96);
		}
		case 3:
		{
			if (dwellSec >= 0)
			{
				format(goal, 96, "Scarico: resta fermo %d s", dwellSec);
			}
			else if (g_FrtOff[playerid])
			{
				strcopy(goal, "Torna alla guida del Mule!", 96);
			}
			else
			{
				strcopy(goal, "Consegna la merce al negozio", 96);
			}
		}
		default:
		{
			if (dwellSec >= 0)
			{
				format(goal, 96, "Carico: resta fermo %d s", dwellSec);
			}
			else if (!g_FrtBoarded[playerid])
			{
				strcopy(goal, "Sali sul Mule al magazzino", 96);
			}
			else if (g_FrtOff[playerid])
			{
				strcopy(goal, "Torna alla guida del Mule!", 96);
			}
			else
			{
				strcopy(goal, "Entra nel checkpoint del magazzino", 96);
			}
		}
	}
	UI_CityContractHud(playerid, g_FrtCt[playerid], shop ? 2 : 1, goal, dest, distM, Freight_TimeLeft(playerid), shop ? g_FrtInteg[playerid] : -1);
}

Freight_End(playerid, reason)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid])
	{
		return 0;
	}
	new bool:welcome = g_FrtWelcome[playerid];
	new bool:online = IsPlayerConnected(playerid) != 0;
	Freight_RemoveVehicle(playerid);
	if (online)
	{
		DisablePlayerCheckpoint(playerid);
		if (!welcome)
		{
			UI_CityContractHudHide(playerid);
		}
		switch (reason)
		{
			case 1:
			{
				Util_Send(playerid, -1, "Contratto di trasporto chiuso: il Mule e' stato ritirato.");
			}
			case 5:
			{
				Util_Send(playerid, -10270721, "Contratto di trasporto scaduto o non piu' valido: il Mule e' stato ritirato.");
			}
			case 7:
			{
				Util_Send(playerid, -10270721, "Contratto di trasporto annullato dallo staff.");
			}
		}
	}
	gPlayer[playerid][pFreightLegTick] = 0;
	gPlayer[playerid][pFreightDwellTick] = 0;
	gPlayer[playerid][pFreightLeftVehTick] = 0;
	if (welcome)
	{
		gPlayer[playerid][pFreightWelcome] = 0;
	}
	Freight_ResetPlayer(playerid);
	if (welcome && online && reason != 0 && reason != 2 && reason != 6)
	{
		Hub_OnWelcomeDelivered(playerid, 0);
	}
	return 1;
}

Freight_Release(playerid, reason)
{
	if (!g_FrtActive[playerid])
	{
		return 0;
	}
	if (!g_FrtWelcome[playerid] && g_FrtCt[playerid] > 0)
	{
		g_FrtDefer[playerid] = 0;
		g_FrtPhase[playerid] = 0;
		Director_Release(playerid, reason);
	}
	if (g_FrtActive[playerid])
	{
		Freight_End(playerid, reason);
	}
}

Freight_Stop(playerid, reason, text[])
{
	if (!g_FrtActive[playerid])
	{
		return 0;
	}
	if (text[0] != 0 && IsPlayerConnected(playerid))
	{
		Util_Send(playerid, -10270721, text);
	}
	new ph = g_FrtPhase[playerid];
	if (!g_FrtWelcome[playerid] && (ph == 2 || ph == 4))
	{
		if (g_FrtDefer[playerid] == 0)
		{
			g_FrtDefer[playerid] = reason;
		}
		Freight_RemoveVehicle(playerid);
		if (IsPlayerConnected(playerid))
		{
			DisablePlayerCheckpoint(playerid);
		}
		return 0;
	}
	Freight_Release(playerid, reason);
}

Freight_Picked(playerid)
{
	new now = GetTickCount();
	g_FrtPhase[playerid] = 3;
	g_FrtDwell[playerid] = 0;
	g_FrtStateRetry[playerid] = 0;
	gPlayer[playerid][pFreightLegTick] = now;
	gPlayer[playerid][pFreightDwellTick] = 0;
	if (!g_FrtWelcome[playerid])
	{
		gPlayer[playerid][pContractPhase] = 2;
	}
	g_FrtInteg[playerid] = Freight_IntegrityOf(g_FrtVeh[playerid]);
	g_FrtPath[playerid] = 0.0;
	GetVehiclePos(g_FrtVeh[playerid], g_FrtLastX[playerid], g_FrtLastY[playerid], g_FrtLastZ[playerid]);
	g_FrtLastTick[playerid] = now;
	Freight_ShowCheckpoint(playerid);
	new name[16];
	LD_DistrictName(g_FrtTo[playerid], name, 16);
	if (g_FrtWelcome[playerid])
	{
		UI_LivingToast(playerid, "Merce caricata: portala al negozio di Idlewood.", 1);
	}
	SendClientMessage(playerid, 0x66DD66FF, "Merce caricata. Consegnala al negozio di %s: guida con prudenza, i danni al Mule rovinano il carico.", name);
}

Freight_DoPickup(playerid)
{
	if (g_FrtWelcome[playerid])
	{
		Freight_Picked(playerid);
		return 0;
	}
	g_FrtPhase[playerid] = 2;
	g_FrtWaitTick[playerid] = GetTickCount();
	if (!Director_Pickup(playerid))
	{
		if (!g_FrtActive[playerid])
		{
			return 0;
		}
		if (g_FrtPhase[playerid] == 2)
		{
			g_FrtPhase[playerid] = 1;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "Carico non registrato al momento: resta nel checkpoint e riprova tra qualche secondo.");
		}
	}
}

Freight_DoDeliver(playerid)
{
	new now = GetTickCount();
	new seconds = (now - gPlayer[playerid][pFreightLegTick]) / 1000;
	new minSec = LD_FreightMinSeconds(g_FrtDist[playerid]);
	if (seconds < minSec)
	{
		new msg[256];
		format(msg, 256, "consegna troppo rapida: pers. %d contratto %d dopo %d s (minimo %d s)", gPlayer[playerid][pCharId], g_FrtCt[playerid], seconds, minSec);
		Log_Write("FREIGHT", msg);
		format(msg, 256, "Consegna non valida: troppo rapida (ancora %d s). Resta nel checkpoint.", minSec - seconds);
		Freight_Note(playerid, msg);
		g_FrtRetryTick[playerid] = now + 5000;
		return 0;
	}
	if (!g_FrtWelcome[playerid] && g_FrtDist[playerid] < 300)
	{
		Freight_Stop(playerid, 5, "Contratto non valido (tratta troppo corta).");
		return 0;
	}
	new Float:minPath = float(g_FrtDist[playerid] * 80 / 100);
	if ((g_FrtPath[playerid] < minPath))
	{
		new msg[256];
		format(msg, 256, "percorso insufficiente: pers. %d contratto %d percorso %.0f m su %d m", gPlayer[playerid][pCharId], g_FrtCt[playerid], g_FrtPath[playerid], g_FrtDist[playerid]);
		Log_Write("FREIGHT", msg);
		Freight_Note(playerid, "Consegna non valida: la merce deve essere portata dal magazzino con il Mule.");
		g_FrtRetryTick[playerid] = now + 5000;
		return 0;
	}
	new integ = Freight_IntegrityOf(g_FrtVeh[playerid]);
	if (integ < g_FrtInteg[playerid])
	{
		g_FrtInteg[playerid] = integ;
	}
	integ = g_FrtInteg[playerid];
	if (g_FrtWelcome[playerid])
	{
		Freight_End(playerid, 0);
		Util_Send(playerid, 0x66DD66FF, "Consegna di benvenuto completata: il negozio di Idlewood ti ringrazia!");
		Hub_OnWelcomeDelivered(playerid, 1);
		return 0;
	}
	g_FrtPhase[playerid] = 4;
	g_FrtWaitTick[playerid] = now;
	if (!Director_Complete(playerid, integ, seconds))
	{
		if (!g_FrtActive[playerid])
		{
			return 0;
		}
		if (g_FrtPhase[playerid] == 4)
		{
			g_FrtPhase[playerid] = 3;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "Consegna non registrata al momento: resta nel checkpoint e riprova tra qualche secondo.");
		}
	}
}

bool:Freight_Begin(playerid, contractId, fromD, toD, cargo, distanceM, bool:welcome)
{
	if (!Freight_ValidId(playerid) || !Util_IsPlaying(playerid) || g_FrtActive[playerid])
	{
		return 0;
	}
	if (!LD_IsReady() || gPlayer[playerid][pLivingReady] == 0 || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed])
	{
		return 0;
	}
	if (Job_IsOnShift(playerid) || gPlayer[playerid][pTaxiOnDuty] != 0 || gPlayer[playerid][pRentalId] != 0)
	{
		return 0;
	}
	if (welcome)
	{
		if (contractId != 0 || gPlayer[playerid][pContractId] != 0)
		{
			return 0;
		}
		fromD = 1;
		toD = 1;
		if (cargo < 1 || cargo > 3)
		{
			cargo = 1;
		}
	}
	else
	{
		if (contractId <= 0 || gPlayer[playerid][pFreightWelcome] != 0)
		{
			return 0;
		}
		if (gPlayer[playerid][pContractId] != 0 && gPlayer[playerid][pContractId] != contractId)
		{
			return 0;
		}
		if (fromD == toD || cargo < 1 || cargo > 3)
		{
			return 0;
		}
		if (gPlayer[playerid][pLevel] < 2)
		{
			return 0;
		}
	}
	new pair = Freight_PairDistance(fromD, toD);
	if (pair <= 0)
	{
		return 0;
	}
	new dist = welcome ? pair : (distanceM > pair ? distanceM : pair);
	if (!welcome && dist < 300)
	{
		return 0;
	}
	if (!LD_PoolHasRoom())
	{
		Util_Send(playerid, -10270721, "Nessun veicolo da carico disponibile al momento. Riprova tra poco.");
		return 0;
	}
	new Float:x, Float:y, Float:z, slot = 0;
	Freight_Point(fromD, 0, x, y, z);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FrtActive[i] && g_FrtFrom[i] == fromD && g_FrtPhase[i] == 1)
		{
			slot++;
		}
	}
	x += (5.0 * float(slot % 4));
	new veh = CreateVehicle(414, x, y, z, 0.0, 1, 1, -1, 0);
	if (veh == 65535 || veh <= 0 || veh >= 2000)
	{
		Util_Send(playerid, -10270721, "Impossibile preparare il veicolo da carico. Riprova.");
		return 0;
	}
	new serial = LD_VehRegister(veh, 3, playerid);
	if (serial == 0)
	{
		DestroyVehicle(veh);
		Util_Send(playerid, -10270721, "Nessun veicolo da carico disponibile al momento. Riprova tra poco.");
		return 0;
	}
	SetVehicleVirtualWorld(veh, 0);
	SetVehicleHealth(veh, 1000.0);
	SetVehicleParamsEx(veh, 1, 0, 0, 0, 0, 0, 0);
	new now = GetTickCount();
	Freight_ResetPlayer(playerid);
	g_FrtActive[playerid] = 1;
	g_FrtWelcome[playerid] = welcome;
	g_FrtCt[playerid] = contractId;
	g_FrtFrom[playerid] = fromD;
	g_FrtTo[playerid] = toD;
	g_FrtCargo[playerid] = cargo;
	g_FrtDist[playerid] = dist;
	g_FrtPhase[playerid] = 1;
	g_FrtVeh[playerid] = veh;
	g_FrtSerial[playerid] = serial;
	g_FrtStartTick[playerid] = now;
	gPlayer[playerid][pFreightVehicle] = veh;
	gPlayer[playerid][pFreightLegTick] = 0;
	gPlayer[playerid][pFreightDwellTick] = 0;
	gPlayer[playerid][pFreightLeftVehTick] = 0;
	if (welcome)
	{
		gPlayer[playerid][pFreightWelcome] = 1;
	}
	else
	{
		gPlayer[playerid][pContractId] = contractId;
		gPlayer[playerid][pContractPhase] = 1;
		gPlayer[playerid][pContractFromDistrict] = fromD;
		gPlayer[playerid][pContractToDistrict] = toD;
		gPlayer[playerid][pContractCargo] = cargo;
		gPlayer[playerid][pContractDistance] = distanceM;
		if (gPlayer[playerid][pContractStartTick] == 0)
		{
			gPlayer[playerid][pContractStartTick] = now;
		}
	}
	Freight_ShowCheckpoint(playerid);
	new fromName[16], toName[16], cargoName[96];
	LD_DistrictName(fromD, fromName, 16);
	LD_DistrictName(toD, toName, 16);
	Freight_CargoName(cargo, cargoName, 96);
	if (welcome)
	{
		SendClientMessage(playerid, 0x66DD66FF, "Consegna di benvenuto: sali sul Mule al magazzino di Idlewood, fermati nel checkpoint %d s per caricare %s, poi portali al negozio di Idlewood.", 6, cargoName);
		UI_LivingToast(playerid, "Sali sul Mule al magazzino di Idlewood.", 0);
	}
	else
	{
		SendClientMessage(playerid, 0x66DD66FF, "Contratto #%d: ritira il Mule al magazzino di %s, fermati nel checkpoint (max %.0f km/h) %d s per caricare %s, poi consegna al negozio di %s (%d m).", contractId, fromName, 0x41200000, 6, cargoName, toName, dist);
		Freight_Hud(playerid, -1, -1);
	}
	return 1;
}

Freight_OnPickupResult(playerid, result)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid] || g_FrtWelcome[playerid] || g_FrtPhase[playerid] != 2)
	{
		return 0;
	}
	if (g_FrtDefer[playerid] != 0)
	{
		Freight_Release(playerid, g_FrtDefer[playerid]);
		return 1;
	}
	switch (result)
	{
		case 1, 2:
		{
			if (!Freight_VehOk(playerid))
			{
				Freight_Release(playerid, 4);
				return 1;
			}
			Freight_Picked(playerid);
		}
		case -1, 10:
		{
			g_FrtPhase[playerid] = 1;
			g_FrtDwell[playerid] = 0;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "Registrazione del carico non riuscita: resta nel checkpoint per ritentare.");
		}
		default:
		{
			Freight_Release(playerid, 5);
		}
	}
	return 1;
}

Freight_OnCompleteResult(playerid, result, paid, balance)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid] || g_FrtWelcome[playerid] || g_FrtPhase[playerid] != 4)
	{
		return 0;
	}
	switch (result)
	{
		case 1, 2, 6:
		{
			new ct = g_FrtCt[playerid];
			Freight_End(playerid, 0);
			if (result == 2)
			{
				SendClientMessage(playerid, -1, "Consegna del contratto #%d gia' registrata: nessun nuovo pagamento.", ct);
			}
			else if (result == 6)
			{
				SendClientMessage(playerid, 0x66DD66FF, "Consegna #%d completata: $%d accreditati in banca (tetto orario raggiunto). Saldo: $%d.", ct, paid, balance);
			}
			else
			{
				SendClientMessage(playerid, 0x66DD66FF, "Consegna #%d completata: $%d accreditati in banca. Saldo: $%d.", ct, paid, balance);
			}
		}
		case 8:
		{
			Freight_End(playerid, 0);
			Util_Send(playerid, -10270721, "Contratto FALLITO: la merce e' arrivata troppo danneggiata. Nessun compenso.");
		}
		case -1, 10:
		{
			if (g_FrtDefer[playerid] != 0)
			{
				Freight_Release(playerid, g_FrtDefer[playerid]);
				return 1;
			}
			g_FrtPhase[playerid] = 3;
			g_FrtDwell[playerid] = 0;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "Registrazione della consegna non riuscita: resta nel checkpoint per ritentare.");
		}
		case 4:
		{
			g_FrtStateRetry[playerid]++;
			if (g_FrtDefer[playerid] != 0 || g_FrtStateRetry[playerid] >= 3)
			{
				Freight_Release(playerid, g_FrtDefer[playerid] != 0 ? g_FrtDefer[playerid] : 5);
				return 1;
			}
			g_FrtPhase[playerid] = 3;
			g_FrtDwell[playerid] = 0;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "Consegna rifiutata dal registro (troppo rapida o stato non valido): attendi qualche secondo nel checkpoint.");
		}
		default:
		{
			Freight_Release(playerid, g_FrtDefer[playerid] != 0 ? g_FrtDefer[playerid] : 5);
		}
	}
	return 1;
}

Freight_WaitTimeout(playerid)
{
	new msg[256];
	format(msg, 256, "esito DB non ricevuto: pers. %d contratto %d fase %d", gPlayer[playerid][pCharId], g_FrtCt[playerid], g_FrtPhase[playerid]);
	Log_Write("FREIGHT", msg);
	if (g_FrtDefer[playerid] != 0)
	{
		Freight_Release(playerid, g_FrtDefer[playerid]);
		return 0;
	}
	g_FrtPhase[playerid] = g_FrtPhase[playerid] == 2 ? 1 : 3;
	g_FrtDwell[playerid] = 0;
	g_FrtRetryTick[playerid] = GetTickCount() + 5000;
}

bool:Freight_SamplePath(playerid, now)
{
	new Float:x, Float:y, Float:z;
	GetVehiclePos(g_FrtVeh[playerid], x, y, z);
	new Float:dx = (x - g_FrtLastX[playerid]), Float:dy = (y - g_FrtLastY[playerid]), Float:dz = (z - g_FrtLastZ[playerid]);
	new Float:seg = floatsqroot((((dx * dx) + (dy * dy)) + (dz * dz)));
	new dt = now - g_FrtLastTick[playerid];
	if (dt < 0)
	{
		dt = 0;
	}
	g_FrtLastX[playerid] = x;
	g_FrtLastY[playerid] = y;
	g_FrtLastZ[playerid] = z;
	g_FrtLastTick[playerid] = now;
	if ((seg > (15.0 + ((70.0 * float(dt)) / float(1000)))))
	{
		new msg[256];
		format(msg, 256, "salto del Mule: pers. %d contratto %d %.0f m in %d ms", gPlayer[playerid][pCharId], g_FrtCt[playerid], seg, dt);
		Log_Write("FREIGHT", msg);
		return 0;
	}
	g_FrtPath[playerid] += seg;
	return 1;
}

Freight_TickPlayer(playerid, now)
{
	new ph = g_FrtPhase[playerid];
	if (ph == 2 || ph == 4)
	{
		if (now - g_FrtWaitTick[playerid] >= 20000)
		{
			Freight_WaitTimeout(playerid);
		}
		else if (g_FrtDefer[playerid] == 0 && Freight_VehOk(playerid))
		{
			Freight_Hud(playerid, -1, -1);
		}
		return 0;
	}
	if (Job_IsOnShift(playerid))
	{
		Freight_Stop(playerid, 1, "Hai iniziato un turno di lavoro: il contratto di trasporto e' stato chiuso.");
		return 0;
	}
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed])
	{
		Freight_Stop(playerid, 3, "Non sei in condizione di guidare: contratto di trasporto interrotto.");
		return 0;
	}
	if (!Freight_VehOk(playerid))
	{
		Freight_Stop(playerid, 4, "Il Mule del contratto non esiste piu': contratto interrotto.");
		return 0;
	}
	new veh = g_FrtVeh[playerid];
	new Float:hp;
	GetVehicleHealth(veh, hp);
	if ((hp < 300.0))
	{
		Freight_Stop(playerid, 4, "Mule distrutto: il carico e' perso e il contratto e' interrotto.");
		return 0;
	}
	new bool:driving = Freight_IsDriving(playerid);
	if (driving)
	{
		g_FrtBoarded[playerid] = 1;
		g_FrtOff[playerid] = 0;
		gPlayer[playerid][pFreightLeftVehTick] = 0;
	}
	else if (g_FrtBoarded[playerid])
	{
		if (!g_FrtOff[playerid])
		{
			g_FrtOff[playerid] = 1;
			gPlayer[playerid][pFreightLeftVehTick] = now;
		}
		new Float:px, Float:py, Float:pz;
		GetPlayerPos(playerid, px, py, pz);
		if (now - gPlayer[playerid][pFreightLeftVehTick] >= 45000 || (GetVehicleDistanceFromPoint(veh, px, py, pz) > 150.0))
		{
			Freight_Stop(playerid, 4, "Mule abbandonato: contratto di trasporto rilasciato.");
			return 0;
		}
	}
	else if (now - g_FrtStartTick[playerid] >= 600000)
	{
		Freight_Stop(playerid, 4, "Non hai preso in consegna il Mule in tempo: contratto di trasporto rilasciato.");
		return 0;
	}
	if (ph == 3)
	{
		if (!Freight_SamplePath(playerid, now))
		{
			Freight_Stop(playerid, 4, "Spostamento anomalo del Mule: contratto di trasporto annullato.");
			return 0;
		}
		new integ = LD_Clamp(floatround((hp / 10.0), 1), 0, 100);
		if (integ < g_FrtInteg[playerid])
		{
			g_FrtInteg[playerid] = integ;
		}
	}
	new bool:shop = ph == 3;
	new Float:tx, Float:ty, Float:tz;
	Freight_Point(shop ? g_FrtTo[playerid] : g_FrtFrom[playerid], shop, tx, ty, tz);
	new Float:dist = (driving ? GetVehicleDistanceFromPoint(veh, tx, ty, tz) : GetPlayerDistanceFromPoint(playerid, tx, ty, tz));
	new dwellSec = -1;
	new bool:retryOk = g_FrtRetryTick[playerid] == 0 || now - g_FrtRetryTick[playerid] >= 0;
	if (driving && retryOk && (dist <= 6.0) && (float(Veh_SpeedKmh(veh)) <= 10.0) && GetVehicleVirtualWorld(veh) == 0)
	{
		if (!g_FrtDwell[playerid])
		{
			g_FrtDwell[playerid] = 1;
			gPlayer[playerid][pFreightDwellTick] = now;
			if (g_FrtWelcome[playerid])
			{
				UI_LivingToast(playerid, shop ? "Scarico in corso: resta fermo." : "Carico in corso: resta fermo.", 0);
			}
		}
		new need = shop ? 5000 : 6000;
		new waited = now - gPlayer[playerid][pFreightDwellTick];
		if (waited >= need)
		{
			g_FrtDwell[playerid] = 0;
			gPlayer[playerid][pFreightDwellTick] = 0;
			if (shop)
			{
				Freight_DoDeliver(playerid);
			}
			else
			{
				Freight_DoPickup(playerid);
			}
			if (!g_FrtActive[playerid])
			{
				return 0;
			}
		}
		else
		{
			dwellSec = Freight_SecCeil(need - waited);
		}
	}
	else
	{
		g_FrtDwell[playerid] = 0;
		gPlayer[playerid][pFreightDwellTick] = 0;
	}
	Freight_Hud(playerid, floatround(dist, 1), dwellSec);
}

public Freight_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!g_FrtActive[i])
		{
			continue;
		}
		if (!IsPlayerConnected(i))
		{
			Freight_End(i, 2);
			continue;
		}
		Freight_TickPlayer(i, now);
	}
	return 1;
}

Freight_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Freight_ResetPlayer(i);
	}
	if (g_FrtTimer != 0)
	{
		KillTimer(g_FrtTimer);
	}
	g_FrtTimer = SetTimer("Freight_OnTick", 1000, 1);
}

Freight_OnExit()
{
	if (g_FrtTimer != 0)
	{
		KillTimer(g_FrtTimer);
	}
	g_FrtTimer = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FrtActive[i])
		{
			Freight_End(i, 6);
		}
	}
}

Freight_OnPlayerConnect(playerid)
{
	if (!Freight_ValidId(playerid))
	{
		return 0;
	}
	Freight_ResetPlayer(playerid);
}

Freight_OnCharReady(playerid)
{
}

Freight_OnPlayerDisconnect(playerid, reason)
{
	if (!Freight_ValidId(playerid))
	{
		return 0;
	}
	if (g_FrtActive[playerid])
	{
		Freight_End(playerid, 2);
	}
	Freight_ResetPlayer(playerid);
}

Freight_OnPlayerDeath(playerid)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid])
	{
		return 0;
	}
	Freight_Stop(playerid, 3, "Sei stato ferito: il contratto di trasporto e' interrotto e il Mule ritirato.");
}

Freight_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	if (LD_VehModule(vehicleid) != 3)
	{
		return 0;
	}
	new owner = LD_VehOwner(vehicleid);
	if (owner == playerid || ispassenger != 0)
	{
		return 0;
	}
	ClearAnimations(playerid, 0);
	Util_Send(playerid, -10270721, "Questo veicolo da carico e' assegnato a un altro trasportatore.");
}

Freight_OnPlayerExitVehicle(playerid, vehicleid)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid] || g_FrtVeh[playerid] != vehicleid || !g_FrtBoarded[playerid])
	{
		return 0;
	}
	if (!g_FrtOff[playerid])
	{
		g_FrtOff[playerid] = 1;
		gPlayer[playerid][pFreightLeftVehTick] = GetTickCount();
		SendClientMessage(playerid, -10270721, "Torna alla guida del Mule entro %d secondi (e resta entro %.0f m) o il contratto sara' rilasciato.", 45, 0x43160000);
	}
}

Freight_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (newstate != 2)
	{
		return 0;
	}
	new veh = GetPlayerVehicleID(playerid);
	if (LD_VehModule(veh) != 3)
	{
		return 0;
	}
	if (LD_VehOwner(veh) != playerid)
	{
		RemovePlayerFromVehicle(playerid, 0);
		Util_Send(playerid, -10270721, "Questo veicolo da carico e' assegnato a un altro trasportatore.");
		return 0;
	}
	if (g_FrtActive[playerid] && g_FrtVeh[playerid] == veh)
	{
		g_FrtBoarded[playerid] = 1;
		g_FrtOff[playerid] = 0;
		gPlayer[playerid][pFreightLeftVehTick] = 0;
	}
}

Freight_OnVehicleDeath(vehicleid, killerid)
{
	if (LD_VehModule(vehicleid) != 3)
	{
		return 0;
	}
	new owner = LD_VehOwner(vehicleid);
	if (!Freight_ValidId(owner) || !g_FrtActive[owner] || g_FrtVeh[owner] != vehicleid)
	{
		return 0;
	}
	Freight_Stop(owner, 4, "Mule distrutto: il carico e' perso e il contratto e' interrotto.");
}

// ===== modules/cityos/cityos.inc =====
new bool:g_CosWaitBoard[MAX_PLAYERS];
new g_CosRumor[3][8][] = {
	{"La panetteria di Idlewood ha riaperto dopo l'estate: il pane esce caldo alle sei.", "Alla Casa del Quartiere cercano volontari per il doposcuola del giovedi'.", "Il campetto dietro la stazione ha di nuovo le reti: qualcuno le ha ricucite a mano.", "Un vecchio meccanico ripara bici gratis ai ragazzi, basta portargli un caffe'.", "Le signore del palazzo giallo organizzano una cena di quartiere sabato sera.", "Il negozio all'angolo ha appeso una lavagna: chi ha bisogno lascia un biglietto.", "Dicono che il murale vicino alla fermata sara' restaurato dagli stessi artisti.", "Chi esce dal turno di notte trova sempre una luce accesa alla Casa del Quartiere."},
	{"A Ganton il barbiere sotto i portici taglia i capelli ai ragazzi prima degli esami.", "Il negozio di Ganton aspetta un carico di frutta: chi consegna e' il benvenuto.", "Sulla Grove hanno ridipinto le panchine, ognuna con un colore diverso.", "Un gruppo di madri accompagna i bambini a scuola a turno, a piedi.", "Il torneo di basket del venerdi' quest'anno raccoglie fondi per il campetto.", "Un ex corriere ha aperto una piccola officina: assume chi vuole imparare.", "Le luci della via principale sono tornate: i commercianti hanno fatto colletta.", "Dicono che il vecchio cinema all'aperto potrebbe tornare per una sera d'estate."},
	{"Al magazzino di Jefferson servono autisti puntuali: chi lavora bene viene ricordato.", "Il motel sulla collina offre la colazione a chi aiuta a scaricare le merci.", "Un coro di quartiere prova ogni martedi' nella sala della chiesa.", "La lavanderia a gettoni e' diventata il posto dove ci si scambia le notizie.", "I ragazzi del quartiere puliscono il parco ogni prima domenica del mese.", "Un fornaio di Jefferson regala le pagnotte invendute alla mensa la sera.", "La fermata dell'autobus ha una nuova pensilina: costruita da chi la usa.", "Dicono che chi consegna con cura a Jefferson trova sempre una porta aperta."}
};

bool:CityOS_Playing(playerid)
{
	return Util_IsPlaying(playerid) && gPlayer[playerid][pLivingReady] != 0 && LD_IsReady();
}

CityOS_Integrity(playerid)
{
	new veh = gPlayer[playerid][pFreightVehicle];
	if (veh <= 0 || veh >= 2000 || LD_VehModule(veh) != 3 || LD_VehOwner(veh) != playerid)
	{
		return -1;
	}
	new Float:h;
	GetVehicleHealth(veh, h);
	return LD_Clamp(floatround(h, 1) / 10, 0, 100);
}

CityOS_NextDistance(playerid)
{
	new d = gPlayer[playerid][pContractPhase] == 2 ? gPlayer[playerid][pContractToDistrict] : gPlayer[playerid][pContractFromDistrict];
	new Float:tx, Float:ty, Float:px, Float:py, Float:pz;
	new bool:shop = gPlayer[playerid][pContractPhase] == 2;
	switch (d)
	{
		case 1:
		{
			tx = Float:((shop ? 1927.0 : 0x44EB0000));
			ty = Float:((shop ? 0xC4DFC000 : 0xC4DE8000));
		}
		case 2:
		{
			tx = Float:((shop ? 0x451BA000 : 0x45160000));
			ty = Float:((shop ? 0xC4D34000 : 0xC4D98000));
		}
		case 3:
		{
			tx = Float:((shop ? 0x4508E000 : 2145.0));
			ty = Float:((shop ? -1155.0 : -1215.0));
		}
		default:
		{
			return -1;
		}
	}
	GetPlayerPos(playerid, px, py, pz);
	new Float:dx = (tx - px), Float:dy = (ty - py);
	return floatround(floatsqroot(((dx * dx) + (dy * dy))), 1);
}

CityOS_ShowBoard(playerid)
{
	if (!CityOS_Playing(playerid))
	{
		return 0;
	}
	new now = gettime(), n = Director_BoardCount();
	UI_CityBoardBegin(playerid);
	new id = 0, fromD = 0, toD = 0, cargo = 0, reward = 0, meters = 0, expires = 0, minLevel = 0, minRep = 0, minLocal = 0, premium = 0, rows = 0;
	for (new i = 0; i < n && rows < 12; i++)
	{
		if (!Director_BoardVisible(playerid, i))
		{
			continue;
		}
		if (!Director_BoardGet(i, id, fromD, toD, cargo, reward, meters, expires, minLevel, minRep, minLocal, premium))
		{
			continue;
		}
		UI_CityBoardAdd(playerid, id, 1, fromD, toD, cargo, reward, meters, expires - now, premium != 0, minLevel, minRep, minLocal, Director_BlockCode(playerid, i));
		rows++;
	}
	UI_CityBoardShow(playerid, Hub_NearBoard(playerid) >= 0);
}

CityOS_ShowDistrict(playerid, districtId)
{
	if (!CityOS_Playing(playerid))
	{
		return 0;
	}
	if (districtId < 1 || districtId > 3)
	{
		UI_CityDistrictPick(playerid);
		return 0;
	}
	DB_LivingHistory(playerid, districtId);
}

CityOS_RenderDistrict(playerid, districtId, count)
{
	new now = gettime(), fest = DB_LivingDistrictGet(districtId, 4), festH = 0;
	if (fest > now)
	{
		festH = (fest - now + 3600 - 1) / 3600;
	}
	UI_CityDistrictBegin(playerid, districtId, District_GetActivity(districtId), District_GetSecurity(districtId), District_GetCrime(districtId), LD_GetLocalRep(playerid, districtId), festH);
	new r = LD_HashMod(LD_Hash32(LD_Bucket(now), districtId, 3), 8);
	UI_CityDistrictRumor(playerid, g_CosRumor[districtId - 1][r]);
	for (new i = 0; i < count && i < 8; i++)
	{
		new ago = now - g_LdHist[i][lhTimestamp];
		UI_CityDistrictEvent(playerid, g_LdHist[i][lhType], ago > 0 ? ago : 0, g_LdHist[i][lhActDelta]);
	}
	UI_CityDistrictShow(playerid);
}

CityOS_OnInit()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		g_CosWaitBoard[i] = 0;
	}
	LD_Listen("CityOS_OnDistrictEvent", 30);
}

CityOS_OnExit()
{
}

CityOS_OnPlayerConnect(playerid)
{
	g_CosWaitBoard[playerid] = 0;
}

CityOS_OnCharReady(playerid)
{
	g_CosWaitBoard[playerid] = 0;
}

CityOS_OnPlayerDisconnect(playerid, reason)
{
	g_CosWaitBoard[playerid] = 0;
}

public CityOS_OnDistrictEvent(type, districtId, charId, value, opId[])
{
	if (type != 104)
	{
		return 1;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!g_CosWaitBoard[i])
		{
			continue;
		}
		g_CosWaitBoard[i] = 0;
		if (IsPlayerConnected(i))
		{
			CityOS_ShowBoard(i);
		}
	}
	return 1;
}

CityOS_CmdContratti(playerid, params[])
{
	if (!CityOS_Playing(playerid))
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	new pos = 0, tok[24], num[24];
	Util_NextToken(params, pos, tok, 24);
	if (!strcmp(tok, "accetta", 1, 0x7FFFFFFF) && tok[0] != 0)
	{
		new id = 0;
		Util_NextToken(params, pos, num, 24);
		if (!Util_ParseInt(num, id) || id <= 0)
		{
			Util_Send(playerid, 0x99CCFFFF, "Uso: /contratti accetta <numero contratto>");
			return 1;
		}
		Director_Accept(playerid, id);
		return 1;
	}
	CityOS_ShowBoard(playerid);
	return 1;
}

CityOS_CmdContratto(playerid, params[])
{
	if (!CityOS_Playing(playerid))
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	new pos = 0, tok[24];
	Util_NextToken(params, pos, tok, 24);
	new ct = gPlayer[playerid][pContractId];
	new bool:active = ct != 0 && (gPlayer[playerid][pContractPhase] == 1 || gPlayer[playerid][pContractPhase] == 2);
	if (tok[0] != 0 && !strcmp(tok, "abbandona", 1, 0x7FFFFFFF))
	{
		if (!active)
		{
			Util_Send(playerid, -10270721, "Non hai un contratto da lasciare.");
			return 1;
		}
		Director_Release(playerid, 1);
		return 1;
	}
	if (!active)
	{
		if (ct != 0)
		{
			Util_Send(playerid, -1, "La tua richiesta di contratto e' in elaborazione: attendi un istante.");
		}
		else
		{
			UI_CityContractNone(playerid);
		}
		return 1;
	}
	new exp = Director_ExpiresAt(playerid), left = -1;
	if (exp > 0)
	{
		left = exp > gettime() ? exp - gettime() : 0;
	}
	UI_CityContractStatus(playerid, ct, gPlayer[playerid][pContractPhase], gPlayer[playerid][pContractFromDistrict], gPlayer[playerid][pContractToDistrict], gPlayer[playerid][pContractCargo], gPlayer[playerid][pContractReward], left, CityOS_Integrity(playerid), CityOS_NextDistance(playerid), -5);
	return 1;
}

CityOS_CmdReputazione(playerid, params[])
{
	if (!CityOS_Playing(playerid))
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	UI_CityRepBegin(playerid);
	UI_CityRepTrack(playerid, 1, LD_GetProPoints(playerid, 1), 0, 0, 0, 0, 0);
	new rating = DB_LivingPlayerGet(playerid, 3);
	UI_CityRepTrack(playerid, 2, LD_GetProPoints(playerid, 2), 0, 0, rating, rating > 0 ? 100 : 0, 0);
	for (new d = 1; d <= 3; d++)
	{
		UI_CityRepLocal(playerid, d, LD_GetLocalRep(playerid, d));
	}
	UI_CityRepShow(playerid);
	return 1;
}

CityOS_CmdQuartiere(playerid, params[])
{
	if (!CityOS_Playing(playerid))
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	new pos = 0, tok[24], d = 0;
	Util_NextToken(params, pos, tok, 24);
	if (tok[0] != 0)
	{
		d = LD_ParseDistrict(tok);
		if (d == 0)
		{
			Util_Send(playerid, 0x99CCFFFF, "Uso: /quartiere [idlewood|ganton|jefferson]");
			return 1;
		}
	}
	else
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		d = GetPlayerInterior(playerid) == 0 ? District_At(x, y) : 0;
	}
	CityOS_ShowDistrict(playerid, d);
	return 1;
}

public Living_OnDBHistory(playerid, result, districtId, count)
{
	if (!CityOS_Playing(playerid) || districtId < 1 || districtId > 3)
	{
		return 1;
	}
	if (result == 10)
	{
		Util_Send(playerid, -10270721, "Sto ancora caricando i tuoi dati: riprova tra un istante.");
		return 1;
	}
	CityOS_RenderDistrict(playerid, districtId, result == 1 ? count : 0);
	return 1;
}

public UI_OnContractAccept(playerid, contractId)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	Director_Accept(playerid, contractId);
	return 1;
}

public UI_OnContractAbandon(playerid, contractId)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	if (contractId <= 0 || gPlayer[playerid][pContractId] != contractId)
	{
		Util_Send(playerid, -10270721, "Questo contratto non e' piu' attivo.");
		return 1;
	}
	Director_Release(playerid, 1);
	return 1;
}

public UI_OnContractBoardRefresh(playerid)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	if (!DB_IsReady())
	{
		CityOS_ShowBoard(playerid);
		return 1;
	}
	g_CosWaitBoard[playerid] = 1;
	DB_LivingBoard(65535);
	return 1;
}

public UI_OnDistrictPick(playerid, districtId)
{
	if (!CityOS_Playing(playerid))
	{
		return 1;
	}
	CityOS_ShowDistrict(playerid, districtId);
	return 1;
}

// ===== modules/hub/hub.inc =====
new Float:s_HubBoard[3][3] = {
	{1850.0, -1800.0, 13.6},
	{2490.0, -1678.0, 13.5},
	{2133.0, -1215.0, 24.0}
};
new s_HubBoardDistrict[3] = {1, 2, 3};
new s_HubKitItem[3] = {3, 2, 6};
new s_HubKitQty[3] = {2, 1, 2};
new g_HubPickup[3] = {-1, -1, -1};
new Text3D:g_HubLabel[3] = {65535, 65535, 65535};
new g_HubZone = -1;
new g_HubTimer;
new g_HubTickCount;
new g_HubLastRefresh;
new bool:g_HubRefreshed;
new bool:g_HubFestInit[4];
new g_HubFestSeen[4];
new g_HubPrjSeen[4];
new g_HubGoalSeen[4];
new g_HubPrjNameSeen[4][65];
new g_HubFundPrj[4];
new g_HubFund[4];
new g_HubOnb[MAX_PLAYERS];
new g_HubStep[MAX_PLAYERS];
new g_HubAhead[MAX_PLAYERS];
new g_HubHintShown[MAX_PLAYERS];
new g_HubHintDue[MAX_PLAYERS];
new bool:g_HubOpBusy[MAX_PLAYERS];
new g_HubOpStep[MAX_PLAYERS];
new g_HubOpId[MAX_PLAYERS][37];
new g_HubOpRetryAt[MAX_PLAYERS];
new g_HubOpTries[MAX_PLAYERS];
new g_HubKitLeft[MAX_PLAYERS];
new g_HubKitAt[MAX_PLAYERS];
new g_HubKitTries[MAX_PLAYERS];
new bool:g_HubKitReload[MAX_PLAYERS];
new g_HubTarget[MAX_PLAYERS];
new bool:g_HubCpOn[MAX_PLAYERS];
new g_HubAtBoard[MAX_PLAYERS];
new g_HubGreeted[MAX_PLAYERS];
new g_HubDonDay[MAX_PLAYERS];
new g_HubDonToday[MAX_PLAYERS];
new g_HubPrjOpId[MAX_PLAYERS][37];
new g_HubPrjOpProject[MAX_PLAYERS];
new g_HubPrjOpAmount[MAX_PLAYERS];
new g_HubPrjDistrict[MAX_PLAYERS];

bool:Hub_Valid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

bool:Hub_PlayerOk(playerid)
{
	return Util_IsPlaying(playerid) && gPlayer[playerid][pCharId] > 0;
}

Hub_PlayerByChar(charId)
{
	if (charId <= 0)
	{
		return 65535;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && gPlayer[i][pCharId] == charId)
		{
			return i;
		}
	}
	return 65535;
}

Hub_Bit(n)
{
	return 1 << n;
}

Hub_CurStep(playerid)
{
	return g_HubStep[playerid] + 1;
}

bool:Hub_HintsOn(playerid)
{
	return gPlayer[playerid][pHintsOff] == 0;
}

Hub_ResetPlayer(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	g_HubOnb[playerid] = 0;
	g_HubStep[playerid] = 0;
	g_HubAhead[playerid] = 0;
	g_HubHintShown[playerid] = 0;
	g_HubHintDue[playerid] = 0;
	g_HubOpBusy[playerid] = 0;
	g_HubOpStep[playerid] = 0;
	g_HubOpId[playerid][0] = 0;
	g_HubOpRetryAt[playerid] = 0;
	g_HubOpTries[playerid] = 0;
	g_HubKitLeft[playerid] = 0;
	g_HubKitAt[playerid] = 0;
	g_HubKitTries[playerid] = 0;
	g_HubKitReload[playerid] = 0;
	g_HubTarget[playerid] = 0;
	g_HubCpOn[playerid] = 0;
	g_HubAtBoard[playerid] = 0;
	g_HubGreeted[playerid] = 0;
	g_HubDonDay[playerid] = 0;
	g_HubDonToday[playerid] = 0;
	g_HubPrjOpId[playerid][0] = 0;
	g_HubPrjOpProject[playerid] = 0;
	g_HubPrjOpAmount[playerid] = 0;
	g_HubPrjDistrict[playerid] = 0;
}

Hub_NearBoard(playerid)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pCharId] <= 0)
	{
		return -1;
	}
	if (GetPlayerState(playerid) == 9 || GetPlayerState(playerid) == 7)
	{
		return -1;
	}
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
		return -1;
	}
	for (new b = 0; b < 3; b++)
	{
		if (IsPlayerInRangeOfPoint(playerid, 4.0, s_HubBoard[b][0], s_HubBoard[b][1], s_HubBoard[b][2]))
		{
			return b;
		}
	}
	return -1;
}

bool:Hub_TargetPos(target, &Float:x, &Float:y, &Float:z)
{
	switch (target)
	{
		case 1:
		{
			x = 1850.0;
			y = -1800.0;
			z = 13.6;
		}
		case 2:
		{
			x = 1480.5;
			y = -1736.0;
			z = 13.5;
		}
		case 3:
		{
			x = 1505.0;
			y = -1700.0;
			z = 13.5;
		}
		default:
		{
			return 0;
		}
	}
	return 1;
}

Hub_ClearTarget(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	if (g_HubTarget[playerid] != 0 && IsPlayerConnected(playerid))
	{
		RemovePlayerMapIcon(playerid, 97);
	}
	if (g_HubCpOn[playerid] && IsPlayerConnected(playerid) && LD_ActiveFlow(playerid) == 0)
	{
		DisablePlayerCheckpoint(playerid);
	}
	g_HubCpOn[playerid] = 0;
	g_HubTarget[playerid] = 0;
}

Hub_SetTarget(playerid, target, bool:withCheckpoint)
{
	new Float:x, Float:y, Float:z;
	if (!Hub_TargetPos(target, x, y, z))
	{
		Hub_ClearTarget(playerid);
		return 0;
	}
	Hub_ClearTarget(playerid);
	SetPlayerMapIcon(playerid, 97, x, y, z, 0, -2994689, 1);
	g_HubTarget[playerid] = target;
	if (withCheckpoint && LD_ActiveFlow(playerid) == 0)
	{
		SetPlayerCheckpoint(playerid, x, y, z, 3.0);
		g_HubCpOn[playerid] = 1;
	}
}

Hub_StepTarget(step)
{
	switch (step)
	{
		case 1, 3:
		{
			return 1;
		}
		case 5:
		{
			return 2;
		}
	}
	return 0;
}

Hub_OnInit()
{
	new text[256], name[16];
	for (new b = 0; b < 3; b++)
	{
		g_HubPickup[b] = CreatePickup(1239, 1, s_HubBoard[b][0], s_HubBoard[b][1], s_HubBoard[b][2], 0);
		if (b == 0)
		{
			g_HubLabel[b] = Lang_Create3DTextLabel("Casa del Quartiere di Idlewood\nBacheca contratti - Progetto del quartiere\n/contratti  /contribuisci  /aiuto servizi", -2994689, s_HubBoard[b][0], s_HubBoard[b][1], (0.8 + s_HubBoard[b][2]), 15.0, 0, 0);
		}
		else
		{
			LD_DistrictName(s_HubBoardDistrict[b], name, 16);
			format(text, 256, "Bacheca di quartiere - %s\nUn pezzo di Casa del Quartiere anche qui\n/contratti  /contribuisci", name);
			g_HubLabel[b] = Lang_Create3DTextLabel(text, 0x99CCFFFF, s_HubBoard[b][0], s_HubBoard[b][1], (0.8 + s_HubBoard[b][2]), 15.0, 0, 0);
		}
	}
	g_HubZone = GangZoneCreate((1850.0 - 22.0), (-1800.0 - 22.0), (1850.0 + 22.0), (-1800.0 + 22.0));
	g_HubTickCount = 0;
	g_HubLastRefresh = 0;
	g_HubRefreshed = 0;
	for (new d = 0; d <= 3; d++)
	{
		g_HubFestInit[d] = 0;
		g_HubFestSeen[d] = 0;
		g_HubPrjSeen[d] = 0;
		g_HubGoalSeen[d] = 0;
		g_HubPrjNameSeen[d][0] = 0;
		g_HubFundPrj[d] = 0;
		g_HubFund[d] = 0;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Hub_ResetPlayer(i);
	}
	if (!LD_Listen("Hub_OnDistrictEvent", 40))
	{
		Log_Write("HUB", "registrazione del listener Hub_OnDistrictEvent non riuscita");
	}
	g_HubTimer = SetTimer("Hub_OnTick", 1000, 1);
}

Hub_OnExit()
{
	if (g_HubTimer != 0)
	{
		KillTimer(g_HubTimer);
	}
	g_HubTimer = 0;
	for (new b = 0; b < 3; b++)
	{
		if (g_HubPickup[b] != -1)
		{
			DestroyPickup(g_HubPickup[b]);
		}
		if (g_HubLabel[b] != 65535)
		{
			Delete3DTextLabel(g_HubLabel[b]);
		}
		g_HubPickup[b] = -1;
		g_HubLabel[b] = 65535;
	}
	if (g_HubZone != -1)
	{
		GangZoneDestroy(g_HubZone);
	}
	g_HubZone = -1;
}

Hub_OnPlayerConnect(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
}

Hub_OnCharReady(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
	if (g_HubZone != -1)
	{
		GangZoneShowForPlayer(playerid, g_HubZone, -2994880);
	}
	Hub_TryLoad(playerid);
}

Hub_OnPlayerDisconnect(playerid, reason)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
}

Hub_TryLoad(playerid)
{
	if (g_HubOnb[playerid] != 0 || DB_LivingPlayerGet(playerid, 0) == 0)
	{
		return 0;
	}
	new step = LD_Clamp(DB_LivingPlayerGet(playerid, 4), 0, 5);
	new bool:done = DB_LivingPlayerGet(playerid, 5) != 0 || step >= 5;
	g_HubStep[playerid] = step;
	gPlayer[playerid][pOnboardStep] = step;
	gPlayer[playerid][pHintsOff] = DB_LivingPlayerGet(playerid, 6) != 0 ? 1 : 0;
	if (done)
	{
		g_HubOnb[playerid] = 2;
		UI_LivingHelpSet(playerid, 6, !Hub_HintsOn(playerid));
		return 0;
	}
	g_HubOnb[playerid] = 1;
	UI_LivingHelpSet(playerid, Hub_CurStep(playerid), !Hub_HintsOn(playerid));
	if (!Hub_HintsOn(playerid))
	{
		return 0;
	}
	if (step == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Benvenuto a Los Santos. Qui nessuno arriva da solo: a due passi da Unity Station c'e' la Casa del Quartiere di Idlewood.");
		Util_Send(playerid, 0x99CCFFFF, "Se ti va, /aiuto ti accompagna nel primo giorno. Preferisci fare da te? /aiuto off, nessun problema.");
	}
	else
	{
		new msg[256];
		format(msg, 256, "Bentornato. Il tuo primo giorno riprende dal passo %d di %d: /aiuto per rivederlo.", Hub_CurStep(playerid), 5);
		Util_Send(playerid, 0x99CCFFFF, msg);
	}
	g_HubHintDue[playerid] = GetTickCount() + 8000;
	new target = Hub_StepTarget(Hub_CurStep(playerid));
	if (target != 0)
	{
		Hub_SetTarget(playerid, target, 0);
	}
}

Hub_SendStep(playerid, step, bool:fresh)
{
	if (fresh)
	{
		DB_LivingMakeOpId(g_HubOpId[playerid], 37, "ob", step, gPlayer[playerid][pCharId]);
		g_HubOpTries[playerid] = 0;
	}
	g_HubOpBusy[playerid] = 1;
	g_HubOpStep[playerid] = step;
	g_HubOpRetryAt[playerid] = 0;
	if (DB_LivingBusy(playerid, 4))
	{
		g_HubOpRetryAt[playerid] = GetTickCount() + 5000;
		return 0;
	}
	DB_LivingOnboardStep(playerid, step, g_HubOpId[playerid]);
}

Hub_Advance(playerid, step)
{
	if (g_HubOnb[playerid] != 1 || step < 1 || step > 5)
	{
		return 0;
	}
	new cur = Hub_CurStep(playerid);
	if (step < cur)
	{
		return 0;
	}
	if (step > cur || g_HubOpBusy[playerid])
	{
		g_HubAhead[playerid] |= Hub_Bit(step);
		return 0;
	}
	Hub_SendStep(playerid, step, 1);
}

Hub_StepBegin(playerid)
{
	new cur = Hub_CurStep(playerid);
	gPlayer[playerid][pOnboardStep] = g_HubStep[playerid];
	UI_LivingHelpSet(playerid, cur, !Hub_HintsOn(playerid));
	UI_LivingHintHide(playerid);
	if (!Hub_HintsOn(playerid))
	{
		Hub_ClearTarget(playerid);
		return 0;
	}
	if (g_HubHintDue[playerid] == 0)
	{
		g_HubHintDue[playerid] = GetTickCount() + 3000;
	}
	new target = Hub_StepTarget(cur);
	if (target == 0)
	{
		Hub_ClearTarget(playerid);
	}
	else if (target != g_HubTarget[playerid])
	{
		Hub_SetTarget(playerid, target, 0);
	}
}

Hub_Finish(playerid, bool:rewarded)
{
	g_HubOnb[playerid] = 2;
	g_HubAhead[playerid] = 0;
	g_HubHintDue[playerid] = 0;
	Hub_ClearTarget(playerid);
	UI_LivingHelpComplete(playerid, rewarded);
	UI_LivingHelpSet(playerid, 6, !Hub_HintsOn(playerid));
}

Hub_StepMessage(playerid, step, paid)
{
	new msg[256];
	switch (step)
	{
		case 1:
		{
			UI_LivingNotify(playerid, "Sei alla Casa del Quartiere: qui la citta' ti chiama per nome. Bacheca, notizie, una mano quando serve.", 1);
		}
		case 2:
		{
			UI_LivingNotify(playerid, "Ora sai come respira Idlewood. Quello che facciamo, lo cambia per tutti.", 1);
		}
		case 3:
		{
			if (paid > 0)
			{
				format(msg, 256, "Consegna di benvenuto fatta: il negozio ringrazia. La Casa del Quartiere ti ha versato $%d sul conto.", paid);
			}
			else
			{
				format(msg, 256, "Consegna di benvenuto fatta: il negozio ringrazia.");
			}
			UI_LivingNotify(playerid, msg, 1);
		}
		case 4:
		{
			UI_LivingNotify(playerid, "La citta' comincia a conoscerti. Ogni lavoro fatto bene lascia un segno.", 1);
		}
	}
}

Hub_KitTick(playerid, now)
{
	if (g_HubKitLeft[playerid] == 0)
	{
		if (g_HubKitReload[playerid] && now - g_HubKitAt[playerid] >= 0 && gPlayer[playerid][pInvOpBusy] == 0)
		{
			g_HubKitReload[playerid] = 0;
			Inv_Reload(playerid);
		}
		return 0;
	}
	if (now - g_HubKitAt[playerid] < 0)
	{
		return 0;
	}
	g_HubKitAt[playerid] = now + 1500;
	if (!Inv_Ready(playerid) || gPlayer[playerid][pInvOpBusy] != 0)
	{
		if (++g_HubKitTries[playerid] >= 40)
		{
			new msg[256];
			format(msg, 256, "pacco accoglienza non consegnato al personaggio %d (inventario non pronto)", gPlayer[playerid][pCharId]);
			Log_Write("HUB", msg);
			g_HubKitLeft[playerid] = 0;
		}
		return 0;
	}
	for (new i = 0; i < 3; i++)
	{
		if (!(g_HubKitLeft[playerid] & Hub_Bit(i)))
		{
			continue;
		}
		g_HubKitLeft[playerid] &= ~Hub_Bit(i);
		if (s_HubKitQty[i] <= 0)
		{
			continue;
		}
		new opId[33];
		format(opId, 33, "obkit%d-%d", gPlayer[playerid][pCharId], i);
		DB_InvAdd(playerid, gPlayer[playerid][pCharId], s_HubKitItem[i], s_HubKitQty[i], opId, "add", 0);
		break;
	}
	if (g_HubKitLeft[playerid] == 0)
	{
		g_HubKitReload[playerid] = 1;
	}
}

public Living_OnDBOnboard(playerid, result, step, paid, balance, giveKit, exp)
{
	if (!Hub_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	new sent = g_HubOpStep[playerid], now = GetTickCount();
	switch (result)
	{
		case 1:
		{
			g_HubOpBusy[playerid] = 0;
			g_HubOpId[playerid][0] = 0;
			if (sent == 0)
			{
				Hub_Finish(playerid, 0);
				return 1;
			}
			g_HubStep[playerid] = LD_Clamp(step, 0, 5);
			g_HubAhead[playerid] &= ~Hub_Bit(sent);
			if (giveKit != 0)
			{
				g_HubKitLeft[playerid] = 7;
				g_HubKitAt[playerid] = now;
				g_HubKitTries[playerid] = 0;
				if (exp > 0)
				{
					Level_AddExp(playerid, exp);
					Char_Save(playerid);
				}
			}
			if (g_HubStep[playerid] >= 5)
			{
				Hub_Finish(playerid, giveKit != 0);
				return 1;
			}
			Hub_StepMessage(playerid, sent, paid);
			Hub_StepBegin(playerid);
		}
		case 2, 4:
		{
			g_HubOpBusy[playerid] = 0;
			g_HubOpId[playerid][0] = 0;
			new dbStep = LD_Clamp(step, 0, 5);
			if (result == 2 && (sent == 0 || sent > dbStep || dbStep >= 5))
			{
				g_HubStep[playerid] = dbStep;
				g_HubOnb[playerid] = 2;
				g_HubAhead[playerid] = 0;
				Hub_ClearTarget(playerid);
				UI_LivingHelpSet(playerid, 6, !Hub_HintsOn(playerid));
				return 1;
			}
			g_HubStep[playerid] = dbStep;
			Hub_StepBegin(playerid);
		}
		case -1, 10:
		{
			g_HubOpTries[playerid]++;
			g_HubOpRetryAt[playerid] = now + (g_HubOpTries[playerid] < 5 ? 5000 : 30000);
		}
		default:
		{
			g_HubOpBusy[playerid] = 0;
			g_HubOpId[playerid][0] = 0;
			new msg[256];
			format(msg, 256, "onboarding: esito %d per il passo %d del personaggio %d", result, sent, gPlayer[playerid][pCharId]);
			Log_Write("HUB", msg);
		}
	}
	return 1;
}

Hub_HintsOff(playerid)
{
	switch (g_HubOnb[playerid])
	{
		case 0:
		{
			Util_Send(playerid, -10270721, "Sto ancora recuperando il tuo percorso: riprova tra un attimo.");
		}
		case 2:
		{
			if (Hub_HintsOn(playerid))
			{
				DB_LivingOnboardHints(playerid, 1);
			}
			gPlayer[playerid][pHintsOff] = 1;
			UI_LivingHintHide(playerid);
			Util_Send(playerid, 0x99CCFFFF, "Suggerimenti spenti. La Casa del Quartiere di Idlewood resta aperta, se ti serve.");
		}
		default:
		{
			if (g_HubOpBusy[playerid])
			{
				Util_Send(playerid, -10270721, "Un attimo: sto registrando il tuo ultimo passo. Riprova tra poco.");
				return 0;
			}
			gPlayer[playerid][pHintsOff] = 1;
			g_HubHintDue[playerid] = 0;
			UI_LivingHintHide(playerid);
			Hub_ClearTarget(playerid);
			Hub_SendStep(playerid, 0, 1);
		}
	}
}

Hub_StartWelcome(playerid)
{
	if (g_HubOnb[playerid] != 1 || Hub_CurStep(playerid) != 3)
	{
		if (g_HubOnb[playerid] == 1 && Hub_CurStep(playerid) < 3)
		{
			Util_Send(playerid, 0x99CCFFFF, "La consegna di benvenuto arriva tra poco: prima finisci il passo in corso (/aiuto).");
		}
		else
		{
			Util_Send(playerid, 0x99CCFFFF, "La consegna di benvenuto e' per il primo giorno. Per altri incarichi c'e' la bacheca: /contratti.");
		}
		return 0;
	}
	if (gPlayer[playerid][pFreightWelcome] != 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "La consegna di benvenuto e' gia' in corso: il magazzino di Idlewood ti aspetta.");
		return 0;
	}
	if (Hub_NearBoard(playerid) == -1)
	{
		Util_Send(playerid, 0x99CCFFFF, "La consegna si prende a una bacheca: ti ho segnato la Casa del Quartiere di Idlewood sulla mappa.");
		Hub_SetTarget(playerid, 1, 1);
		return 0;
	}
	new block = LD_CheckStart(playerid);
	if (block != 0)
	{
		LD_SendBlock(playerid, block);
		return 0;
	}
	Hub_ClearTarget(playerid);
	if (!Freight_Begin(playerid, 0, 1, 1, 1, 0, 1))
	{
		Util_Send(playerid, -10270721, "Il furgone della consegna di benvenuto non e' disponibile proprio ora: riprova tra poco.");
		return 0;
	}
	Util_Send(playerid, 0x99CCFFFF, "Un carico di merci dal magazzino al negozio di Idlewood: strada breve, nessuna fretta. Il quartiere ti ringrazia gia'.");
}

Hub_OnWelcomeDelivered(playerid, bool:success)
{
	if (!Hub_Valid(playerid) || !IsPlayerConnected(playerid) || g_HubOnb[playerid] != 1)
	{
		return 0;
	}
	if (success)
	{
		Hub_Advance(playerid, 3);
		return 1;
	}
	Util_Send(playerid, 0x99CCFFFF, "Pazienza, capita a tutti. La consegna di benvenuto resta li': quando vuoi, /aiuto consegna a una bacheca.");
	Hub_StepBegin(playerid);
	return 1;
}

Hub_ShowServices(playerid)
{
	new msg[256];
	Util_Send(playerid, 0x99CCFFFF, "Casa del Quartiere di Idlewood - cosa trovi qui (e alle bacheche di Ganton e Jefferson):");
	Util_Send(playerid, -1, " /contratti - la bacheca: si consulta ovunque, si accetta qui o a una bacheca di quartiere");
	Util_Send(playerid, -1, " /quartiere [nome] - come sta il quartiere e cosa si dice in strada");
	format(msg, 256, " /contribuisci [importo] [quartiere] - il progetto della comunita': da $%d a $%d, max $%d al giorno, dal conto", 50, 500, 1000);
	Util_Send(playerid, -1, msg);
	Util_Send(playerid, -1, " /documento richiedi - lo sportello documenti");
	Util_Send(playerid, -1, " /aiuto lavoro - la strada per il Job Center di Pershing Square  |  /aiuto noleggio - il noleggio mezzi");
}

Hub_CmdAiuto(playerid, params[])
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	new pos = 0, sub[24];
	Util_NextToken(params, pos, sub, 24);
	if (sub[0] == 0)
	{
		if (g_HubOnb[playerid] == 0)
		{
			Util_Send(playerid, 0x99CCFFFF, "Sto recuperando il tuo percorso: riprova tra un attimo. Intanto: /aiuto servizi.");
			return 1;
		}
		UI_LivingHelpSet(playerid, g_HubOnb[playerid] == 2 ? 6 : Hub_CurStep(playerid), !Hub_HintsOn(playerid));
		UI_LivingHelpShow(playerid);
		return 1;
	}
	if (!strcmp(sub, "off", 1, 0x7FFFFFFF))
	{
		Hub_HintsOff(playerid);
		return 1;
	}
	if (!strcmp(sub, "servizi", 1, 0x7FFFFFFF) || !strcmp(sub, "hub", 1, 0x7FFFFFFF))
	{
		Hub_ShowServices(playerid);
		return 1;
	}
	if (!strcmp(sub, "consegna", 1, 0x7FFFFFFF))
	{
		Hub_StartWelcome(playerid);
		return 1;
	}
	if (!strcmp(sub, "mappa", 1, 0x7FFFFFFF))
	{
		if (g_HubOnb[playerid] == 1)
		{
			UI_OnHelpWaypoint(playerid, Hub_CurStep(playerid));
		}
		else
		{
			Util_Send(playerid, 0x99CCFFFF, "Nessun passo da segnare. Per la Casa del Quartiere: /aiuto casa.");
		}
		return 1;
	}
	if (!strcmp(sub, "casa", 1, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 1, 1);
		Util_Send(playerid, 0x99CCFFFF, "Ti ho segnato la Casa del Quartiere di Idlewood sulla mappa.");
		return 1;
	}
	if (!strcmp(sub, "lavoro", 1, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 2, 1);
		Util_Send(playerid, 0x99CCFFFF, "Il Job Center e' a Pershing Square, vicino al municipio: te l'ho segnato sulla mappa. Li', /lavoro prendi.");
		return 1;
	}
	if (!strcmp(sub, "noleggio", 1, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 3, 1);
		Util_Send(playerid, 0x99CCFFFF, "Il noleggio mezzi e' a Pershing Square: te l'ho segnato sulla mappa. Li', /noleggio.");
		return 1;
	}
	Util_Send(playerid, 0x99CCFFFF, "Uso: /aiuto [servizi|mappa|consegna|casa|lavoro|noleggio|off]");
	return 1;
}

public UI_OnHelpWaypoint(playerid, step)
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	if (g_HubOnb[playerid] != 1 || step != Hub_CurStep(playerid))
	{
		Util_Send(playerid, 0x99CCFFFF, "Questo passo non e' quello in corso: /aiuto per vedere a che punto sei.");
		return 1;
	}
	switch (step)
	{
		case 1:
		{
			Hub_SetTarget(playerid, 1, 1);
			Util_Send(playerid, 0x99CCFFFF, "Segui il segnale: la Casa del Quartiere e' a due passi da Unity Station.");
		}
		case 3:
		{
			if (Hub_NearBoard(playerid) != -1)
			{
				Util_Send(playerid, 0x99CCFFFF, "Sei gia' a una bacheca: /aiuto consegna e si parte.");
			}
			else
			{
				Hub_SetTarget(playerid, 1, 1);
				Util_Send(playerid, 0x99CCFFFF, "Ti ho segnato la Casa del Quartiere: li', /aiuto consegna.");
			}
		}
		case 5:
		{
			Hub_SetTarget(playerid, 2, 1);
			Util_Send(playerid, 0x99CCFFFF, "Ti ho segnato il Job Center di Pershing Square. Puoi anche solo scrivere /lavoro o /noleggio da qui.");
		}
		default:
		{
			Util_Send(playerid, 0x99CCFFFF, "Non serve andare lontano: il comando funziona ovunque tu sia (/aiuto per i dettagli).");
		}
	}
	return 1;
}

public UI_OnHelpHintsOff(playerid)
{
	if (Hub_PlayerOk(playerid))
	{
		Hub_HintsOff(playerid);
	}
	return 1;
}

Hub_DayLeft(playerid)
{
	new day = gettime() / 86400;
	if (g_HubDonDay[playerid] != day)
	{
		g_HubDonDay[playerid] = day;
		g_HubDonToday[playerid] = 0;
	}
	new left = 1000 - g_HubDonToday[playerid];
	return left > 0 ? left : 0;
}

Hub_ProjectFund(districtId)
{
	new prj = DB_LivingDistrictGet(districtId, 6), fund = DB_LivingDistrictGet(districtId, 8);
	if (prj > 0 && g_HubFundPrj[districtId] == prj && g_HubFund[districtId] > fund)
	{
		fund = g_HubFund[districtId];
	}
	return fund;
}

bool:Hub_ProjectOpen(districtId)
{
	return DB_LivingDistrictGet(districtId, 6) > 0 && DB_LivingDistrictGet(districtId, 9) > gettime();
}

Hub_ProjectBlock(playerid, districtId)
{
	if (!Hub_ProjectOpen(districtId))
	{
		return 3;
	}
	if (Hub_NearBoard(playerid) == -1)
	{
		return 4;
	}
	if (gPlayer[playerid][pPlayedMs] / 60000 < 60)
	{
		return 1;
	}
	if (Hub_DayLeft(playerid) < 50)
	{
		return 2;
	}
	return 0;
}

Hub_ProjectFill(playerid, districtId)
{
	new name[65], prj = DB_LivingDistrictGet(districtId, 6), hours = 0;
	DB_LivingProjectName(districtId, name, 65);
	new left = DB_LivingDistrictGet(districtId, 9) - gettime();
	if (left > 0)
	{
		hours = (left + 3600 - 1) / 3600;
	}
	UI_LivingProjectSet(playerid, Hub_ProjectOpen(districtId) ? prj : 0, districtId, name, DB_LivingDistrictGet(districtId, 7), Hub_ProjectFund(districtId), hours, 50, 500, Hub_DayLeft(playerid), Hub_ProjectBlock(playerid, districtId));
}

Hub_DistrictOfProject(projectId)
{
	if (projectId <= 0)
	{
		return 0;
	}
	for (new d = 1; d <= 3; d++)
	{
		if (DB_LivingDistrictGet(d, 6) == projectId)
		{
			return d;
		}
	}
	return 0;
}

Hub_CmdContribuisci(playerid, params[])
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	new pos = 0, tok[24], amount = 0, districtId = 0;
	Util_NextToken(params, pos, tok, 24);
	if (tok[0] != 0)
	{
		if (Util_ParseInt(tok, amount))
		{
			if (amount <= 0)
			{
				Util_Send(playerid, -10270721, "Importo non valido: scrivi un numero intero positivo (es. /contribuisci 100).");
				return 1;
			}
			Util_NextToken(params, pos, tok, 24);
			if (tok[0] != 0)
			{
				districtId = LD_ParseDistrict(tok);
			}
		}
		else
		{
			districtId = LD_ParseDistrict(tok);
		}
		if (tok[0] != 0 && districtId == 0)
		{
			Util_Send(playerid, -10270721, "Quartiere sconosciuto: Idlewood, Ganton o Jefferson.");
			return 1;
		}
	}
	if (districtId == 0)
	{
		new b = Hub_NearBoard(playerid);
		districtId = b != -1 ? s_HubBoardDistrict[b] : 1;
	}
	Hub_ProjectFill(playerid, districtId);
	if (amount <= 0 || Hub_ProjectBlock(playerid, districtId) != 0)
	{
		UI_LivingProjectShow(playerid);
	}
	else
	{
		UI_LivingProjectContribute(playerid, amount);
	}
	return 1;
}

public UI_OnProjectOpen(playerid, districtId)
{
	if (!Hub_PlayerOk(playerid) || districtId < 1 || districtId > 3)
	{
		return 1;
	}
	Hub_ProjectFill(playerid, districtId);
	UI_LivingProjectShow(playerid);
	return 1;
}

public UI_OnProjectContribute(playerid, projectId, amount)
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	if (!LD_IsReady())
	{
		LD_SendBlock(playerid, 1);
		return 1;
	}
	new districtId = Hub_DistrictOfProject(projectId);
	if (districtId == 0 || !Hub_ProjectOpen(districtId))
	{
		UI_LivingReject(playerid, "Questo progetto non raccoglie piu' fondi: ne partira' presto un altro.");
		return 1;
	}
	new msg[256];
	switch (Hub_ProjectBlock(playerid, districtId))
	{
		case 4:
		{
			UI_LivingReject(playerid, "Le donazioni si fanno alla Casa del Quartiere di Idlewood o a una bacheca di quartiere.");
			return 1;
		}
		case 1:
		{
			format(msg, 256, "Potrai donare dopo almeno %d minuti trascorsi in citta'. Intanto, grazie del pensiero.", 60);
			UI_LivingReject(playerid, msg);
			return 1;
		}
		case 2:
		{
			UI_LivingReject(playerid, "Per oggi hai gia' dato il massimo: grazie davvero.");
			return 1;
		}
	}
	if (!LD_DonationValid(amount, g_HubDonToday[playerid]))
	{
		format(msg, 256, "Importo non valido: da $%d a $%d, al massimo $%d al giorno.", 50, 500, 1000);
		UI_LivingReject(playerid, msg);
		return 1;
	}
	if (gPlayer[playerid][pDonationPending] != 0 || DB_LivingBusy(playerid, 3))
	{
		UI_LivingReject(playerid, "Un attimo: la tua donazione precedente e' ancora in registrazione.");
		return 1;
	}
	if (gPlayer[playerid][pBank] < amount)
	{
		UI_LivingReject(playerid, "Le donazioni partono dal conto in banca e li' non c'e' abbastanza. Nessun problema: ogni contratto aiuta il fondo.");
		return 1;
	}
	if (g_HubPrjOpId[playerid][0] == 0 || g_HubPrjOpProject[playerid] != projectId || g_HubPrjOpAmount[playerid] != amount)
	{
		DB_LivingMakeOpId(g_HubPrjOpId[playerid], 37, "pj", projectId, gPlayer[playerid][pCharId]);
		g_HubPrjOpProject[playerid] = projectId;
		g_HubPrjOpAmount[playerid] = amount;
	}
	gPlayer[playerid][pDonationPending] = 9;
	g_HubPrjDistrict[playerid] = districtId;
	DB_LivingProjectContrib(playerid, projectId, amount, g_HubPrjOpId[playerid]);
	return 1;
}

public Living_OnDBProject(playerid, result, projectId, donated, balance, points, fund, projectState)
{
	if (!Hub_Valid(playerid) || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	gPlayer[playerid][pDonationPending] = 0;
	new msg[256], name[65], dname[16], d = g_HubPrjDistrict[playerid];
	if (d < 1 || d > 3)
	{
		d = Hub_DistrictOfProject(projectId);
	}
	if (result != -1)
	{
		g_HubPrjOpId[playerid][0] = 0;
		g_HubPrjOpProject[playerid] = 0;
		g_HubPrjOpAmount[playerid] = 0;
	}
	switch (result)
	{
		case 1:
		{
			Hub_DayLeft(playerid);
			g_HubDonToday[playerid] += donated;
			DB_LivingProjectName(d, name, 65);
			LD_DistrictName(d, dname, 16);
			if (d >= 1 && d <= 3)
			{
				g_HubFundPrj[d] = projectId;
				g_HubFund[d] = fund;
			}
			format(msg, 256, "Grazie! Hai donato $%d per \"%s\": raccolti $%d su $%d.", donated, name, fund, DB_LivingDistrictGet(d, 7));
			UI_LivingNotify(playerid, msg, 1);
			if (points > 0)
			{
				format(msg, 256, "%s se ne ricordera': reputazione locale +%d.", dname, points);
				Util_Send(playerid, 0x66DD66FF, msg);
			}
			if (projectState == 2)
			{
				Util_Send(playerid, 0x66DD66FF, "E' stata la tua donazione a completare il progetto. Il quartiere fa festa!");
				Hub_RequestRefresh(1);
			}
			format(msg, 256, "personaggio %d dona %d al progetto %d (fondo %d, stato %d)", gPlayer[playerid][pCharId], donated, projectId, fund, projectState);
			Log_Write("HUB", msg);
		}
		case 2:
		{
			UI_LivingReject(playerid, "Questa donazione risulta gia' registrata.");
		}
		case 3:
		{
			UI_LivingReject(playerid, "Le donazioni partono dal conto in banca e li' non c'e' abbastanza.");
		}
		case 4, 5:
		{
			UI_LivingReject(playerid, "Questo progetto non raccoglie piu' fondi: ne partira' presto un altro.");
			Hub_RequestRefresh(1);
		}
		case 7:
		{
			format(msg, 256, "Per ora non si puo': servono almeno %d minuti in citta' e al massimo $%d donati al giorno.", 60, 1000);
			UI_LivingReject(playerid, msg);
		}
		case 9:
		{
			format(msg, 256, "Importo non valido: da $%d a $%d.", 50, 500);
			UI_LivingReject(playerid, msg);
		}
		case 10:
		{
			UI_LivingReject(playerid, "Un attimo: c'e' gia' una donazione in registrazione.");
		}
		default:
		{
			UI_LivingReject(playerid, "Il registro della Casa del Quartiere non ha risposto. Riprova con lo stesso importo: non verra' addebitato due volte.");
		}
	}
	return 1;
}

Hub_RequestRefresh(bool:force)
{
	if (!DB_IsReady())
	{
		return 0;
	}
	new now = GetTickCount();
	if (!force && g_HubRefreshed && now - g_HubLastRefresh < 60000)
	{
		return 0;
	}
	g_HubRefreshed = 1;
	g_HubLastRefresh = now;
	DB_LivingLoadDistricts();
}

Hub_Broadcast(color, text[])
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i))
		{
			Util_Send(i, color, text);
		}
	}
}

Hub_CheckFestivals()
{
	new msg[256], dname[16], opId[37];
	for (new d = 1; d <= 3; d++)
	{
		if (DB_LivingDistrictGet(d, 0) == 0)
		{
			continue;
		}
		new fest = DB_LivingDistrictGet(d, 4), prj = DB_LivingDistrictGet(d, 6);
		if (!g_HubFestInit[d])
		{
			g_HubFestInit[d] = 1;
			g_HubFestSeen[d] = fest;
			g_HubPrjSeen[d] = prj;
			g_HubGoalSeen[d] = DB_LivingDistrictGet(d, 7);
			DB_LivingProjectName(d, g_HubPrjNameSeen[d], 65);
			continue;
		}
		if (fest == g_HubFestSeen[d] && prj == g_HubPrjSeen[d])
		{
			continue;
		}
		LD_DistrictName(d, dname, 16);
		if (fest > g_HubFestSeen[d] && g_HubPrjSeen[d] > 0)
		{
			format(msg, 256, "%s ce l'ha fatta: \"%s\" e' completato grazie a chi ci lavora e a chi ha donato. Festa di quartiere per %d ore!", dname, g_HubPrjNameSeen[d], 72);
			Hub_Broadcast(0x66DD66FF, msg);
			format(opId, 37, "pj%d-done", g_HubPrjSeen[d]);
			LD_Emit(8, d, 0, g_HubGoalSeen[d], opId);
		}
		else if (prj > 0 && prj != g_HubPrjSeen[d])
		{
			new name[65];
			DB_LivingProjectName(d, name, 65);
			format(msg, 256, "A %s parte un nuovo progetto della comunita': \"%s\". Ogni contratto da e per il quartiere lo aiuta.", dname, name);
			Hub_Broadcast(0x99CCFFFF, msg);
		}
		g_HubFestSeen[d] = fest;
		g_HubPrjSeen[d] = prj;
		g_HubGoalSeen[d] = DB_LivingDistrictGet(d, 7);
		DB_LivingProjectName(d, g_HubPrjNameSeen[d], 65);
	}
}

public Hub_OnDistrictEvent(type, districtId, charId, value, opId[])
{
	switch (type)
	{
		case 106:
		{
			if (value != 2 && value != 4 && value != 5)
			{
				return 1;
			}
			new playerid = Hub_PlayerByChar(charId);
			if (playerid != INVALID_PLAYER_ID)
			{
				Hub_Advance(playerid, value);
			}
		}
		case 108:
		{
			new playerid = Hub_PlayerByChar(charId);
			if (playerid != INVALID_PLAYER_ID)
			{
				Hub_TryLoad(playerid);
			}
		}
		case 105:
		{
			Hub_CheckFestivals();
		}
	}
	return 1;
}

Hub_GreetBoard(playerid, board)
{
	if (g_HubGreeted[playerid] & Hub_Bit(board))
	{
		return 0;
	}
	g_HubGreeted[playerid] |= Hub_Bit(board);
	if (board == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Casa del Quartiere di Idlewood: bacheca (/contratti), progetto del quartiere (/contribuisci), notizie (/quartiere).");
		Util_Send(playerid, 0x99CCFFFF, "Qui si ricomincia, si da' una mano, ci si conosce. Tutti i servizi: /aiuto servizi.");
		return 0;
	}
	new msg[256], dname[16];
	LD_DistrictName(s_HubBoardDistrict[board], dname, 16);
	format(msg, 256, "Bacheca di quartiere di %s: qui accetti i contratti (/contratti) e sostieni il progetto della zona (/contribuisci).", dname);
	Util_Send(playerid, 0x99CCFFFF, msg);
}

Hub_PlayerTick(playerid, now)
{
	if (g_HubOnb[playerid] == 0)
	{
		Hub_TryLoad(playerid);
	}
	new board = Hub_NearBoard(playerid);
	if (board + 1 != g_HubAtBoard[playerid])
	{
		g_HubAtBoard[playerid] = board + 1;
		if (board != -1)
		{
			Hub_GreetBoard(playerid, board);
			if (g_HubOnb[playerid] == 1 && Hub_CurStep(playerid) == 3 && gPlayer[playerid][pFreightWelcome] == 0)
			{
				Util_Send(playerid, 0x99CCFFFF, "C'e' una consegna di benvenuto che ti aspetta: /aiuto consegna.");
			}
		}
	}
	if (g_HubTarget[playerid] != 0)
	{
		if (g_HubCpOn[playerid] && LD_ActiveFlow(playerid) != 0)
		{
			g_HubCpOn[playerid] = 0;
		}
		new Float:x, Float:y, Float:z;
		if (Hub_TargetPos(g_HubTarget[playerid], x, y, z) && IsPlayerInRangeOfPoint(playerid, 6.0, x, y, z))
		{
			new target = g_HubTarget[playerid];
			Hub_ClearTarget(playerid);
			if (target == 2)
			{
				Util_Send(playerid, 0x99CCFFFF, "Eccoti al Job Center: /lavoro per vedere cosa offre la citta'.");
			}
			else if (target == 3)
			{
				Util_Send(playerid, 0x99CCFFFF, "Eccoti al noleggio: /noleggio per scegliere un mezzo.");
			}
		}
	}
	if (g_HubOnb[playerid] == 1)
	{
		new cur = Hub_CurStep(playerid);
		if (g_HubOpBusy[playerid])
		{
			if (g_HubOpRetryAt[playerid] != 0 && now - g_HubOpRetryAt[playerid] >= 0)
			{
				Hub_SendStep(playerid, g_HubOpStep[playerid], 0);
			}
		}
		else if (cur == 1 && board == 0)
		{
			Hub_Advance(playerid, 1);
		}
		else if (g_HubAhead[playerid] & Hub_Bit(cur))
		{
			Hub_Advance(playerid, cur);
		}
		if (Hub_HintsOn(playerid) && g_HubHintDue[playerid] != 0 && now - g_HubHintDue[playerid] >= 0 && !g_HubOpBusy[playerid])
		{
			new last = gPlayer[playerid][pLastHintTick];
			if (g_HubHintShown[playerid] & Hub_Bit(cur))
			{
				g_HubHintDue[playerid] = 0;
			}
			else if (last == 0 || now - last >= 90000)
			{
				UI_LivingHint(playerid, cur);
				gPlayer[playerid][pLastHintTick] = now != 0 ? now : 1;
				g_HubHintShown[playerid] |= Hub_Bit(cur);
				g_HubHintDue[playerid] = 0;
			}
		}
	}
	Hub_KitTick(playerid, now);
}

public Hub_OnTick()
{
	if (!LD_IsReady())
	{
		return 1;
	}
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!Util_IsPlaying(i) || gPlayer[i][pLivingReady] == 0 || gPlayer[i][pCharId] <= 0)
		{
			continue;
		}
		Hub_PlayerTick(i, now);
	}
	if (++g_HubTickCount >= 5)
	{
		g_HubTickCount = 0;
		Hub_CheckFestivals();
	}
	return 1;
}

