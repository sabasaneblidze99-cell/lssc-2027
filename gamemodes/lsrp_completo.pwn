bool:Inv_ValidPlayer(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS && IsPlayerConnected(playerid);
}

Inv_Count(playerid, itemId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || itemId < 1 || itemId >= 11)
	{
		return 0;
	}
	new total = 0;
	for (new s = 0; s < 20; s++)
	{
		if (gPlayer[playerid][pInvItem][s] == itemId)
		{
			total += gPlayer[playerid][pInvQty][s];
		}
	}
	return total;
}

Inv_Capacity(playerid)
{
	return DB_InvCapacity(gPlayer[playerid][pInvHasBag] != 0);
}

bool:Inv_Ready(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS && gPlayer[playerid][pInvState] == 2;
}

Inv_ParseItem(const token[])
{
	new value = 0;
	if (token[0] == 0)
	{
		return 0;
	}
	if (Util_ParseInt(token, value))
	{
		return value >= 1 && value <= 10 ? value : 0;
	}
	for (new i = 0; i < 16; i++)
	{
		if (!strcmp(token, s_InvAliasName[i], true, 0x7FFFFFFF))
		{
			return s_InvAliasId[i];
		}
	}
	return 0;
}

Inv_Say(playerid, color, const text[])
{
	Util_Send(playerid, color, text);
}

Inv_PushUi(playerid)
{
	new cap = Inv_Capacity(playerid);
	UI_InvClear(playerid);
	for (new s = 0; s < cap && s < 20; s++)
	{
		UI_InvSet(playerid, s, gPlayer[playerid][pInvItem][s], gPlayer[playerid][pInvQty][s]);
	}
	UI_InvMeta(playerid, gPlayer[playerid][pInvCount], cap, gPlayer[playerid][pInvHasBag] != 0);
}

Inv_ClearCache(playerid)
{
	for (new s = 0; s < 20; s++)
	{
		gPlayer[playerid][pInvItem][s] = 0;
		gPlayer[playerid][pInvQty][s] = 0;
	}
	gPlayer[playerid][pInvCount] = 0;
}

Inv_Load(playerid)
{
	if (!Inv_ValidPlayer(playerid) || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	if (gPlayer[playerid][pInvState] == 1)
	{
		return 0;
	}
	gPlayer[playerid][pInvState] = 1;
	DB_InvLoad(playerid, gPlayer[playerid][pCharId]);
	return 0;
}

Inv_Reload(playerid)
{
	if (!Inv_ValidPlayer(playerid))
	{
		return 0;
	}
	if (gPlayer[playerid][pInvState] == 1)
	{
		gPlayer[playerid][pInvReloadQueued] = 1;
		return 0;
	}
	Inv_Load(playerid);
	return 0;
}

public Inv_OnDBLoaded(playerid, count)
{
	if (!Inv_ValidPlayer(playerid))
	{
		return 1;
	}
	if (count == -1 || count < 0)
	{
		gPlayer[playerid][pInvState] = 3;
		gPlayer[playerid][pInvReloadQueued] = 0;
		if (gPlayer[playerid][pFridgeHouse] > 0)
		{
			House_InvFridgeResult(playerid, gPlayer[playerid][pFridgeHouse], gPlayer[playerid][pFridgeDir], 0, -1);
			Log_Write("INV", "esito frigo incerto non riconciliato (reload fallito): verificare house_utilities.fridge_units");
			gPlayer[playerid][pFridgeHouse] = 0;
		}
		if (gPlayer[playerid][pSpawned])
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90; (\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;): \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; /inventario-\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		}
		return 1;
	}
	Inv_ClearCache(playerid);
	gPlayer[playerid][pInvHasBag] = g_InvBag[playerid] != 0 ? 1 : 0;
	new cap = Inv_Capacity(playerid);
	for (new r = 0; r < count && r < 20; r++)
	{
		new slot = g_InvRows[playerid][r][irSlot], item = g_InvRows[playerid][r][irItem], qty = g_InvRows[playerid][r][irQty];
		if (slot < 0 || slot >= cap || !DB_InvItemOk(item) || qty < 1 || qty > DB_InvStackMax(item) || gPlayer[playerid][pInvItem][slot] != 0)
		{
			Log_Write("INV", "riga inventario anomala scartata dalla cache");
			continue;
		}
		gPlayer[playerid][pInvItem][slot] = item;
		gPlayer[playerid][pInvQty][slot] = qty;
		gPlayer[playerid][pInvCount]++;
	}
	gPlayer[playerid][pInvState] = 2;
	if (gPlayer[playerid][pFridgeHouse] > 0)
	{
		new before = gPlayer[playerid][pFridgeFoodBefore], after = Inv_Count(playerid, 1);
		new moved = gPlayer[playerid][pFridgeDir] == 1 ? before - after : after - before;
		new house = gPlayer[playerid][pFridgeHouse], dir = gPlayer[playerid][pFridgeDir];
		gPlayer[playerid][pFridgeHouse] = 0;
		if (moved > 0)
		{
			House_InvFridgeResult(playerid, house, dir, moved, 1);
		}
		else
		{
			House_InvFridgeResult(playerid, house, dir, 0, 0);
		}
	}
	if (gPlayer[playerid][pInvReloadQueued])
	{
		gPlayer[playerid][pInvReloadQueued] = 0;
		Inv_Load(playerid);
		return 1;
	}
	if (count == 0 && Inv_Count(playerid, 10) == 0 && !gPlayer[playerid][pInvOpBusy])
	{
		Inv_StartDoc(playerid, true);
	}
	Inv_PushUi(playerid);
	return 1;
}

Inv_BeginOp(playerid, op, itemId, qty, aux)
{
	gPlayer[playerid][pInvOpBusy] = 1;
	gPlayer[playerid][pInvOp] = op;
	gPlayer[playerid][pInvOpItem] = itemId;
	gPlayer[playerid][pInvOpQty] = qty;
	gPlayer[playerid][pInvOpAux] = aux;
	gPlayer[playerid][pInvOpPeer] = 0;
	DB_InvMakeOpId(gPlayer[playerid][pInvOpId], 33, gPlayer[playerid][pCharId]);
}

Inv_EndOp(playerid)
{
	gPlayer[playerid][pInvOpBusy] = 0;
	gPlayer[playerid][pInvOp] = 0;
	gPlayer[playerid][pInvOpItem] = 0;
	gPlayer[playerid][pInvOpQty] = 0;
	gPlayer[playerid][pInvOpAux] = 0;
	gPlayer[playerid][pInvOpPeer] = 0;
}

bool:Inv_OpIs(playerid, op)
{
	return Inv_ValidPlayer(playerid) && gPlayer[playerid][pInvOpBusy] != 0 && gPlayer[playerid][pInvOp] == op;
}

bool:Inv_StateOk(playerid)
{
	if (!Util_IsPlaying(playerid))
	{
		return false;
	}
	return gPlayer[playerid][pInvState] == 2 && !gPlayer[playerid][pInvOpBusy] && !gPlayer[playerid][pWounded] && !gPlayer[playerid][pCuffed];
}

bool:Inv_Guard(playerid)
{
	if (!Util_IsPlaying(playerid))
	{
		return false;
	}
	switch (gPlayer[playerid][pInvState])
	{
		case 2:
		{
		}
		case 1:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
			return false;
		}
		default:
		{
			Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x95;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA1;, \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
			Inv_Load(playerid);
			return false;
		}
	}
	if (gPlayer[playerid][pInvOpBusy])
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return false;
	}
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed])
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x91;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA1; \xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return false;
	}
	new now = GetTickCount();
	if (gPlayer[playerid][pInvLastActionTick] != 0 && now - gPlayer[playerid][pInvLastActionTick] < 1500)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return false;
	}
	gPlayer[playerid][pInvLastActionTick] = now != 0 ? now : 1;
	return true;
}

Inv_CmdInventario(playerid)
{
	if (gPlayer[playerid][pInvState] == 1)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return 0;
	}
	if (gPlayer[playerid][pInvState] != 2)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x95;\xE1;\x83;\xAA;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA1;, \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		Inv_Load(playerid);
		return 0;
	}
	Inv_PushUi(playerid);
	UI_InvShow(playerid);
	return 0;
}

Inv_CdLeftSec(playerid, itemId)
{
	new until = gPlayer[playerid][pInvItemCdUntil][itemId];
	if (until == 0)
	{
		return 0;
	}
	new left = until - GetTickCount();
	if (left <= 0)
	{
		return 0;
	}
	return (left + 1000 - 1) / 1000;
}

Inv_UseStart(playerid, itemId)
{
	if (!Inv_Guard(playerid))
	{
		return 0;
	}
	if (itemId < 1 || itemId > 10)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\xA3;\xE1;\x83;\xAA;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x97;\xE1;\x83;\x98;.");
		return 0;
	}
	if (Inv_Count(playerid, itemId) < 1)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;: %s.", s_InvName[itemId]);
		return 0;
	}
	switch (itemId)
	{
		case 1:
