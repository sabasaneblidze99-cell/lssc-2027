new Float:g_FrtLastX[MAX_PLAYERS];
new Float:g_FrtLastY[MAX_PLAYERS];
new Float:g_FrtLastZ[MAX_PLAYERS];
new g_FrtLastTick[MAX_PLAYERS];
new g_FrtRetryTick[MAX_PLAYERS];
new g_FrtStateRetry[MAX_PLAYERS];
new g_FrtNoteTick[MAX_PLAYERS];

bool:Freight_ValidId(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

Freight_ResetPlayer(playerid)
{
	g_FrtActive[playerid] = false;
	g_FrtWelcome[playerid] = false;
	g_FrtCt[playerid] = 0;
	g_FrtFrom[playerid] = 0;
	g_FrtTo[playerid] = 0;
	g_FrtCargo[playerid] = 0;
	g_FrtDist[playerid] = 0;
	g_FrtPhase[playerid] = 0;
	g_FrtVeh[playerid] = 65535;
	g_FrtSerial[playerid] = 0;
	g_FrtBoarded[playerid] = false;
	g_FrtDwell[playerid] = false;
	g_FrtOff[playerid] = false;
	g_FrtStartTick[playerid] = 0;
	g_FrtWaitTick[playerid] = 0;
	g_FrtDefer[playerid] = 0;
	g_FrtInteg[playerid] = 100;
	g_FrtPath[playerid] = 0.0;
	g_FrtLastX[playerid] = 0.0;
	g_FrtLastY[playerid] = 0.0;
	g_FrtLastZ[playerid] = 0.0;
	g_FrtLastTick[playerid] = 0;
	g_FrtRetryTick[playerid] = 0;
	g_FrtStateRetry[playerid] = 0;
	g_FrtNoteTick[playerid] = 0;
}

bool:Freight_Point(d, bool:shop, &Float:x, &Float:y, &Float:z)
{
	switch (d)
	{
		case 1:
		{
			if (shop)
			{
				x = 1927.0;
				y = -1790.0;
				z = 13.5;
			}
			else
			{
				x = 1880.0;
				y = -1780.0;
				z = 13.5;
			}
		}
		case 2:
		{
			if (shop)
			{
				x = 2490.0;
				y = -1690.0;
				z = 13.5;
			}
			else
			{
				x = 2400.0;
				y = -1740.0;
				z = 13.5;
			}
		}
		case 3:
		{
			if (shop)
			{
				x = 2190.0;
				y = -1155.0;
				z = 24.0;
			}
			else
			{
				x = 2145.0;
				y = -1215.0;
				z = 24.0;
			}
		}
		default:
		{
			x = 0.0;
			y = 0.0;
			z = 0.0;
			return false;
		}
	}
	return true;
}

Freight_PairDistance(fromD, toD)
{
	new Float:ax, Float:ay, Float:az, Float:bx, Float:by, Float:bz;
	if (!Freight_Point(fromD, false, ax, ay, az) || !Freight_Point(toD, true, bx, by, bz))
	{
		return 0;
	}
	new Float:dx = (bx - ax), Float:dy = (by - ay);
	return floatround(floatsqroot(((dx * dx) + (dy * dy))), floatround_method:1);
}

Freight_CargoName(cargo, dest[], size)
{
	switch (cargo)
	{
		case 2:
		{
			strcopy(dest, "\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;", size);
		}
		case 3:
		{
			strcopy(dest, "materiali", size);
		}
		default:
		{
			strcopy(dest, "\xE1;\x83;\xA1;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98;", size);
		}
	}
}

Freight_SecCeil(ms)
{
	if (ms <= 0)
	{
		return 0;
	}
	return (ms + 1000 - 1) / 1000;
}

Freight_Note(playerid, const text[])
{
	new now = GetTickCount();
	if (g_FrtNoteTick[playerid] != 0 && now - g_FrtNoteTick[playerid] < 4000)
	{
		return 0;
	}
	g_FrtNoteTick[playerid] = now;
	Util_Send(playerid, -10270721, text);
	return 0;
}

Freight_IntegrityOf(vehicleid)
{
	new Float:hp;
	GetVehicleHealth(vehicleid, hp);
	return LD_Clamp(floatround((hp / 10.0), floatround_method:1), 0, 100);
}

bool:Freight_VehOk(playerid)
{
	new veh = g_FrtVeh[playerid];
	if (veh == 65535 || veh <= 0 || veh >= 2000 || !IsValidVehicle(veh))
	{
		return false;
	}
	return LD_VehModule(veh) == 3 && LD_VehOwner(veh) == playerid && LD_VehSerial(veh) == g_FrtSerial[playerid];
}

bool:Freight_IsDriving(playerid)
{
	return Freight_VehOk(playerid) && GetPlayerVehicleID(playerid) == g_FrtVeh[playerid] && GetPlayerState(playerid) == PLAYER_STATE_DRIVER;
}

Freight_RemoveVehicle(playerid)
{
	new veh = g_FrtVeh[playerid];
	if (veh != 65535 && veh > 0 && veh < 2000)
	{
		if (LD_VehModule(veh) == 3 && LD_VehOwner(veh) == playerid && LD_VehSerial(veh) == g_FrtSerial[playerid])
		{
			LD_VehRelease(veh);
			if (IsValidVehicle(veh))
			{
				if (IsPlayerConnected(playerid) && GetPlayerVehicleID(playerid) == veh)
				{
					RemovePlayerFromVehicle(playerid, false);
				}
				DestroyVehicle(veh);
			}
		}
	}
	g_FrtVeh[playerid] = 65535;
	g_FrtSerial[playerid] = 0;
	gPlayer[playerid][pFreightVehicle] = 0;
}

Freight_ShowCheckpoint(playerid)
{
	if (!IsPlayerConnected(playerid))
	{
		return 0;
	}
	new Float:x, Float:y, Float:z;
	new bool:shop = g_FrtPhase[playerid] >= 3;
	if (!Freight_Point(shop ? g_FrtTo[playerid] : g_FrtFrom[playerid], shop, x, y, z))
	{
		return 0;
	}
	DisablePlayerCheckpoint(playerid);
	SetPlayerCheckpoint(playerid, x, y, z, 6.0);
	return 0;
}

Freight_TimeLeft(playerid)
{
	if (g_FrtPhase[playerid] < 3)
	{
		return -1;
	}
	new left = LD_FreightTimeLimit(g_FrtDist[playerid]) - (GetTickCount() - gPlayer[playerid][pFreightLegTick]) / 1000;
	return left > 0 ? left : 0;
}

Freight_Hud(playerid, distM, dwellSec)
{
	if (g_FrtWelcome[playerid] || g_FrtCt[playerid] <= 0)
	{
		return 0;
	}
	new name[48], goal[288], dest[288];
	new bool:shop = g_FrtPhase[playerid] >= 3;
	LD_DistrictName(shop ? g_FrtTo[playerid] : g_FrtFrom[playerid], name, 48);
	format(dest, 288, "%s %s", shop ? "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;" : "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;", name);
	switch (g_FrtPhase[playerid])
	{
		case 2:
		{
			strcopy(goal, "\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;...", 96);
		}
		case 4:
		{
			strcopy(goal, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;...", 96);
		}
		case 3:
		{
			if (dwellSec >= 0)
			{
				format(goal, 288, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x98; %d \xE1;\x83;\xAC;\xE1;\x83;\x9B;", dwellSec);
			}
			else if (g_FrtOff[playerid])
			{
				strcopy(goal, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x98; Mule-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;!", 96);
			}
			else
			{
				strcopy(goal, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;", 96);
			}
		}
		default:
		{
			if (dwellSec >= 0)
			{
				format(goal, 288, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;: \xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x98; %d \xE1;\x83;\xAC;\xE1;\x83;\x9B;", dwellSec);
			}
			else if (!g_FrtBoarded[playerid])
			{
				strcopy(goal, "\xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x98; Mule-\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;", 96);
			}
			else if (g_FrtOff[playerid])
			{
				strcopy(goal, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x98; Mule-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;!", 96);
			}
			else
			{
				strcopy(goal, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98;", 96);
			}
		}
	}
	UI_CityContractHud(playerid, g_FrtCt[playerid], shop ? 2 : 1, goal, dest, distM, Freight_TimeLeft(playerid), shop ? g_FrtInteg[playerid] : -1);
	return 0;
}

Freight_End(playerid, reason)
{
	if (!Freight_ValidId(playerid) || !g_FrtActive[playerid])
	{
		return 0;
	}
	new bool:welcome = g_FrtWelcome[playerid];
	new bool:online = IsPlayerConnected(playerid);
	Freight_RemoveVehicle(playerid);
	if (online)
	{
		DisablePlayerCheckpoint(playerid);
		if (!welcome)
		{
			UI_CityContractHudHide(playerid);
		}
		switch (reason)
		{
			case 1:
			{
				Util_Send(playerid, -1, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;: Mule \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;.");
			}
			case 5:
			{
				Util_Send(playerid, -10270721, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;: Mule \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;.");
			}
			case 7:
			{
				Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\x9B;\xE1;\x83;\x90;.");
			}
		}
	}
	gPlayer[playerid][pFreightLegTick] = 0;
	gPlayer[playerid][pFreightDwellTick] = 0;
	gPlayer[playerid][pFreightLeftVehTick] = 0;
	if (welcome)
	{
		gPlayer[playerid][pFreightWelcome] = 0;
	}
	Freight_ResetPlayer(playerid);
	if (welcome && online && reason != 0 && reason != 2 && reason != 6)
	{
		Hub_OnWelcomeDelivered(playerid, false);
	}
	return 1;
}

Freight_Release(playerid, reason)
{
	if (!g_FrtActive[playerid])
	{
		return 0;
	}
	if (!g_FrtWelcome[playerid] && g_FrtCt[playerid] > 0)
	{
		g_FrtDefer[playerid] = 0;
		g_FrtPhase[playerid] = 0;
		Director_Release(playerid, reason);
	}
	if (g_FrtActive[playerid])
	{
		Freight_End(playerid, reason);
	}
	return 0;
}

Freight_Stop(playerid, reason, const text[])
{
	if (!g_FrtActive[playerid])
	{
		return 0;
	}
	if (text[0] != 0 && IsPlayerConnected(playerid))
	{
		Util_Send(playerid, -10270721, text);
	}
	new ph = g_FrtPhase[playerid];
	if (!g_FrtWelcome[playerid] && (ph == 2 || ph == 4))
	{
		if (g_FrtDefer[playerid] == 0)
		{
			g_FrtDefer[playerid] = reason;
		}
		Freight_RemoveVehicle(playerid);
		if (IsPlayerConnected(playerid))
		{
			DisablePlayerCheckpoint(playerid);
		}
		return 0;
	}
	Freight_Release(playerid, reason);
	return 0;
}

Freight_Picked(playerid)
{
	new now = GetTickCount();
	g_FrtPhase[playerid] = 3;
	g_FrtDwell[playerid] = false;
	g_FrtStateRetry[playerid] = 0;
	gPlayer[playerid][pFreightLegTick] = now;
	gPlayer[playerid][pFreightDwellTick] = 0;
	if (!g_FrtWelcome[playerid])
	{
		gPlayer[playerid][pContractPhase] = 2;
	}
	g_FrtInteg[playerid] = Freight_IntegrityOf(g_FrtVeh[playerid]);
	g_FrtPath[playerid] = 0.0;
	GetVehiclePos(g_FrtVeh[playerid], g_FrtLastX[playerid], g_FrtLastY[playerid], g_FrtLastZ[playerid]);
	g_FrtLastTick[playerid] = now;
	Freight_ShowCheckpoint(playerid);
	new name[48];
	LD_DistrictName(g_FrtTo[playerid], name, 48);
	if (g_FrtWelcome[playerid])
	{
		UI_LivingToast(playerid, "\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", 1);
	}
	SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;. \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94; %s-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;: \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;, Mule-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\xA3;\xE1;\x83;\xAD;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1;.", name);
}

Freight_DoPickup(playerid)
{
	if (g_FrtWelcome[playerid])
	{
		Freight_Picked(playerid);
		return 0;
	}
	g_FrtPhase[playerid] = 2;
	g_FrtWaitTick[playerid] = GetTickCount();
	if (!Director_Pickup(playerid))
	{
		if (!g_FrtActive[playerid])
		{
			return 0;
		}
		if (g_FrtPhase[playerid] == 2)
		{
			g_FrtPhase[playerid] = 1;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x94; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		}
	}
	return 0;
}

Freight_DoDeliver(playerid)
{
	new now = GetTickCount();
	new seconds = (now - gPlayer[playerid][pFreightLegTick]) / 1000;
	new minSec = LD_FreightMinSeconds(g_FrtDist[playerid]);
	if (seconds < minSec)
	{
		new msg[768];
		format(msg, 768, "consegna troppo rapida: pers. %d contratto %d dopo %d s (minimo %d s)", gPlayer[playerid][pCharId], g_FrtCt[playerid], seconds, minSec);
		Log_Write("FREIGHT", msg);
		format(msg, 768, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x98;\xE1;\x83;\x90; (\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x95; %d \xE1;\x83;\xAC;\xE1;\x83;\x9B;). \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", minSec - seconds);
		Freight_Note(playerid, msg);
		g_FrtRetryTick[playerid] = now + 5000;
		return 0;
	}
	if (!g_FrtWelcome[playerid] && g_FrtDist[playerid] < 300)
	{
		Freight_Stop(playerid, 5, "\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90; (\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x90;).");
		return 0;
	}
	new Float:minPath = float(g_FrtDist[playerid] * 80 / 100);
	if ((g_FrtPath[playerid] < minPath))
	{
		new msg[768];
		format(msg, 768, "percorso insufficiente: pers. %d contratto %d percorso %.0f m su %d m", gPlayer[playerid][pCharId], g_FrtCt[playerid], g_FrtPath[playerid], g_FrtDist[playerid]);
		Log_Write("FREIGHT", msg);
		Freight_Note(playerid, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; Mule-\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x9D;.");
		g_FrtRetryTick[playerid] = now + 5000;
		return 0;
	}
	new integ = Freight_IntegrityOf(g_FrtVeh[playerid]);
	if (integ < g_FrtInteg[playerid])
	{
		g_FrtInteg[playerid] = integ;
	}
	integ = g_FrtInteg[playerid];
	if (g_FrtWelcome[playerid])
	{
		Freight_End(playerid, 0);
		Util_Send(playerid, 0x66DD66FF, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x90;: Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1;!");
		Hub_OnWelcomeDelivered(playerid, true);
		return 0;
	}
	g_FrtPhase[playerid] = 4;
	g_FrtWaitTick[playerid] = now;
	if (!Director_Complete(playerid, integ, seconds))
	{
		if (!g_FrtActive[playerid])
		{
			return 0;
		}
		if (g_FrtPhase[playerid] == 4)
		{
			g_FrtPhase[playerid] = 3;
			g_FrtRetryTick[playerid] = GetTickCount() + 5000;
			Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xAF;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x94; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		}
	}
	return 0;
}

bool:Freight_Begin(playerid, contractId, fromD, toD, cargo, distanceM, bool:welcome)
{
	if (!Freight_ValidId(playerid) || !Util_IsPlaying(playerid) || g_FrtActive[playerid])
	{
		return false;
	}
	if (!LD_IsReady() || gPlayer[playerid][pLivingReady] == 0 || gPlayer[playerid][pCharId] <= 0)
	{
		return false;
	}
	if (gPlayer[playerid][pWounded] || gPlayer[playerid][pCuffed])
	{
		return false;
	}
	if (Job_IsOnShift(playerid) || gPlayer[playerid][pTaxiOnDuty] != 0 || gPlayer[playerid][pRentalId] != 0)
	{
		return false;
	}
	if (welcome)
	{
		if (contractId != 0 || gPlayer[playerid][pContractId] != 0)
		{
			return false;
		}
		fromD = 1;
		toD = 1;
		if (cargo < 1 || cargo > 3)
		{
			cargo = 1;
		}
	}
	else
	{
		if (contractId <= 0 || gPlayer[playerid][pFreightWelcome] != 0)
		{
			return false;
		}
		if (gPlayer[playerid][pContractId] != 0 && gPlayer[playerid][pContractId] != contractId)
		{
			return false;
		}
		if (fromD == toD || cargo < 1 || cargo > 3)
		{
			return false;
		}
		if (gPlayer[playerid][pLevel] < 2)
		{
			return false;
		}
	}
	new pair = Freight_PairDistance(fromD, toD);
	if (pair <= 0)
	{
		return false;
	}
	new dist = welcome ? pair : (distanceM > pair ? distanceM : pair);
	if (!welcome && dist < 300)
	{
		return false;
	}
	if (!LD_PoolHasRoom())
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9D; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98;.");
		return false;
	}
	new Float:x, Float:y, Float:z, slot = 0;
	Freight_Point(fromD, false, x, y, z);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FrtActive[i] && g_FrtFrom[i] == fromD && g_FrtPhase[i] == 1)
		{
			slot++;
		}
	}
	x += (5.0 * float(slot % 4));
	new veh = CreateVehicle(414, x, y, z, 0.0, 1, 1, -1, false);
	if (veh == 65535 || veh <= 0 || veh >= 2000)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9D; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
		return false;
	}
	new serial = LD_VehRegister(veh, 3, playerid);
	if (serial == 0)
