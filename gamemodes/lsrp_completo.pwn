bool:Inv_FridgeMove(playerid, houseId, direction, qty, fridgeCap)
{
	if (!Inv_Guard(playerid))
	{
		return false;
	}
	if (qty < 1 || qty > 40)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;.");
		return false;
	}
	if (direction == 1 && Inv_Count(playerid, 1) < qty)
	{
		Inv_Say(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\xA3;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;.");
		return false;
	}
	if (direction == 2 && Inv_Count(playerid, 1) + qty > 12)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\x9B; %d \xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.", 12);
		return false;
	}
	Inv_BeginOp(playerid, 7, 1, qty, houseId);
	DB_FridgeMove(playerid, gPlayer[playerid][pCharId], houseId, 1, qty, direction, gPlayer[playerid][pInvOpId], fridgeCap, direction == 2 ? 12 : 0);
	return true;
}

public Inv_OnDBFridge(playerid, houseId, direction, qty, result)
{
	if (!Inv_OpIs(playerid, 7))
	{
