}

UI_StoryOriginName(origin, dest[], size)
{
	dest[0] = 0;
	if (origin >= 1 && origin <= 5)
	{
		Lang_Translit(g_UiStoryOriginShort[origin], dest, size);
	}
}

UI_StoryCompose(const name[], origin, motive, dest[], size)
{
	if (origin < 0 || origin > 5)
	{
		origin = 0;
	}
	if (motive < 0 || motive > 4)
	{
		motive = 0;
	}
	if (origin == 0 && motive == 0)
	{
		strcopy(dest, "\xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\xAA;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x90;.", size);
		return 0;
	}
	new nm[96];
	strcopy(nm, name, 96);
	for (new i = 0; nm[i] != 0; i++)
	{
		if (nm[i] == 95)
		{
			nm[i] = 32;
		}
	}
	if (origin == 0)
	{
		format(dest, size, "%s. \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\xAA;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x90;. %s", nm, g_UiStoryMotiveText[motive]);
	}
	else if (motive == 0)
	{
		format(dest, size, "%s. %s", nm, g_UiStoryOriginText[origin]);
	}
	else
	{
		format(dest, size, "%s. %s %s", nm, g_UiStoryOriginText[origin], g_UiStoryMotiveText[motive]);
	}
	return 0;
}

