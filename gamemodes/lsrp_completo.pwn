	{
		new msg[480];
		format(msg, 480, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;: \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x90; $%d (\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90; + \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;) \xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x99;\xE1;\x83;\xA1;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x93;\xE1;\x83;\xA8;\xE1;\x83;\x98;.", total);
		UI_LivingReject(playerid, msg);
