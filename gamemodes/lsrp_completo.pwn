}

// errore verso la pagina CEF o il dialog: 1 formato nome, 2 nome occupato, 3 data non valida, 4 riprova
CharSel_Error(playerid, code)
{
	if (g_CsCef[playerid] && CefUI_Active(playerid))
	{
		cef_emit_event(playerid, "lssc:chars_err", 1, code);
		return 1;
	}
	switch (code)
	{
		case 1: CharSel_ShowNameDialog(playerid, "{FF6347}\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		case 2: CharSel_ShowNameDialog(playerid, "{FF6347}\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		case 3: CharSel_ShowBirthDialog(playerid, "{FF6347}\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		default: CharSel_ShowNameDialog(playerid, "{FF6347}\xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;.");
	}
	return 1;
}

bool:CharSel_LeapYear(y)
{
	return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
}

// giorno/mese/anno -> "YYYY-MM-DD" se la data esiste e l'eta' e' 18-80
bool:CharSel_SetBirth(playerid, d, m, y)
{
	new dim[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
	if (m < 1 || m > 12 || d < 1)
	{
		return false;
	}
	new maxd = dim[m - 1] + ((m == 2 && CharSel_LeapYear(y)) ? 1 : 0);
	if (d > maxd)
	{
		return false;
	}
	new cy, cm, cd;
	getdate(cy, cm, cd);
	new age = cy - y;
	if (cm < m || (cm == m && cd < d))
	{
		age--;
	}
	if (age < CS_AGE_MIN || age > CS_AGE_MAX)
	{
		return false;
	}
	format(g_CsBirth[playerid], 11, "%04d-%02d-%02d", y, m, d);
	return true;
}

bool:CharSel_ParseBirth(playerid, const text[])
{
	new d = 0, m = 0, y = 0, part = 0, digits = 0;
	for (new i = 0; text[i] != 0; i++)
	{
		new c = text[i];
		if (c >= '0' && c <= '9')
		{
			digits++;
			if (part == 0) d = d * 10 + c - '0';
			else if (part == 1) m = m * 10 + c - '0';
			else if (part == 2) y = y * 10 + c - '0';
			if (digits > 8)
			{
				return false;
			}
		}
		else if (c == '/' || c == '.' || c == '-')
		{
			part++;
			if (part > 2)
			{
				return false;
			}
		}
		else if (c != ' ')
		{
			return false;
		}
	}
	return part == 2 && y >= 1000 && CharSel_SetBirth(playerid, d, m, y);
}

// nome proposto: formato, poi unicita' sul DB (personaggi e username degli altri account)
CharSel_SubmitName(playerid, const name[])
{
	if (gPlayer[playerid][pAuthState] != CS_STATE_NEW || g_CsBusy[playerid])
	{
		return 0;
	}
	new tmp[75];
	strcat(tmp, name, sizeof tmp);
	if (strlen(name) > 20 || !Util_IsValidRPName(tmp))
	{
		CharSel_Error(playerid, 1);
		return 0;
	}
	g_CsBusy[playerid] = true;
	g_CsNewName[playerid][0] = 0;
	strcat(g_CsNewName[playerid], tmp, 75);
	new query[320];
	mysql_format(g_DB, query, sizeof query,
		"SELECT (SELECT COUNT(*) FROM characters WHERE char_name = '%e') + (SELECT COUNT(*) FROM accounts WHERE name = '%e' AND id <> %d) AS taken",
		tmp, tmp, gPlayer[playerid][pAccountId]);
	mysql_tquery(g_DB, query, "CharSel_OnNameChecked", "dd", playerid, g_CsToken[playerid]);
	return 1;
}

public CharSel_OnNameChecked(playerid, token)
{
	if (!IsPlayerConnected(playerid) || g_CsToken[playerid] != token || gPlayer[playerid][pAuthState] != CS_STATE_NEW)
	{
		return 1;
	}
	g_CsBusy[playerid] = false;
	new rows = 0, taken = 1;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "taken", taken);
	}
	if (taken != 0)
	{
		g_CsNewName[playerid][0] = 0;
		CharSel_Error(playerid, 2);
		return 1;
	}
	// un altro giocatore online con lo stesso nome (launcher): SetPlayerName fallirebbe
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (i != playerid && IsPlayerConnected(i))
		{
			new other[25];
			GetPlayerName(i, other, sizeof other);
			if (strcmp(other, g_CsNewName[playerid], true) == 0)
			{
				g_CsNewName[playerid][0] = 0;
				CharSel_Error(playerid, 2);
				return 1;
			}
		}
	}
	if (g_CsCef[playerid] && g_CsBirth[playerid][0] != 0)
	{
		CharSel_Finish(playerid);        // dalla pagina arrivano nome e data insieme
		return 1;
	}
	CharSel_ShowBirthDialog(playerid, "");
	return 1;
}

// nome e data validi: nome RP applicato, poi il percorso esistente (genere -> aspetto -> storia -> intro)
CharSel_Finish(playerid)
{
	new cur[25], us;
	GetPlayerName(playerid, cur, sizeof cur);
	if (strcmp(cur, g_CsNewName[playerid], false) != 0 && SetPlayerName(playerid, g_CsNewName[playerid]) != 1)
	{
		g_CsNewName[playerid][0] = 0;
		CharSel_Error(playerid, 2);
		return 0;
	}
	us = strfind(g_CsNewName[playerid], "_");
	g_CsFirst[playerid][0] = 0;
	g_CsLast[playerid][0] = 0;
	strmid(g_CsFirst[playerid], g_CsNewName[playerid], 0, us, 21);
	strmid(g_CsLast[playerid], g_CsNewName[playerid], us + 1, strlen(g_CsNewName[playerid]), 21);
	if (g_CsCef[playerid] && CefUI_Active(playerid))
	{
		CefUI_Close(playerid, "chars");
	}
	gPlayer[playerid][pAuthState] = 5;
	Intro_OnNoCharacter(playerid);
	Account_ShowPrompt(playerid);   // genere (CEF o dialog 9003)
	return 1;
}

// nome RP del personaggio caricato (Char_OnDBLoaded): prima di qualunque altra query del personaggio
bool:CharSel_ApplyLoadedName(playerid)
{
	if (g_CsLoadedName[playerid][0] == 0)
	{
		return true;               // legacy: resta il nome del launcher
	}
	new cur[25];
	GetPlayerName(playerid, cur, sizeof cur);
	if (strcmp(cur, g_CsLoadedName[playerid], false) == 0)
	{
		return true;
	}
	return SetPlayerName(playerid, g_CsLoadedName[playerid]) == 1;
}

// pagina CEF senza la vista chars: si continua con i dialog (ui/cef_views.inc)
CharSel_OnCefFallback(playerid)
{
	g_CsCef[playerid] = false;
	if (gPlayer[playerid][pAuthState] == CS_STATE_LIST)
	{
		CharSel_ShowList(playerid);
	}
	else if (gPlayer[playerid][pAuthState] == CS_STATE_NEW)
	{
		CharSel_ShowNameDialog(playerid, "");
	}
}

// usate da database/db_character.inc (incluso prima di questo file)
CharSel_SetLoadedName(playerid, const name[])
{
	g_CsLoadedName[playerid][0] = 0;
	if (Util_IsValidRPNameC(name))
	{
		strcat(g_CsLoadedName[playerid], name, 25);
	}
}

CharSel_Identity(playerid, name[], first[], last[], birth[], size = sizeof name)
{
	name[0] = 0;
	first[0] = 0;
	last[0] = 0;
	birth[0] = 0;
	if (g_CsNewName[playerid][0] == 0)
	{
		GetPlayerName(playerid, name, size);
		new us = strfind(name, "_");
		if (us > 0)
		{
			strmid(first, name, 0, us, 21);
			strmid(last, name, us + 1, strlen(name), 21);
		}
		return 0;
	}
	strcat(name, g_CsNewName[playerid], size);
	strcat(first, g_CsFirst[playerid], 21);
	strcat(last, g_CsLast[playerid], 21);
	strcat(birth, g_CsBirth[playerid], 11);
	return 1;
}

// ---------------------------------------------------------------- dialog e pagina
bool:CharSel_OnDialogResponse(playerid, dialogid, response, listitem, const inputtext[])
{
	if (dialogid != CS_DIALOG_LIST && dialogid != CS_DIALOG_NAME && dialogid != CS_DIALOG_BIRTH)
	{
		return false;
	}
	switch (dialogid)
	{
		case CS_DIALOG_LIST:
		{
			if (gPlayer[playerid][pAuthState] != CS_STATE_LIST)
			{
				return true;
			}
			if (!response)
			{
				Account_Kick(playerid, "\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1;!");
				return true;
			}
			CharSel_Pick(playerid, listitem);
		}
		case CS_DIALOG_NAME:
		{
			if (gPlayer[playerid][pAuthState] != CS_STATE_NEW)
			{
				return true;
			}
			if (!response)
			{
				if (CharSel_CountChars(playerid) > 0)
				{
					CharSel_ShowList(playerid);
				}
				else
				{
					CharSel_ShowNameDialog(playerid, "");
				}
				return true;
			}
			if (inputtext[0] == 0 && CharSel_CountChars(playerid) == 0)
			{
				new launcher[25];
				GetPlayerName(playerid, launcher, sizeof launcher);
				CharSel_SubmitName(playerid, launcher);
				return true;
			}
			CharSel_SubmitName(playerid, inputtext);
		}
		case CS_DIALOG_BIRTH:
		{
			if (gPlayer[playerid][pAuthState] != CS_STATE_NEW || g_CsNewName[playerid][0] == 0)
			{
				return true;
			}
			if (!response)
			{
				g_CsNewName[playerid][0] = 0;
				CharSel_ShowNameDialog(playerid, "");
				return true;
			}
			if (!CharSel_ParseBirth(playerid, inputtext))
			{
				CharSel_ShowBirthDialog(playerid, "{FF6347}\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
				return true;
			}
			CharSel_Finish(playerid);
		}
	}
	return true;
}

public Cef_OnCharPick(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid) || gPlayer[playerid][pAuthState] != CS_STATE_LIST)
	{
		return 1;
	}
	CharSel_Pick(playerid, CefBridge_Arg(arguments, 0, -1));
	return 1;
}

// lssc:char_create slot nome cognome giorno mese anno (nomi latini: nessuno spazio)
public Cef_OnCharCreate(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || !CefUI_Active(playerid))
	{
		return 1;
	}
	new st = gPlayer[playerid][pAuthState];
	new slot = CefBridge_Arg(arguments, 0, -1);
	if (slot < 0 || slot >= CS_SLOTS || g_CsBusy[playerid])
	{
		return 1;
	}
	if (st == CS_STATE_LIST && g_CsListed[playerid] && g_CsId[playerid][slot] <= 0)
	{
		g_CsSlot[playerid] = slot;
		gPlayer[playerid][pAuthState] = CS_STATE_NEW;
		st = CS_STATE_NEW;
	}
	if (st != CS_STATE_NEW || slot != g_CsSlot[playerid])
	{
		return 1;
	}
	g_CsCef[playerid] = true;
	new pos = 0, first[24], last[24], name[144];
	Util_NextToken(arguments, pos, first, 2);       // salta lo slot
	Util_NextToken(arguments, pos, first, sizeof first);
	Util_NextToken(arguments, pos, last, sizeof last);
	new d = CefBridge_Arg(arguments, 3, 0), m = CefBridge_Arg(arguments, 4, 0), y = CefBridge_Arg(arguments, 5, 0);
	g_CsBirth[playerid][0] = 0;
	if (!CharSel_SetBirth(playerid, d, m, y))
	{
		CharSel_Error(playerid, 3);
		return 1;
	}
	format(name, sizeof name, "%s_%s", first, last);
	CharSel_SubmitName(playerid, name);
	return 1;
}

public Cef_OnCharBack(playerid, const arguments[])
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAuthState] != CS_STATE_NEW || g_CsBusy[playerid])
	{
		return 1;
	}
	if (CharSel_CountChars(playerid) > 0)
	{
		g_CsBirth[playerid][0] = 0;
		gPlayer[playerid][pAuthState] = CS_STATE_LIST;
	}
	return 1;
}

// ===== modules/commands/admin_commands.inc =====

bool:Admin_ParseTarget(playerid, const token[], &targetid)
{
	if (!Util_ParsePlayerId(token, targetid) || !Util_IsPlaying(targetid))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.");
		return false;
	}
	return true;
}

public Cmd_goto(playerid, const params[])
{
	if (Util_GetAdmin(playerid) < 1)
	{
		return 0;
	}
	new pos = 0, tok[36], targetid = 0;
	Util_NextToken(params, pos, tok, 36);
	if (tok[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /goto id");
		return 1;
	}
	if (!Admin_ParseTarget(playerid, tok, targetid))
	{
		return 1;
	}
	if (targetid == playerid)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.");
		return 1;
	}
	new Float:x, Float:y, Float:z;
	GetPlayerPos(targetid, x, y, z);
	SetPlayerInterior(playerid, GetPlayerInterior(targetid));
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
	SetPlayerPos(playerid, (1.0 + x), y, z);
	new an[75], tn[75], msg[384];
	GetPlayerName(playerid, an, 75);
	GetPlayerName(targetid, tn, 75);
	SendClientMessage(playerid, -5963521, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x98; %s-\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;.", tn);
	format(msg, 384, "%s /goto %s", an, tn);
	Log_Write("ADMIN", msg);
	DB_AdminLog(gPlayer[playerid][pAccountId], gPlayer[targetid][pAccountId], "goto", "");
	Admin_AdmCmd(an, "raggiunto", tn, "", "");
	return 1;
}

public Cmd_setlevel(playerid, const params[])
{
	if (Util_GetAdmin(playerid) < 3)
	{
		return 0;
	}
	new pos = 0, tid[36], tlv[36], targetid = 0, level = 0;
	Util_NextToken(params, pos, tid, 36);
	Util_NextToken(params, pos, tlv, 36);
	if (tid[0] == 0 || tlv[0] == 0 || !Util_ParseInt(tlv, level))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /setlevel id \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;");
		return 1;
	}
	if (!Admin_ParseTarget(playerid, tid, targetid))
	{
		return 1;
	}
	if (level < 1 || level > 50)
	{
		SendClientMessage(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; (%d-%d).", 1, 50);
		return 1;
	}
	if (!Level_Set(targetid, level))
	{
		return 1;
	}
	Char_Save(targetid);
	new an[75], tn[75], msg[384];
	GetPlayerName(playerid, an, 75);
	GetPlayerName(targetid, tn, 75);
	SendClientMessage(playerid, -5963521, "%s-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;: %d.", tn, level);
	if (targetid != playerid)
	{
		SendClientMessage(targetid, -2994689, "\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9B; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x90;: %d.", level);
	}
	format(msg, 384, "%s /setlevel %s %d", an, tn, level);
	Log_Write("ADMIN", msg);
	format(msg, 384, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94; %d", level);
	DB_AdminLog(gPlayer[playerid][pAccountId], gPlayer[targetid][pAccountId], "setlevel", msg);
	Admin_AdmCmd(an, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAA;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;:", tn, msg, "");
	return 1;
}

