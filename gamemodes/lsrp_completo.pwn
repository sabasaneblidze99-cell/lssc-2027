Intro_CmdMostra(playerid, const params[])
{
	new pos = 0, tok[48], target = INVALID_PLAYER_ID;
	Util_NextToken(params, pos, tok, 48);
	if (!Util_ParsePlayerId(tok, target) || target == playerid || !Util_IsPlaying(target))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /mostrastoria [id] (\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA4; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xA1;)");
		return 0;
	}
	if (!Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;.");
		return 0;
	}
	new now = GetTickCount(), last = gPlayer[playerid][pStoryLastShowTick];
	if (gPlayer[playerid][pStoryShowTarget] != 0 || (last != 0 && now - last < 10000))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x94; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return 0;
	}
	gPlayer[playerid][pStoryLastShowTick] = now != 0 ? now : 1;
	gPlayer[playerid][pStoryShowTarget] = target + 1;
	DB_StoryRead(playerid, playerid, 1);
	return 0;
}

public Story_OnDBRead(playerid, targetid, purpose, result, origin, motive, bool:hasStory)
{
	if (!Intro_ValidId(playerid))
	{
		return 1;
	}
	if (purpose == 1)
	{
		new to = gPlayer[playerid][pStoryShowTarget] - 1;
		gPlayer[playerid][pStoryShowTarget] = 0;
		if (!Util_IsPlaying(playerid))
		{
			return 1;
		}
		if (result != 1)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;. \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
			return 1;
		}
		if (!hasStory || (origin == 0 && motive == 0))
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; (/storia imposta).");
			return 1;
		}
		if (to < 0 || to >= 1000 || !Util_IsPlaying(to) || !Util_InRange(playerid, to, 3.0))
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x93; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;.");
			return 1;
		}
		new name[75], tname[75];
		GetPlayerName(playerid, name, 75);
		GetPlayerName(to, tname, 75);
		UI_StoryShowOther(to, name, origin, motive);
		SendClientMessage(to, -1, "%s \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA1;.", name);
		SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; %s-\xE1;\x83;\xA1;.", tname);
		return 1;
	}
	if (purpose == 2)
	{
		if (Util_GetAdmin(playerid) < 2)
		{
			return 1;
		}
		if (result != 1)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x90; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
			return 1;
		}
		if (targetid < 0 || targetid >= MAX_PLAYERS || !IsPlayerConnected(targetid))
		{
			return 1;
		}
		new tname[75], reason[192];
		GetPlayerName(targetid, tname, 75);
		format(reason, 192, "letta la storia di %s (pg %d)", tname, gPlayer[targetid][pCharId]);
		Admin_Log(playerid, gPlayer[targetid][pAccountId], "storia", reason);
		UI_StoryShowOther(playerid, tname, origin, motive);
	}
	return 1;
}

