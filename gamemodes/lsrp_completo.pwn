bool:Hub_Valid(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS;
}

bool:Hub_PlayerOk(playerid)
{
	return Util_IsPlaying(playerid) && gPlayer[playerid][pCharId] > 0;
}

Hub_PlayerByChar(charId)
{
	if (charId <= 0)
	{
		return 65535;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && gPlayer[i][pCharId] == charId)
		{
			return i;
		}
	}
	return 65535;
}

Hub_Bit(n)
{
	return 1 << n;
}

Hub_CurStep(playerid)
{
	return g_HubStep[playerid] + 1;
}

bool:Hub_HintsOn(playerid)
{
	return gPlayer[playerid][pHintsOff] == 0;
}

Hub_ResetPlayer(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	g_HubOnb[playerid] = 0;
	g_HubStep[playerid] = 0;
	g_HubAhead[playerid] = 0;
	g_HubHintShown[playerid] = 0;
	g_HubHintDue[playerid] = 0;
	g_HubOpBusy[playerid] = false;
	g_HubOpStep[playerid] = 0;
	g_HubOpId[playerid][0] = 0;
	g_HubOpRetryAt[playerid] = 0;
	g_HubOpTries[playerid] = 0;
	g_HubKitLeft[playerid] = 0;
	g_HubKitAt[playerid] = 0;
	g_HubKitTries[playerid] = 0;
	g_HubKitReload[playerid] = false;
	g_HubTarget[playerid] = 0;
	g_HubCpOn[playerid] = false;
	g_HubAtBoard[playerid] = 0;
	g_HubGreeted[playerid] = 0;
	g_HubDonDay[playerid] = 0;
	g_HubDonToday[playerid] = 0;
	g_HubPrjOpId[playerid][0] = 0;
	g_HubPrjOpProject[playerid] = 0;
	g_HubPrjOpAmount[playerid] = 0;
	g_HubPrjDistrict[playerid] = 0;
	return 0;
}

Hub_NearBoard(playerid)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pCharId] <= 0)
	{
		return -1;
	}
	if (GetPlayerState(playerid) == PLAYER_STATE_SPECTATING || GetPlayerState(playerid) == PLAYER_STATE_WASTED)
	{
		return -1;
	}
	if (GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
	{
		return -1;
	}
	for (new b = 0; b < 3; b++)
	{
		if (IsPlayerInRangeOfPoint(playerid, 4.0, s_HubBoard[b][0], s_HubBoard[b][1], s_HubBoard[b][2]))
		{
			return b;
		}
	}
	return -1;
}

bool:Hub_TargetPos(target, &Float:x, &Float:y, &Float:z)
{
	switch (target)
	{
		case 1:
		{
			x = 1850.0;
			y = -1800.0;
			z = 13.6;
		}
		case 2:
		{
			x = 1480.5;
			y = -1736.0;
			z = 13.5;
		}
		case 3:
		{
			x = 1505.0;
			y = -1700.0;
			z = 13.5;
		}
		default:
		{
			return false;
		}
	}
	return true;
}

Hub_ClearTarget(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	if (g_HubTarget[playerid] != 0 && IsPlayerConnected(playerid))
	{
		RemovePlayerMapIcon(playerid, 97);
	}
	if (g_HubCpOn[playerid] && IsPlayerConnected(playerid) && LD_ActiveFlow(playerid) == 0)
	{
		DisablePlayerCheckpoint(playerid);
	}
	g_HubCpOn[playerid] = false;
	g_HubTarget[playerid] = 0;
	return 0;
}

Hub_SetTarget(playerid, target, bool:withCheckpoint)
{
	new Float:x, Float:y, Float:z;
	if (!Hub_TargetPos(target, x, y, z))
	{
		Hub_ClearTarget(playerid);
		return 0;
	}
	Hub_ClearTarget(playerid);
	SetPlayerMapIcon(playerid, 97, x, y, z, 0, -2994689, MAPICON_GLOBAL);
	g_HubTarget[playerid] = target;
	if (withCheckpoint && LD_ActiveFlow(playerid) == 0)
	{
		SetPlayerCheckpoint(playerid, x, y, z, 3.0);
		g_HubCpOn[playerid] = true;
	}
	return 0;
}

Hub_StepTarget(step)
{
	switch (step)
	{
		case 1, 3:
		{
			return 1;
		}
		case 5:
		{
			return 2;
		}
	}
	return 0;
}

Hub_OnInit()
{
	new text[768], name[48];
	for (new b = 0; b < 3; b++)
	{
		g_HubPickup[b] = CreatePickup(1239, 1, s_HubBoard[b][0], s_HubBoard[b][1], s_HubBoard[b][2], 0);
		if (b == 0)
		{
			g_HubLabel[b] = Lang_Create3DTextLabel("Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\n\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90; - \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\n/contratti  /contribuisci  /aiuto servizi", -2994689, s_HubBoard[b][0], s_HubBoard[b][1], (0.8 + s_HubBoard[b][2]), 15.0, 0, false);
		}
		else
		{
			LD_DistrictName(s_HubBoardDistrict[b], name, 48);
			format(text, 768, "\xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\x90; - %s\n\xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xAC;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\xAA;\n/contratti  /contribuisci", name);
			g_HubLabel[b] = Lang_Create3DTextLabel(text, 0x99CCFFFF, s_HubBoard[b][0], s_HubBoard[b][1], (0.8 + s_HubBoard[b][2]), 15.0, 0, false);
		}
	}
	g_HubZone = GangZoneCreate((1850.0 - 22.0), (-1800.0 - 22.0), (1850.0 + 22.0), (-1800.0 + 22.0));
	g_HubTickCount = 0;
	g_HubLastRefresh = 0;
	g_HubRefreshed = false;
	for (new d = 0; d <= 3; d++)
	{
		g_HubFestInit[d] = false;
		g_HubFestSeen[d] = 0;
		g_HubPrjSeen[d] = 0;
		g_HubGoalSeen[d] = 0;
		g_HubPrjNameSeen[d][0] = 0;
		g_HubFundPrj[d] = 0;
		g_HubFund[d] = 0;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Hub_ResetPlayer(i);
	}
	if (!LD_Listen("Hub_OnDistrictEvent", 40))
	{
		Log_Write("HUB", "registrazione del listener Hub_OnDistrictEvent non riuscita");
	}
	g_HubTimer = SetTimer("Hub_OnTick", 1000, true);
}

Hub_OnExit()
{
	if (g_HubTimer != 0)
	{
		KillTimer(g_HubTimer);
	}
	g_HubTimer = 0;
	for (new b = 0; b < 3; b++)
	{
		if (g_HubPickup[b] != -1)
		{
			DestroyPickup(g_HubPickup[b]);
		}
		if (g_HubLabel[b] != INVALID_3DTEXT_ID)
		{
			Delete3DTextLabel(g_HubLabel[b]);
		}
		g_HubPickup[b] = -1;
		g_HubLabel[b] = Text3D:65535;
	}
	if (g_HubZone != -1)
	{
		GangZoneDestroy(g_HubZone);
	}
	g_HubZone = -1;
}

Hub_OnPlayerConnect(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
	return 0;
}

Hub_OnCharReady(playerid)
{
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
	if (g_HubZone != -1)
	{
		GangZoneShowForPlayer(playerid, g_HubZone, -2994880);
	}
	Hub_TryLoad(playerid);
	return 0;
}

Hub_OnPlayerDisconnect(playerid, reason)
{
	#pragma unused reason
	if (!Hub_Valid(playerid))
	{
		return 0;
	}
	Hub_ResetPlayer(playerid);
	return 0;
}

Hub_TryLoad(playerid)
{
	if (g_HubOnb[playerid] != 0 || DB_LivingPlayerGet(playerid, E_LD_PLAYER:0) == 0)
	{
		return 0;
	}
	new step = LD_Clamp(DB_LivingPlayerGet(playerid, E_LD_PLAYER:4), 0, 5);
	new bool:done = DB_LivingPlayerGet(playerid, E_LD_PLAYER:5) != 0 || step >= 5;
	g_HubStep[playerid] = step;
	gPlayer[playerid][pOnboardStep] = step;
	gPlayer[playerid][pHintsOff] = DB_LivingPlayerGet(playerid, E_LD_PLAYER:6) != 0 ? 1 : 0;
	if (done)
	{
		g_HubOnb[playerid] = 2;
		UI_LivingHelpSet(playerid, 6, !Hub_HintsOn(playerid));
		return 0;
	}
	g_HubOnb[playerid] = 1;
	UI_LivingHelpSet(playerid, Hub_CurStep(playerid), !Hub_HintsOn(playerid));
	if (!Hub_HintsOn(playerid))
	{
		return 0;
	}
	if (step == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\xA8;\xE1;\x83;\x98;. \xE1;\x83;\x90;\xE1;\x83;\xA5; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x9D; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x9C; \xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: Unity Station-\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1; Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x97;\xE1;\x83;\xA3; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\x90;, /aiuto \xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\xA6;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;. \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\x90;? /aiuto off, \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x90; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x90;.");
	}
	else
	{
		new msg[768];
		format(msg, 768, "\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;. \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\xA0;\xE1;\x83;\xAB;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; %d/%d \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C;: \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\x93; /aiuto.", Hub_CurStep(playerid), 5);
		Util_Send(playerid, 0x99CCFFFF, msg);
	}
	g_HubHintDue[playerid] = GetTickCount() + 8000;
	new target = Hub_StepTarget(Hub_CurStep(playerid));
	if (target != 0)
	{
		Hub_SetTarget(playerid, target, false);
	}
	return 0;
}

Hub_SendStep(playerid, step, bool:fresh)
{
	if (fresh)
	{
		DB_LivingMakeOpId(g_HubOpId[playerid], 37, "ob", step, gPlayer[playerid][pCharId]);
		g_HubOpTries[playerid] = 0;
	}
	g_HubOpBusy[playerid] = true;
	g_HubOpStep[playerid] = step;
	g_HubOpRetryAt[playerid] = 0;
	if (DB_LivingBusy(playerid, 4))
	{
		g_HubOpRetryAt[playerid] = GetTickCount() + 5000;
		return 0;
	}
	DB_LivingOnboardStep(playerid, step, g_HubOpId[playerid]);
	return 0;
}

Hub_Advance(playerid, step)
{
	if (g_HubOnb[playerid] != 1 || step < 1 || step > 5)
	{
		return 0;
	}
	new cur = Hub_CurStep(playerid);
	if (step < cur)
	{
		return 0;
	}
	if (step > cur || g_HubOpBusy[playerid])
	{
		g_HubAhead[playerid] |= Hub_Bit(step);
		return 0;
	}
	Hub_SendStep(playerid, step, true);
	return 0;
}

Hub_StepBegin(playerid)
{
	new cur = Hub_CurStep(playerid);
	gPlayer[playerid][pOnboardStep] = g_HubStep[playerid];
	UI_LivingHelpSet(playerid, cur, !Hub_HintsOn(playerid));
	UI_LivingHintHide(playerid);
	if (!Hub_HintsOn(playerid))
	{
		Hub_ClearTarget(playerid);
		return 0;
	}
	if (g_HubHintDue[playerid] == 0)
	{
		g_HubHintDue[playerid] = GetTickCount() + 3000;
	}
	new target = Hub_StepTarget(cur);
	if (target == 0)
	{
		Hub_ClearTarget(playerid);
	}
	else if (target != g_HubTarget[playerid])
	{
		Hub_SetTarget(playerid, target, false);
	}
	return 0;
}

Hub_Finish(playerid, bool:rewarded)
{
	g_HubOnb[playerid] = 2;
	g_HubAhead[playerid] = 0;
	g_HubHintDue[playerid] = 0;
	Hub_ClearTarget(playerid);
	UI_LivingHelpComplete(playerid, rewarded);
	UI_LivingHelpSet(playerid, 6, !Hub_HintsOn(playerid));
}

