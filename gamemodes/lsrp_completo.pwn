bool:UI_HsParseAmount(const text[], &value)
{
	new len = strlen(text);
	if (len < 1 || len > 4)
	{
		return false;
	}
	value = 0;
	for (new i = 0; i < len; i++)
	{
		if (text[i] < 48 || text[i] > 57)
		{
			return false;
		}
		value = value * 10 + (text[i] - 48);
	}
	return true;
}

