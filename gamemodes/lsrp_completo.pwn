Hub_CmdAiuto(playerid, const params[])
{
	if (!Hub_PlayerOk(playerid))
	{
		return 1;
	}
	new pos = 0, sub[72];
	Util_NextToken(params, pos, sub, 72);
	if (sub[0] == 0)
	{
		if (g_HubOnb[playerid] == 0)
		{
			Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\xA2;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x95;: \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94;. \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;: /aiuto servizi.");
			return 1;
		}
		UI_LivingHelpSet(playerid, g_HubOnb[playerid] == 2 ? 6 : Hub_CurStep(playerid), !Hub_HintsOn(playerid));
		UI_LivingHelpShow(playerid);
		return 1;
	}
	if (!strcmp(sub, "off", true, 0x7FFFFFFF))
	{
		Hub_HintsOff(playerid);
		return 1;
	}
	if (!strcmp(sub, "servizi", true, 0x7FFFFFFF) || !strcmp(sub, "hub", true, 0x7FFFFFFF))
	{
		Hub_ShowServices(playerid);
		return 1;
	}
	if (!strcmp(sub, "consegna", true, 0x7FFFFFFF))
	{
		Hub_StartWelcome(playerid);
		return 1;
	}
	if (!strcmp(sub, "mappa", true, 0x7FFFFFFF))
	{
		if (g_HubOnb[playerid] == 1)
		{
			UI_OnHelpWaypoint(playerid, Hub_CurStep(playerid));
		}
		else
		{
			Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xAF;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;. \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;: /aiuto casa.");
		}
		return 1;
	}
	if (!strcmp(sub, "casa", true, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 1, true);
		Util_Send(playerid, 0x99CCFFFF, "Idlewood-\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;.");
		return 1;
	}
	if (!strcmp(sub, "lavoro", true, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 2, true);
		Util_Send(playerid, 0x99CCFFFF, "Job Center Pershing Square-\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;, \xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;: \xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;. \xE1;\x83;\x98;\xE1;\x83;\xA5;: /lavoro prendi.");
		return 1;
	}
	if (!strcmp(sub, "noleggio", true, 0x7FFFFFFF))
	{
		Hub_SetTarget(playerid, 3, true);
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;\xE1;\x83;\x9E;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; Pershing Square-\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x90;: \xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;. \xE1;\x83;\x98;\xE1;\x83;\xA5;: /noleggio.");
