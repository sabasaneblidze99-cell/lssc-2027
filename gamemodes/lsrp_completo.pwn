	UI_LvLocalLabel(g_UiLvDsLRep[playerid], lrep, 240);
	format(body, 2560, "{FFFFFF}\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: %s\n\n{FFFFFF}\xE1;\x83;\x94;\xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;  %s {FFFFFF}%d/%d\n{FFFFFF}\xE1;\x83;\xA3;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;                %s {FFFFFF}%d/%d\n{FFFFFF}\xE1;\x83;\x99;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\xAE;\xE1;\x83;\x98;  %s {FFFFFF}%d/%d%s\n\n{FFFFFF}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9E;\xE1;\x83;\xA3;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA5;: {FFD24D}%d{FFFFFF} - %s\n", prosp, bAct, act, 1000, bSec, g_UiLvDsSec[playerid], 100, bCrime, g_UiLvDsCrime[playerid], 100, g_UiLvDsCrime[playerid] >= 70 ? "  {FF8866}(\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x96;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;: \xE1;\x83;\x99;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\xA2;\xE1;\x83;\xA1; \xE1;\x83;\x98;\xE1;\x83;\xAE;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xA1;)" : "", g_UiLvDsLRep[playerid], lrep);
	if (g_UiLvDsFest[playerid] > 0)
	{
		format(line, 384, "{66DD66}\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\xA1; \xE1;\x83;\xA3;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA9;\xE1;\x83;\x90; %d \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;.\n", g_UiLvDsFest[playerid]);
