AzMap_Create()
{
	Streamer_SetVisibleItems(STREAMER_TYPE_OBJECT, 900);
	AzMap_Part0();
	AzMap_Part1();
	AzMap_Part2();
	AzMap_Part3();
	AzMap_Part4();
	AzMap_Part5();
	AzMap_Part6();
	AzMap_Part7();
	printf("[MAPPA] Arizona Los Santos: %d oggetti", AZMAP_OBJECTS);
}

