		{
			UI_LvBar(pts, next, "FFD24D", bar, 192);
			format(line, 576, "{FFFFFF}%s: {FFD24D}%s{FFFFFF} (+%d%%) - %d \xE1;\x83;\xA5;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x90;\n  %s {AAAAAA}%s - %d \xE1;\x83;\xA5;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x92;\n", g_UiLvTrackName[t], g_UiLvTierName[tier], UI_LvTierBonus(tier), pts, bar, g_UiLvTierName[tier + 1], next - pts);
		}
		else
		{
			format(line, 576, "{FFFFFF}%s: {66DD66}%s{FFFFFF} (+%d%%) - %d \xE1;\x83;\xA5;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x90;, \xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\n", g_UiLvTrackName[t], g_UiLvTierName[tier], UI_LvTierBonus(tier), pts);
		}
		strcat(body, line, 2560);
