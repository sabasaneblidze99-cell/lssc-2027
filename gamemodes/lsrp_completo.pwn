public House_InvFridgeResult(playerid, houseId, direction, qty, result)
{
	new idx = House_Find(houseId);
	if (idx == -1)
	{
		return 1;
	}
	g_HsFridgeBusy[idx] = false;
	if (!Inv_ValidPlayer(playerid))
	{
		return 1;
	}
	switch (result)
	{
		case 1:
		{
			if (direction == 1)
			{
				g_HouseRows[idx][hrFridgeUnits] = min(g_HouseRows[idx][hrFridgeUnits] + qty, House_FridgeCap(idx));
			}
			else
			{
				g_HouseRows[idx][hrFridgeUnits] = max(g_HouseRows[idx][hrFridgeUnits] - qty, 0);
			}
			House_RefreshInside(idx);
			if (direction == 1)
			{
				SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; %d \xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90; (%d/%d).", qty, g_HouseRows[idx][hrFridgeUnits], House_FridgeCap(idx));
			}
			else
			{
				SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x90;\xE1;\x83;\x98;\xE1;\x83;\xA6;\xE1;\x83;\x94; %d \xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\xA3;\xE1;\x83;\xA4;\xE1;\x83;\x90; (\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xA1;. %d).", qty, 12);
			}
			if (House_FindInside(playerid) == idx)
			{
				House_ReopenFridge(playerid);
			}
		}
