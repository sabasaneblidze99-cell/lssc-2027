			{
				Lang_ShowPlayerDialog(playerid, 9724, DIALOG_STYLE_MSGBOX, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x9D;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;?", "{FFFFFF}\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA6;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA5; \xE1;\x83;\xA1;\xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x9A;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;, \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\xA8;\xE1;\x83;\x94;.\n\n{AAAAAA}\xE1;\x83;\xA7;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90; \xE1;\x83;\xB0;\xE1;\x83;\x99;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;, \xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAA; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAE;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;: \xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\xA1;-\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;, \xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x94; \xE1;\x83;\xA9;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA1;.",
	"\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x90;", "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x9C;");
				return true;
			}
			UI_LivingHelpShow(playerid);
			return true;
		}
		case 9723:
		{
			new step = g_UiLvHpView[playerid];
			new bool:mapBtn = step == g_UiLvHpStep[playerid] && !g_UiLvHpOff[playerid];
			if (mapBtn)
			{
				if (response && step >= 1 && step <= 5)
				{
					UI_LivingToast(playerid, "\xE1;\x83;\x92;\xE1;\x83;\x96;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\xA0;\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x90;\xE1;\x83;\x96;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x98;\xE1;\x83;\xA8;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x95;", 1);
					UI_OnHelpWaypoint(playerid, step);
				}
				else
				{
					UI_LivingHelpShow(playerid);
				}
			}
			else if (response)
			{
				UI_LivingHelpShow(playerid);
			}
			return true;
		}
		case 9724:
		{
			if (!response)
			{
				UI_LivingHelpShow(playerid);
				return true;
			}
			g_UiLvHpOff[playerid] = true;
			UI_LivingHintHide(playerid);
			UI_OnHelpHintsOff(playerid);
			return true;
		}
	}
	return true;
}

// ===== modules/database/db_core.inc =====
new MySQL:g_DB;
new g_DBPending[MAX_PLAYERS];
new g_DBAdminPending[1001];
new g_DBFindTag[1001];
new g_DBHashAlgo[MAX_PLAYERS];
new g_DBMutedUntil[MAX_PLAYERS];
new g_DBLockedUntil[MAX_PLAYERS];

bool:DB_IsReady()
{
	return g_DB != MYSQL_INVALID_HANDLE;
}

DB_IniTrim(str[])
{
	new len = strlen(str);
	while (len > 0 && str[len - 1] <= 32)
	{
		str[--len] = 0;
	}
	new s = 0;
	while (str[s] && str[s] <= 32)
	{
		s++;
	}
	if (s > 0)
	{
		strdel(str, 0, s);
	}
}

bool:DB_IniRead(const path[], host[], user[], pass[], dbname[], &port, &mask, size)
{
	new File:f = fopen(path, filemode:0);
	if (!f)
	{
		return false;
	}
	new line[320], key[96], val[384], bool:first = true;
	host[0] = user[0] = pass[0] = dbname[0] = 0;
	port = 3306;
	mask = 0;
	while (fread(f, line, 320, false))
	{
		if (first)
		{
			first = false;
			if ((line[0] & 255) == 239 && (line[1] & 255) == 187 && (line[2] & 255) == 191)
			{
				strdel(line, 0, 3);
			}
			else if (line[0] == 65279)
			{
				strdel(line, 0, 1);
			}
		}
		new eq = strfind(line, "=", false, 0);
		if (eq < 1)
		{
			continue;
		}
		strmid(key, line, 0, eq, 96);
		strmid(val, line, eq + 1, strlen(line), 384);
		DB_IniTrim(key);
		DB_IniTrim(val);
		if (!key[0] || key[0] == 59 || key[0] == 35)
		{
			continue;
		}
		if (!strcmp(key, "hostname", true, 0x7FFFFFFF))
		{
			strcopy(host, val, size);
			mask |= 1;
		}
		else if (!strcmp(key, "username", true, 0x7FFFFFFF))
		{
			strcopy(user, val, size);
			mask |= 2;
		}
		else if (!strcmp(key, "password", true, 0x7FFFFFFF))
		{
			strcopy(pass, val, size);
		}
		else if (!strcmp(key, "database", true, 0x7FFFFFFF))
		{
			strcopy(dbname, val, size);
			mask |= 4;
		}
		else if (!strcmp(key, "server_port", true, 0x7FFFFFFF) || !strcmp(key, "port", true, 0x7FFFFFFF))
		{
			new p = strval(val);
			if (p > 0 && p < 65536)
			{
				port = p;
			}
		}
	}
	fclose(f);
	return true;
}

DB_ConnectHint(errno, const errtxt[])
{
	switch (errno)
	{
		case 1045:
		{
			print("[DB] suggerimento: accesso negato. Controlla username/password in mysql.ini e che l'utente possa collegarsi da quell'host (es. 'root'@'127.0.0.1').");
		}
		case 1049:
		{
			print("[DB] suggerimento: il database indicato in mysql.ini non esiste. Importa sql/lsrp_completo.sql (crea il database lsrp) e poi sql/crea_utente.sql.");
		}
		case 2002, 2003, 2005:
		{
			print("[DB] suggerimento: server MySQL non raggiungibile. Verifica che sia avviato, hostname e server_port (default 3306) in mysql.ini e il firewall.");
		}
		case 1251, 2059, 2061:
		{
			print("[DB] suggerimento: plugin di autenticazione non supportato (MySQL 8: caching_sha2_password). Esegui: ALTER USER 'utente'@'host' IDENTIFIED WITH mysql_native_password BY 'password'; FLUSH PRIVILEGES;");
		}
		default:
		{
			if (strfind(errtxt, "authentication", true, 0) != -1 || strfind(errtxt, "caching_sha2", true, 0) != -1)
			{
				print("[DB] suggerimento: possibile problema di autenticazione MySQL 8: ALTER USER 'utente'@'host' IDENTIFIED WITH mysql_native_password BY 'password'; FLUSH PRIVILEGES;");
			}
			else if (errno == 0)
			{
				print("[DB] suggerimento: nessun errore dal plugin. Verifica che mysql.ini sia nella cartella di omp-server (non 'mysql.ini.txt': Windows nasconde le estensioni) e che il plugin mysql sia caricato.");
			}
		}
	}
}

bool:DB_ConnectFinish(MySQL:h, const where[])
{
	new errbuf[384], errno = 0;
	if (h != MYSQL_INVALID_HANDLE)
	{
		errno = mysql_errno(h);
	}
	if (h == MYSQL_INVALID_HANDLE || errno != 0)
	{
		errbuf[0] = 0;
		mysql_error(errbuf, 384, h);
		printf("[DB] connessione fallita (%s): errno %d, %s", where, errno, errbuf[0] ? errbuf : "(nessun messaggio dal plugin)");
		DB_ConnectHint(errno, errbuf);
		if (h != MYSQL_INVALID_HANDLE)
		{
			mysql_close(h);
		}
		return false;
	}
	g_DB = h;
	mysql_set_charset("utf8mb4", g_DB);
	DB_AlignCollation();
	print("[DB] connesso (utf8mb4)");
	return true;
}

DB_AlignCollation()
{
	mysql_tquery(g_DB, "SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci", "", "");
}

bool:DB_Connect()
{
	if (DB_IsReady())
	{
		return true;
	}
	new host[128], user[128], pass[128], dbname[128], port = 0, mask = 0;
	new bool:read = DB_IniRead("mysql.ini", host, user, pass, dbname, port, mask, 128);
	if (!read)
	{
		read = DB_IniRead("../mysql.ini", host, user, pass, dbname, port, mask, 128);
	}
	if (!read)
	{
		new MySQL:h = mysql_connect_file("mysql.ini");
		if (h != MYSQL_INVALID_HANDLE && mysql_errno(h) == 0)
		{
			g_DB = h;
			mysql_set_charset("utf8mb4", g_DB);
			DB_AlignCollation();
			print("[DB] connesso (utf8mb4, via mysql_connect_file)");
			return true;
		}
		printf("[DB] connessione con '%s' fallita: il file va nella radice del server (accanto a omp-server) oppure in scriptfiles/.", "mysql.ini");
		print("[DB] attenzione: su Windows controlla che non si chiami 'mysql.ini.txt' (estensioni nascoste) e che le chiavi siano hostname, username, password, database, server_port.");
		DB_ConnectFinish(h, "mysql_connect_file");
		return false;
	}
	if (mask != 7)
	{
		printf("[DB] %s: chiavi mancanti o vuote:%s%s%s (servono hostname, username, database; password e server_port opzionali).", "mysql.ini", mask & 1 ? "" : " hostname", mask & 2 ? "" : " username", mask & 4 ? "" : " database");
		return false;
	}
	new MySQLOpt:opts = mysql_init_options();
	mysql_set_option(opts, E_MYSQL_OPTION:3, port);
	new MySQL:h2 = mysql_connect(host, user, pass, dbname, opts);
	pass[0] = 0;
	new where[288];
	format(where, 288, "%s@%s:%d db=%s", user, host, port, dbname);
	return DB_ConnectFinish(h2, where);
}

DB_Shutdown()
{
	if (!DB_IsReady())
	{
		return 0;
	}
	mysql_close(g_DB);
	g_DB = MySQL:0;
	print("[DB] connessione chiusa");
	return 0;
}

bool:DB_PlayerMatches(playerid, const name[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return false;
	}
	new cur[75];
	GetPlayerName(playerid, cur, 75);
	return strcmp(cur, name, false, 0x7FFFFFFF) == 0;
}

DB_PendingSet(playerid, op)
{
	g_DBPending[playerid] |= op;
}

DB_PendingClear(playerid, op)
{
	g_DBPending[playerid] &= ~op;
}

DB_DeliverFailure(playerid, op)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	DB_PendingClear(playerid, op);
	if (!IsPlayerConnected(playerid))
	{
		return 0;
	}
	switch (op)
	{
		case 1:
		{
			Account_OnDBLoaded(playerid, -1, "", "", 0);
		}
		case 2:
		{
			Account_OnDBCreated(playerid, 0);
		}
		case 4:
		{
			if (funcidx("Char_OnDBError") != -1)
			{
				CallLocalFunction("Char_OnDBError", "d", playerid);
			}
			else
			{
				Char_OnDBLoaded(playerid, false);
			}
		}
		case 8:
		{
			Char_OnDBCreated(playerid, 0);
		}
		case 16:
		{
			if (funcidx("Admin_OnBanChecked") != -1)
			{
				CallLocalFunction("Admin_OnBanChecked", "ddsd", playerid, 0, "", 0);
			}
		}
		case 32:
		{
			if (funcidx("Veh_OnDBLoaded") != -1)
			{
				CallLocalFunction("Veh_OnDBLoaded", "dd", playerid, -1);
			}
		}
		case 256:
		{
			if (funcidx("Veh_OnDBCounted") != -1)
			{
				CallLocalFunction("Veh_OnDBCounted", "dd", playerid, -1);
			}
		}
		case 64:
		{
			if (funcidx("Veh_OnDBCreated") != -1)
			{
				CallLocalFunction("Veh_OnDBCreated", "dds", playerid, 0, "");
			}
		}
		case 128:
		{
			if (funcidx("Veh_OnDBDeleted") != -1)
			{
				CallLocalFunction("Veh_OnDBDeleted", "ddd", playerid, 0, -1);
			}
		}
		case 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072:
		{
			if (funcidx("DB_HouseFailure") != -1)
			{
				CallLocalFunction("DB_HouseFailure", "ddd", playerid, op, -1);
			}
		}
		case 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216:
		{
			if (funcidx("DB_JobFacFailure") != -1)
			{
				CallLocalFunction("DB_JobFacFailure", "dd", playerid, op);
			}
		}
		case 33554432, 67108864:
		{
			if (funcidx("DB_InvFailure") != -1)
			{
				CallLocalFunction("DB_InvFailure", "dd", playerid, op);
			}
		}
		case 134217728, 268435456:
		{
			if (funcidx("DB_BankFailure") != -1)
			{
				CallLocalFunction("DB_BankFailure", "dd", playerid, op);
			}
		}
		case 536870912, 1073741824:
		{
			if (funcidx("DB_StoryFailure") != -1)
			{
				CallLocalFunction("DB_StoryFailure", "dd", playerid, op);
			}
		}
	}
	return 0;
}

DB_DeliverAdminFailure(slot, op)
{
	if (slot < 0 || slot > 1000)
	{
		return 0;
	}
	g_DBAdminPending[slot] &= ~op;
	new req = slot == 1000 ? 65535 : slot;
	if (req != INVALID_PLAYER_ID && !IsPlayerConnected(req))
	{
		return 0;
	}
	switch (op)
	{
		case 1:
		{
			if (funcidx("Admin_OnWarnAdded") != -1)
			{
				CallLocalFunction("Admin_OnWarnAdded", "ddd", req, 0, -1);
			}
		}
		case 2:
		{
			if (funcidx("Admin_OnBanAdded") != -1)
			{
				CallLocalFunction("Admin_OnBanAdded", "dsd", req, "", 0);
			}
		}
		case 4:
		{
			if (funcidx("Admin_OnUnbanned") != -1)
			{
				CallLocalFunction("Admin_OnUnbanned", "dsd", req, "", -1);
			}
		}
		case 8:
		{
			if (funcidx("Admin_OnAccountFound") != -1)
			{
				CallLocalFunction("Admin_OnAccountFound", "dddsds", req, g_DBFindTag[slot], -1, "", 0, "");
			}
		}
	}
	return 0;
}

DB_FailAllAdminPending(op)
{
	for (new i = 0; i <= 1000; i++)
	{
		if (g_DBAdminPending[i] & op)
		{
			DB_DeliverAdminFailure(i, op);
		}
	}
}

DB_FailAllPending(op)
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_DBPending[i] & op)
		{
			DB_DeliverFailure(i, op);
		}
	}
}

public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle)
{
	printf("[DB] errore %d (callback '%s'): %s", errorid, callback, error);
	if (!strcmp(callback, "DB_OnAccountLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(1);
	}
	else if (!strcmp(callback, "DB_OnAccountCreated", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(2);
	}
	else if (!strcmp(callback, "DB_OnCharLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(4);
	}
	else if (!strcmp(callback, "DB_OnCharCreated", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(8);
	}
	else if (!strcmp(callback, "DB_OnBanChecked", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(16);
	}
	else if (!strcmp(callback, "DB_OnVehiclesLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(32);
	}
	else if (!strcmp(callback, "DB_OnVehiclesCounted", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(256);
	}
	else if (!strcmp(callback, "DB_OnVehicleCreated", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(64);
	}
	else if (!strcmp(callback, "DB_OnVehicleDeleted", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(128);
	}
	else if (!strcmp(callback, "DB_OnHouseBought", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(512);
	}
	else if (!strcmp(callback, "DB_OnHouseSold", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(1024);
	}
	else if (!strcmp(callback, "DB_OnHouseKeyAdded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(2048);
	}
	else if (!strcmp(callback, "DB_OnHouseKeyRemoved", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(4096);
	}
	else if (!strcmp(callback, "DB_OnHouseKeysLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(8192);
	}
	else if (!strcmp(callback, "DB_OnHouseBillsLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(16384);
	}
	else if (!strcmp(callback, "DB_OnHouseBillsPaid", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnHouseRestored", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(32768);
	}
	else if (!strcmp(callback, "DB_OnHouseFoodLoaded", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(65536);
	}
	else if (!strcmp(callback, "DB_OnHouseStored", false, 0x7FFFFFFF))
	{
		DB_FailAllPending(131072);
	}
	else if (!strcmp(callback, "DB_OnHouse", false, 10) && funcidx("DB_HouseGlobalFailure") != -1)
	{
		CallLocalFunction("DB_HouseGlobalFailure", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnJF", false, 7) && funcidx("DB_JobFacQueryError") != -1)
	{
		CallLocalFunction("DB_JobFacQueryError", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnInv", false, 8) && funcidx("DB_InvQueryError") != -1)
	{
		CallLocalFunction("DB_InvQueryError", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnBankDeltaSaved", false, 0x7FFFFFFF))
	{
		if (funcidx("DB_BankDeltaFailed") != -1)
		{
			CallLocalFunction("DB_BankDeltaFailed", "");
		}
	}
	else if (!strcmp(callback, "DB_OnBank", false, 9) && funcidx("DB_BankQueryError") != -1)
	{
		CallLocalFunction("DB_BankQueryError", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnStory", false, 10) && funcidx("DB_StoryQueryError") != -1)
	{
		CallLocalFunction("DB_StoryQueryError", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnLd", false, 7) && funcidx("DB_LivingQueryError") != -1)
	{
		CallLocalFunction("DB_LivingQueryError", "s", callback);
	}
	else if (!strcmp(callback, "DB_OnWarnInserted", false, 0x7FFFFFFF) || !strcmp(callback, "DB_OnWarnCounted", false, 0x7FFFFFFF))
	{
		DB_FailAllAdminPending(1);
	}
	else if (!strcmp(callback, "DB_OnBanInserted", false, 0x7FFFFFFF))
	{
		DB_FailAllAdminPending(2);
	}
	else if (!strcmp(callback, "DB_OnUnbanDone", false, 0x7FFFFFFF))
	{
		DB_FailAllAdminPending(4);
	}
	else if (!strcmp(callback, "DB_OnAccountFound", false, 0x7FFFFFFF))
	{
		DB_FailAllAdminPending(8);
	}
	return 1;
}

// ===== modules/database/db_account.inc =====

DB_GetHashAlgo(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS ? g_DBHashAlgo[playerid] : 0;
}

DB_GetMutedUntil(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS ? g_DBMutedUntil[playerid] : 0;
}

DB_GetLockedUntil(playerid)
{
	return playerid >= 0 && playerid < MAX_PLAYERS ? g_DBLockedUntil[playerid] : 0;
}

DB_LoadAccount(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	g_DBHashAlgo[playerid] = 0;
	g_DBMutedUntil[playerid] = 0;
	g_DBLockedUntil[playerid] = 0;
	if (!DB_IsReady())
	{
		DB_DeliverFailure(playerid, 1);
		return 0;
	}
	new name[75], query[512];
	GetPlayerName(playerid, name, 75);
	mysql_format(g_DB, query, 512, "SELECT id, password_hash, salt, hash_algo, muted_until, admin_level, locked_until FROM accounts WHERE name = '%e' LIMIT 1", name);
	DB_PendingSet(playerid, 1);
	mysql_tquery(g_DB, query, "DB_OnAccountLoaded", "ds", playerid, name);
	return 0;
}

public DB_OnAccountLoaded(playerid, const name[])
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 1;
	}
	DB_PendingClear(playerid, 1);
	if (gPlayer[playerid][pAuthState] != 0)
	{
		return 1;
	}
	new rows = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		Account_OnDBLoaded(playerid, 0, "", "", 0);
		return 1;
	}
	new accountId = 0, adminLevel = 0;
	new hash[195], salt[51];
	cache_get_value_name_int(0, "id", accountId);
	cache_get_value_name(0, "password_hash", hash, 195);
	cache_get_value_name(0, "salt", salt, 51);
	cache_get_value_name_int(0, "admin_level", adminLevel);
	cache_get_value_name_int(0, "hash_algo", g_DBHashAlgo[playerid]);
	cache_get_value_name_int(0, "muted_until", g_DBMutedUntil[playerid]);
	cache_get_value_name_int(0, "locked_until", g_DBLockedUntil[playerid]);
	Account_OnDBLoaded(playerid, accountId, hash, salt, adminLevel);
	return 1;
}

bool:DB_HashFormatOk(const hash[], const salt[], algo)
{
	if (algo == 0)
	{
		return strlen(hash) == 64 && strlen(salt) == 16;
	}
	if (algo == 1)
	{
		return strlen(hash) == 60 && strlen(salt) < 17;
	}
	return false;
}

DB_CreateAccountEx(playerid, const hash[], const salt[], algo)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!DB_IsReady() || !DB_HashFormatOk(hash, salt, algo))
	{
		DB_DeliverFailure(playerid, 2);
		return 0;
	}
	new name[75], query[512];
	GetPlayerName(playerid, name, 75);
	mysql_format(g_DB, query, 512, "INSERT IGNORE INTO accounts (name, password_hash, salt, hash_algo) VALUES ('%e', '%e', '%e', %d)", name, hash, salt, algo);
	DB_PendingSet(playerid, 2);
	mysql_tquery(g_DB, query, "DB_OnAccountCreated", "ds", playerid, name);
	return 0;
}

public DB_OnAccountCreated(playerid, const name[])
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 1;
	}
	DB_PendingClear(playerid, 2);
	if (gPlayer[playerid][pAuthState] != 2)
	{
		return 1;
	}
	new accountId = 0;
	if (cache_affected_rows() == 1)
	{
		accountId = cache_insert_id();
	}
	Account_OnDBCreated(playerid, accountId);
	return 1;
}

DB_UpdateLogin(accountId, const ip[])
{
	if (!DB_IsReady() || accountId <= 0)
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET last_login = NOW(), last_ip = '%e', failed_logins = 0 WHERE id = %d", ip, accountId);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_UpdatePasswordHash(accountId, const hash[], algo)
{
	if (!DB_IsReady() || accountId <= 0)
	{
		return 0;
	}
	new len = strlen(hash);
	if (!((algo == 0 && len == 64) || (algo == 1 && len == 60)))
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET password_hash = '%e', hash_algo = %d WHERE id = %d", hash, algo, accountId);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_AccountLoginFailed(accountId)
{
	if (!DB_IsReady() || accountId <= 0)
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET locked_until = IF(failed_logins + 1 >= %d, UNIX_TIMESTAMP() + %d, locked_until), failed_logins = IF(failed_logins + 1 >= %d, 0, failed_logins + 1) WHERE id = %d", 9, 600, 9, accountId);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_AccountSetEmail(playerid, accountId, const email[])
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!DB_IsReady() || accountId <= 0)
	{
		Account_OnDBEmailSet(playerid, -1);
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE IGNORE accounts SET email = '%e', email_verified = 0, email_token_hash = NULL WHERE id = %d", email, accountId);
	mysql_tquery(g_DB, query, "DB_OnAccountEmailSet", "dds", playerid, accountId, email);
	return 0;
}

public DB_OnAccountEmailSet(playerid, accountId, const email[])
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAccountId] != accountId)
	{
		return 1;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT (email <=> '%e') AS same FROM accounts WHERE id = %d", email, accountId);
	mysql_tquery(g_DB, query, "DB_OnAccountEmailCheck", "dd", playerid, accountId);
	return 1;
}

public DB_OnAccountEmailCheck(playerid, accountId)
{
	if (!IsPlayerConnected(playerid) || gPlayer[playerid][pAccountId] != accountId)
	{
		return 1;
	}
	new rows = 0, same = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		Account_OnDBEmailSet(playerid, -1);
		return 1;
	}
	cache_get_value_name_int(0, "same", same);
	Account_OnDBEmailSet(playerid, same ? 1 : 0);
	return 1;
}

// ===== modules/database/db_character.inc =====
new g_BankDb[MAX_PLAYERS];
new g_BankFly[MAX_PLAYERS];
new g_BankFlyChar[MAX_PLAYERS];
new g_BankGen[MAX_PLAYERS];

DB_BankSessionReset(playerid, charId)
{
	g_BankDb[playerid] = gPlayer[playerid][pBank];
	g_BankFly[playerid] = 0;
	g_BankFlyChar[playerid] = charId;
	g_BankGen[playerid]++;
}

DB_BankDeltaTake(playerid)
{
	new charId = gPlayer[playerid][pCharId];
	if (g_BankFlyChar[playerid] != charId)
	{
		g_BankFly[playerid] = 0;
		g_BankFlyChar[playerid] = charId;
	}
	new d = gPlayer[playerid][pBank] - g_BankDb[playerid] - g_BankFly[playerid];
	g_BankFly[playerid] += d;
	return d;
}

public DB_OnBankDeltaSaved(playerid, const name[], charId, gen, delta)
{
	if (!DB_PlayerMatches(playerid, name) || gPlayer[playerid][pCharId] != charId || g_BankGen[playerid] != gen || g_BankFlyChar[playerid] != charId)
	{
		return 1;
	}
	g_BankDb[playerid] += delta;
	g_BankFly[playerid] -= delta;
	return 1;
}

public DB_BankDeltaFailed()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		g_BankFly[i] = 0;
	}
	print("[DB] salvataggio personaggio fallito: i delta banca in volo verranno rimandati");
	return 1;
}

DB_LoadCharacter(playerid, accountId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!DB_IsReady() || accountId <= 0)
	{
		DB_DeliverFailure(playerid, 4);
		return 0;
	}
	new name[75], query[512];
	GetPlayerName(playerid, name, 75);
	new jfCols[64] = ", job, faction, faction_rank, COALESCE(char_name, '') AS cn";
	mysql_format(g_DB, query, 512, "SELECT id, money, bank, level, exp, health, armor, pos_x, pos_y, pos_z, angle, interior, world, skin, LEAST(played_ms, %d) AS played_ms%s FROM characters WHERE account_id = %d AND slot = %d LIMIT 1", 0x7FFFFFFF, jfCols, accountId, CharSel_Slot(playerid));
	DB_PendingSet(playerid, 4);
	mysql_tquery(g_DB, query, "DB_OnCharLoaded", "dsd", playerid, name, accountId);
	return 0;
}

public DB_OnCharLoaded(playerid, const name[], accountId)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 1;
	}
	DB_PendingClear(playerid, 4);
	if (gPlayer[playerid][pAuthState] != 4 || gPlayer[playerid][pAccountId] != accountId)
	{
		return 1;
	}
	new rows = 0;
	cache_get_row_count(rows);
	if (rows < 1)
	{
		Char_OnDBLoaded(playerid, false);
		return 1;
	}
	cache_get_value_name_int(0, "id", gPlayer[playerid][pCharId]);
	cache_get_value_name_int(0, "money", gPlayer[playerid][pMoney]);
	cache_get_value_name_int(0, "bank", gPlayer[playerid][pBank]);
	cache_get_value_name_int(0, "level", gPlayer[playerid][pLevel]);
	cache_get_value_name_int(0, "exp", gPlayer[playerid][pExp]);
	cache_get_value_name_float(0, "health", gPlayer[playerid][pHealth]);
	cache_get_value_name_float(0, "armor", gPlayer[playerid][pArmor]);
	cache_get_value_name_float(0, "pos_x", gPlayer[playerid][pPosX]);
	cache_get_value_name_float(0, "pos_y", gPlayer[playerid][pPosY]);
	cache_get_value_name_float(0, "pos_z", gPlayer[playerid][pPosZ]);
	cache_get_value_name_float(0, "angle", gPlayer[playerid][pAngle]);
	cache_get_value_name_int(0, "interior", gPlayer[playerid][pInterior]);
	cache_get_value_name_int(0, "world", gPlayer[playerid][pWorld]);
	cache_get_value_name_int(0, "skin", gPlayer[playerid][pSkin]);
	cache_get_value_name_int(0, "played_ms", gPlayer[playerid][pPlayedMs]);
	DB_BankSessionReset(playerid, gPlayer[playerid][pCharId]);
	cache_get_value_name_int(0, "job", gPlayer[playerid][pJob]);
	cache_get_value_name_int(0, "faction", gPlayer[playerid][pFaction]);
	cache_get_value_name_int(0, "faction_rank", gPlayer[playerid][pFactionRank]);
	new cn[25];
	cache_get_value_name(0, "cn", cn, sizeof cn);
	CharSel_SetLoadedName(playerid, cn);
	gPlayer[playerid][pCivilSkin] = gPlayer[playerid][pSkin];
	Char_OnDBLoaded(playerid, true);
	return 1;
}

DB_CreateCharacter(playerid, accountId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!DB_IsReady() || accountId <= 0)
	{
		DB_DeliverFailure(playerid, 8);
		return 0;
	}
	new name[75], query[768], cn[25], first[21], last[21], birth[11];
	GetPlayerName(playerid, name, 75);
	CharSel_Identity(playerid, cn, first, last, birth);
	mysql_format(g_DB, query, 768, "INSERT IGNORE INTO characters (account_id, slot, char_name, first_name, last_name, birth_date, gender, money, bank, level, exp, health, armor, pos_x, pos_y, pos_z, angle, interior, world, skin, played_ms) VALUES (%d, %d, '%e', '%e', '%e', NULLIF('%e', ''), %d, %d, %d, %d, %d, %f, %f, %f, %f, %f, %f, %d, %d, %d, %d)", accountId, CharSel_Slot(playerid), cn, first, last, birth, gPlayer[playerid][pGender] == 1 ? 1 : 0, gPlayer[playerid][pMoney], gPlayer[playerid][pBank], gPlayer[playerid][pLevel], gPlayer[playerid][pExp], gPlayer[playerid][pHealth], gPlayer[playerid][pArmor], gPlayer[playerid][pPosX], gPlayer[playerid][pPosY], gPlayer[playerid][pPosZ], gPlayer[playerid][pAngle], gPlayer[playerid][pInterior], gPlayer[playerid][pWorld], gPlayer[playerid][pSkin], max(gPlayer[playerid][pPlayedMs], 0));
	g_BankDb[playerid] = gPlayer[playerid][pBank];
	DB_PendingSet(playerid, 8);
	mysql_tquery(g_DB, query, "DB_OnCharCreated", "ds", playerid, name);
	return 0;
}

public DB_OnCharCreated(playerid, const name[])
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 1;
	}
	DB_PendingClear(playerid, 8);
	if (gPlayer[playerid][pAuthState] != 7)
	{
		return 1;
	}
	new charId = 0;
	if (cache_affected_rows() == 1)
	{
		charId = cache_insert_id();
	}
	gPlayer[playerid][pCharId] = charId;
	if (charId > 0)
	{
		DB_BankSessionReset(playerid, charId);
		new q[128];   // numero di telefono in gioco come nella migrazione 012 (5550000 + id)
		mysql_format(g_DB, q, sizeof q, "UPDATE characters SET phone_number = 5550000 + id WHERE id = %d AND id < 10000 AND phone_number IS NULL", charId);
		mysql_tquery(g_DB, q);
	}
	if (charId > 0)
	{
		gPlayer[playerid][pCivilSkin] = gPlayer[playerid][pSkin];
	}
	Char_OnDBCreated(playerid, charId);
	return 1;
}

DB_SaveCharacter(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !DB_IsReady())
	{
		return 0;
	}
	if (gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	new query[768], skin, name[75];
	GetPlayerName(playerid, name, 75);
	new bankDelta = DB_BankDeltaTake(playerid);
	skin = gPlayer[playerid][pCivilSkin];
	mysql_format(g_DB, query, 768, "UPDATE characters SET money = %d, bank = GREATEST(0, LEAST(%d, CAST(bank AS SIGNED) + (%d))), level = %d, exp = %d, health = %f, armor = %f, pos_x = %f, pos_y = %f, pos_z = %f, angle = %f, interior = %d, world = %d, skin = %d, played_ms = %d, last_save = NOW(), last_played_at = NOW() WHERE id = %d", gPlayer[playerid][pMoney], 0x3B9ACA00, bankDelta, gPlayer[playerid][pLevel], gPlayer[playerid][pExp], gPlayer[playerid][pHealth], gPlayer[playerid][pArmor], gPlayer[playerid][pPosX], gPlayer[playerid][pPosY], gPlayer[playerid][pPosZ], gPlayer[playerid][pAngle], gPlayer[playerid][pInterior], gPlayer[playerid][pWorld], skin, max(gPlayer[playerid][pPlayedMs], 0), gPlayer[playerid][pCharId]);
	mysql_tquery(g_DB, query, "DB_OnBankDeltaSaved", "dsddd", playerid, name, gPlayer[playerid][pCharId], g_BankGen[playerid], bankDelta);
	return 0;
}

// ===== modules/database/db_admin.inc =====

DB_ReqSlot(requesterid)
{
	return requesterid >= 0 && requesterid < 1000 ? requesterid : 1000;
}

DB_ReqName(requesterid, name[], size)
{
	name[0] = 0;
	if (requesterid >= 0 && requesterid < 1000 && IsPlayerConnected(requesterid))
	{
		GetPlayerName(requesterid, name, size);
	}
}

DB_ReqResolve(requesterid, const reqName[])
{
	if (requesterid < 0 || requesterid >= 1000 || reqName[0] == 0)
	{
		return 65535;
	}
	if (!DB_PlayerMatches(requesterid, reqName))
	{
		return 65535;
	}
	return requesterid;
}

DB_ReqBegin(requesterid, op)
{
	g_DBAdminPending[DB_ReqSlot(requesterid)] |= op;
}

DB_ReqEnd(requesterid, op)
{
	g_DBAdminPending[DB_ReqSlot(requesterid)] &= ~op;
}

DB_AdminLog(staffAccountId, targetAccountId, const action[], const reason[])
{
	if (!DB_IsReady() || action[0] == 0)
	{
		return 0;
	}
	new query[1024], target[48];
	if (targetAccountId > 0)
	{
		format(target, 48, "%d", targetAccountId);
	}
	else
	{
		strcat(target, "NULL", 48);
	}
	mysql_format(g_DB, query, 1024, "INSERT INTO admin_log (staff_account_id, target_account_id, action, reason) VALUES (%d, %s, LEFT('%e', %d), LEFT('%e', %d))", max(staffAccountId, 0), target, action, 24, reason, 128);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_SetMute(accountId, untilTimestamp)
{
	if (!DB_IsReady() || accountId <= 0)
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET muted_until = %d WHERE id = %d", max(untilTimestamp, 0), accountId);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_SetAdminLevel(accountId, level)
{
	if (!DB_IsReady() || accountId <= 0 || level < 0 || level > 255)
	{
		return 0;
	}
	new query[512];
	mysql_format(g_DB, query, 512, "UPDATE accounts SET admin_level = %d WHERE id = %d", level, accountId);
	mysql_tquery(g_DB, query, "", "");
	return 0;
}

DB_AddWarn(requesterid, targetAccountId, staffAccountId, const reason[])
{
	if (!DB_IsReady() || targetAccountId <= 0)
	{
		DB_ReqBegin(requesterid, 1);
		DB_DeliverAdminFailure(DB_ReqSlot(requesterid), 1);
		return 0;
	}
	new query[1024], reqName[75];
	DB_ReqName(requesterid, reqName, 75);
	mysql_format(g_DB, query, 1024, "INSERT INTO warns (account_id, staff_account_id, reason) VALUES (%d, %d, LEFT('%e', %d))", targetAccountId, max(staffAccountId, 0), reason, 64);
	DB_ReqBegin(requesterid, 1);
	mysql_tquery(g_DB, query, "DB_OnWarnInserted", "dsd", requesterid, reqName, targetAccountId);
	return 0;
}

public DB_OnWarnInserted(requesterid, const reqName[], targetAccountId)
{
	new query[512];
	mysql_format(g_DB, query, 512, "SELECT COUNT(*) AS cnt FROM warns WHERE account_id = %d AND active = 1", targetAccountId);
	mysql_tquery(g_DB, query, "DB_OnWarnCounted", "dsd", requesterid, reqName, targetAccountId);
	return 1;
}

public DB_OnWarnCounted(requesterid, const reqName[], targetAccountId)
{
	DB_ReqEnd(requesterid, 1);
	new cnt = 0;
	cache_get_value_name_int(0, "cnt", cnt);
	if (funcidx("Admin_OnWarnAdded") != -1)
	{
		CallLocalFunction("Admin_OnWarnAdded", "ddd", DB_ReqResolve(requesterid, reqName), targetAccountId, cnt);
	}
	return 1;
}

DB_AddBan(requesterid, accountId, const name[], const ip[], staffAccountId, const reason[], minutes)
{
	if (!DB_IsReady() || name[0] == 0)
	{
		DB_ReqBegin(requesterid, 2);
		DB_DeliverAdminFailure(DB_ReqSlot(requesterid), 2);
		return 0;
	}
	new query[1024], reqName[75], accStr[48], expStr[144];
	DB_ReqName(requesterid, reqName, 75);
	if (accountId > 0)
	{
		format(accStr, 48, "%d", accountId);
	}
	else
	{
		strcat(accStr, "NULL", 48);
	}
	if (minutes > 0)
	{
		format(expStr, 144, "UNIX_TIMESTAMP() + %d", min(minutes, 5256000) * 60);
	}
	else
	{
		strcat(expStr, "NULL", 144);
	}
	mysql_format(g_DB, query, 1024, "INSERT INTO bans (account_id, account_name, ip, staff_account_id, reason, expires_at) VALUES (%s, LEFT('%e', 24), LEFT('%e', 15), %d, LEFT('%e', %d), %s)", accStr, name, ip, max(staffAccountId, 0), reason, 64, expStr);
	DB_ReqBegin(requesterid, 2);
	mysql_tquery(g_DB, query, "DB_OnBanInserted", "dss", requesterid, reqName, name);
	return 0;
}

public DB_OnBanInserted(requesterid, const reqName[], const name[])
{
	DB_ReqEnd(requesterid, 2);
	new banId = 0;
	if (cache_affected_rows() == 1)
	{
		banId = cache_insert_id();
	}
	if (funcidx("Admin_OnBanAdded") != -1)
	{
		CallLocalFunction("Admin_OnBanAdded", "dsd", DB_ReqResolve(requesterid, reqName), name, banId);
	}
	return 1;
}

DB_Unban(requesterid, const accountName[])
{
	if (!DB_IsReady() || accountName[0] == 0)
	{
		DB_ReqBegin(requesterid, 4);
		DB_DeliverAdminFailure(DB_ReqSlot(requesterid), 4);
		return 0;
	}
	new query[512], reqName[75];
	DB_ReqName(requesterid, reqName, 75);
	mysql_format(g_DB, query, 512, "UPDATE bans SET active = 0 WHERE active = 1 AND account_name = '%e'", accountName);
	DB_ReqBegin(requesterid, 4);
	mysql_tquery(g_DB, query, "DB_OnUnbanDone", "dss", requesterid, reqName, accountName);
	return 0;
}

public DB_OnUnbanDone(requesterid, const reqName[], const name[])
{
	DB_ReqEnd(requesterid, 4);
	if (funcidx("Admin_OnUnbanned") != -1)
	{
		CallLocalFunction("Admin_OnUnbanned", "dsd", DB_ReqResolve(requesterid, reqName), name, cache_affected_rows());
	}
	return 1;
}

DB_CheckBan(playerid, const name[], const ip[])
{
	#pragma unused ip
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!DB_IsReady())
	{
		DB_DeliverFailure(playerid, 16);
		return 0;
	}
	new query[512], pname[75];
	GetPlayerName(playerid, pname, 75);
	mysql_format(g_DB, query, 512, "UPDATE bans SET active = 0 WHERE active = 1 AND expires_at IS NOT NULL AND expires_at <= UNIX_TIMESTAMP() AND account_name = '%e'", name);
	mysql_tquery(g_DB, query, "", "");
	mysql_format(g_DB, query, 512, "SELECT reason, IFNULL(expires_at, 0) AS expires_at FROM bans WHERE active = 1 AND (expires_at IS NULL OR expires_at > UNIX_TIMESTAMP()) AND account_name = '%e' ORDER BY (expires_at IS NULL) DESC, expires_at DESC LIMIT 1", name);
	DB_PendingSet(playerid, 16);
	mysql_tquery(g_DB, query, "DB_OnBanChecked", "ds", playerid, pname);
	return 0;
}

public DB_OnBanChecked(playerid, const name[])
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return 1;
	}
	DB_PendingClear(playerid, 16);
	new rows = 0, reason[195], expiresAt = 0;
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name(0, "reason", reason, 195);
		cache_get_value_name_int(0, "expires_at", expiresAt);
	}
	if (funcidx("Admin_OnBanChecked") != -1)
	{
		CallLocalFunction("Admin_OnBanChecked", "ddsd", playerid, rows > 0 ? 1 : 0, reason, expiresAt);
	}
	return 1;
}

DB_FindAccountByName(requesterid, const name[], tag)
{
	new slot = DB_ReqSlot(requesterid);
	g_DBFindTag[slot] = tag;
	if (!DB_IsReady() || name[0] == 0)
	{
		DB_ReqBegin(requesterid, 8);
		DB_DeliverAdminFailure(slot, 8);
		return 0;
	}
	new query[512], reqName[75];
	DB_ReqName(requesterid, reqName, 75);
	mysql_format(g_DB, query, 512, "SELECT id, name, admin_level, IFNULL(last_ip, '') AS last_ip FROM accounts WHERE name = '%e' LIMIT 1", name);
	DB_ReqBegin(requesterid, 8);
	mysql_tquery(g_DB, query, "DB_OnAccountFound", "dsds", requesterid, reqName, tag, name);
	return 0;
}

public DB_OnAccountFound(requesterid, const reqName[], tag, const name[])
{
	DB_ReqEnd(requesterid, 8);
	new rows = 0, accountId = 0, adminLevel = 0, canon[75], lastIp[48];
	cache_get_row_count(rows);
	if (rows > 0)
	{
		cache_get_value_name_int(0, "id", accountId);
		cache_get_value_name(0, "name", canon, 75);
		cache_get_value_name_int(0, "admin_level", adminLevel);
		cache_get_value_name(0, "last_ip", lastIp, 48);
	}
	else
	{
		strcat(canon, name, 75);
	}
	if (funcidx("Admin_OnAccountFound") != -1)
	{
		CallLocalFunction("Admin_OnAccountFound", "dddsds", DB_ReqResolve(requesterid, reqName), tag, accountId, canon, adminLevel, lastIp);
	}
	return 1;
}

// ===== modules/database/db_vehicle.inc =====
new g_VehRows[MAX_PLAYERS][4][E_VEH_ROW];
new g_VehNew[MAX_PLAYERS][E_VEH_NEW];

DB_VehStaleRelease(playerid, op)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (!IsPlayerConnected(playerid))
	{
		DB_PendingClear(playerid, op);
	}
	return 0;
}

DB_VehCompensate(kind, ownerId, vehDbId)
{
	if (!DB_IsReady() || ownerId <= 0 || vehDbId <= 0)
	{
		Log_Write("DBVEH", "compensazione veicolo NON eseguita (db non pronto o id non valido): verificare a mano");
		return 0;
	}
	new query[512];
	if (kind == 1)
	{
		mysql_format(g_DB, query, 512, "UPDATE vehicles SET deleted = 1 WHERE id = %d AND owner_id = %d AND deleted = 0", vehDbId, ownerId);
	}
	else
	{
		mysql_format(g_DB, query, 512, "UPDATE vehicles SET deleted = 0 WHERE id = %d AND owner_id = %d AND deleted = 1", vehDbId, ownerId);
	}
	mysql_tquery(g_DB, query, "DB_OnVehicleCompensated", "ddd", kind, ownerId, vehDbId);
	return 0;
}

public DB_OnVehicleCompensated(kind, ownerId, vehDbId)
{
	new msg[384];
	format(msg, 384, "%s veicolo %d (owner %d) a sessione scaduta: righe=%d%s", kind == 1 ? "rollback creazione" : "ripristino vendita", vehDbId, ownerId, cache_affected_rows(), cache_affected_rows() == 1 ? "" : " ANOMALIA: verificare a mano");
	Log_Write("DBVEH", msg);
	return 1;
}

bool:DB_VehSessionOk(playerid, const name[], ownerId)
{
	if (!DB_PlayerMatches(playerid, name))
	{
		return false;
	}
	return ownerId > 0 && gPlayer[playerid][pCharId] == ownerId;
}

DB_LoadVehicles(playerid, ownerId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid))
	{
		return 0;
	}
	if (!DB_IsReady() || ownerId <= 0)
	{
		DB_DeliverFailure(playerid, 32);
		return 0;
	}
	new name[75], query[768];
	GetPlayerName(playerid, name, 75);
	mysql_format(g_DB, query, 768, "SELECT id, model, plate, color1, color2, price_paid, pos_x, pos_y, pos_z, pos_a, park_x, park_y, park_z, park_a, interior, world, health, fuel_cl, locked, destroyed FROM vehicles WHERE owner_id = %d AND deleted = 0 ORDER BY id LIMIT %d", ownerId, 4);
	DB_PendingSet(playerid, 32);
	mysql_tquery(g_DB, query, "DB_OnVehiclesLoaded", "dsd", playerid, name, ownerId);
	return 0;
}

public DB_OnVehiclesLoaded(playerid, const name[], ownerId)
{
	if (!DB_VehSessionOk(playerid, name, ownerId))
	{
		return 1;
	}
	DB_PendingClear(playerid, 32);
	new rows = 0, n = 0, tmp = 0;
	cache_get_row_count(rows);
	for (new i = 0; i < rows && n < 4; i++)
	{
		cache_get_value_name_int(i, "id", g_VehRows[playerid][n][vrId]);
		cache_get_value_name_int(i, "model", g_VehRows[playerid][n][vrModel]);
		cache_get_value_name(i, "plate", g_VehRows[playerid][n][vrPlate], 8);
		cache_get_value_name_int(i, "color1", g_VehRows[playerid][n][vrColor1]);
		cache_get_value_name_int(i, "color2", g_VehRows[playerid][n][vrColor2]);
		cache_get_value_name_int(i, "price_paid", g_VehRows[playerid][n][vrPricePaid]);
		cache_get_value_name_float(i, "pos_x", g_VehRows[playerid][n][vrPosX]);
		cache_get_value_name_float(i, "pos_y", g_VehRows[playerid][n][vrPosY]);
		cache_get_value_name_float(i, "pos_z", g_VehRows[playerid][n][vrPosZ]);
		cache_get_value_name_float(i, "pos_a", g_VehRows[playerid][n][vrPosA]);
		cache_get_value_name_float(i, "park_x", g_VehRows[playerid][n][vrParkX]);
		cache_get_value_name_float(i, "park_y", g_VehRows[playerid][n][vrParkY]);
		cache_get_value_name_float(i, "park_z", g_VehRows[playerid][n][vrParkZ]);
		cache_get_value_name_float(i, "park_a", g_VehRows[playerid][n][vrParkA]);
		cache_get_value_name_int(i, "interior", g_VehRows[playerid][n][vrInterior]);
		cache_get_value_name_int(i, "world", g_VehRows[playerid][n][vrWorld]);
		cache_get_value_name_float(i, "health", g_VehRows[playerid][n][vrHealth]);
		cache_get_value_name_int(i, "fuel_cl", g_VehRows[playerid][n][vrFuelCl]);
		cache_get_value_name_int(i, "locked", tmp);
		g_VehRows[playerid][n][vrLocked] = tmp != 0;
		cache_get_value_name_int(i, "destroyed", tmp);
		g_VehRows[playerid][n][vrDestroyed] = tmp != 0;
		n++;
	}
	if (funcidx("Veh_OnDBLoaded") != -1)
	{
		CallLocalFunction("Veh_OnDBLoaded", "dd", playerid, n);
	}
	return 1;
}

