	{
		UI_LvCefRep(playerid);
		return 0;
	}
	new body[2560], line[576], bar[192], lrep[240];
	strcopy(body, "{FFD24D}\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;\n", 1280);
	for (new t = 1; t <= 2; t++)
