Fac_RequestMembers(playerid, mode)
{
	new f = gPlayer[playerid][pFaction];
	if (f < 1)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;.");
		return 0;
	}
	if (g_FcMemBusy[playerid] && Fac_CdLeftMs(true, g_FcMemBusyTick[playerid], 10000) > 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\xAE;\xE1;\x83;\x9D;\xE1;\x83;\x95;\xE1;\x83;\x9C;\xE1;\x83;\x90; \xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\xA3;\xE1;\x83;\xA8;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;.");
		return 0;
	}
	g_FcMemBusy[playerid] = true;
	g_FcMemBusyTick[playerid] = GetTickCount();
	g_FcMemMode[playerid] = mode;
	DB_FactionMembers(playerid, f);
	return 0;
}

Faction_CmdFazione(playerid, const params[])
{
	if (gPlayer[playerid][pFaction] < 1 || gPlayer[playerid][pFactionRank] < 1)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\xAA;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xAC;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;.");
		return 0;
	}
	new pos = 0, sub[48];
	Util_NextToken(params, pos, sub, 48);
	if (sub[0] == 0 || !strcmp(sub, "info", true, 0x7FFFFFFF))
	{
		Fac_RequestMembers(playerid, 0);
		return 0;
	}
	if (!strcmp(sub, "membri", true, 0x7FFFFFFF))
	{
		Fac_RequestMembers(playerid, 2);
		return 0;
	}
	if (!strcmp(sub, "lascia", true, 0x7FFFFFFF))
	{
		if (Fac_CmdBlocked(playerid) || !Fac_NeedActive(playerid))
		{
			return 0;
		}
		GetPlayerName(playerid, g_FcOpName[playerid], 25);
		DB_FactionLeave(playerid, gPlayer[playerid][pCharId], gPlayer[playerid][pFaction]);
		return 0;
	}
	Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /fazione [info|membri|lascia]");
	return 0;
}

public UI_OnFactionMenuAction(playerid, action)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pFaction] < 1)
	{
		return 1;
	}
	if (action != 2 && gPlayer[playerid][pFactionRank] < 5)
	{
		return 1;
	}
	Fac_RequestMembers(playerid, action);
	return 1;
}

public Faction_OnDBMembers(playerid, faction, count)
{
	if (!Fac_ValidPlayer(playerid))
	{
		return 1;
	}
	g_FcMemBusy[playerid] = false;
	if (count < 0)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;.");
		return 1;
	}
	if (gPlayer[playerid][pFaction] != faction || faction < 1)
	{
		return 1;
	}
	new mode = g_FcMemMode[playerid], online = 0;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (Util_IsPlaying(i) && gPlayer[i][pFaction] == faction)
		{
			online++;
		}
	}
	if (mode == 0)
	{
		UI_FactionMenuShow(playerid, faction, gPlayer[playerid][pFactionRank], bool:gPlayer[playerid][pOnDuty], online, count);
		return 1;
	}
	UI_FactionMemberListClear(playerid);
	g_FcMemCount[playerid] = 0;
	for (new i = 0; i < count; i++)
	{
		new other = Fac_FindByChar(g_FacMembers[i][fmCharId]), status = 0;
		if (other != INVALID_PLAYER_ID)
		{
			status = gPlayer[other][pOnDuty] ? 2 : 1;
		}
		if (!UI_FactionMemberListAdd(playerid, g_FacMembers[i][fmCharId], g_FacMembers[i][fmName], g_FacMembers[i][fmRank], status))
		{
			break;
		}
		new n = g_FcMemCount[playerid];
		if (n >= 32)
		{
			break;
		}
		g_FcMemChar[playerid][n] = g_FacMembers[i][fmCharId];
		g_FcMemRank[playerid][n] = g_FacMembers[i][fmRank];
		strpack(g_FcMemName[playerid][n], g_FacMembers[i][fmName], 7);
		g_FcMemCount[playerid] = n + 1;
	}
	UI_FactionMembersShow(playerid, faction, gPlayer[playerid][pFactionRank], mode);
	return 1;
}

Fac_SetStart(staff, targetChar, targetAcc, const targetName[], faction, rank)
{
	g_FcSetActive[staff] = true;
	g_FcSetTargetChar[staff] = targetChar;
	g_FcSetTargetAcc[staff] = targetAcc;
	g_FcSetStaffAcc[staff] = gPlayer[staff][pAccountId];
	g_FcSetFac[staff] = faction;
	g_FcSetRank[staff] = rank;
	strmid(g_FcSetName[staff], targetName, 0, strlen(targetName), 25);
	GetPlayerName(staff, g_FcSetStaffName[staff], 25);
	DB_FactionSet(staff, targetChar, faction, rank);
}

bool:Faction_CmdSetfazione(playerid, const params[])
{
	if (Util_GetAdmin(playerid) < 3)
	{
		return false;
	}
	new pos = 0, who[75], tf[36], tr[36], faction = 0, rank = 0;
	Util_NextToken(params, pos, who, 75);
	Util_NextToken(params, pos, tf, 36);
	Util_NextToken(params, pos, tr, 36);
	if (who[0] == 0 || !Util_ParseInt(tf, faction) || faction < 0 || faction > 2 || (faction != 0 && (!Util_ParseInt(tr, rank) || rank < 1 || rank > 6)))
	{
		SendClientMessage(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /setfazione id|\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;_\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;(%d-%d, 0 = \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA8;\xE1;\x83;\x9A;\xE1;\x83;\x90;) \xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;(1-%d)", 0, 2, 6);
		return true;
	}
	if (faction == 0)
	{
		rank = 0;
	}
	if (g_FcSetActive[playerid])
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\xA3;\xE1;\x83;\x99;\xE1;\x83;\x95;\xE1;\x83;\x94; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x9B;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94; /setfazione \xE1;\x83;\x9D;\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;.");
		return true;
	}
	new targetid = INVALID_PLAYER_ID;
	if (Util_ParsePlayerId(who, targetid))
	{
		if (!Util_IsPlaying(targetid) || gPlayer[targetid][pCharId] <= 0)
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;.");
			return true;
		}
	}
	else
	{
		targetid = Admin_FindByName(who);
	}
	if (targetid != INVALID_PLAYER_ID && gPlayer[targetid][pLoggedIn] && gPlayer[targetid][pCharId] > 0)
	{
		new tn[75];
		GetPlayerName(targetid, tn, 75);
		Fac_SetStart(playerid, gPlayer[targetid][pCharId], gPlayer[targetid][pAccountId], tn, faction, rank);
		return true;
	}
	if (!Util_IsValidRPName(who))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\xAC;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; (\xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\x97;\xE1;\x83;\x98;\xE1;\x83;\x97;\xE1;\x83;\x94; id \xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;_\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;).");
		return true;
	}
	g_FcSetActive[playerid] = true;
	g_FcSetTargetChar[playerid] = 0;
	g_FcSetTargetAcc[playerid] = 0;
	g_FcSetStaffAcc[playerid] = gPlayer[playerid][pAccountId];
	g_FcSetFac[playerid] = faction;
	g_FcSetRank[playerid] = rank;
	strmid(g_FcSetName[playerid], who, 0, strlen(who), 25);
	GetPlayerName(playerid, g_FcSetStaffName[playerid], 25);
	DB_FactionFindByName(playerid, who, 1);
	return true;
}

public Faction_OnDBFound(playerid, tag, charId, const name[], faction, rank, level)
{
	if (tag != 1 || !Fac_ValidPlayer(playerid) || !g_FcSetActive[playerid] || g_FcSetTargetChar[playerid] != 0)
	{
		return 1;
	}
	if (charId <= 0)
	{
		g_FcSetActive[playerid] = false;
		Util_Send(playerid, -10270721, charId < 0 ? "\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x98; \xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x9D;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x92;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\x97;." : "\xE1;\x83;\x9E;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x9F;\xE1;\x83;\x98; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAB;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x9C;\xE1;\x83;\x90;.");
		return 1;
	}
	new f = g_FcSetFac[playerid], r = g_FcSetRank[playerid];
	Fac_SetStart(playerid, charId, 0, name, f, r);
	return 1;
}

public Faction_OnTick()
{
	new now = GetTickCount();
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i))
		{
			continue;
		}
		if (g_FcInvActive[i] && Fac_CdLeftMs(true, g_FcInvStart[i], 60000) <= 0)
		{
			new from = g_FcInvFrom[i], fromChar = g_FcInvFromChar[i];
			Fac_ClearInvite(i, true);
			Util_Send(i, -1, "\xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;.");
			if (Fac_ValidPlayer(from) && gPlayer[from][pCharId] == fromChar)
			{
				Util_Send(from, -1, "\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;.");
			}
		}
		if (!gPlayer[i][pSpawned] || !Util_IsPlaying(i))
		{
			continue;
		}
		if (gPlayer[i][pCuffed])
		{
			new by = g_FcCuffBy[i];
			if (Fac_CdLeftMs(true, g_FcCuffTick[i], 600000) <= 0 || !Util_IsPlaying(by) || !gPlayer[by][pOnDuty])
			{
				Fac_Uncuff(i);
			}
		}
		if (gPlayer[i][pOnDuty])
		{
			if (gPlayer[i][pFaction] < 1 || Admin_IsMuted(i))
			{
				Faction_ForceOff(i, true);
				Util_Send(i, -10270721, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x92;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x95;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\xA1;.");
			}
			else
			{
				Fac_PayTick(i, now);
			}
		}
		if (g_FcRevTarget[i] != 65535)
		{
			new t = g_FcRevTarget[i];
			if (!gPlayer[i][pOnDuty] || gPlayer[i][pWounded] || gPlayer[i][pCuffed])
			{
				Fac_ReviveCancel(i, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
			}
			else if (!Util_IsPlaying(t) || gPlayer[t][pCharId] != g_FcRevTargetChar[i] || !gPlayer[t][pWounded])
			{
				Fac_ReviveCancel(i, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA6;\xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98;.");
			}
			else if (!Util_InRange(i, t, (3.0 + 1.0)))
			{
				Fac_ReviveCancel(i, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\x93;\xE1;\x83;\x98;.");
			}
			else if (now - g_FcRevStart[i] >= 8000)
			{
				if (g_FcKit[i] > 0)
				{
					Fac_ReviveDone(i, t);
				}
				else
				{
					Fac_ReviveCancel(i, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x93;\xE1;\x83;\x98;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x9D; \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xAC;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x90;.");
				}
			}
		}
		if (gPlayer[i][pWounded])
		{
			g_FcInjLeftMs[i] -= 500;
			if (g_FcInjLeftMs[i] <= 0)
			{
				Faction_Hospitalize(i);
				continue;
			}
			new sec = Fac_SecCeil(g_FcInjLeftMs[i]);
			if (sec != g_FcInjSec[i])
			{
				g_FcInjSec[i] = sec;
				UI_InjuryHudUpdate(i, sec);
				Fac_ApplyInjuredPose(i);
			}
		}
	}
	return 1;
}

Faction_OnInit()
{
	for (new p = 0; p < MAX_PLAYERS; p++)
	{
		Faction_ResetPlayer(p);
	}
	g_FacTimer = SetTimer("Faction_OnTick", 500, true);
}

Faction_OnExit()
{
	if (g_FacTimer != 0)
	{
		KillTimer(g_FacTimer);
	}
	g_FacTimer = 0;
}

Faction_OnPlayerConnect(playerid)
{
	Faction_ResetPlayer(playerid);
}

Faction_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	Fac_ReleaseCuffedBy(playerid);
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, true);
	}
	if (g_FcInvActive[playerid])
	{
		Fac_ClearInvite(playerid, false);
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FcInvActive[i] && g_FcInvFrom[i] == playerid)
		{
			Fac_ClearInvite(i, true);
		}
		if (g_FcRevTarget[i] == playerid)
		{
			Fac_ReviveCancel(i, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;: \xE1;\x83;\x9E;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		}
	}
	if (gPlayer[playerid][pWounded])
	{
		gPlayer[playerid][pWounded] = 0;
		gPlayer[playerid][pPosX] = 1182.0;
		gPlayer[playerid][pPosY] = -1330.0;
		gPlayer[playerid][pPosZ] = 13.9;
		gPlayer[playerid][pAngle] = 270.0;
		gPlayer[playerid][pInterior] = 0;
		gPlayer[playerid][pWorld] = 0;
		gPlayer[playerid][pHealth] = 100.0;
		gPlayer[playerid][pArmor] = 0.0;
		gPlayer[playerid][pSpawned] = 0;
	}
	gPlayer[playerid][pSkin] = gPlayer[playerid][pCivilSkin];
	Faction_ResetPlayer(playerid);
	return 0;
}

Faction_OnPlayerDeath(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	Fac_ReleaseCuffedBy(playerid);
	if (gPlayer[playerid][pCuffed])
	{
		gPlayer[playerid][pCuffed] = 0;
		g_FcCuffBy[playerid] = 65535;
	}
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, false);
	}
	g_FcRevTarget[playerid] = 65535;
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (g_FcRevTarget[i] == playerid)
		{
			Fac_ReviveCancel(i, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xAA;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\xAC;\xE1;\x83;\xA7;\xE1;\x83;\x93;\xE1;\x83;\x90;.");
		}
	}
	if (gPlayer[playerid][pWounded])
	{
		g_FcHospPending[playerid] = true;
		return 0;
	}
	gPlayer[playerid][pWounded] = 1;
	g_FcInjLeftMs[playerid] = 180000;
	g_FcInjSec[playerid] = -1;
	UI_InjuryHudHide(playerid);
	return 0;
}

Faction_OnPlayerSpawn(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || !gPlayer[playerid][pSpawned])
	{
		return 0;
	}
	if (gPlayer[playerid][pOnDuty])
	{
		Faction_ForceOff(playerid, true);
	}
	if (g_FcHospPending[playerid])
	{
		Faction_Hospitalize(playerid);
		return 0;
	}
	if (!gPlayer[playerid][pWounded])
	{
		return 0;
	}
	SetPlayerHealth(playerid, 25.0);
	Faction_UpdateControl(playerid);
	Fac_ApplyInjuredPose(playerid);
	g_FcInjLeftMs[playerid] = 180000;
	g_FcInjSec[playerid] = 180;
	UI_InjuryHudShow(playerid, 180);
	SendClientMessage(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;. \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;\xE1;\x83;\xA1; (EMS): \xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\xA8;\xE1;\x83;\x94; %d \xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xB0;\xE1;\x83;\x9D;\xE1;\x83;\xA1;\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x96;\xE1;\x83;\x93;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; ($%d).", 180, 200);
	return 0;
}

Faction_SendHelp(playerid)
{
	new f = gPlayer[playerid][pFaction], rank = gPlayer[playerid][pFactionRank];
	if (f < 1 || rank < 1)
	{
		return 0;
	}
	SendClientMessage(playerid, -2994689, "--- \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90; %s ---", g_FacShort[f]);
	Util_Send(playerid, 0x99CCFFFF, "/fazione [info|membri|lascia] \xC2;\xB7; /duty (\xE1;\x83;\xA8;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\x91;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;) \xC2;\xB7; /r \xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xC2;\xB7; /dep \xE1;\x83;\xA2;\xE1;\x83;\x94;\xE1;\x83;\xA5;\xE1;\x83;\xA1;\xE1;\x83;\xA2;\xE1;\x83;\x98;");
	if (f == 1)
	{
		Util_Send(playerid, 0x99CCFFFF, "/ammanetta id \xC2;\xB7; /smanetta id");
		if (rank >= 2)
		{
			Util_Send(playerid, 0x99CCFFFF, "/multa id \xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xAE;\xE1;\x83;\x90; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\x96;\xE1;\x83;\x94;\xE1;\x83;\x96;\xE1;\x83;\x98;");
		}
	}
	else
	{
		Util_Send(playerid, 0x99CCFFFF, "/cura id \xC2;\xB7; /rianima id");
	}
	if (rank >= 5)
	{
		Util_Send(playerid, 0x99CCFFFF, "/invita id \xC2;\xB7; /promuovi id \xC2;\xB7; /degrada id \xC2;\xB7; /licenzia id");
	}
	return 0;
}

// ===== modules/inventory/inv_doc.inc =====

public Inv_ShowDocument(playerid, viewerid)
{
	if (!Inv_ValidPlayer(playerid) || !Inv_ValidPlayer(viewerid))
	{
		return 1;
	}
	new name[75], job[72], fac[72], rank[72];
	GetPlayerName(playerid, name, 75);
	Job_NameOf(gPlayer[playerid][pJob], job, 72);
	Fac_ShortName(gPlayer[playerid][pFaction], fac, 72);
	Fac_RankName(gPlayer[playerid][pFaction], gPlayer[playerid][pFactionRank], rank, 72);
	new total = gPlayer[playerid][pPlayedMs];
	SendClientMessage(viewerid, -2994689, "--- \xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9C;-\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\x93;\xE1;\x83;\xA0;\xE1;\x83;\x94;\xE1;\x83;\x90;\xE1;\x83;\xA1;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; ---");
	SendClientMessage(viewerid, -1, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;: %s  \xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9C;\xE1;\x83;\x94;: %d  \xE1;\x83;\x9C;\xE1;\x83;\x90;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98;: %d\xE1;\x83;\xA1;\xE1;\x83;\x97; %02d\xE1;\x83;\xAC;\xE1;\x83;\x97;", name, gPlayer[playerid][pLevel], total / 3600000, total % 3600000 / 60000);
	new origin[72];
	UI_StoryOriginName(gPlayer[playerid][pStoryOrigin], origin, 72);
	if (origin[0] != 0)
	{
		SendClientMessage(viewerid, -1, "\xE1;\x83;\xAC;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\x95;\xE1;\x83;\x9A;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90;: %s", origin);
	}
	if (gPlayer[playerid][pFaction] > 0)
	{
		SendClientMessage(viewerid, -1, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;: %s  \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;: %s (%s)", job, fac, rank);
	}
	else
	{
		SendClientMessage(viewerid, -1, "\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\xA3;\xE1;\x83;\xA0;\xE1;\x83;\x98;: %s  \xE1;\x83;\xA4;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\xAA;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x90;", job);
	}
	return 1;
}

Inv_CmdDocumento(playerid, const params[])
{
	new pos = 0, tok[72], target = 0;
	Util_NextToken(params, pos, tok, 72);
	if (!strcmp(tok, "richiedi", true, 0x7FFFFFFF))
	{
		Inv_DocRequest(playerid);
		return 0;
	}
	if (!Inv_Ready(playerid))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x98;\xE1;\x83;\x9C;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x90;\xE1;\x83;\xA0;\xE1;\x83;\x98; \xE1;\x83;\x9B;\xE1;\x83;\x98;\xE1;\x83;\xA3;\xE1;\x83;\xAC;\xE1;\x83;\x95;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;: \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98; \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; (/inventario).");
		return 0;
	}
	if (Inv_Count(playerid, 10) < 1)
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x9E;\xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xAC;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x91;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x95;\xE1;\x83;\xA1;: \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x98;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; /documento richiedi.");
		return 0;
	}
	if (tok[0] == 0)
	{
		Inv_ShowDocument(playerid, playerid);
		return 0;
	}
	if (!Util_ParsePlayerId(tok, target) || !Util_IsPlaying(target))
	{
		Util_Send(playerid, 0x99CCFFFF, "\xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\xA7;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: /documento \xC2;\xB7; /documento [id] \xC2;\xB7; /documento richiedi");
		return 0;
	}
	if (target != playerid && !Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "\xE1;\x83;\x9B;\xE1;\x83;\x9D;\xE1;\x83;\x97;\xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA8;\xE1;\x83;\x94; \xE1;\x83;\xAB;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x98;\xE1;\x83;\x90;\xE1;\x83;\x9C; \xE1;\x83;\xA8;\xE1;\x83;\x9D;\xE1;\x83;\xA0;\xE1;\x83;\xA1;\xE1;\x83;\x90;\xE1;\x83;\x90;.");
		return 0;
	}
	new tname[75];
	GetPlayerName(target, tname, 75);
	Inv_ShowDocument(playerid, target);
	if (target != playerid)
	{
		SendClientMessage(playerid, 0x66DD66FF, "\xE1;\x83;\x93;\xE1;\x83;\x9D;\xE1;\x83;\x99;\xE1;\x83;\xA3;\xE1;\x83;\x9B;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\xA2;\xE1;\x83;\x98; \xE1;\x83;\x90;\xE1;\x83;\xA9;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x9C;\xE1;\x83;\x94; %s-\xE1;\x83;\xA1;.", tname);
	}
	return 0;
}

// ===== modules/living/living_calc.inc =====

LD_Clamp(v, lo, hi)
{
	if (v < lo)
	{
		return lo;
	}
	if (v > hi)
	{
		return hi;
	}
	return v;
}

LD_Hash32(a, b, c)
{
	new h = 0x811C9DC5, v[3];
	v[0] = a;
	v[1] = b;
	v[2] = c;
	for (new i = 0; i < 3; i++)
	{
		for (new s = 0; s < 32; s += 8)
		{
			h ^= v[i] >>> s & 255;
			h *= 0x01000193;
		}
	}
	return h;
}

LD_HashMod(h, n)
{
	if (n <= 0)
	{
		return 0;
	}
	return (h & 0x7FFFFFFF) % n;
}

LD_Bucket(unixTs)
{
	if (unixTs <= 0)
	{
		return 0;
	}
	return unixTs / 1800;
}

bool:LD_ContractSlot(bucket, slot, &fromD, &toD, &cargo)
{
	new h = LD_Hash32(bucket, slot, 1);
	fromD = LD_HashMod(h, 3) + 1;
	new off = LD_HashMod(h >>> 8, 2) + 1;
	toD = (fromD - 1 + off) % 3 + 1;
	cargo = LD_HashMod(h >>> 16, 3) + 1;
	return true;
}

LD_ProTier(points)
{
	if (points >= 600)
	{
		return 3;
	}
	if (points >= 300)
	{
		return 2;
	}
	if (points >= 100)
	{
		return 1;
	}
	return 0;
}

LD_ProBonusPct(points)
{
	switch (LD_ProTier(points))
	{
		case 1:
		{
			return 5;
		}
		case 2:
		{
			return 10;
		}
		case 3:
		{
			return 15;
		}
	}
	return 0;
}

LD_LocalRepLevel(rep)
{
	if (rep >= 40)
	{
		return 2;
	}
	if (rep >= 10)
	{
		return 1;
	}
	return 0;
}

LD_DiscountPct(rep)
{
	switch (LD_LocalRepLevel(rep))
	{
		case 1:
		{
			return 5;
		}
		case 2:
		{
			return 10;
		}
	}
	return 0;
}

LD_ApplyDiscount(amount, rep)
{
	if (amount <= 0)
	{
		return 0;
	}
	new a = LD_Clamp(amount, 0, 10000000);
	return a - a * LD_DiscountPct(rep) / 100;
}

LD_FreightMinSeconds(distM)
{
	new d = LD_Clamp(distM, 0, 100000);
	new s = (d + 40 - 1) / 40;
	return s > 25 ? s : 25;
}

LD_FreightTimeLimit(distM)
{
	new d = LD_Clamp(distM, 0, 100000);
	return d * 10 / 60 + 120;
}

LD_TaxiFare(meters)
{
	new m = LD_Clamp(meters, 0, 100000);
	return m * 12 / 100 + 15;
}

LD_TaxiFareFor(meters, rep)
{
	return LD_ApplyDiscount(LD_TaxiFare(meters), rep);
}

LD_TaxiNpcPay(fare, proPoints)
{
	if (fare <= 0)
	{
		return 0;
	}
	return LD_Clamp(fare, 0, 10000000) * (LD_ProBonusPct(proPoints) + 100) / 100;
}

LD_RentalModel(vkind)
{
	switch (vkind)
	{
		case 1:
		{
			return 462;
		}
		case 2:
		{
			return 436;
		}
		case 3:
		{
			return 410;
		}
		case 4:
		{
			return 420;
		}
	}
	return 0;
}

LD_RentalDeposit(vkind)
{
	switch (vkind)
	{
		case 1:
		{
			return 200;
		}
		case 2:
		{
			return 400;
		}
		case 3:
		{
			return 450;
		}
		case 4:
		{
			return 300;
		}
	}
	return 0;
}

LD_RentalFee(vkind, blocks)
{
	if (blocks < 1 || blocks > 3)
	{
		return 0;
	}
	switch (vkind)
	{
		case 1:
		{
			return blocks * 30;
		}
		case 2:
		{
			return blocks * 60;
		}
		case 3:
		{
			return blocks * 70;
		}
	}
	return 0;
}

LD_RentalFeeFor(vkind, blocks, rep)
{
	return LD_ApplyDiscount(LD_RentalFee(vkind, blocks), rep);
}

LD_RentalRefund(deposit, health)
{
	if (deposit <= 0)
	{
		return 0;
	}
	new dep = LD_Clamp(deposit, 0, 10000);
	if (health >= 1000)
	{
		return dep;
	}
	if (health <= 300)
	{
		return 0;
	}
	new span = 700;
	new r = (dep * 2 * (health - 300) + span) / (span * 2);
	return LD_Clamp(r, 0, dep);
}

bool:LD_DonationValid(amount, donatedToday)
{
	if (amount < 50 || amount > 500)
	{
		return false;
	}
	if (donatedToday < 0)
	{
		return false;
	}
	return donatedToday + amount <= 1000;
}

LD_FloatKey(Float:f)
{
	new i = _:f;
	return i >= 0 ? i : cellmin - i;
}

bool:LD_InBox(kx, ky, Float:x1, Float:y1, Float:x2, Float:y2)
{
	return kx >= LD_FloatKey(x1) && kx <= LD_FloatKey(x2) && ky >= LD_FloatKey(y1) && ky <= LD_FloatKey(y2);
}

District_At(Float:x, Float:y)
{
	new kx = LD_FloatKey(x), ky = LD_FloatKey(y);
	if (LD_InBox(kx, ky, 1812.0, -1880.0, 1971.0, -1742.0))
	{
		return 1;
	}
	if (LD_InBox(kx, ky, 2222.0, -1852.0, 2632.0, -1628.0))
	{
		return 2;
	}
	if (LD_InBox(kx, ky, 2056.0, -1287.0, 2281.0, -1115.0))
	{
		return 3;
	}
	return 0;
}

bool:LD_StrEqI(const a[], const b[])
{
	new i = 0;
	while (a[i] != 0 && b[i] != 0)
	{
		if (tolower(a[i]) != tolower(b[i]))
		{
			return false;
		}
		i++;
	}
	return a[i] == 0 && b[i] == 0;
}

LD_ParseDistrict(const name[])
{
	if (name[0] >= 49 && name[0] < 52 && name[1] == 0)
	{
		return name[0] - 48;
	}
	if (LD_StrEqI(name, "idlewood"))
	{
		return 1;
	}
	if (LD_StrEqI(name, "ganton"))
	{
		return 2;
	}
	if (LD_StrEqI(name, "jefferson"))
	{
		return 3;
	}
	return 0;
}

LD_CopyStr(dest[], size, const src[])
{
	if (size <= 0)
	{
		return 0;
	}
	new i = 0;
	while (src[i] != 0 && i < size - 1)
	{
		dest[i] = src[i];
		i++;
	}
	dest[i] = 0;
	return i;
}

LD_DistrictName(id, dest[], size)
{
	switch (id)
	{
		case 1:
		{
			return LD_CopyStr(dest, size, "Idlewood");
		}
		case 2:
		{
			return LD_CopyStr(dest, size, "Ganton");
		}
		case 3:
		{
			return LD_CopyStr(dest, size, "Jefferson");
		}
	}
	return LD_CopyStr(dest, size, "-");
}

// ===== modules/living/living_api.inc =====
new bool:g_LdReady;
new g_LdLsnName[8][32];
new g_LdLsnPrio[8];
new g_LdLsnCount;
new g_LdEmitDepth;
new g_LdVehMod[2000];
new g_LdVehOwner[2000];
new g_LdVehSerial[2000];
new g_LdVehSerialSeq;
new g_LdPool;

bool:LD_IsReady()
{
	return g_LdReady;
}

LD_SetReady(bool:ready)
{
	g_LdReady = ready;
	if (!ready)
	{
		return 0;
	}
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		Living_TryCharReady(i);
	}
	return 0;
}

bool:LD_LsnBefore(prio, const fn[], idx)
{
	if (prio != g_LdLsnPrio[idx])
	{
		return prio < g_LdLsnPrio[idx];
	}
	return bool:(strcmp(fn, g_LdLsnName[idx], false, 0x7FFFFFFF) < 0);
}

bool:LD_Listen(const fn[], prio)
{
	if (strlen(fn) >= 32 || funcidx(fn) == -1)
	{
		return false;
	}
	for (new i = 0; i < g_LdLsnCount; i++)
	{
		if (!strcmp(fn, g_LdLsnName[i], false, 0x7FFFFFFF))
		{
			return false;
		}
	}
	if (g_LdLsnCount >= 8)
	{
		return false;
	}
	new pos = g_LdLsnCount;
	while (pos > 0 && LD_LsnBefore(prio, fn, pos - 1))
	{
		g_LdLsnPrio[pos] = g_LdLsnPrio[pos - 1];
		strmid(g_LdLsnName[pos], g_LdLsnName[pos - 1], 0, 32, 32);
		pos--;
	}
	g_LdLsnPrio[pos] = prio;
	strmid(g_LdLsnName[pos], fn, 0, 32, 32);
	g_LdLsnCount++;
	return true;
}

LD_Emit(type, districtId, charId, value, const opId[])
{
	if (g_LdEmitDepth >= 2)
	{
		new msg[256];
		format(msg, 256, "evento %d scartato (annidamento): quartiere %d pers. %d valore %d", type, districtId, charId, value);
		Log_Write("LIVING", msg);
		return 0;
	}
	g_LdEmitDepth++;
	new n = g_LdLsnCount;
	for (new i = 0; i < n; i++)
	{
		if (opId[0] == 0)
		{
			CallLocalFunction(g_LdLsnName[i], "dddds", type, districtId, charId, value, "-");
		}
		else
		{
			CallLocalFunction(g_LdLsnName[i], "dddds", type, districtId, charId, value, opId);
		}
	}
	g_LdEmitDepth--;
	return n;
}

LD_OnboardAction(playerid, step)
{
	if (!Util_IsPlaying(playerid) || gPlayer[playerid][pCharId] <= 0)
	{
		return 0;
	}
	LD_Emit(106, 0, gPlayer[playerid][pCharId], step, "-");
	return 0;
}

LD_GetLocalRep(playerid, districtId)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || districtId < 1 || districtId > 3)
	{
		return 0;
	}
	return gPlayer[playerid][pDistrictRep][districtId];
}

LD_GetProPoints(playerid, track)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || track < 1 || track > 2)
	{
		return 0;
	}
	return gPlayer[playerid][pProPoints][track];
}

LD_SetProPoints(playerid, track, points)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS || track < 1 || track > 2)
	{
		return 0;
	}
	gPlayer[playerid][pProPoints][track] = points > 0 ? points : 0;
	return 0;
}

LD_ActiveFlow(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS)
	{
		return 0;
	}
	if (Job_IsOnShift(playerid))
	{
		return 1;
	}
	if (gPlayer[playerid][pContractId] != 0 || gPlayer[playerid][pFreightWelcome] != 0)
	{
		return 2;
	}
	if (gPlayer[playerid][pTaxiOnDuty] != 0 || gPlayer[playerid][pRentalClass] == 2)
	{
		return 3;
	}
	if (gPlayer[playerid][pRentalId] != 0)
	{
		return 4;
	}
	return 0;
}

LD_CheckStart(playerid)
{
	if (!g_LdReady || gPlayer[playerid][pLivingReady] == 0)
	{
		return 1;
	}
	if (gPlayer[playerid][pWounded])
	{
		return 2;
	}
	if (gPlayer[playerid][pCuffed])
	{
		return 3;
	}
	if (LD_ActiveFlow(playerid) != 0)
	{
		return 4;
	}
	return 0;
}

bool:LD_SendBlock(playerid, block)
{
	switch (block)
	{
		case 1:
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\xA5;\xE1;\x83;\x90;\xE1;\x83;\x9A;\xE1;\x83;\x90;\xE1;\x83;\xA5;\xE1;\x83;\x98;\xE1;\x83;\xA1; \xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\xA0;\xE1;\x83;\x95;\xE1;\x83;\x98;\xE1;\x83;\xA1;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x98; \xE1;\x83;\x98;\xE1;\x83;\xA0;\xE1;\x83;\x97;\xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\x91;\xE1;\x83;\x90;: \xE1;\x83;\xA1;\xE1;\x83;\xAA;\xE1;\x83;\x90;\xE1;\x83;\x93;\xE1;\x83;\x94; \xE1;\x83;\xAA;\xE1;\x83;\x9D;\xE1;\x83;\xA2;\xE1;\x83;\x90; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\x9C;\xE1;\x83;\xA8;\xE1;\x83;\x98;.");
		}
		case 2:
		{
			Util_Send(playerid, -10270721, "\xE1;\x83;\x93;\xE1;\x83;\x90;\xE1;\x83;\xAD;\xE1;\x83;\xA0;\xE1;\x83;\x98;\xE1;\x83;\x9A;\xE1;\x83;\x98; \xE1;\x83;\xAE;\xE1;\x83;\x90;\xE1;\x83;\xA0;: \xE1;\x83;\x90;\xE1;\x83;\xAE;\xE1;\x83;\x9A;\xE1;\x83;\x90; \xE1;\x83;\x90;\xE1;\x83;\x9B;\xE1;\x83;\x90;\xE1;\x83;\xA1; \xE1;\x83;\x95;\xE1;\x83;\x94;\xE1;\x83;\xA0; \xE1;\x83;\x92;\xE1;\x83;\x90;\xE1;\x83;\x90;\xE1;\x83;\x99;\xE1;\x83;\x94;\xE1;\x83;\x97;\xE1;\x83;\x94;\xE1;\x83;\x91;.");
		}
		case 3:
		{
