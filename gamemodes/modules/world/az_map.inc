#define AZMAP_PARTS (30)

// crea il pezzo p (0 .. AZMAP_PARTS-1) del mapping; chiamata a tappe dall'avvio
AzMap_CreatePart(p)
{
	switch (p)
	{
		case 0: AzMap_Part0();
		case 1: AzMap_Part1();
		case 2: AzMap_Part2();
		case 3: AzMap_Part3();
		case 4: AzMap_Part4();
		case 5: AzMap_Part5();
		case 6: AzMap_Part6();
		case 7: AzMap_Part7();
		case 8: AzMap_Part8();
		case 9: AzMap_Part9();
		case 10: AzMap_Part10();
		case 11: AzMap_Part11();
		case 12: AzMap_Part12();
		case 13: AzMap_Part13();
		case 14: AzMap_Part14();
		case 15: AzMap_Part15();
		case 16: AzMap_Part16();
		case 17: AzMap_Part17();
		case 18: AzMap_Part18();
		case 19: AzMap_Part19();
		case 20: AzMap_Part20();
		case 21: AzMap_Part21();
		case 22: AzMap_Part22();
		case 23: AzMap_Part23();
		case 24: AzMap_Part24();
		case 25: AzMap_Part25();
		case 26: AzMap_Part26();
		case 27: AzMap_Part27();
		case 28: AzMap_Part28();
		case 29: AzMap_Part29();
	}
	if (p == 0)
	{
		Streamer_SetVisibleItems(STREAMER_TYPE_OBJECT, 500);   // 0.3.7 + CEF nello stesso processo: memoria del client limitata
		// invio a blocchi: allo spawn il client riceve 25 oggetti per ciclo dello streamer invece di centinaia insieme
		Streamer_ToggleChunkStream(1);
		Streamer_SetChunkSize(STREAMER_TYPE_OBJECT, 25);
		Streamer_SetChunkTickRate(STREAMER_TYPE_OBJECT, 1);
	}
	if (p == AZMAP_PARTS - 1)
	{
		printf("[MAPPA] Arizona Los Santos: %d oggetti", AZMAP_OBJECTS);
	}
}

