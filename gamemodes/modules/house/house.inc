	{
		Util_Send(playerid, -10270721, "Non hai tutta quella spesa con te.");
		return 0;
	}
	new cap = House_FridgeCap(idx);
	if (g_HouseRows[idx][HOUSE_ROW_43] + n > cap)
	{
		SendClientMessage(playerid, -10270721, "Nel frigo c'e' posto solo per altre %d porzioni.", cap - g_HouseRows[idx][HOUSE_ROW_43]);
		return 0;
	}
	g_HsFridgeBusy[idx] = 1;
	if (!Inv_FridgeMove(playerid, g_HouseRows[idx][HOUSE_ROW_0], 1, n, cap))
	{
		g_HsFridgeBusy[idx] = 0;
	}
