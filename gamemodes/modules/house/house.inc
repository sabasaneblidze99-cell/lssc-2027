}

House_TickRow(idx)
{
	g_HouseRows[idx][HOUSE_ROW_42] += 1;
	if (House_LightOn(idx))
	{
		g_HouseRows[idx][HOUSE_ROW_40] += 1;
	}
	if (House_GasOn(idx))
	{
		g_HouseRows[idx][HOUSE_ROW_41] += 1;
	}
	if (!House_LightOn(idx))
	{
		g_HouseRows[idx][HOUSE_ROW_44] += 1;
		if (g_HouseRows[idx][HOUSE_ROW_44] >= 180 && !g_HsFridgeBusy[idx])
		{
			g_HouseRows[idx][HOUSE_ROW_44] = 0;
			new units = g_HouseRows[idx][HOUSE_ROW_43], lost = (units * 50 + 100 - 1) / 100;
			if (lost > 0)
			{
				g_HouseRows[idx][HOUSE_ROW_43] = max(units - lost, 0);
				DB_FridgeAddSys(g_HouseRows[idx][HOUSE_ROW_0], -(units - g_HouseRows[idx][HOUSE_ROW_43]));
				House_RefreshInside(idx);
				new owner = House_OwnerPlayer(idx);
				if (owner != 65535)
				{
					SendClientMessage(owner, -10270721, "Casa %d: senza corrente il frigo ha perso %d porzioni.", g_HouseRows[idx][HOUSE_ROW_0], lost);
				}
			}
			House_SaveTick(idx);
		}
	}
	if (g_HouseRows[idx][HOUSE_ROW_42] >= 180)
	{
		House_CloseCycle(idx);
	}
}

public House_OnTick()
{
	new now = GetTickCount();
	if (g_HsReady)
	{
		for (new idx = 0; idx < g_HouseCount; idx++)
		{
			if (g_HouseRows[idx][HOUSE_ROW_1] <= 0 || g_HsBusy[idx])
			{
				continue;
			}
			new owner = House_OwnerPlayer(idx);
			if (owner == 65535 || !House_PlayerActive(owner, now))
			{
				continue;
			}
			House_TickRow(idx);
		}
	}
	for (new p = 0; p < 1000; p++)
	{
		if (!IsPlayerConnected(p) || !Util_IsPlaying(p) || g_HPl[p][HPLAYER_0] == 0)
		{
			continue;
		}
		if (g_HPl[p][HPLAYER_1] > 0)
		{
			House_FindInside(p);
		}
		if (g_HPl[p][HPLAYER_13] == 0)
		{
			House_BeginFoodLoad(p);
		}
		if (g_HPl[p][HPLAYER_13] != 2 || !House_PlayerActive(p, now))
		{
			continue;
		}
		g_HPl[p][HPLAYER_16] += 60000;
		if (g_HPl[p][HPLAYER_16] >= 360000)
		{
			g_HPl[p][HPLAYER_16] -= 360000;
			if (g_HPl[p][HPLAYER_14] > 0)
			{
				House_HungerSet(p, g_HPl[p][HPLAYER_14] - 1, 1);
			}
		}
	}
	return 1;
}

public House_OnSaveTick()
{
	for (new idx = 0; idx < g_HouseCount; idx++)
	{
		if (g_HouseRows[idx][HOUSE_ROW_1] <= 0 || g_HsBusy[idx])
		{
			continue;
		}
		if (House_OwnerPlayer(idx) == 65535)
		{
			continue;
		}
		House_SaveTick(idx);
	}
	return 1;
}

public House_OnDBSeeded(ok)
{
	if (ok != 1)
	{
		Log_Write("HOUSE", "seed case fallito (errore database)");
	}
	return 1;
}

public House_OnDBLoaded(count)
{
	if (count == -1)
	{
		g_HsReady = 0;
		Log_Write("HOUSE", "caricamento case fallito: sistema case disabilitato");
		return 1;
	}
	for (new i = 0; i < count && i < 64; i++)
	{
		g_HsBusy[i] = 0;
		House_RefreshWorld(i);
	}
	g_HsReady = 1;
	new msg[128];
	format(msg, 128, "caricate %d case", count);
	Log_Write("HOUSE", msg);
	return 1;
}

House_OnInit()
{
	for (new p = 0; p < 1000; p++)
	{
		House_ResetPlayer(p);
	}
	for (new i = 0; i < 64; i++)
	{
		g_HsPickup[i] = -1;
		g_HsLabel[i] = 65535;
		g_HsBusy[i] = 0;
		g_HsFridgeBusy[i] = 0;
	}
	g_HsReady = 0;
	for (new s = 0; s < 2; s++)
	{
		Lang_Create3DTextLabel("Supermercato\n/compra - cibo, pasto, acqua, snack, kit, benda, zaino...", 0x66DD66FF, s_HsShops[s][0], s_HsShops[s][1], (0.9 + Float:(s_HsShops[s][2])), 12.0, 0, 0);
	}
	g_HsTickTimer = SetTimer("House_OnTick", 60000, 1);
	g_HsSaveTimer = SetTimer("House_OnSaveTick", 300000, 1);
	DB_BootHouses();
}

House_SavePlayerFood(playerid)
{
	if (g_HPl[playerid][HPLAYER_13] != 2 || gPlayer[playerid][PLAYER_DATA_3] <= 0)
	{
		return 0;
	}
	DB_SaveHunger(gPlayer[playerid][PLAYER_DATA_3], g_HPl[playerid][HPLAYER_14]);
}

House_OnExit()
{
	if (g_HsTickTimer != 0)
	{
		KillTimer(g_HsTickTimer);
	}
	if (g_HsSaveTimer != 0)
	{
		KillTimer(g_HsSaveTimer);
	}
	g_HsTickTimer = 0;
	g_HsSaveTimer = 0;
	for (new idx = 0; idx < g_HouseCount; idx++)
	{
		if (g_HouseRows[idx][HOUSE_ROW_1] > 0 && House_OwnerPlayer(idx) != 65535)
		{
			House_SaveTick(idx);
		}
	}
	for (new p = 0; p < 1000; p++)
	{
		if (IsPlayerConnected(p))
		{
			House_SavePlayerFood(p);
		}
	}
}

House_OnPlayerConnect(playerid)
{
	House_ResetPlayer(playerid);
	g_HSessionSeq++;
	g_HPl[playerid][HPLAYER_0] = g_HSessionSeq;
	g_HPl[playerid][HPLAYER_21] = GetTickCount() - 1500;
}

House_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= 1000)
	{
		return 0;
	}
	for (new idx = 0; idx < g_HouseCount; idx++)
	{
		if (g_HouseRows[idx][HOUSE_ROW_1] > 0 && g_HouseRows[idx][HOUSE_ROW_1] == gPlayer[playerid][PLAYER_DATA_3])
		{
			House_SaveTick(idx);
		}
	}
	House_SavePlayerFood(playerid);
	House_ResetPlayer(playerid);
}

House_OnPlayerSpawn(playerid)
{
	if (!House_PlayerOk(playerid))
	{
		return 0;
	}
	g_HPl[playerid][HPLAYER_18] = 0;
	new world = GetPlayerVirtualWorld(playerid);
	if (g_HsReady && world > 1000)
	{
		new idx = House_Find(world - 1000);
		if (idx != -1 && g_HouseRows[idx][HOUSE_ROW_1] > 0 && (!g_HouseRows[idx][HOUSE_ROW_35] || House_HasAccess(idx, playerid)))
		{
			g_HPl[playerid][HPLAYER_1] = g_HouseRows[idx][HOUSE_ROW_0];
			House_ApplyInsideUi(playerid, idx);
		}
		else
		{
			if (idx != -1)
			{
				House_PlaceOutside(playerid, idx);
			}
			else
			{
				new Float:x, Float:y, Float:z, Float:a;
				Char_GetSpawnPoint(0, x, y, z, a);
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0);
				SetPlayerPos(playerid, x, y, z);
				House_ClearInside(playerid);
			}
		}
	}
	else
	{
		House_ClearInside(playerid);
	}
	if (g_HPl[playerid][HPLAYER_13] == 2)
	{
		UI_HungerHudUpdate(playerid, g_HPl[playerid][HPLAYER_14]);
		House_CapHealthIfWeak(playerid);
	}
	else
	{
		g_HPl[playerid][HPLAYER_17] = 1;
		House_BeginFoodLoad(playerid);
	}
}

House_OnPlayerPickUpPickup(playerid, pickupid)
{
	if (!House_PlayerOk(playerid) || !g_HsReady)
	{
		return 0;
	}
	new idx = -1;
	for (new i = 0; i < g_HouseCount; i++)
	{
		if (g_HsPickup[i] == pickupid)
		{
			idx = i;
			break;
		}
	}
	if (idx == -1)
	{
		return 0;
	}
	new now = GetTickCount();
	if (now - g_HPl[playerid][HPLAYER_23] < 3000)
	{
		return 0;
	}
	g_HPl[playerid][HPLAYER_23] = now;
	new tier = House_Tier(idx);
	if (g_HouseRows[idx][HOUSE_ROW_1] <= 0)
	{
		SendClientMessage(playerid, -1, "Casa %d (%s) in vendita: $%d, livello minimo %d. Usa /casa per le info e l'acquisto.", g_HouseRows[idx][HOUSE_ROW_0], s_HsTierName[tier], g_HouseRows[idx][HOUSE_ROW_33], s_HsTierLevel[tier]);
	}
	else
	{
		if (House_CanEnterNow(idx, playerid))
		{
			SendClientMessage(playerid, -1, "Casa %d di %s. Usa /entra per entrare.", g_HouseRows[idx][HOUSE_ROW_0], g_HouseRows[idx][HOUSE_ROW_2]);
		}
		else
		{
			SendClientMessage(playerid, -1, "Casa %d di %s: porta chiusa a chiave. Usa /bussa.", g_HouseRows[idx][HOUSE_ROW_0], g_HouseRows[idx][HOUSE_ROW_2]);
		}
	}
}
