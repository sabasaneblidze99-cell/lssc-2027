House_GiveKey(playerid, token[])
{
	new idx = House_KeyContext(playerid), target = 0;
	if (idx == -1)
	{
		return 0;
	}
	if (!Util_ParsePlayerId(token, target) || !Util_IsPlaying(target) || target == playerid || gPlayer[target][PLAYER_DATA_3] <= 0)
	{
		Util_Send(playerid, -10270721, "Giocatore non valido.");
		return 0;
	}
	if (!Util_InRange(playerid, target, 3.0))
	{
		Util_Send(playerid, -10270721, "Il giocatore e' troppo lontano.");
		return 0;
	}
	if (House_IsGuest(idx, gPlayer[target][PLAYER_DATA_3]))
	{
		Util_Send(playerid, -10270721, "Quel giocatore ha gia' una chiave.");
		return 0;
	}
	if (g_HouseRows[idx][HOUSE_ROW_45] >= 3)
	{
		SendClientMessage(playerid, -10270721, "Hai gia' consegnato il massimo di chiavi (%d).", 3);
		return 0;
	}
	g_HPl[playerid][HPLAYER_2] = 7;
	g_HPl[playerid][HPLAYER_3] = g_HouseRows[idx][HOUSE_ROW_0];
	g_HPl[playerid][HPLAYER_7] = gPlayer[target][PLAYER_DATA_3];
	DB_AddKey(playerid, g_HouseRows[idx][HOUSE_ROW_0], gPlayer[playerid][PLAYER_DATA_3], gPlayer[target][PLAYER_DATA_3]);
}

public House_OnDBKeyAdded(playerid, houseId, targetId, affected)
{
	if (playerid < 0 || playerid >= 1000 || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (g_HPl[playerid][HPLAYER_2] != 7 || !House_OpMatches(playerid, houseId, affected))
	{
		return 1;
	}
	targetId = g_HPl[playerid][HPLAYER_7];
	g_HPl[playerid][HPLAYER_2] = 0;
	new idx = House_Find(houseId);
	if (affected == -1)
	{
		Util_Send(playerid, -10270721, "Chiave non consegnata (errore database).");
		return 1;
	}
	if (affected != 1 || idx == -1)
	{
		Util_Send(playerid, -10270721, "Chiave non consegnata: limite raggiunto o gia' presente.");
		return 1;
	}
	if (g_HouseRows[idx][HOUSE_ROW_45] < 3)
	{
		g_HouseRows[idx][HOUSE_ROW_47][g_HouseRows[idx][HOUSE_ROW_45]] = targetId;
		g_HouseRows[idx][HOUSE_ROW_45]++;
	}
	new target = House_PlayerByChar(targetId), tname[25] = "il giocatore";
	if (target != 65535)
	{
		GetPlayerName(target, tname, 25);
		SendClientMessage(target, 0x66DD66FF, "Hai ricevuto la chiave della casa %d (%s).", houseId, g_HouseRows[idx][HOUSE_ROW_2]);
	}
	SendClientMessage(playerid, 0x66DD66FF, "Hai consegnato una chiave della casa %d a %s (%d/%d).", houseId, tname, g_HouseRows[idx][HOUSE_ROW_45], 3);
	return 1;
}

House_LoadKeys(playerid, intent, token[])
{
