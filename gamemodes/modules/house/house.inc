	DB_LoadKeys(playerid, g_HouseRows[idx][HOUSE_ROW_0], gPlayer[playerid][PLAYER_DATA_3]);
}

public House_OnDBKeysLoaded(playerid, houseId, count)
{
	if (playerid < 0 || playerid >= 1000 || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (g_HPl[playerid][HPLAYER_2] != 6 || !House_OpMatches(playerid, houseId, count))
	{
		return 1;
	}
	new intent = g_HPl[playerid][HPLAYER_6];
	g_HPl[playerid][HPLAYER_2] = 0;
	if (count == -1)
	{
		Util_Send(playerid, -10270721, "Impossibile leggere le chiavi (errore database).");
		return 1;
	}
	if (intent == 3)
	{
		SendClientMessage(playerid, -2994689, "--- Chiavi casa %d (%d/%d) ---", houseId, count, 3);
		for (new i = 0; i < count; i++)
		{
			new online = House_PlayerByChar(g_HouseKeyList[playerid][i][HOUSE_KEY_0]);
			if (online != 65535)
			{
				SendClientMessage(playerid, -1, "%d) %s (online, id %d)", i + 1, g_HouseKeyList[playerid][i][HOUSE_KEY_1], online);
			}
			else
			{
				SendClientMessage(playerid, -1, "%d) %s", i + 1, g_HouseKeyList[playerid][i][HOUSE_KEY_1]);
			}
		}
		Util_Send(playerid, 0x99CCFFFF, "Uso: /casa chiave [id] · /casa revoca [id | Nome_Cognome | numero]");
		return 1;
	}
	new target = 0, num = 0;
	for (new i = 0; i < count && target == 0; i++)
	{
		if (!strcmp(g_HouseKeyList[playerid][i][HOUSE_KEY_1], g_HPl[playerid][HPLAYER_24], 1, 0x7FFFFFFF))
		{
			target = g_HouseKeyList[playerid][i][HOUSE_KEY_0];
		}
	}
	if (target == 0 && Util_ParseInt(g_HPl[playerid][HPLAYER_24], num))
	{
		if (num >= 0 && num < 1000 && IsPlayerConnected(num))
		{
			for (new i = 0; i < count; i++)
			{
				if (g_HouseKeyList[playerid][i][HOUSE_KEY_0] == gPlayer[num][PLAYER_DATA_3])
				{
					target = gPlayer[num][PLAYER_DATA_3];
				}
			}
		}
		if (target == 0 && num >= 1 && num <= count)
		{
			target = g_HouseKeyList[playerid][num - 1][HOUSE_KEY_0];
		}
	}
	if (target <= 0)
	{
		Util_Send(playerid, -10270721, "Nessuna chiave corrisponde: usa /casa chiavi per l'elenco.");
		return 1;
	}
	g_HPl[playerid][HPLAYER_2] = 8;
	g_HPl[playerid][HPLAYER_3] = houseId;
	g_HPl[playerid][HPLAYER_7] = target;
	DB_RemoveKey(playerid, houseId, gPlayer[playerid][PLAYER_DATA_3], target);
	return 1;
}

public House_OnDBKeyRemoved(playerid, houseId, targetId, affected)
{
	if (playerid < 0 || playerid >= 1000 || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (g_HPl[playerid][HPLAYER_2] != 8 || !House_OpMatches(playerid, houseId, affected))
	{
		return 1;
	}
	targetId = g_HPl[playerid][HPLAYER_7];
	g_HPl[playerid][HPLAYER_2] = 0;
	new idx = House_Find(houseId);
	if (affected == -1)
	{
		Util_Send(playerid, -10270721, "Chiave non revocata (errore database).");
		return 1;
	}
	if (affected != 1 || idx == -1)
	{
		Util_Send(playerid, -10270721, "Chiave non revocata: non risulta piu' presente.");
		return 1;
	}
	new w = 0;
	for (new k = 0; k < g_HouseRows[idx][HOUSE_ROW_45] && k < 3; k++)
	{
		if (g_HouseRows[idx][HOUSE_ROW_47][k] == targetId)
		{
			continue;
		}
		g_HouseRows[idx][HOUSE_ROW_47][w++] = g_HouseRows[idx][HOUSE_ROW_47][k];
	}
	for (new k = w; k < 3; k++)
	{
		g_HouseRows[idx][HOUSE_ROW_47][k] = 0;
	}
	g_HouseRows[idx][HOUSE_ROW_45] = w;
	new target = House_PlayerByChar(targetId);
	if (target != 65535)
	{
		SendClientMessage(target, -10270721, "La tua chiave della casa %d e' stata revocata.", houseId);
		if (g_HPl[target][HPLAYER_1] == houseId && g_HouseRows[idx][HOUSE_ROW_35])
		{
			House_PlaceOutside(target, idx);
		}
	}
	SendClientMessage(playerid, 0x66DD66FF, "Chiave revocata (%d/%d).", g_HouseRows[idx][HOUSE_ROW_45], 3);
	return 1;
}

