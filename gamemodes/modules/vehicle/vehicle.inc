public Veh_OnDBLoaded(playerid, count)
{
	if (playerid < 0 || playerid >= 1000 || !IsPlayerConnected(playerid))
	{
		return 1;
	}
	if (g_VPl[playerid][VPLAYER_1] != 1)
	{
		return 1;
	}
	if (count < 0)
	{
		g_VPl[playerid][VPLAYER_1] = 3;
		Util_Send(playerid, -10270721, "Impossibile caricare i tuoi veicoli (errore database). Gli acquisti sono sospesi fino al prossimo accesso.");
		return 1;
	}
	new needed = 0;
	for (new i = 0; i < count && i < 4; i++)
	{
		for (new f = 0; f < 30; f++)
		{
			g_VSlot[playerid][i][f] = 0;
		}
		g_VSlot[playerid][i][VSLOT_29] = 65535;
		g_VSlot[playerid][i][VSLOT_0] = 1;
		g_VSlot[playerid][i][VSLOT_1] = g_VehRows[playerid][i][VEH_ROW_0];
		g_VSlot[playerid][i][VSLOT_2] = g_VehRows[playerid][i][VEH_ROW_1];
		strmid(g_VSlot[playerid][i][VSLOT_3], g_VehRows[playerid][i][VEH_ROW_2], 0, strlen(g_VehRows[playerid][i][VEH_ROW_2]), 8);
		g_VSlot[playerid][i][VSLOT_11] = g_VehRows[playerid][i][VEH_ROW_10];
		g_VSlot[playerid][i][VSLOT_12] = g_VehRows[playerid][i][VEH_ROW_11];
		g_VSlot[playerid][i][VSLOT_13] = g_VehRows[playerid][i][VEH_ROW_12];
		g_VSlot[playerid][i][VSLOT_14] = g_VehRows[playerid][i][VEH_ROW_13];
		g_VSlot[playerid][i][VSLOT_15] = g_VehRows[playerid][i][VEH_ROW_14];
		g_VSlot[playerid][i][VSLOT_16] = g_VehRows[playerid][i][VEH_ROW_15];
		g_VSlot[playerid][i][VSLOT_17] = g_VehRows[playerid][i][VEH_ROW_16];
		g_VSlot[playerid][i][VSLOT_18] = g_VehRows[playerid][i][VEH_ROW_17];
		g_VSlot[playerid][i][VSLOT_19] = g_VehRows[playerid][i][VEH_ROW_18];
		g_VSlot[playerid][i][VSLOT_20] = g_VehRows[playerid][i][VEH_ROW_19];
		g_VSlot[playerid][i][VSLOT_21] = g_VehRows[playerid][i][VEH_ROW_20];
		g_VSlot[playerid][i][VSLOT_22] = g_VehRows[playerid][i][VEH_ROW_23];
		g_VSlot[playerid][i][VSLOT_23] = g_VehRows[playerid][i][VEH_ROW_24];
		g_VSlot[playerid][i][VSLOT_24] = g_VehRows[playerid][i][VEH_ROW_25];
		g_VSlot[playerid][i][VSLOT_25] = g_VehRows[playerid][i][VEH_ROW_26];
		if (!g_VSlot[playerid][i][VSLOT_25])
		{
			needed++;
		}
	}
	g_VPl[playerid][VPLAYER_1] = 2;
	if (count <= 0)
	{
		return 1;
	}
	if (g_VPool + needed > 300)
	{
		new name[25], msg[256];
		GetPlayerName(playerid, name, 25);
		format(msg, 256, "[VEICOLI] Tetto di %d veicoli personali raggiunto: i veicoli di %s [%d] non sono stati creati.", 300, name, playerid);
		Admin_Notify(msg, -5963521);
		Log_Write("VEH", msg);
		Util_Send(playerid, -10270721, "Il server ha raggiunto il limite di veicoli personali: i tuoi veicoli non sono disponibili al momento.");
		return 1;
	}
	new spawned = 0;
	for (new i = 0; i < count && i < 4; i++)
	{
		if (g_VSlot[playerid][i][VSLOT_25])
		{
			continue;
		}
		if (Veh_Spawn(playerid, i, Float:g_VSlot[playerid][i][VSLOT_14], Float:g_VSlot[playerid][i][VSLOT_15], Float:g_VSlot[playerid][i][VSLOT_16], Float:g_VSlot[playerid][i][VSLOT_17]))
		{
			spawned++;
		}
	}
	SendClientMessage(playerid, -1, "Hai %d veicolo/i (%d in strada). Usa /v list per i dettagli.", count, spawned);
	return 1;
}

Veh_CmdDealer(playerid)
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	if (Veh_CooldownBlocked(playerid))
	{
		return 0;
	}
	if (!Veh_NearDealer(playerid))
	{
		Util_Send(playerid, -10270721, "Devi essere al concessionario di Los Santos.");
		return 0;
	}
	if (GetPlayerState(playerid) != 1)
	{
		Util_Send(playerid, -10270721, "Scendi dal veicolo per usare il concessionario.");
		return 0;
	}
	if (g_VPl[playerid][VPLAYER_1] != 2)
	{
		Util_Send(playerid, -10270721, "I tuoi veicoli non sono ancora stati caricati: riprova tra poco.");
		return 0;
	}
	if (Veh_Busy(playerid))
	{
		Util_Send(playerid, -10270721, "Hai un'operazione veicolo in corso: attendi.");
		return 0;
	}
	UI_VehicleShopShow(playerid, gPlayer[playerid][PLAYER_DATA_90], gPlayer[playerid][PLAYER_DATA_88], gPlayer[playerid][PLAYER_DATA_89]);
}

public UI_OnVehicleBuyConfirm(playerid, catalogIndex, payWithBank)
{
	if (!Veh_PlayerReady(playerid))
	{
		return 1;
	}
	if (!Veh_NearDealer(playerid))
	{
		Util_Send(playerid, -10270721, "Devi essere al concessionario di Los Santos.");
		return 1;
	}
	if (Veh_Busy(playerid))
	{
		Util_Send(playerid, -10270721, "Hai un'operazione veicolo in corso: attendi.");
		return 1;
	}
	if (g_VPl[playerid][VPLAYER_1] != 2)
	{
		Util_Send(playerid, -10270721, "I tuoi veicoli non sono disponibili (caricamento non riuscito o in corso).");
		return 1;
	}
	if (catalogIndex < 0 || catalogIndex >= 13 || (payWithBank != 0 && payWithBank != 1))
	{
		Util_Send(playerid, -10270721, "Richiesta di acquisto non valida.");
		return 1;
	}
	if (gPlayer[playerid][PLAYER_DATA_90] < g_VehCatLevel[catalogIndex])
	{
		SendClientMessage(playerid, -10270721, "Questo modello richiede il livello %d.", g_VehCatLevel[catalogIndex]);
		return 1;
	}
	if (Veh_UsedCount(playerid) >= Veh_MaxForLevel(gPlayer[playerid][PLAYER_DATA_90]) || Veh_FreeSlot(playerid) == -1)
	{
		SendClientMessage(playerid, -10270721, "Hai raggiunto il limite di veicoli per il tuo livello (%d).", Veh_MaxForLevel(gPlayer[playerid][PLAYER_DATA_90]));
		return 1;
	}
	if (g_VPool >= 300)
	{
		Util_Send(playerid, -10270721, "Il concessionario non puo' consegnare altri veicoli in questo momento.");
		return 1;
	}
	new price = g_VehCatPrice[catalogIndex];
	if (payWithBank == 1 ? !Money_CanBank(playerid, price) : !Money_Can(playerid, price))
	{
