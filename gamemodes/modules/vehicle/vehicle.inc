Veh_DoRecover(playerid, slot)
{
	if (slot < 0 || slot >= 4 || !g_VSlot[playerid][slot][VSLOT_0])
	{
		Util_Send(playerid, -10270721, "Slot veicolo non valido.");
		return 0;
	}
	if (Veh_Busy(playerid) || g_VSlot[playerid][slot][VSLOT_28])
	{
		Util_Send(playerid, -10270721, "Hai un'operazione veicolo in corso: attendi.");
		return 0;
	}
	if (!g_VSlot[playerid][slot][VSLOT_25])
	{
		Util_Send(playerid, -10270721, "Questo veicolo non e' distrutto.");
		return 0;
	}
	if (g_VPool >= 300)
	{
		Util_Send(playerid, -10270721, "Limite veicoli del server raggiunto: riprova piu' tardi.");
		return 0;
	}
	new listPrice = Veh_ListPrice(g_VSlot[playerid][slot][VSLOT_2], g_VSlot[playerid][slot][VSLOT_13]);
	new cost = max(listPrice * 5 / 100, 500);
	new bool:useCash = Money_Can(playerid, cost);
	if (!useCash && !Money_CanBank(playerid, cost))
	{
		SendClientMessage(playerid, -10270721, "Assicurazione $%d: fondi insufficienti (contanti o banca).", cost);
		return 0;
	}
	new vid = g_VSlot[playerid][slot][VSLOT_29];
	if (vid != 65535)
	{
		Veh_Despawn(playerid, slot);
	}
	new minFuel = Veh_CapacityCl(g_VSlot[playerid][slot][VSLOT_2]) * 10 / 100;
	g_VSlot[playerid][slot][VSLOT_25] = 0;
	g_VSlot[playerid][slot][VSLOT_22] = 0x43AF0000;
	g_VSlot[playerid][slot][VSLOT_23] = max(g_VSlot[playerid][slot][VSLOT_23], minFuel);
	g_VSlot[playerid][slot][VSLOT_24] = 1;
	if (!Veh_Spawn(playerid, slot, Float:g_VSlot[playerid][slot][VSLOT_18], Float:g_VSlot[playerid][slot][VSLOT_19], Float:g_VSlot[playerid][slot][VSLOT_20], Float:g_VSlot[playerid][slot][VSLOT_21]))
	{
		g_VSlot[playerid][slot][VSLOT_25] = 1;
		Util_Send(playerid, -10270721, "Recupero non riuscito (limite veicoli del server). Nessun addebito.");
		return 0;
	}
	if (!(useCash ? Money_Take(playerid, cost) : Money_TakeBank(playerid, cost, "bill", "")))
	{
		Veh_Despawn(playerid, slot);
		g_VSlot[playerid][slot][VSLOT_25] = 1;
		Util_Send(playerid, -10270721, "Pagamento non riuscito. Recupero annullato.");
		return 0;
	}
	Char_Save(playerid);
	DB_RecoverVehicle(g_VSlot[playerid][slot][VSLOT_1], gPlayer[playerid][PLAYER_DATA_3], Float:g_VSlot[playerid][slot][VSLOT_22], g_VSlot[playerid][slot][VSLOT_23]);
	new mname[12], pname[25], msg[256];
	Veh_ModelName(g_VSlot[playerid][slot][VSLOT_2], mname, 12);
	SendClientMessage(playerid, 0x66DD66FF, "Assicurazione pagata ($%d, %s): la tua %s ti aspetta al parcheggio.", cost, useCash ? "contanti" : "banca", mname);
	GetPlayerName(playerid, pname, 25);
	format(msg, 256, "RECUPERO %s: %s dbId %d costo $%d", pname, mname, g_VSlot[playerid][slot][VSLOT_1], cost);
	Log_Write("VEH", msg);
}

Veh_CmdV(playerid, params[])
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	new pos = 0, sub[16], a1[16], a2[16];
	Util_NextToken(params, pos, sub, 16);
	Util_NextToken(params, pos, a1, 16);
	Util_NextToken(params, pos, a2, 16);
	for (new i = 0; sub[i] != 0; i++)
	{
		sub[i] = tolower(sub[i]);
	}
	if (sub[0] == 0)
	{
		Util_Send(playerid, 0x99CCFFFF, "Uso: /v lock | engine | lights | park | find [slot] | list | sell [slot] | recover [slot]");
		return 0;
	}
	if (Veh_CooldownBlocked(playerid))
	{
		return 0;
	}
	if (!strcmp(sub, "lock", 0, 0x7FFFFFFF))
	{
		Veh_DoLock(playerid);
		return 0;
	}
	if (!strcmp(sub, "engine", 0, 0x7FFFFFFF))
	{
		Veh_DoEngine(playerid);
		return 0;
	}
	if (!strcmp(sub, "lights", 0, 0x7FFFFFFF))
	{
		Veh_DoLights(playerid);
		return 0;
	}
	if (!strcmp(sub, "park", 0, 0x7FFFFFFF))
	{
		Veh_DoPark(playerid);
		return 0;
	}
	if (!strcmp(sub, "list", 0, 0x7FFFFFFF))
	{
		Veh_DoList(playerid);
		return 0;
	}
	if (!strcmp(sub, "tow", 0, 0x7FFFFFFF))
	{
		Util_Send(playerid, -10270721, "Il carro attrezzi non e' ancora disponibile.");
		return 0;
	}
	new slot = -1;
	if (!strcmp(sub, "find", 0, 0x7FFFFFFF) || !strcmp(sub, "sell", 0, 0x7FFFFFFF) || !strcmp(sub, "recover", 0, 0x7FFFFFFF))
	{
		new bool:confirm = 0;
		if (!strcmp(sub, "sell", 0, 0x7FFFFFFF) && !strcmp(a1, "conferma", 0, 0x7FFFFFFF))
		{
			confirm = 1;
			a1[0] = 0;
		}
		else
		{
			if (!strcmp(sub, "sell", 0, 0x7FFFFFFF) && !strcmp(a2, "conferma", 0, 0x7FFFFFFF))
			{
				confirm = 1;
			}
		}
		if (a1[0] != 0)
		{
			if (!Veh_ParseSlot(a1, slot))
			{
				SendClientMessage(playerid, -10270721, "Slot non valido (1-%d).", 4);
				return 0;
			}
		}
		else
		{
			if (!strcmp(sub, "recover", 0, 0x7FFFFFFF))
			{
				new destroyed = 0;
				for (new s = 0; s < 4; s++)
				{
					if (g_VSlot[playerid][s][VSLOT_0] && g_VSlot[playerid][s][VSLOT_25])
					{
						slot = s;
						destroyed++;
					}
				}
				if (destroyed != 1)
				{
					Util_Send(playerid, 0x99CCFFFF, "Uso: /v recover [slot] (/v list per vedere quali sono distrutti)");
					return 0;
				}
			}
			else
			{
				slot = Veh_NearestOwnSlot(playerid);
				if (slot == -1 && Veh_UsedCount(playerid) == 1)
				{
					for (new s = 0; s < 4; s++)
					{
						if (g_VSlot[playerid][s][VSLOT_0])
						{
							slot = s;
						}
					}
				}
				if (slot == -1)
				{
					Util_Send(playerid, 0x99CCFFFF, "Uso: /v find|sell [slot] (nessun tuo veicolo vicino)");
					return 0;
				}
			}
		}
		if (!strcmp(sub, "find", 0, 0x7FFFFFFF))
		{
			Veh_DoFind(playerid, slot);
		}
		else
		{
			if (!strcmp(sub, "recover", 0, 0x7FFFFFFF))
			{
				Veh_DoRecover(playerid, slot);
			}
			else
			{
				Veh_DoSell(playerid, slot, confirm);
			}
		}
		return 0;
	}
	Util_Send(playerid, 0x99CCFFFF, "Uso: /v lock | engine | lights | park | find [slot] | list | sell [slot] | recover [slot]");
}

Veh_CmdRefuel(playerid, params[])
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	if (Veh_CooldownBlocked(playerid))
	{
		return 0;
	}
	new slot = Veh_DrivenSlot(playerid);
	if (slot == -1)
	{
		Util_Send(playerid, -10270721, "Devi essere al volante di un tuo veicolo.");
		return 0;
	}
	if (!Veh_NearStation(playerid))
	{
		Util_Send(playerid, -10270721, "Non sei vicino a un distributore.");
		return 0;
	}
	if (Veh_Busy(playerid) || g_VSlot[playerid][slot][VSLOT_28])
	{
		Util_Send(playerid, -10270721, "Veicolo non disponibile: operazione in corso.");
		return 0;
	}
	if (g_VSlot[playerid][slot][VSLOT_26])
	{
		Util_Send(playerid, -10270721, "Spegni il motore prima di fare rifornimento (/v engine).");
		return 0;
	}
	new cap = Veh_CapacityCl(g_VSlot[playerid][slot][VSLOT_2]);
	new need = cap - g_VSlot[playerid][slot][VSLOT_23];
	if (need <= 0)
	{
		Util_Send(playerid, -10270721, "Il serbatoio e' gia' pieno.");
		return 0;
	}
	new want = need, pos = 0, tok[12];
	Util_NextToken(params, pos, tok, 12);
	if (tok[0] != 0)
	{
		new liters = 0;
		if (!Util_ParseInt(tok, liters) || liters < 1 || liters > cap / 100)
		{
			SendClientMessage(playerid, 0x99CCFFFF, "Uso: /refuel [litri 1-%d] (senza argomento: pieno)", cap / 100);
			return 0;
		}
		want = min(liters * 100, need);
	}
	new cash = min(gPlayer[playerid][PLAYER_DATA_88], cap);
	new affordable = cash * 100 / 3;
	new add = min(want, affordable);
	if (add <= 0)
	{
		Util_Send(playerid, -10270721, "Non hai abbastanza contanti per fare rifornimento.");
		return 0;
	}
	new cost = (add * 3 + 100 - 1) / 100;
	if (!Money_Take(playerid, cost))
	{
		Util_Send(playerid, -10270721, "Non hai abbastanza contanti per fare rifornimento.");
		return 0;
	}
	g_VSlot[playerid][slot][VSLOT_23] += add;
	if (Veh_FuelPct(playerid, slot) > 15)
	{
		g_VSlot[playerid][slot][VSLOT_27] = 0;
	}
	Char_Save(playerid);
	Veh_SaveSlot(playerid, slot);
	Veh_HudRefresh(playerid);
	SendClientMessage(playerid, 0x66DD66FF, "Rifornimento: +%.1f L per $%d. Serbatoio: %.1f/%.0f L.", (Float:(float(add)) / Float:(float(100))), cost, (Float:(float(g_VSlot[playerid][slot][VSLOT_23])) / Float:(float(100))), (Float:(float(cap)) / Float:(float(100))));
}

Veh_OnInit()
{
	for (new v = 0; v < 2001; v++)
	{
		g_VMapOwner[v] = 65535;
		g_VMapSlot[v] = -1;
		g_VMapSession[v] = 0;
	}
	for (new p = 0; p < 1000; p++)
	{
		Veh_ResetPlayer(p);
	}
	g_VPool = 0;
	g_VSaveTimer = SetTimer("Veh_OnSaveTick", 120000, 1);
	CreatePickup(1239, 1, 1655.0, -1665.0, 22.5, 0);
	Lang_Create3DTextLabel("Concessionario di Los Santos\nUsa /concessionario", -2994689, 1655.0, -1665.0, (22.5 + 1.0), 15.0, 0, 0);
	for (new i = 0; i < 3; i++)
	{
		Lang_Create3DTextLabel("Distributore\nUsa /refuel [litri]", -2994689, g_VehStations[i][0], g_VehStations[i][1], (1.0 + Float:(g_VehStations[i][2])), 15.0, 0, 0);
	}
}

Veh_OnExit()
{
	Veh_SaveAll();
	if (g_VSaveTimer != 0)
	{
		KillTimer(g_VSaveTimer);
	}
	if (g_VFuelTimer != 0)
	{
		KillTimer(g_VFuelTimer);
	}
	if (g_VHudTimer != 0)
	{
		KillTimer(g_VHudTimer);
	}
	g_VSaveTimer = 0;
	g_VFuelTimer = 0;
	g_VHudTimer = 0;
}

Veh_OnPlayerConnect(playerid)
{
	Veh_ResetPlayer(playerid);
	g_VSessionSeq++;
	g_VPl[playerid][VPLAYER_0] = g_VSessionSeq;
	g_VPl[playerid][VPLAYER_11] = GetTickCount() - 2000;
}

Veh_OnPlayerSpawn(playerid)
{
	if (!Veh_PlayerReady(playerid))
	{
		return 0;
	}
	if (g_VPl[playerid][VPLAYER_1] == 0 || g_VPl[playerid][VPLAYER_1] == 3)
	{
		Veh_BeginLoad(playerid);
	}
}

Veh_OnPlayerDisconnect(playerid)
{
	if (playerid < 0 || playerid >= 1000)
	{
		return 0;
	}
	if (g_VPl[playerid][VPLAYER_12] != 0)
	{
		KillTimer(g_VPl[playerid][VPLAYER_12]);
	}
	Veh_HudStop(playerid);
	for (new s = 0; s < 4; s++)
	{
		if (!g_VSlot[playerid][s][VSLOT_0])
		{
			continue;
		}
		if (g_VSlot[playerid][s][VSLOT_29] != 65535)
		{
			if (g_VSlot[playerid][s][VSLOT_26])
			{
				g_VSlot[playerid][s][VSLOT_26] = 0;
			}
			Veh_SaveSlot(playerid, s);
			Veh_Despawn(playerid, s);
		}
	}
	Veh_ResetPlayer(playerid);
	Veh_SyncTimers();
}

Veh_OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	new o = 65535, s = -1;
	if (!Veh_Lookup(vehicleid, o, s) || o == playerid)
	{
		return 0;
	}
	if (ispassenger == 0)
	{
		ClearAnimations(playerid, 0);
		Util_Send(playerid, -10270721, "Non hai le chiavi di questo veicolo.");
	}
}

Veh_OnPlayerExitVehicle(playerid, vehicleid)
{
	new o = 65535, s = -1;
	if (Veh_Lookup(vehicleid, o, s))
	{
		Veh_SaveSlot(o, s);
	}
}

Veh_OnPlayerStateChange(playerid, t_PLAYER_STATE:newstate, t_PLAYER_STATE:oldstate)
{
	if (oldstate == 2 && g_VPl[playerid][VPLAYER_13] != 0)
	{
		new vid = g_VPl[playerid][VPLAYER_13], o = 65535, s = -1;
		Veh_HudStop(playerid);
		if (Veh_Lookup(vid, o, s) && o == playerid)
		{
			if (g_VSlot[o][s][VSLOT_26])
			{
				Veh_SetEngine(o, s, 0);
			}
			Veh_SaveSlot(o, s);
		}
	}
	if (newstate == 2)
	{
		new vid = GetPlayerVehicleID(playerid), o = 65535, s = -1;
		if (!Veh_Lookup(vid, o, s))
		{
			return 0;
		}
		if (o != playerid)
		{
			Util_Send(playerid, -10270721, "Non hai le chiavi di questo veicolo.");
			RemovePlayerFromVehicle(playerid, 0);
			return 0;
		}
		Veh_SetParams(vid, g_VSlot[o][s][VSLOT_26] ? 1 : 0, -1, -1);
		Veh_HudStart(playerid, vid);
		if (!g_VSlot[o][s][VSLOT_26])
		{
			Util_Send(playerid, 0x99CCFFFF, "Motore spento: usa /v engine per avviarlo.");
		}
	}
}

Veh_OnVehicleDeath(vehicleid, killerid)
{
	new o = 65535, s = -1;
	if (!Veh_Lookup(vehicleid, o, s) || g_VSlot[o][s][VSLOT_25])
	{
		return 0;
	}
	if (g_VSlot[o][s][VSLOT_26])
	{
		Veh_SetEngine(o, s, 0);
	}
	g_VSlot[o][s][VSLOT_25] = 1;
	g_VSlot[o][s][VSLOT_22] = 0x43AF0000;
	Veh_SaveSlot(o, s);
	SetTimerEx("Veh_OnWreckRemove", 10000, 0, "ddd", vehicleid, o, g_VMapSession[vehicleid]);
	new mname[12], pname[25], msg[256];
	Veh_ModelName(g_VSlot[o][s][VSLOT_2], mname, 12);
	SendClientMessage(o, -10270721, "La tua %s (slot %d) e' stata distrutta. Recuperala con /v recover %d.", mname, s + 1, s + 1);
	GetPlayerName(o, pname, 25);
	format(msg, 256, "DISTRUTTO %s: %s dbId %d", pname, mname, g_VSlot[o][s][VSLOT_1]);
	Log_Write("VEH", msg);
}
