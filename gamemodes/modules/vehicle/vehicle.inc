bool:Veh_Spawn(playerid, slot, Float:x, Float:y, Float:z, Float:a)
{
	if (g_VPool >= 300)
	{
		return 0;
	}
	if (g_VSlot[playerid][slot][VSLOT_29] != 65535)
	{
		return 0;
	}
	new vid = CreateVehicle(g_VSlot[playerid][slot][VSLOT_2], x, y, z, a, g_VSlot[playerid][slot][VSLOT_11], g_VSlot[playerid][slot][VSLOT_12], -1, 0);
	if (vid == 65535 || vid <= 0 || vid > 2000)
	{
		return 0;
	}
	SetVehicleNumberPlate(vid, g_VSlot[playerid][slot][VSLOT_3]);
	new Float:hp = Float:g_VSlot[playerid][slot][VSLOT_22];
	if ((Float:(hp) < Float:(0x43AF0000)))
	{
		hp = Float:0x43AF0000;
	}
	SetVehicleHealth(vid, hp);
	g_VSlot[playerid][slot][VSLOT_22] = hp;
	g_VSlot[playerid][slot][VSLOT_26] = 0;
	g_VSlot[playerid][slot][VSLOT_27] = 0;
	g_VSlot[playerid][slot][VSLOT_14] = x;
	g_VSlot[playerid][slot][VSLOT_15] = y;
	g_VSlot[playerid][slot][VSLOT_16] = z;
	g_VSlot[playerid][slot][VSLOT_17] = a;
	Veh_SetParams(vid, 0, 0, g_VSlot[playerid][slot][VSLOT_24] ? 1 : 0);
	g_VMapOwner[vid] = playerid;
	g_VMapSlot[vid] = slot;
	g_VMapSession[vid] = g_VPl[playerid][VPLAYER_0];
	g_VSlot[playerid][slot][VSLOT_29] = vid;
	g_VPool++;
	return 1;
}

Veh_Despawn(playerid, slot)
{
	new vid = g_VSlot[playerid][slot][VSLOT_29];
	if (vid == 65535)
	{
		return 0;
	}
	Veh_HudDropVehicle(vid);
	if (vid > 0 && vid <= 2000)
	{
		g_VMapOwner[vid] = 65535;
		g_VMapSlot[vid] = -1;
		g_VMapSession[vid] = 0;
	}
	DestroyVehicle(vid);
	g_VSlot[playerid][slot][VSLOT_29] = 65535;
	g_VSlot[playerid][slot][VSLOT_26] = 0;
	if (g_VPool > 0)
	{
		g_VPool--;
	}
	Veh_SyncTimers();
}

Veh_SaveSlot(playerid, slot)
{
	if (!g_VSlot[playerid][slot][VSLOT_0] || g_VSlot[playerid][slot][VSLOT_1] <= 0)
	{
		return 0;
	}
	new vid = g_VSlot[playerid][slot][VSLOT_29];
	if (vid != 65535)
	{
		new Float:x, Float:y, Float:z, Float:a, Float:hp;
		GetVehiclePos(vid, x, y, z);
		GetVehicleZAngle(vid, a);
		GetVehicleHealth(vid, hp);
		g_VSlot[playerid][slot][VSLOT_14] = x;
		g_VSlot[playerid][slot][VSLOT_15] = y;
		g_VSlot[playerid][slot][VSLOT_16] = z;
		g_VSlot[playerid][slot][VSLOT_17] = a;
		if (!g_VSlot[playerid][slot][VSLOT_25])
		{
			g_VSlot[playerid][slot][VSLOT_22] = hp;
		}
	}
	else
	{
		if (g_VSlot[playerid][slot][VSLOT_25])
		{
			return 0;
		}
	}
	DB_SaveVehicle(g_VSlot[playerid][slot][VSLOT_1], Float:g_VSlot[playerid][slot][VSLOT_14], Float:g_VSlot[playerid][slot][VSLOT_15], Float:g_VSlot[playerid][slot][VSLOT_16], Float:g_VSlot[playerid][slot][VSLOT_17], 0, 0, Float:g_VSlot[playerid][slot][VSLOT_22], g_VSlot[playerid][slot][VSLOT_23], g_VSlot[playerid][slot][VSLOT_24], g_VSlot[playerid][slot][VSLOT_25]);
}

Veh_SaveAll()
{
	for (new p = 0; p < 1000; p++)
