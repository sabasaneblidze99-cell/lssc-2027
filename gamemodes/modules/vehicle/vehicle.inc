		SendClientMessage(playerid, 0x99CCFFFF, "Per confermare: /v sell %d conferma", slot + 1);
		return 0;
	}
	g_VPl[playerid][VPLAYER_6] = 1;
	g_VPl[playerid][VPLAYER_7] = 0;
	g_VPl[playerid][VPLAYER_8] = slot;
	g_VPl[playerid][VPLAYER_9] = g_VSlot[playerid][slot][VSLOT_1];
	g_VPl[playerid][VPLAYER_10] = refund;
	g_VSlot[playerid][slot][VSLOT_28] = 1;
	Util_Send(playerid, -1, "Vendita in corso...");
