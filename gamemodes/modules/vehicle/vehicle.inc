	g_VSlot[playerid][slot][VSLOT_12] = 1;
	g_VSlot[playerid][slot][VSLOT_13] = price;
	g_VSlot[playerid][slot][VSLOT_14] = 0x44CEE000;
	g_VSlot[playerid][slot][VSLOT_15] = 0xC4D34000;
	g_VSlot[playerid][slot][VSLOT_16] = 0x41B40000;
	g_VSlot[playerid][slot][VSLOT_17] = 0x43870000;
	g_VSlot[playerid][slot][VSLOT_18] = 0x44CEE000;
	g_VSlot[playerid][slot][VSLOT_19] = 0xC4D34000;
	g_VSlot[playerid][slot][VSLOT_20] = 0x41B40000;
	g_VSlot[playerid][slot][VSLOT_21] = 0x43870000;
	g_VSlot[playerid][slot][VSLOT_22] = 0x447A0000;
	g_VSlot[playerid][slot][VSLOT_23] = Veh_CapacityCl(g_VehCatModel[idx]) * 50 / 100;
	g_VSlot[playerid][slot][VSLOT_24] = 1;
	if (!Veh_Spawn(playerid, slot, 1655.0, Float:0xC4D34000, 22.5, Float:0x43870000))
	{
		g_VSlot[playerid][slot][VSLOT_0] = 0;
		Veh_RollbackCreate(playerid, vehDbId);
		Util_Send(playerid, -10270721, "Consegna non riuscita (limite veicoli del server). Nessun addebito.");
