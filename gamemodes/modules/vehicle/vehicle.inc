public Veh_OnFuelTick()
{
	for (new p = 0; p < 1000; p++)
	{
		if (g_VPl[p][VPLAYER_0] == 0 || !IsPlayerConnected(p))
		{
			continue;
		}
		for (new s = 0; s < 4; s++)
		{
			new vid = g_VSlot[p][s][VSLOT_29];
			if (!g_VSlot[p][s][VSLOT_0] || vid == 65535 || !g_VSlot[p][s][VSLOT_26])
			{
				continue;
			}
			new use = Veh_SpeedKmh(vid) >= 5 ? 6 : 2;
			g_VSlot[p][s][VSLOT_23] = max(g_VSlot[p][s][VSLOT_23] - use, 0);
			if (g_VSlot[p][s][VSLOT_23] <= 0)
			{
				Veh_SetEngine(p, s, 0);
				Veh_SaveSlot(p, s);
				new driver = GetVehicleDriver(vid);
				if (driver >= 0 && driver < 1000)
				{
					Util_Send(driver, -10270721, "Serbatoio vuoto: il motore si e' spento. Cerca un distributore (/refuel).");
				}
				if (driver != p)
				{
					Util_Send(p, -10270721, "Un tuo veicolo ha finito il carburante e si e' spento.");
				}
			}
			else
			{
				if (!g_VSlot[p][s][VSLOT_27] && Veh_FuelPct(p, s) <= 15)
				{
					g_VSlot[p][s][VSLOT_27] = 1;
					Util_Send(p, -10270721, "Carburante in riserva: raggiungi un distributore.");
				}
			}
		}
	}
}

