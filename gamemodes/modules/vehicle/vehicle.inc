Veh_SyncTimers()
{
	new engines = 0, huds = 0;
	for (new p = 0; p < 1000; p++)
	{
		if (g_VPl[p][VPLAYER_0] == 0)
		{
			continue;
		}
		if (g_VPl[p][VPLAYER_13] != 0)
		{
			huds++;
		}
		for (new s = 0; s < 4; s++)
		{
			if (g_VSlot[p][s][VSLOT_0] && g_VSlot[p][s][VSLOT_29] != 65535 && g_VSlot[p][s][VSLOT_26])
			{
				engines++;
			}
		}
	}
	if (engines > 0 && g_VFuelTimer == 0)
	{
		g_VFuelTimer = SetTimer("Veh_OnFuelTick", 10000, 1);
	}
	else
	{
		if (engines == 0 && g_VFuelTimer != 0)
		{
			KillTimer(g_VFuelTimer);
			g_VFuelTimer = 0;
		}
	}
	if (huds > 0 && g_VHudTimer == 0)
	{
		g_VHudTimer = SetTimer("Veh_OnHudTick", 500, 1);
	}
	else
	{
		if (huds == 0 && g_VHudTimer != 0)
		{
			KillTimer(g_VHudTimer);
			g_VHudTimer = 0;
		}
	}
}

bool:Veh_Lookup(vehicleid, &owner, &slot)
{
	owner = 65535;
	slot = -1;
	if (vehicleid <= 0 || vehicleid > 2000)
	{
		return 0;
	}
	new o = g_VMapOwner[vehicleid], s = g_VMapSlot[vehicleid];
	if (o < 0 || o >= 1000 || !IsPlayerConnected(o))
	{
		return 0;
	}
	if (g_VMapSession[vehicleid] != g_VPl[o][VPLAYER_0] || g_VPl[o][VPLAYER_0] == 0)
	{
		return 0;
	}
	if (s < 0 || s >= 4)
	{
		return 0;
	}
	if (!g_VSlot[o][s][VSLOT_0] || g_VSlot[o][s][VSLOT_29] != vehicleid)
	{
		return 0;
	}
	owner = o;
	slot = s;
	return 1;
}

