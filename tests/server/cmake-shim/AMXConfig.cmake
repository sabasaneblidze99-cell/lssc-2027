# Minimal replacement for Zeex/cmake-modules AMXConfig (original repo no longer clonable)
include(CheckIncludeFile)
check_include_file(alloca.h HAVE_ALLOCA_H)
check_include_file(inttypes.h HAVE_INTTYPES_H)
check_include_file(malloc.h HAVE_MALLOC_H)
check_include_file(stdint.h HAVE_STDINT_H)
foreach(h ALLOCA_H INTTYPES_H MALLOC_H STDINT_H)
  if(HAVE_${h})
    add_definitions(-DHAVE_${h})
  endif()
endforeach()
if(UNIX)
  add_definitions(-DLINUX)
endif()
if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/amx/sclinux.h)
  include_directories(${CMAKE_CURRENT_SOURCE_DIR}/amx)
endif()
if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/sclinux.h)
  include_directories(${CMAKE_CURRENT_SOURCE_DIR})
endif()
